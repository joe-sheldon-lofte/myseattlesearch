---
layout: "base.njk"
permalink: "/design-system/index.html"
eleventyComputed:
  title: "Master UI Component Catalog & Living Analyzer | MySeattleSearch"
  meta_description: "Exhaustive component verification surface testing all widgets, scores, graphics, and section layouts against production data."
---

{# =========================================================================
   CANONICAL DATA BINDING ANCHOR: SHORELINE, WA (North Sound = "x")
   Pulls 100% authentic production data across all active data stores.
   ========================================================================= #}
{% set city = city_data[33] %}
{% set city_slug = city.City | slugify %}
{% set city_name = city.City %}

{# Telemetry Data Stores #}
{% set weather_record = city_weather[city_slug] %}
{% set transit_record = transit_radar_live[city_slug] %}
{% set business_categories = city_businesses[city_slug].categories %}
{% set walk_record = walk_transit_bike_scores[city.City] %}
{% set ev_record = city_ev_scores[city_slug] %}
{% set editorial_content = editorials[city_slug] %}

{# Dynamic Category Slugs from city_data #}
{% set cat1_key = (city.FeatCat1 or '').split(',')[0] %}
{% set cat2_key = (city.FeatCat2 or '').split(',')[0] %}
{% set cat3_key = (city.FeatCat3 or '').split(',')[0] %}
{% set b1 = business_categories[cat1_key][0] if business_categories and cat1_key and business_categories[cat1_key] else null %}
{% set b2 = business_categories[cat2_key][0] if business_categories and cat2_key and business_categories[cat2_key] else null %}
{% set b3 = business_categories[cat3_key][0] if business_categories and cat3_key and business_categories[cat3_key] else null %}

{# Real Estate Telemetry: Shoreline is in Group 2 #}
{% set supply_feed = infosparks_stats.feeds["group_2_months_supply_closed"].data | last %}
{% set current_months_supply = supply_feed[city.City] if supply_feed else null %}

{# Sports Feeds #}
{% set recent_game = hourly_sports.recent_finals[0] if hourly_sports and hourly_sports.recent_finals else null %}

{# Schemas Debug Flag: Visualizes JSON-LD structure on this analyzer page #}
{% set schema_debug = true %}
{% set schema_neighborhood_name = city.City %}
{% set schema_parent_area = city.County ~ " County" %}
{% set schema_lat = city.Latitude | float %}
{% set schema_lon = city.Longitude | float %}
{% set schema_breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Neighborhoods", url: "/neighborhood/" },
  { name: city.City, url: "/neighborhood/" ~ city_slug ~ "/" }
] %}

<div class="layout-container">

  {# =========================================================================
     SECTION 1: HERO BILLBOARDS & HEADERS
     ========================================================================= #}
  <section id="section-headers" class="section-divider" data-section-title="Headers & Billboards" aria-label="Page Headers and Hero Billboards">
    <div class="card-header-split">
      <h2 class="text-section-title">Hero Billboards &amp; Headers</h2>
      <span class="text-body-secondary">Full &amp; Subpage Variants</span>
    </div>

    <div class="section-grid-static grid-cols-1">
      <div>
        <span class="text-overline">widget.neighborhood.page.header (Full Bleed Billboard)</span>
        {% include "components/widget/neighborhood-page-header.njk" %}
      </div>
      <div>
        <span class="text-overline">widget.neighborhood.subpage.header (Subpage Compact Navigation Header)</span>
        {% set subpage_title = "Transit & Regional Mobility" %}
        {% include "components/widget/neighborhood-subpage-header.njk" %}
      </div>
    </div>
  </section>

  {# =========================================================================
     SECTION 2: ATMOSPHERIC & ASTRONOMICAL TELEMETRY
     ========================================================================= #}
  <section id="section-weather" class="section-divider" data-section-title="Atmosphere & Weather" aria-label="Atmospheric and Astronomical Telemetry">
    <div class="card-header-split">
      <h2 class="text-section-title">Atmospheric &amp; Astronomical Telemetry</h2>
      <span class="text-body-secondary">Real-Time Sensor Feeds</span>
    </div>

    <div class="section-grid-static grid-cols-3">
      {# Compact Weather Bar #}
      <div>
        <span class="text-overline">widget.weather.current.widget</span>
        {% set widget_weather_temp = weather_record.current.temp_f %}
        {% set widget_weather_condition = "Cloudy" if weather_record.current.weather_code == 3 else ("Rain" if weather_record.current.weather_code >= 50 else "Fair") %}
        {% set widget_weather_summary = widget_weather_condition %}
        {% set active_neighborhood = city.City %}
        {% include "components/widget/weather-current-widget.njk" %}
      </div>

      {# Solar Dial #}
      <div>
        <span class="text-overline">widget.weather.sunrise.sunset</span>
        {% set weather_sunrise = weather_record.astronomy.sunrise_today %}
        {% set weather_sunset = weather_record.astronomy.sunset_today %}
        {% set active_neighborhood = city.City %}
        {% include "components/widget/weather-sunrise-sunset.njk" %}
      </div>

      {# EPA AQI #}
      <div>
        <span class="text-overline">widget.weather.aqi</span>
        {% set aqi_val = weather_record.air_quality.us_aqi %}
        {% set aqi_status = weather_record.air_quality.status_label %}
        {% set aqi_area = weather_record.air_quality.reporting_area %}
        {% include "components/widget/weather-aqi.njk" %}
      </div>
    </div>

    {# 7-Day Forecast Matrix #}
    <div style="margin-top: 1.5rem;">
      <span class="text-overline">widget.weather.forecast.sevenday</span>
      {% set forecast_dates = weather_record.forecast_7_day.dates %}
      {% set forecast_max = weather_record.forecast_7_day.temp_max %}
      {% set forecast_min = weather_record.forecast_7_day.temp_min %}
      {% set forecast_precip = weather_record.forecast_7_day.precip_prob_max %}
      {% include "components/widget/weather-forecast-sevenday.njk" %}
    </div>

    {# Full-Width Current Weather Display #}
    <div style="margin-top: 1.5rem;">
      <span class="text-overline">widget.weather.current.display</span>
      {% set active_neighborhood = city.City %}
      {% include "components/widget/weather-current-display.njk" %}
    </div>
  </section>

  {# =========================================================================
     SECTION 3: ACTIVE MOBILITY & TRANSIT VELOCITY
     ========================================================================= #}
  <section id="section-transit" class="section-divider" data-section-title="Transit & Mobility" aria-label="Transit and Commute Telemetry">
    <div class="card-header-split">
      <h2 class="text-section-title">Active Mobility &amp; Transit Velocity</h2>
      <span class="text-body-secondary">GTFS-RT &amp; Corridor Baselines</span>
    </div>

    <div class="section-grid-static grid-cols-3">
      {# Active Commute Score #}
      <div>
        <span class="text-overline">score.custom.activecommute</span>
        {% set score_activecommute_val = transit_record.active_commute_score %}
        {% include "components/score/custom-activecommute.njk" %}
      </div>

      {# Active Transit Score #}
      <div>
        <span class="text-overline">score.custom.activetransit</span>
        {% set score_activetransit_val = transit_record.active_transit_score %}
        {% include "components/score/custom-activetransit.njk" %}
      </div>

      {# EV Infrastructure Score #}
      <div>
        <span class="text-overline">score.custom.evinfrastucture</span>
        {% set score_evinfrastructure_val = ev_record.ev_charge_score %}
        {% include "components/score/custom-evinfrastucture.njk" %}
      </div>
    </div>

    {# Walk, Bike, Transit Triad #}
    <div class="section-grid-static grid-cols-3" style="margin-top: 1.5rem;">
      <div>
        <span class="text-overline">score.walkscore.walkscore</span>
        {% set score_walkscore_val = walk_record.walkscore %}
        {% include "components/score/walkscore-walkscore.njk" %}
      </div>
      <div>
        <span class="text-overline">score.walkscore.transitscore</span>
        {% set score_transitscore_val = walk_record.transitscore %}
        {% include "components/score/walkscore-transitscore.njk" %}
      </div>
      <div>
        <span class="text-overline">score.walkscore.bikescore</span>
        {% set score_bikescore_val = walk_record.bikescore %}
        {% include "components/score/walkscore-bikescore.njk" %}
      </div>
    </div>
  </section>

  {# =========================================================================
     SECTION 4: REAL ESTATE DYNAMICS & ABSORPTION
     ========================================================================= #}
  <section id="section-realestate" class="section-divider" data-section-title="Real Estate Dynamics" aria-label="Real Estate Market Dynamics">
    <div class="card-header-split">
      <h2 class="text-section-title">Real Estate Dynamics &amp; Absorption</h2>
      <span class="text-body-secondary">MLS Inventory Analytics</span>
    </div>

    <div class="section-grid-static grid-cols-2">
      {# Market Balance Radial Gauge #}
      <div>
        <span class="text-overline">widget.realestate.market.balance.gauge</span>
        {% set active_neighborhood = city.City %}
        {% include "components/widget/realestate-market-balance-gauge.njk" %}
      </div>

      {# Market Balance Segmented Bar #}
      <div>
        <span class="text-overline">widget.realestate.market.balance.bar</span>
        {% set active_neighborhood = city.City %}
        {% include "components/widget/realestate-market-balance-bar.njk" %}
      </div>
    </div>

    {# Daily Mortgage Rate Table #}
    <div style="margin-top: 1.5rem;">
      <span class="text-overline">widget.realestate.mortgage.rates.daily.table</span>
      {% include "components/widget/realestate-mortgage-rates-daily-table.njk" %}
    </div>
  </section>

  {# =========================================================================
     SECTION 5: CURATED LOCAL COMMERCE
     ========================================================================= #}
  <section id="section-commerce" class="section-divider" data-section-title="Local Commerce" aria-label="Curated Local Commerce">
    <div class="card-header-split">
      <h2 class="text-section-title">Local Commerce</h2>
      <span class="text-body-secondary">Curated Service &amp; Dining</span>
    </div>

    <div class="section-grid-static grid-cols-3">
      <div>
        <span class="text-overline">Category: {{ cat1_key }}</span>
        {% if b1 %}
          {% set business_name = b1.name %}
          {% set business_category = b1.category %}
          {% set business_price_level = b1.price_level %}
          {% set business_rating = b1.rating %}
          {% set business_reviews_count = b1.review_count %}
          {% set business_address = b1.location %}
          {% set business_summary = b1.summary %}
          {% set business_image_url = b1.image_url %}
          {% set business_url = b1.url %}
          {% include "components/widget/business-listing.njk" %}
        {% endif %}
      </div>

      <div>
        <span class="text-overline">Category: {{ cat2_key }}</span>
        {% if b2 %}
          {% set business_name = b2.name %}
          {% set business_category = b2.category %}
          {% set business_price_level = b2.price_level %}
          {% set business_rating = b2.rating %}
          {% set business_reviews_count = b2.review_count %}
          {% set business_address = b2.location %}
          {% set business_summary = b2.summary %}
          {% set business_image_url = b2.image_url %}
          {% set business_url = b2.url %}
          {% include "components/widget/business-listing.njk" %}
        {% endif %}
      </div>

      <div>
        <span class="text-overline">Category: {{ cat3_key }}</span>
        {% if b3 %}
          {% set business_name = b3.name %}
          {% set business_category = b3.category %}
          {% set business_price_level = b3.price_level %}
          {% set business_rating = b3.rating %}
          {% set business_reviews_count = b3.review_count %}
          {% set business_address = b3.location %}
          {% set business_summary = b3.summary %}
          {% set business_image_url = b3.image_url %}
          {% set business_url = b3.url %}
          {% include "components/widget/business-listing.njk" %}
        {% endif %}
      </div>
    </div>
  </section>

  {# =========================================================================
     SECTION 6: NEWS WIRE & CIVIC CALENDAR
     ========================================================================= #}
  <section id="section-news-events" class="section-divider" data-section-title="News & Events" aria-label="News and Upcoming Events">
    <div class="card-header-split">
      <h2 class="text-section-title">News Wire &amp; Civic Calendar</h2>
      <span class="text-body-secondary">Regional Dispatches &amp; Events</span>
    </div>

    <div class="section-grid-static grid-cols-2">
      <div>
        <span class="text-overline">widget.news.summary.list.five</span>
        {% set news_items = market_news %}
        {% include "components/widget/news-summary-list-five.njk" %}
      </div>

      <div>
        <span class="text-overline">widget.events.summary.list.five</span>
        {% set events_neighborhood_name = city.City %}
        {% set events_five_data = public_events_feed %}
        {% include "components/widget/events-summary-list-five.njk" %}
      </div>
    </div>
  </section>

  {# =========================================================================
     SECTION 7: ATHLETICS TELEMETRY & SCOREBOXES
     ========================================================================= #}
  <section id="section-sports" class="section-divider" data-section-title="Athletics" aria-label="Athletics Telemetry">
    <div class="card-header-split">
      <h2 class="text-section-title">Regional Athletics Telemetry</h2>
      <span class="text-body-secondary">Pro, Minor &amp; Collegiate Feeds</span>
    </div>

    {# Lead Game Matchup #}
    <div>
      <span class="text-overline">widget.sports.game.summary (Lead Game)</span>
      {% if recent_game %}
        {% set game_summary_team_local = recent_game.home_team %}
        {% set game_summary_team_away = recent_game.away_team %}
        {% set game_summary_score_local = recent_game.home_score %}
        {% set game_summary_score_away = recent_game.away_score %}
        {% set game_summary_league = recent_game.league %}
        {% set game_summary_status = recent_game.status | upper %}
        {% set game_summary_date = recent_game.game_date %}
        {% include "components/widget/sports-game-summary.njk" %}
      {% endif %}
    </div>

    {# Tiered Athletic Score Boxes #}
    <div class="section-grid-static grid-cols-3" style="margin-top: 1.5rem;">
      {% for team in sports_data.teams %}
        {% if team.level == "Professional" and loop.index <= 1 and team.recentGames and team.recentGames.length > 0 %}
          {% set g = team.recentGames[0] %}
          <div>
            <span class="text-overline">Pro: {{ team.sport }}</span>
            {% set scorebox_header = team.sport ~ " • " ~ team.level %}
            {% set team_local_name = g.home_team %}
            {% set team_local_score = g.home_score %}
            {% set team_opp_name = g.away_team %}
            {% set team_opp_score = g.away_score %}
            {% set scorebox_status = g.status | upper %}
            {% include "components/widget/sports-score-box.njk" %}
          </div>
        {% endif %}
      {% endfor %}

      {% for team in sports_data.teams %}
        {% if team.level == "Minor League" and loop.index <= 1 and team.recentGames and team.recentGames.length > 0 %}
          {% set g = team.recentGames[0] %}
          <div>
            <span class="text-overline">Minor: {{ team.sport }}</span>
            {% set scorebox_header = team.sport ~ " • " ~ team.level %}
            {% set team_local_name = g.home_team %}
            {% set team_local_score = g.home_score %}
            {% set team_opp_name = g.away_team %}
            {% set team_opp_score = g.away_score %}
            {% set scorebox_status = g.status | upper %}
            {% include "components/widget/sports-score-box.njk" %}
          </div>
        {% endif %}
      {% endfor %}

      {% for team in sports_data.teams %}
        {% if team.level == "Collegiate" and loop.index <= 1 and team.recentGames and team.recentGames.length > 0 %}
          {% set g = team.recentGames[0] %}
          <div>
            <span class="text-overline">Collegiate: {{ team.sport }}</span>
            {% set scorebox_header = team.sport ~ " • " ~ team.level %}
            {% set team_local_name = g.home_team %}
            {% set team_local_score = g.home_score %}
            {% set team_opp_name = g.away_team %}
            {% set team_opp_score = g.away_score %}
            {% set scorebox_status = g.status | upper %}
            {% include "components/widget/sports-score-box.njk" %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {# =========================================================================
     SECTION 8: EDITORIAL & CIVIC DOSSIER
     ========================================================================= #}
  <section id="section-editorial" class="section-divider" data-section-title="Editorial Dossier" aria-label="Editorial Narrative">
    <div class="card-header-split">
      <h2 class="text-section-title">Editorial Intelligence</h2>
      <span class="text-body-secondary">Municipal Dossier</span>
    </div>

    <div>
      <span class="text-overline">widget.neighborhood.editorial</span>
      {% set active_neighborhood = city.City %}
      {% include "components/widget/neighborhood-editorial.njk" %}
    </div>
  </section>

  {# =========================================================================
     SECTION 9: VECTOR MAP MARKERS & GRAPHICS (graphic.*)
     ========================================================================= #}
  <section id="section-graphics" class="section-divider" data-section-title="Vector Graphics" aria-label="SVG Vector Markers">
    <div class="card-header-split">
      <h2 class="text-section-title">SVG Vector Graphics &amp; Markers</h2>
      <span class="text-body-secondary">Standard 48px Display Wells</span>
    </div>

    <div class="section-grid-static grid-cols-4">
      <div class="widget-card">
        <span class="text-overline">graphic.map.bus</span>
        {% include "components/graphic/map-bus.njk" %}
      </div>
      <div class="widget-card">
        <span class="text-overline">graphic.map.train</span>
        {% include "components/graphic/map-train.njk" %}
      </div>
      <div class="widget-card">
        <span class="text-overline">graphic.map.ferry.boat</span>
        {% include "components/graphic/map-ferry-boat.njk" %}
      </div>
      <div class="widget-card">
        <span class="text-overline">graphic.globe.link</span>
        {% include "components/graphic/globe-link.njk" %}
      </div>
    </div>
  </section>

  {# =========================================================================
     SECTION 10: STRUCTURED SCHEMAS (schema.*)
     ========================================================================= #}
  <section id="section-schemas" class="section-divider" data-section-title="SEO Schemas" aria-label="JSON-LD Structured Data">
    <div class="card-header-split">
      <h2 class="text-section-title">Schema.org JSON-LD Verification</h2>
      <span class="text-body-secondary">Visual Inspection Drawers</span>
    </div>

    <div class="section-grid-static grid-cols-2">
      <div>
        <span class="text-overline">schema.neighborhood</span>
        {% include "components/schema/neighborhood.njk" %}
      </div>

      <div>
        <span class="text-overline">schema.breadcrumblist</span>
        {% include "components/schema/breadcrumblist.njk" %}
      </div>
    </div>
  </section>

</div>