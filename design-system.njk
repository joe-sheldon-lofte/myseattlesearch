<!-- File: design-system.njk -->

{# Macro: Evaluates captured content. Renders component if file has markup, or a dashed placeholder slot if empty. #}
{% macro renderSlot(element_name, content) %}
  {% if content | trim | length > 0 %}
    {{ content | safe }}
  {% else %}
    <div class="widget-card placeholder-slot" style="border: 2px dashed rgba(0, 0, 0, 0.16); background: var(--color-surface-gray); min-height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 1.25rem; width: 100%; box-sizing: border-box;">
      <span class="text-overline" style="margin-bottom: 0.35rem; color: #86868b; font-size: 0.7rem; word-break: break-all;">{{ element_name }}</span>
      <span style="font-size: 0.75rem; font-weight: 700; color: #71717a; background: #e4e4e7; padding: 0.2rem 0.65rem; border-radius: 999px;">⏳ Pending Build</span>
    </div>
  {% endif %}
{% endmacro %}

<main class="layout-container" style="padding-top: 3.5rem; padding-bottom: 9rem;">

  <header style="margin-bottom: 4rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 2rem;">
