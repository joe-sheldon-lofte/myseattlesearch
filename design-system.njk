<!-- File: src/design-system.njk (or root design-system.njk) -->
---
layout: base.njk
title: "MySeattleSearch - Clean Design System"
permalink: "/design-system/index.html"
---
<!-- Include our global styles -->
<link rel="stylesheet" href="/style.css">

<main class="layout-container" style="padding-top: 4rem; padding-bottom: 6rem;">
  
  <header style="margin-bottom: 4rem;">
    <h1 class="text-display">Design System</h1>
    <p class="text-body-secondary" style="font-size: 1.25rem;">Apple-esque styling, pure white backgrounds, fluid typography.</p>
  </header>

  <!-- TYPOGRAPHY SCALE -->
  <section style="margin-bottom: 5rem;">
    <h2 class="text-section-title">Typography Scale</h2>
    
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div>
        <div class="text-overline">text.heading.display</div>
        <div class="text-display">Seattle Market Trends</div>
      </div>
      
      <div>
        <div class="text-overline">text.heading.page</div>
        <div class="text-page-title">Real Estate Analytics</div>
      </div>
      
      <div>
        <div class="text-overline">text.heading.section</div>
        <div class="text-section-title" style="margin-top:0; border:none; padding:0;">Local News Feed</div>
      </div>

      <div>
        <div class="text-overline">text.data.huge</div>
        <div class="text-data-huge">72°</div>
      </div>

      <div style="max-width: 600px;">
        <div class="text-overline">text.body.primary</div>
        <p class="text-body">This is the primary body text. It is clean, highly readable, and uses the system font stack to ensure it looks native and crisp on every device, whether it's an iPhone, a Mac, or a Windows PC.</p>
      </div>
    </div>
  </section>

  <!-- WIDGET & CAROUSEL DEMO -->
  <section style="margin-bottom: 5rem;">
    <h2 class="text-section-title">Infinite Horizontal Scroll & Widgets</h2>
    
    <!-- This is the swiping carousel defined in your spreadsheet -->
    <div class="horizontal-scroll-section">
      
      <!-- Card 1: Stat Card (Alpine Blue accent) -->
      <div class="horizontal-scroll-item widget-card">
        <div class="text-overline" style="margin-bottom: 0.5rem;">Active Inventory</div>
        <div class="text-data-huge">142</div>
        <div class="text-body-secondary" style="margin-top: 0.5rem;">▲ 12% from last month</div>
      </div>

      <!-- Card 2: Market Stat -->
      <div class="horizontal-scroll-item widget-card">
        <div class="text-overline" style="margin-bottom: 0.5rem;">Median Price</div>
        <div class="text-data-huge">$1.1M</div>
        <div class="text-body-secondary" style="margin-top: 0.5rem;">Kirkland City Limits</div>
      </div>

      <!-- Card 3: Alert Card (Redfin Red accent) -->
      <div class="horizontal-scroll-item widget-card" style="border-top: 4px solid var(--color-tertiary-default);">
        <div class="text-overline" style="margin-bottom: 0.5rem; color: var(--color-tertiary-default);">Warning</div>
        <div class="text-widget-title">Power Outage</div>
        <div class="text-body-secondary">1,400 customers affected in Edmonds.</div>
      </div>

      <!-- Card 4: Filler -->
      <div class="horizontal-scroll-item widget-card">
        <div class="text-overline" style="margin-bottom: 0.5rem;">Transit Score</div>
        <div class="text-data-huge">85</div>
        <div class="text-body-secondary" style="margin-top: 0.5rem;">Excellent Transit</div>
      </div>

    </div>
  </section>

</main>