---
layout: base.njk
title: "Master UI Component Sandbox | All Catalog Elements"
permalink: "/design-system/index.html"
---

{# Defensive Lynnwood Context & Mock Data Hydration #}
{% set city = { City: "Lynnwood", name: "Lynnwood", lat: 47.8209, lon: -122.3151 } %}

{# Mock Operational Telemetry to force widgets to render #}
{% set scores = {
  activecommute: 82,
  activetransit: 68,
  ontime: 92,
  friction: 12,
  ev: 78,
  tax_stability: 28,
  psai: 84,
  surveillance: 54,
  shore: 12,
  park: 65,
  bark: 88
} %}
{% set walkscore = { walk: 91, bike: 75, transit: 68 } %}
{% set schema_debug = true %}

{# Macro: Evaluates captured content #}
{% macro renderSlot(element_name, content) %}
  {% set clean_content = content | replace('<!--', '') | replace('-->', '') | trim %}
  {% if clean_content | length > 5 %}
    {{ content | safe }}
  {% else %}
    <div class="widget-card placeholder-slot">
      <span class="text-overline placeholder-slot-tag">{{ element_name }}</span>
      <span class="placeholder-slot-badge">⏳ Pending Build</span>
    </div>
  {% endif %}
{% endmacro %}

<main class="layout-container sandbox-main">

  <header class="sandbox-header">
    <div class="text-overline text-accent-alpine">MYSEATTLESEARCH • DESIGN SYSTEM BENCHMARK</div>
    <h1 class="text-display sandbox-title">Full Catalog Sandbox</h1>
    <p class="text-body-secondary sandbox-desc">
      Master component verification surface testing all elements from <code>UI Upgrade - Element_Catalog.csv</code>. 
      <br><strong>Viewing Mode: Single-Column Inspection Ledger</strong> (Live Neighborhood Context: <strong>{{ city.City }}</strong>).
    </p>
    <div class="sandbox-meta-row">
      <div class="sandbox-meta-item">Compiled: <strong>{{ buildTime }}</strong></div>
      <div class="sandbox-meta-item">Architecture: <strong>Vertically Stacked Single-Column</strong></div>
    </div>
  </header>

