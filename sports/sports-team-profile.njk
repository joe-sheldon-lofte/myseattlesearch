---
layout: layouts/base.njk
pagination:
  data: sports_teams
  size: 1
  alias: team
permalink: "sports/{{ team.Level | slugify }}/{{ team.TeamName | slugify }}/index.html"
eleventyComputed:
  title: "{{ team.TeamName }} Telemetry & News | MySeattleSearch"
  search_scope: "sports"
---
{# Section 4.0: Franchise Team Metrics #}
{% set team_name = team.TeamName %}
{% set team_stats = team.teamStats if team.teamStats else {} %}
{% set season_label = team.season_label if team.season_label else "" %}
{% include "components/widget/sports-team-stats.njk" %}

{# Section 6.0: Franchise Wire & Recaps #}
<section class="sports-section" id="news" aria-label="{{ team.TeamName }} News Wire">
  <div class="section-title-stack">
    <span class="text-overline text-accent-alpine">FRANCHISE WIRE</span>
    <h2 class="text-section-title">{{ team.TeamName }} News & Dispatches</h2>
  </div>

  {% set team_news_tag = "sports-" ~ (team.TeamName | slugify) %}
  {% set all_news_heading = team.TeamName ~ " News & Dispatches" %}
  {% set overline_text = (team.AltName | default(team.TeamName) | upper) ~ " DISPATCH WIRE" %}
  {% set all_news_items = market_news | filter_contains('tags', team_news_tag) if market_news else [] %}
  {% include "components/widget/news-summary-list-all.njk" %}
</section>