---
layout: base.njk
pagination:
  data: city_data
  size: 1
  alias: neighborhood
permalink: "/neighborhood/{{ neighborhood.slug }}/transit-commute/"
eleventyComputed:
  title: "{{ neighborhood.name }} Transit, Commute Times & Traffic | MySeattleSearch"
  description: "Live transit radar, active commute scores, WSDOT road construction alerts, ferry schedules, and drive times to employment hubs for {{ neighborhood.name }}, Washington."
---

{% import "components/cards.njk" as cards %}
{% import "components/gauges.njk" as gauges %}
{% import "components/media.njk" as media %}
{% import "components/boards.njk" as boards %}

<!-- Leaflet Core CSS/JS & MarkerCluster Plugin -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

<style>
  .transit-mode-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  @media (max-width: 768px) {
    .transit-mode-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .transit-mode-card {
    background: var(--premier-beige);
    padding: 12px 10px;
    border-radius: 10px;
    text-align: center;
  }
  .map-layer-pill {
    background: var(--premier-beige);
    border: 1px solid rgba(28,28,30,0.12);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--premier-charcoal);
    transition: all 0.2s ease;
  }
  .map-layer-pill.active {
    background: var(--alpine-blue);
    color: #FFFFFF;
    border-color: var(--alpine-blue);
  }
  .custom-svg-marker {
    background: transparent;
    border: none;
  }

  /* Custom Leaflet Cluster Badge Overrides */
  .marker-cluster-small, .marker-cluster-medium, .marker-cluster-large {
    background-color: rgba(30, 77, 107, 0.2) !important;
  }
  .marker-cluster-small div, .marker-cluster-medium div, .marker-cluster-large div {
    background-color: var(--alpine-blue) !important;
    color: #FFFFFF !important;
    font-weight: 800 !important;
    font-size: 0.75rem !important;
    border: 2px solid #FFFFFF !important;
    box-shadow: 0 3px 8px rgba(0,0,0,0.25) !important;
  }

  /* Day Accordion Circle Trigger Button Styling */
  .day-accordion-summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }
  .day-accordion-summary::-webkit-details-marker {
    display: none;
  }
  .accordion-circle-trigger {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1.5px solid var(--alpine-blue);
    color: var(--alpine-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  details[open] .accordion-circle-trigger {
    background: var(--alpine-blue);
    color: #FFFFFF;
  }
  details[open] .accordion-v-line {
    display: none;
  }
</style>

{# Data Loaders #}
{% set cityWeather = neighborhood.slug | getCityWeather %}
{% set transitLive = neighborhood.slug | getTransitLive %}
{% set groupedTransitHistory = neighborhood.slug | get7DayGroupedTransitHistory %}
{% set constructionData = neighborhood.slug | getCityConstruction %}
{% set intercityData = "" | getIntercitySummary %}

{% set marketStats = neighborhood.slug | getMarketStats %}
{% set topGame = "" | getTopSportsGame %}
{% set mobilityData = neighborhood.name | getMobilityScores %}
{% set geoCommutes = neighborhood.Latitude | getGeoCommuteTimes(neighborhood.Longitude, neighborhood.name) %}

<!-- HERO CAROUSEL -->
{{ media.heroCarousel(neighborhood.name, "Transit & Commute Radar", neighborhood.heroImages, neighborhood.county) }}

<!-- FULL-WIDTH AT-A-GLANCE TELEMETRY BAR -->
{{ gauges.glanceBarFull(cityWeather, transitLive, marketStats, topGame, neighborhood) }}

<div class="bento-grid">

  <!-- Left Main Column: Transit & Commute Stream (span-8) -->
  <div class="span-8" style="display: flex; flex-direction: column; gap: 24px;">

    <!-- 1. ACTIVE COMMUTE & TRANSIT TELEMETRY CARD -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>{{ neighborhood.name | upper }} ACTIVE TRANSIT & COMMUTE SCORE</span>
        <span style="font-size: 0.68rem; opacity: 0.9;">Real-Time Feed</span>
      </div>

      <!-- Active Score Summary Gauge Row -->
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 20px;">
        <div style="background: var(--premier-beige); padding: 18px; border-radius: 12px; text-align: center;">
          <div style="font-size: 0.68rem; text-transform: uppercase; color: rgba(28,28,30,0.5); font-weight: 600; margin-bottom: 6px;">
            Active Commute Score
          </div>
          <div style="font-size: 2.4rem; font-weight: 700; color: var(--alpine-blue); line-height: 1;">
            {{ transitLive.active_commute_score | default(100) }}
          </div>
        </div>

        <div style="background: var(--premier-beige); padding: 18px; border-radius: 12px; text-align: center;">
          <div style="font-size: 0.68rem; text-transform: uppercase; color: rgba(28,28,30,0.5); font-weight: 600; margin-bottom: 6px;">
            Active Transit Score
          </div>
          <div style="font-size: 2.4rem; font-weight: 700; color: var(--premier-charcoal); line-height: 1;">
            {{ transitLive.active_transit_score | default(36) }}
          </div>
        </div>
      </div>

      <!-- Active Fleet Breakdown Grid -->
      <div style="font-size: 0.85rem; font-weight: 600; color: var(--premier-charcoal); margin-bottom: 10px;">
        Active Transit Fleet Vehicles & Capacity
      </div>

      {% set vCounts = transitLive.vehicle_counts if (transitLive and transitLive.vehicle_counts) else {} %}
      <div class="transit-mode-grid">
        <div class="transit-mode-card">
          <div style="font-size: 1.5rem;">🚌</div>
          <div style="font-size: 1.1rem; font-weight: 700; color: var(--premier-charcoal); margin-top: 2px;">
            {{ vCounts.buses | default(23) }}
          </div>
          <div style="font-size: 0.65rem; color: rgba(28,28,30,0.5); text-transform: uppercase;">Active Buses</div>
        </div>

        <div class="transit-mode-card">
          <div style="font-size: 1.5rem;">🚈</div>
          <div style="font-size: 1.1rem; font-weight: 700; color: var(--premier-charcoal); margin-top: 2px;">
            {{ vCounts.light_rail | default(0) }}
          </div>
          <div style="font-size: 0.65rem; color: rgba(28,28,30,0.5); text-transform: uppercase;">Light Rail</div>
        </div>

        <div class="transit-mode-card">
          <div style="font-size: 1.5rem;">🚆</div>
          <div style="font-size: 1.1rem; font-weight: 700; color: var(--premier-charcoal); margin-top: 2px;">
            {{ vCounts.commuter_rail | default(0) }}
          </div>
          <div style="font-size: 0.65rem; color: rgba(28,28,30,0.5); text-transform: uppercase;">Sounder Rail</div>
        </div>

        <div class="transit-mode-card">
          <div style="font-size: 1.5rem;">💺</div>
          <div style="font-size: 1.1rem; font-weight: 700; color: var(--alpine-blue); margin-top: 2px;">
            {{ transitLive.total_active_seats | default(920) | localeString }}
          </div>
          <div style="font-size: 0.65rem; color: rgba(28,28,30,0.5); text-transform: uppercase;">Active Seats</div>
        </div>
      </div>
    </div>

    <!-- 2. INTERACTIVE LIVE TRANSIT & TRAFFIC RADAR MAP -->
    <div class="bento-card" style="padding: 0; overflow: hidden; border-radius: 12px; border: 1px solid rgba(28,28,30,0.1);">
      <div class="bento-card-header" style="margin: 0; border-radius: 0; padding: 12px 18px; width: 100%; box-sizing: border-box; background: var(--alpine-blue); color: #FFFFFF; display: flex; justify-content: space-between; align-items: center;">
        <span>{{ neighborhood.name | upper }} LIVE TRANSIT & TRAFFIC RADAR</span>
      </div>

      <!-- Map Layer Control Bar -->
      <div style="padding: 10px 16px; background: #FFFFFF; border-bottom: 1px solid rgba(28,28,30,0.08); display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <span style="font-size: 0.72rem; font-weight: 600; color: rgba(28,28,30,0.5); margin-right: 4px;">LAYERS:</span>
        <button id="pill-traffic" class="map-layer-pill active" onclick="toggleTrafficLayer(this)">Current Traffic</button>
        <button id="pill-vehicles" class="map-layer-pill active" onclick="toggleVehiclesLayer(this)">Buses & Trains</button>
        <button id="pill-work" class="map-layer-pill active" onclick="toggleConstructionLayer(this)">Construction Zones</button>
        <button id="pill-ferries" class="map-layer-pill active" onclick="toggleFerriesLayer(this)">Ferry Terminals</button>
      </div>

      <!-- Map Canvas -->
      <div id="transit-interactive-map" style="width: 100%; height: 420px; z-index: 1;"></div>
    </div>

    <!-- 3. CURRENT COMMUTE TIMES TO MAJOR EMPLOYMENT HUBS (6 SEPARATE HUBS • TWO-WAY COMMUTES) -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>CURRENT COMMUTE TIMES TO MAJOR EMPLOYMENT HUBS</span>
      </div>

      <p style="font-size: 0.8rem; color: rgba(28,28,30,0.7); margin-bottom: 14px; line-height: 1.35;">
        Live traffic and off-peak drive and transit time estimates between <strong>{{ neighborhood.name }}</strong> and major employment destinations.
      </p>

      <div style="display: flex; flex-direction: column; gap: 12px;">
        {% for hub in geoCommutes %}
          <div style="background: var(--premier-beige); padding: 14px 16px; border-radius: 10px; display: flex; flex-direction: column; gap: 8px;">
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--premier-charcoal); border-bottom: 1px solid rgba(28,28,30,0.06); padding-bottom: 4px;">
              {{ hub.hub_name }} • <span style="font-size: 0.75rem; font-weight: 500; color: rgba(28,28,30,0.6);">Distance: {{ hub.distance_miles }} Miles</span>
            </div>

            <!-- Direction 1: Outbound (City to Hub) -->
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; padding: 2px 0;">
              <span style="font-weight: 600; color: var(--premier-charcoal);">{{ hub.outbound_label }}</span>
              <div style="display: flex; gap: 16px; text-align: right;">
                <div>
                  <span style="font-size: 0.58rem; text-transform: uppercase; color: rgba(28,28,30,0.5); display: block;">Drive</span>
                  <strong style="color: var(--alpine-blue);">{{ hub.outbound.curr_drive_mins }} min</strong>
                  <span style="font-size: 0.60rem; color: rgba(28,28,30,0.4); display: block;">Off-Peak: {{ hub.outbound.offpeak_drive_mins }} min</span>
                </div>
                <div style="border-left: 1px solid rgba(28,28,30,0.1); padding-left: 12px;">
                  <span style="font-size: 0.58rem; text-transform: uppercase; color: rgba(28,28,30,0.5); display: block;">Transit</span>
                  <strong style="color: var(--premier-charcoal);">{{ hub.outbound.curr_transit_mins }} min</strong>
                  <span style="font-size: 0.60rem; color: rgba(28,28,30,0.4); display: block;">Off-Peak: {{ hub.outbound.offpeak_transit_mins }} min</span>
                </div>
              </div>
            </div>

            <!-- Direction 2: Inbound (Hub to City) -->
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; padding: 2px 0; border-top: 1px dashed rgba(28,28,30,0.06); padding-top: 6px;">
              <span style="font-weight: 600; color: var(--premier-charcoal);">{{ hub.inbound_label }}</span>
              <div style="display: flex; gap: 16px; text-align: right;">
                <div>
                  <span style="font-size: 0.58rem; text-transform: uppercase; color: rgba(28,28,30,0.5); display: block;">Drive</span>
                  <strong style="color: var(--alpine-blue);">{{ hub.inbound.curr_drive_mins }} min</strong>
                  <span style="font-size: 0.60rem; color: rgba(28,28,30,0.4); display: block;">Off-Peak: {{ hub.inbound.offpeak_drive_mins }} min</span>
                </div>
                <div style="border-left: 1px solid rgba(28,28,30,0.1); padding-left: 12px;">
                  <span style="font-size: 0.58rem; text-transform: uppercase; color: rgba(28,28,30,0.5); display: block;">Transit</span>
                  <strong style="color: var(--premier-charcoal);">{{ hub.inbound.curr_transit_mins }} min</strong>
                  <span style="font-size: 0.60rem; color: rgba(28,28,30,0.4); display: block;">Off-Peak: {{ hub.inbound.offpeak_transit_mins }} min</span>
                </div>
              </div>
            </div>

          </div>
        {% endfor %}
      </div>
    </div>

    <!-- 4. WSDOT ROADWORK & CONSTRUCTION ALERTS -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>WSDOT CONSTRUCTION & ROADWORK ALERTS</span>
      </div>

      {% if constructionData and constructionData.alerts and constructionData.alerts.length > 0 %}
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {% for alert in constructionData.alerts %}
            <div style="background: var(--premier-beige); padding: 12px 14px; border-radius: 10px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <span style="font-size: 0.72rem; font-weight: 700; color: var(--pnw-red); text-transform: uppercase;">
                  {{ alert.event_category | default("Construction") }} • {{ alert.priority }} Priority
                </span>
                <span style="font-size: 0.62rem; color: rgba(28,28,30,0.5);">
                  ID: {{ alert.alert_id }}
                </span>
              </div>
              <div style="font-size: 0.78rem; color: var(--premier-charcoal); line-height: 1.35;">
                {{ alert.headline }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div style="background: #ECFDF5; border: 1px solid #A7F3D0; padding: 12px 16px; border-radius: 10px; color: #065F46; font-size: 0.8rem; font-weight: 500;">
          No Active WSDOT Closure Alerts: There are currently no active WSDOT highway or ramp closures reported within {{ neighborhood.name }}.
        </div>
      {% endif %}
    </div>

    <!-- 5. HISTORICAL TRANSIT SCORE & ON-TIME PERFORMANCE LOG (7 DAY ACCORDIONS WITH ROUND (+) CIRCLE TRIGGER) -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>HISTORICAL TRANSIT & ON-TIME PERFORMANCE LOG</span>
        <span style="font-size: 0.68rem; opacity: 0.9;">7-Day Log</span>
      </div>

      <p style="font-size: 0.8rem; color: rgba(28,28,30,0.7); margin-bottom: 14px; line-height: 1.35;">
        Hourly capacity score and vehicle on-time performance archive for {{ neighborhood.name }} over the past 7 days.
      </p>

      {% if groupedTransitHistory and groupedTransitHistory.length > 0 %}
        <div style="display: flex; flex-direction: column; gap: 8px;">
          {% for dayObj in groupedTransitHistory %}
            <details style="background: var(--premier-beige); border-radius: 10px; padding: 12px 14px;">
              <summary class="day-accordion-summary">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div class="accordion-circle-trigger">
                    <svg viewBox="0 0 10 10" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                      <line x1="5" y1="1" x2="5" y2="9" class="accordion-v-line"></line>
                      <line x1="1" y1="5" x2="9" y2="5"></line>
                    </svg>
                  </div>
                  <span style="font-size: 0.85rem; font-weight: 700; color: var(--premier-charcoal);">{{ dayObj.date_label }}</span>
                </div>
                <span style="font-size: 0.72rem; color: rgba(28,28,30,0.6); font-weight: 500;">
                  Avg Score: <strong style="color: var(--alpine-blue);">{{ dayObj.avg_transit_score }}</strong> • On-Time: <strong style="color: var(--status-green);">{{ dayObj.avg_ontime_rate }}</strong>
                </span>
              </summary>
              <div style="margin-top: 10px; background: #FFFFFF; border-radius: 8px; border: 1px solid rgba(28,28,30,0.08); overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.78rem; text-align: left;">
                  <thead>
                    <tr style="background: var(--premier-beige); border-bottom: 1.5px solid rgba(28,28,30,0.08); color: var(--premier-charcoal);">
                      <th style="padding: 6px 12px; font-weight: 700;">Hour</th>
                      <th style="padding: 6px 12px; font-weight: 700;">Active Transit Score</th>
                      <th style="padding: 6px 12px; font-weight: 700;">On-Time Rate %</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for hRow in dayObj.hours %}
                      <tr style="border-bottom: 1px solid rgba(28,28,30,0.04);">
                        <td style="padding: 5px 12px; font-weight: 600; color: var(--premier-charcoal);">{{ hRow.time12 }}</td>
                        <td style="padding: 5px 12px; font-weight: 700; color: var(--alpine-blue);">{{ hRow.transit_score }}</td>
                        <td style="padding: 5px 12px; font-weight: 700; color: var(--status-green);">{{ hRow.ontime_rate }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </details>
          {% endfor %}
        </div>
      {% else %}
        <div style="font-size: 0.8rem; color: rgba(28,28,30,0.5); text-align: center; padding: 8px 0;">
          168-hour transit history currently syncing for {{ neighborhood.name }}.
        </div>
      {% endif %}
    </div>

  </div>

  <!-- Right Sidebar Column: Directory, Airports, Ferries, Mobility Rings (span-4) -->
  <div class="span-4" style="display: flex; flex-direction: column; gap: 24px;">

    <!-- 1. DIRECTORY NAVIGATION CARD -->
    <div class="bento-card bento-card--action">
      <div class="bento-card-header bento-card-header--action">
        <span>{{ neighborhood.name | upper }} DIRECTORY</span>
      </div>
      <ul class="subpage-list">
        <li><a href="/neighborhood/{{ neighborhood.slug }}/"><span>← Main Community Hub</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/weather/"><span>Weather & Radar</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/news-events/"><span>News & Events</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/municipal/"><span>Municipal Services</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/emergency-safety/"><span>Emergency & Safety</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/elections/"><span>Elections & Voting</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/data/"><span>Data & Statistics</span> <span>→</span></a></li>
      </ul>
    </div>

    <!-- 2. REGIONAL AIRPORT OPERATIONS -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>REGIONAL AIRPORT OPERATIONS</span>
      </div>

      {% set seaStatus = intercityData.airports.seatac_sea.status | default("Normal Operations") if intercityData and intercityData.airports else "Normal Operations" %}
      {% set paeStatus = intercityData.airports.paine_field_pae.status | default("Normal Operations") if intercityData and intercityData.airports else "Normal Operations" %}
      {% set primaryHub = geoCommutes[0] if geoCommutes else {} %}

      <div style="display: flex; flex-direction: column; gap: 10px;">
        <!-- Sea-Tac -->
        <div style="background: var(--premier-beige); padding: 12px; border-radius: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <span style="font-size: 0.82rem; font-weight: 700; color: var(--premier-charcoal);">Sea-Tac (SEA)</span>
            <span style="font-size: 0.65rem; background: #D1FAE5; color: #065F46; padding: 2px 6px; border-radius: 4px; font-weight: 600;">{{ seaStatus }}</span>
          </div>
          <div style="font-size: 0.72rem; color: rgba(28,28,30,0.6);">
            Drive: <strong>{{ (primaryHub.outbound.curr_drive_mins + 12) | default(35) }} min</strong> • Transit: <strong>{{ (primaryHub.outbound.curr_transit_mins + 25) | default(55) }} min</strong>
          </div>
        </div>

        <!-- Paine Field -->
        <div style="background: var(--premier-beige); padding: 12px; border-radius: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <span style="font-size: 0.82rem; font-weight: 700; color: var(--premier-charcoal);">Paine Field (PAE)</span>
            <span style="font-size: 0.65rem; background: #D1FAE5; color: #065F46; padding: 2px 6px; border-radius: 4px; font-weight: 600;">{{ paeStatus }}</span>
          </div>
          <div style="font-size: 0.72rem; color: rgba(28,28,30,0.6);">
            Drive: <strong>{{ (primaryHub.outbound.curr_drive_mins + 4) | default(25) }} min</strong> • Transit: <strong>{{ (primaryHub.outbound.curr_transit_mins + 12) | default(42) }} min</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. WASHINGTON STATE FERRIES (EVENING PDT DEPARTURE TIMES) -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>WASHINGTON STATE FERRIES</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 8px; width: 100%;">
        
        <!-- 1. Seattle ⇄ Bainbridge -->
        <div style="background: var(--premier-beige); padding: 10px 12px; border-radius: 8px; font-size: 0.78rem;">
          <div style="display: flex; justify-content: space-between; font-weight: 700; color: var(--premier-charcoal); margin-bottom: 3px;">
            <span>Seattle ⇄ Bainbridge Island</span>
            <span style="color: var(--status-green);">On Time</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.68rem; color: rgba(28,28,30,0.6);">
            <span>Dep Seattle: <strong>7:15 PM</strong></span>
            <span>Dep Bainbridge: <strong>7:55 PM</strong></span>
          </div>
        </div>

        <!-- 2. Seattle ⇄ Bremerton -->
        <div style="background: var(--premier-beige); padding: 10px 12px; border-radius: 8px; font-size: 0.78rem;">
          <div style="display: flex; justify-content: space-between; font-weight: 700; color: var(--premier-charcoal); margin-bottom: 3px;">
            <span>Seattle ⇄ Bremerton</span>
            <span style="color: var(--status-green);">On Time</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.68rem; color: rgba(28,28,30,0.6);">
            <span>Dep Seattle: <strong>7:25 PM</strong></span>
            <span>Dep Bremerton: <strong>8:10 PM</strong></span>
          </div>
        </div>

        <!-- 3. Edmonds ⇄ Kingston -->
