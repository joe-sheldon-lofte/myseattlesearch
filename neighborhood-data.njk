              <div style="display: flex; justify-content: space-between; padding-left: 67px; font-size: 0.62rem; color: rgba(28,28,30,0.5); font-weight: 500; margin-top: 4px;">
                {% for d in chartShowsPerListing.dates %}<span>{{ d }}</span>{% endfor %}
              </div>
            {% endif %}
          </div>

          <!-- Chart 6: Percent of List Price Average -->
          <div style="background: var(--premier-beige); padding: 14px; border-radius: 12px;">
