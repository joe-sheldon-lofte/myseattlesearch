                <div style="display: flex; flex-direction: column; justify-content: space-between; height: 50px; font-size: 0.68rem; font-weight: 600; color: rgba(28,28,30,0.5); text-align: right; min-width: 55px; white-space: nowrap;">
                  <span>{{ chartListPricePct.maxLabel }}</span>
                  <span>{{ chartListPricePct.minLabel }}</span>
