                <div style="flex: 1; height: 60px; position: relative;">
                  <svg width="100%" height="100%" viewBox="0 0 400 60" preserveAspectRatio="none">
                    <line x1="0" y1="5" x2="400" y2="5" stroke="rgba(28,28,30,0.06)" stroke-width="1"/>
                    <line x1="0" y1="55" x2="400" y2="55" stroke="rgba(28,28,30,0.12)" stroke-width="1"/>
                    <polyline fill="none" stroke="var(--alpine-blue)" stroke-width="2.5" stroke-linecap="round" points="{{ chartShowsPerListing.points }}"/>
                    <ellipse cx="{{ chartShowsPerListing.lastX }}" cy="{{ chartShowsPerListing.lastY }}" rx="2.5" ry="3.8" fill="var(--alpine-blue)"/>
