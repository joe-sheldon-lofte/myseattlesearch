---
layout: base.njk
pagination:
  data: city_data
  size: 1
  alias: neighborhood
permalink: "/neighborhood/{{ neighborhood.slug }}/data/"
eleventyComputed:
  title: "{{ neighborhood.name }} Real Estate & City Data | MySeattleSearch"
  description: "Comprehensive real estate telemetry, Redfin stats, NWMLS market trends, relocation migration maps, and community metrics for {{ neighborhood.name }}, Washington."
---

{% import "components/cards.njk" as cards %}
{% import "components/gauges.njk" as gauges %}
{% import "components/media.njk" as media %}

{% set cityWeather = neighborhood.slug | getCityWeather %}
{% set transitLive = neighborhood.slug | getTransitLive %}
{% set marketStats = neighborhood.slug | getMarketStats %}
{% set topGame = "" | getTopSportsGame %}

{# Data Loaders #}
{% set redfinStats = neighborhood.name | getRedfinCityStats %}
{% set infoSparks = neighborhood.name | getInfoSparksCityStats %}
{% set redfinMigration = neighborhood.name | getRedfinMigration %}
{% set hourlyPulse = neighborhood.name | getHourlyMarketPulse %}
{% set mortgageRates = "" | getLatestMortgageRates %}

{# Custom Community Profile Loaders #}
{% set mobilityData = neighborhood.name | getMobilityScores %}
{% set schoolData = neighborhood.name | getSchoolData %}
{% set crimeData = neighborhood.name | getCrimeData %}
{% set publicSafetyData = neighborhood.name | getPublicSafetyData %}
{% set surveillanceData = neighborhood.name | getSurveillanceData %}
{% set climateData = neighborhood.name | getClimateComfort %}
{% set seattleMigration = "" | getSeattleMigration %}
{% set affordData = "" | getAffordabilityStats %}

{# Dynamic SVG Chart Builders #}
{% set hourlyChart = neighborhood.name | buildHourlyVelocityChart(500, 90) %}
{% set mortgageChartData = "" | buildMortgageTrendChart(280, 70) %}

{% set chartMedianPrice = neighborhood.name | buildInfoSparksChart("Median Sale Price", 400, 60) %}
{% set chartClosedSales = neighborhood.name | buildInfoSparksChart("Closed Sales", 400, 60) %}
{% set chartDaysOnMarket = neighborhood.name | buildInfoSparksChart("Average Days on Market", 400, 60) %}
{% set chartMonthsSupply = neighborhood.name | buildInfoSparksChart("Months Supply Closed", 400, 60) %}
{% set chartShowsPerListing = neighborhood.name | buildInfoSparksChart("Shows Per Listing", 400, 60) %}
{% set chartListPricePct = neighborhood.name | buildInfoSparksChart("Percent of List Price Average", 400, 60) %}

<!-- HERO CAROUSEL -->
{{ media.heroCarousel(neighborhood.name, "Real Estate & City Data", neighborhood.heroImages, neighborhood.county) }}

<!-- FULL-WIDTH AT-A-GLANCE TELEMETRY BAR -->
{{ gauges.glanceBarFull(cityWeather, transitLive, marketStats, topGame, neighborhood) }}

<div class="bento-grid">
  
  <!-- Left Main Column: Full Expanded Market Telemetry Stream (span-8) -->
  <div class="span-8" style="display: flex; flex-direction: column; gap: 24px;">
    
    <!-- 1. CURRENT MARKET BALANCE BENTO BOX -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>CURRENT MARKET BALANCE</span>
      </div>

      {% set moisVal = marketStats.months_supply | default(1.8) | float %}
      {% set moisPct = ((moisVal / 6.0) * 100) | round %}
      {% if moisPct > 98 %}{% set moisPct = 98 %}{% endif %}
      {% if moisPct < 2 %}{% set moisPct = 2 %}{% endif %}

      {% set marketLabel = "Seller's Market" %}
      {% if moisVal > 4.0 %}{% set marketLabel = "Buyer's Market" %}{% elif moisVal >= 2.0 %}{% set marketLabel = "Balanced Market" %}{% endif %}

      {{ gauges.supplyBar(
        "0 Months (Seller's Market)",
        (moisVal | string) ~ " Months Supply (" ~ marketLabel ~ ")",
        "6 Months (Buyer's Market)",
        moisPct ~ "%",
        "span-12"
      ) }}
    </div>

    <!-- 2. HOURLY MARKET VELOCITY (ONLY RENDERS FOR VERIFIED NORTH SOUND CITIES) -->
    {% if neighborhood["North Sound"] | lower == "x" %}
      <div class="bento-card">
        <div class="bento-card-header">
          <span>{{ neighborhood.name }} Hourly Market Velocity</span>
          <span style="font-size: 0.68rem; opacity: 0.9;">Real-Time Feed</span>
        </div>

        {% if hourlyPulse %}
          {% set dropsCount = hourlyPulse["Price Drops"] | default(1) | float %}
          {% set cutsTotal = hourlyPulse["Total Price Cuts ($)"] | default(0) | float %}
          {% set avgPriceCut = 0 %}
          {% if dropsCount > 0 %}
            {% set avgPriceCut = (cutsTotal / dropsCount) | round %}
          {% endif %}

          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 12px;">
            <div style="background: var(--premier-beige); padding: 10px; border-radius: 10px; text-align: center;">
              <div style="font-size: 0.6rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">New Listings</div>
              <div style="font-size: 1.2rem; font-weight: 600; color: var(--premier-charcoal);">{{ hourlyPulse["New Listings"] | default("0") }}</div>
            </div>

            <div style="background: var(--premier-beige); padding: 10px; border-radius: 10px; text-align: center;">
              <div style="font-size: 0.6rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Price Drops</div>
              <div style="font-size: 1.2rem; font-weight: 600; color: var(--pnw-red);">{{ hourlyPulse["Price Drops"] | default("0") }}</div>
            </div>

            <div style="background: var(--premier-beige); padding: 10px; border-radius: 10px; text-align: center;">
              <div style="font-size: 0.6rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Pending Sales</div>
              <div style="font-size: 1.2rem; font-weight: 600; color: var(--premier-charcoal);">{{ hourlyPulse["Pending"] | default("0") }}</div>
            </div>

            <div style="background: var(--premier-beige); padding: 10px; border-radius: 10px; text-align: center;">
              <div style="font-size: 0.6rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Closed / Sold</div>
              <div style="font-size: 1.2rem; font-weight: 600; color: var(--status-green);">{{ hourlyPulse["Sold"] | default("0") }}</div>
            </div>

            <div style="background: var(--premier-beige); padding: 10px; border-radius: 10px; text-align: center;">
              <div style="font-size: 0.6rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Avg New List Price</div>
              <div style="font-size: 1.05rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 2px;">
                ${{ hourlyPulse["Avg New Price"] | default("0") | localeString }}
              </div>
            </div>

            <div style="background: var(--premier-beige); padding: 10px; border-radius: 10px; text-align: center;">
              <div style="font-size: 0.6rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Avg Price Cut ($)</div>
              <div style="font-size: 1.05rem; font-weight: 600; color: var(--pnw-red); margin-top: 2px;">
                ${{ avgPriceCut | localeString }}
              </div>
            </div>
          </div>

          {% if hourlyChart %}
            <!-- Dynamically Calculated SVG Historical Velocity Chart -->
            <div style="background: var(--premier-beige); padding: 16px; border-radius: 12px; margin-bottom: 8px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-size: 0.78rem; font-weight: 600; color: var(--premier-charcoal);">Weekly Velocity Trajectory</span>
                <div style="display: flex; gap: 12px; font-size: 0.65rem; font-weight: 500;">
                  <span style="color: var(--alpine-blue);">━ New Listings</span>
                  <span style="color: var(--status-green);">━ Sold</span>
                  <span style="color: var(--pnw-red);">┈ Price Drops</span>
                </div>
              </div>

              <div style="position: relative; width: 100%; height: 110px;">
                <svg width="100%" height="90" viewBox="0 0 500 90" preserveAspectRatio="none">
                  <line x1="40" y1="10" x2="485" y2="10" stroke="rgba(28,28,30,0.08)" stroke-width="1"/>
                  <line x1="40" y1="45" x2="485" y2="45" stroke="rgba(28,28,30,0.06)" stroke-width="1" stroke-dasharray="3"/>
                  <line x1="40" y1="80" x2="485" y2="80" stroke="rgba(28,28,30,0.15)" stroke-width="1.5"/>

                  <text x="32" y="14" font-size="8" fill="rgba(28,28,30,0.5)" text-anchor="end">{{ hourlyChart.maxLabel }}</text>
                  <text x="32" y="48" font-size="8" fill="rgba(28,28,30,0.5)" text-anchor="end">{{ hourlyChart.midLabel }}</text>
                  <text x="32" y="83" font-size="8" fill="rgba(28,28,30,0.5)" text-anchor="end">0</text>

                  <!-- Dynamic Data Lines -->
                  <polyline fill="none" stroke="var(--alpine-blue)" stroke-width="2.5" stroke-linecap="round" points="{{ hourlyChart.pointsNew }}"/>
                  <polyline fill="none" stroke="var(--status-green)" stroke-width="2.5" stroke-linecap="round" points="{{ hourlyChart.pointsSold }}"/>
                  <polyline fill="none" stroke="var(--pnw-red)" stroke-width="2" stroke-dasharray="3" points="{{ hourlyChart.pointsDrops }}"/>

                  <!-- Un-squished Compensated End Dots -->
                  <ellipse cx="{{ hourlyChart.lastX }}" cy="{{ hourlyChart.lastYNew }}" rx="2.5" ry="3.8" fill="var(--alpine-blue)"/>
                  <ellipse cx="{{ hourlyChart.lastX }}" cy="{{ hourlyChart.lastYSold }}" rx="2.5" ry="3.8" fill="var(--status-green)"/>
                </svg>

                <!-- Dynamic Date Labels -->
                <div style="display: flex; justify-content: space-between; padding-left: 40px; padding-right: 15px; font-size: 0.65rem; color: rgba(28,28,30,0.5); font-weight: 500;">
                  {% for d in hourlyChart.dates %}
                    <span>{{ d }}</span>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

          <div style="font-size: 0.72rem; color: rgba(28,28,30,0.5); text-align: right; margin-top: 12px;">
            Last Updated: {{ "" | topOfHourTime }}
          </div>
        {% else %}
          <div style="font-size: 0.85rem; color: rgba(28,28,30,0.5); text-align: center; padding: 12px 0;">
            Hourly market velocity feed active for {{ neighborhood.name }}.
          </div>
        {% endif %}
      </div>
    {% endif %}

    <!-- 3. REDFIN MARKET TELEMETRY (EXCLUSIVE METRICS) -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>{{ neighborhood.name }} Redfin Market Telemetry</span>
        <span style="font-size: 0.68rem; opacity: 0.9;">Updated Monthly</span>
      </div>

      {% if redfinStats %}
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px;">
          
          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Price Per Sq. Ft.</div>
            <div style="font-size: 1.2rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              ${{ redfinStats.price_per_sqft | localeString }}
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Active Inventory</div>
            <div style="font-size: 1.2rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              {{ redfinStats.active_listings | localeString }} Homes
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">New Listings</div>
            <div style="font-size: 1.2rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              {{ redfinStats.new_listings | localeString }}
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Pending Sales</div>
            <div style="font-size: 1.2rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              {{ redfinStats.pending_sales | localeString }}
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Contract Cancellations</div>
            <div style="font-size: 1.2rem; font-weight: 600; color: var(--pnw-red); margin-top: 4px;">
              {{ redfinStats.contract_cancellations | localeString }}
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Cancellation Rate</div>
            <div style="font-size: 1.2rem; font-weight: 600; color: var(--pnw-red); margin-top: 4px;">
              {{ redfinStats.cancellation_rate_pct | default("0") }}%
            </div>
          </div>

        </div>

        <div style="font-size: 0.72rem; color: rgba(28,28,30,0.5); text-align: right;">
          Last Updated: {{ redfinStats.last_updated | postDate | default("July 3, 2026") }}
        </div>
      {% else %}
        <div style="font-size: 0.85rem; color: rgba(28,28,30,0.5); padding: 16px 0; text-align: center;">
          Monthly Redfin statistics for {{ neighborhood.name }} are currently syncing.
        </div>
      {% endif %}
    </div>

    <!-- 4. NWMLS & INFOSPARKS DATA: SUMMARY BOXES + 6 FULL-WIDTH LINE CHARTS -->
    <div class="bento-card">
      <div class="bento-card-header">
        <span>{{ neighborhood.name | upper }} NWMLS & INFOSPARKS DATA</span>
        <span style="font-size: 0.68rem; opacity: 0.9;">Updated Monthly</span>
      </div>

      <div style="font-size: 1.05rem; font-weight: 500; color: var(--premier-charcoal); margin-bottom: 14px;">
        12-Month History
      </div>

      {% if infoSparks %}
        <!-- Summary Data Metric Boxes -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px;">
          
          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Median Sale Price</div>
            <div style="font-size: 1.25rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              ${{ infoSparks.median_sale_price | localeString }}
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Closed Sales</div>
            <div style="font-size: 1.25rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              {{ infoSparks.closed_sales | localeString }}
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Days on Market</div>
            <div style="font-size: 1.25rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              {{ infoSparks.average_dom | default("29") }} Days
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Months Supply</div>
            <div style="font-size: 1.25rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              {{ infoSparks.months_supply | default("1.8") }} Mo.
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">Shows Per Listing</div>
            <div style="font-size: 1.25rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              {{ infoSparks.shows_per_listing | default("4.9") }}
            </div>
          </div>

          <div style="background: var(--premier-beige); padding: 12px; border-radius: 12px; text-align: center;">
            <div style="font-size: 0.65rem; text-transform: uppercase; color: rgba(28,28,30,0.5);">% of List Price Avg</div>
            <div style="font-size: 1.25rem; font-weight: 600; color: var(--premier-charcoal); margin-top: 4px;">
              {{ infoSparks.percent_list_price | default("98.9%") }}
            </div>
          </div>

        </div>

        <!-- 6 Full-Width Stacked Line Charts (HTML + SVG Hybrid Canvas Layout) -->
        <div style="display: flex; flex-direction: column; gap: 16px;">

          <!-- Chart 1: Median Sale Price -->
          <div style="background: var(--premier-beige); padding: 14px; border-radius: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span style="font-size: 0.78rem; font-weight: 600; text-transform: uppercase; color: rgba(28,28,30,0.6);">1. Median Sale Price Trend</span>
              <span style="font-size: 0.95rem; font-weight: 600; color: var(--alpine-blue);">${{ infoSparks.median_sale_price | localeString }}</span>
            </div>
            {% if chartMedianPrice %}
              <div style="display: flex; gap: 12px; align-items: center;">
                <div style="display: flex; flex-direction: column; justify-content: space-between; height: 50px; font-size: 0.68rem; font-weight: 600; color: rgba(28,28,30,0.5); text-align: right; min-width: 55px; white-space: nowrap;">
                  <span>{{ chartMedianPrice.maxLabel }}</span>
                  <span>{{ chartMedianPrice.minLabel }}</span>
                </div>
                <div style="flex: 1; height: 60px; position: relative;">
                  <svg width="100%" height="100%" viewBox="0 0 400 60" preserveAspectRatio="none">
                    <line x1="0" y1="5" x2="400" y2="5" stroke="rgba(28,28,30,0.06)" stroke-width="1"/>
                    <line x1="0" y1="55" x2="400" y2="55" stroke="rgba(28,28,30,0.12)" stroke-width="1"/>
                    <polyline fill="none" stroke="var(--alpine-blue)" stroke-width="2.5" stroke-linecap="round" points="{{ chartMedianPrice.points }}"/>
                    <ellipse cx="{{ chartMedianPrice.lastX }}" cy="{{ chartMedianPrice.lastY }}" rx="2.5" ry="3.8" fill="var(--alpine-blue)"/>
                  </svg>
                </div>
              </div>
              <div style="display: flex; justify-content: space-between; padding-left: 67px; font-size: 0.62rem; color: rgba(28,28,30,0.5); font-weight: 500; margin-top: 4px;">
                {% for d in chartMedianPrice.dates %}<span>{{ d }}</span>{% endfor %}
              </div>
            {% endif %}
          </div>

          <!-- Chart 2: Closed Sales -->
          <div style="background: var(--premier-beige); padding: 14px; border-radius: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span style="font-size: 0.78rem; font-weight: 600; text-transform: uppercase; color: rgba(28,28,30,0.6);">2. Closed Sales Volume</span>
              <span style="font-size: 0.95rem; font-weight: 600; color: var(--alpine-blue);">{{ infoSparks.closed_sales | localeString }}</span>
            </div>
            {% if chartClosedSales %}
              <div style="display: flex; gap: 12px; align-items: center;">
                <div style="display: flex; flex-direction: column; justify-content: space-between; height: 50px; font-size: 0.68rem; font-weight: 600; color: rgba(28,28,30,0.5); text-align: right; min-width: 55px; white-space: nowrap;">
                  <span>{{ chartClosedSales.maxLabel }}</span>
                  <span>{{ chartClosedSales.minLabel }}</span>
                </div>
                <div style="flex: 1; height: 60px; position: relative;">
                  <svg width="100%" height="100%" viewBox="0 0 400 60" preserveAspectRatio="none">
                    <line x1="0" y1="5" x2="400" y2="5" stroke="rgba(28,28,30,0.06)" stroke-width="1"/>
                    <line x1="0" y1="55" x2="400" y2="55" stroke="rgba(28,28,30,0.12)" stroke-width="1"/>
                    <polyline fill="none" stroke="var(--alpine-blue)" stroke-width="2.5" stroke-linecap="round" points="{{ chartClosedSales.points }}"/>
                    <ellipse cx="{{ chartClosedSales.lastX }}" cy="{{ chartClosedSales.lastY }}" rx="2.5" ry="3.8" fill="var(--alpine-blue)"/>
                  </svg>
                </div>
              </div>
              <div style="display: flex; justify-content: space-between; padding-left: 67px; font-size: 0.62rem; color: rgba(28,28,30,0.5); font-weight: 500; margin-top: 4px;">
                {% for d in chartClosedSales.dates %}<span>{{ d }}</span>{% endfor %}
              </div>
            {% endif %}
          </div>

          <!-- Chart 3: Days on Market -->
          <div style="background: var(--premier-beige); padding: 14px; border-radius: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span style="font-size: 0.78rem; font-weight: 600; text-transform: uppercase; color: rgba(28,28,30,0.6);">3. Average Days on Market</span>
              <span style="font-size: 0.95rem; font-weight: 600; color: var(--alpine-blue);">{{ infoSparks.average_dom | default("29") }} Days</span>
            </div>
            {% if chartDaysOnMarket %}
              <div style="display: flex; gap: 12px; align-items: center;">
                <div style="display: flex; flex-direction: column; justify-content: space-between; height: 50px; font-size: 0.68rem; font-weight: 600; color: rgba(28,28,30,0.5); text-align: right; min-width: 55px; white-space: nowrap;">
                  <span>{{ chartDaysOnMarket.maxLabel }}</span>
                  <span>{{ chartDaysOnMarket.minLabel }}</span>
                </div>
                <div style="flex: 1; height: 60px; position: relative;">
                  <svg width="100%" height="100%" viewBox="0 0 400 60" preserveAspectRatio="none">
                    <line x1="0" y1="5" x2="400" y2="5" stroke="rgba(28,28,30,0.06)" stroke-width="1"/>
                    <line x1="0" y1="55" x2="400" y2="55" stroke="rgba(28,28,30,0.12)" stroke-width="1"/>
                    <polyline fill="none" stroke="var(--alpine-blue)" stroke-width="2.5" stroke-linecap="round" points="{{ chartDaysOnMarket.points }}"/>
                    <ellipse cx="{{ chartDaysOnMarket.lastX }}" cy="{{ chartDaysOnMarket.lastY }}" rx="2.5" ry="3.8" fill="var(--alpine-blue)"/>
                  </svg>
                </div>
              </div>
              <div style="display: flex; justify-content: space-between; padding-left: 67px; font-size: 0.62rem; color: rgba(28,28,30,0.5); font-weight: 500; margin-top: 4px;">
                {% for d in chartDaysOnMarket.dates %}<span>{{ d }}</span>{% endfor %}
              </div>
            {% endif %}
          </div>

          <!-- Chart 4: Months Supply -->
          <div style="background: var(--premier-beige); padding: 14px; border-radius: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span style="font-size: 0.78rem; font-weight: 600; text-transform: uppercase; color: rgba(28,28,30,0.6);">4. Months Supply Inventory</span>
              <span style="font-size: 0.95rem; font-weight: 600; color: var(--alpine-blue);">{{ infoSparks.months_supply | default("1.8") }} Mo.</span>
            </div>
            {% if chartMonthsSupply %}
              <div style="display: flex; gap: 12px; align-items: center;">
                <div style="display: flex; flex-direction: column; justify-content: space-between; height: 50px; font-size: 0.68rem; font-weight: 600; color: rgba(28,28,30,0.5); text-align: right; min-width: 55px; white-space: nowrap;">
