---
layout: base.njk
pagination:
  data: city_data
  size: 1
  alias: neighborhood
permalink: "/neighborhood/{{ neighborhood.slug }}/"
eleventyComputed:
  title: "{{ neighborhood.name }} Local Community & Neighborhood Guide | MySeattleSearch"
  description: "Local news, editorial insights, community events, and neighborhood metrics for {{ neighborhood.name }}, Washington."
---

{% import "components/cards.njk" as cards %}
{% import "components/gauges.njk" as gauges %}
{% import "components/media.njk" as media %}
{% import "components/boards.njk" as boards %}

{% set cityWeather = neighborhood.slug | getCityWeather %}
{% set transitLive = neighborhood.slug | getTransitLive %}
{% set marketStats = neighborhood.slug | getMarketStats %}
{% set topGame = "" | getTopSportsGame %}
{% set monthlyFeature = neighborhood.slug | getMonthlyFeaturedSpots(neighborhood) %}
{% set regionalArticles = neighborhood["News Region"] | getRegionalNews(5) %}
{% set editorialParagraphs = neighborhood.slug | getEditorialParagraphs %}
{% set cityEventList = neighborhood.slug | getCityEvents %}

{{ media.heroCarousel(neighborhood.name, "Local Guide & Telemetry", neighborhood.heroImages, neighborhood.county) }}

<section class="at-a-glance-bar">
  
  <a href="/neighborhood/{{ neighborhood.slug }}/weather/" class="glance-slot" style="text-decoration: none; color: inherit;">
    {{ gauges.weatherWidget(cityWeather.temp, cityWeather.condition, cityWeather.temp_high, cityWeather.temp_low) }}
  </a>

  <a href="/neighborhood/{{ neighborhood.slug }}/weather/" class="glance-slot" style="text-decoration: none; color: inherit;">
    {{ gauges.sunRingMicro(cityWeather.sunrise, cityWeather.sunset) }}
  </a>

  <a href="/neighborhood/{{ neighborhood.slug }}/weather/" class="glance-slot" style="text-decoration: none; color: inherit;">
    {{ gauges.aqiWidget(cityWeather.aqi, cityWeather.aqi_label) }}
  </a>

  <a href="/neighborhood/{{ neighborhood.slug }}/transit-commute/" class="glance-slot" style="text-decoration: none; color: inherit;">
    {{ gauges.progressRingMicro(transitLive.active_transit_score, "Active Transit Score") }}
  </a>

  <a href="/neighborhood/{{ neighborhood.slug }}/data/" class="glance-slot" style="text-decoration: none; color: inherit;">
    {{ gauges.marketGaugeMicro(marketStats.market_label, "Market Hotness") }}
  </a>

  <a href="/neighborhood/region-sports/pro/" class="glance-slot" style="text-decoration: none; color: inherit;">
    {{ gauges.gameMicro(topGame) }}
  </a>

</section>

<div class="bento-grid">
  
  <div class="span-8" style="display: flex; flex-direction: column; gap: 24px;">
    
    <div class="bento-card">
      <div class="bento-card-header">
        <span>Top Rated Local Spots</span>
        <span style="font-size: 0.68rem; opacity: 0.9; text-transform: uppercase;">{{ monthlyFeature.headerBadge }}</span>
      </div>
      <div class="yelp-grid">
        {% if monthlyFeature.spots and monthlyFeature.spots.length > 0 %}
          {% for spot in monthlyFeature.spots %}
            <a href="{{ spot.url }}" class="yelp-item" target="_blank" rel="noopener">
              {% if spot.image_url %}
                <img src="{{ spot.image_url }}" alt="{{ spot.name }}">
              {% endif %}
              <div style="font-size: 0.85rem; font-weight: 500;">{{ spot.name }}</div>
              <div style="font-size: 0.75rem; color: var(--alpine-blue);">★ {{ spot.rating }} ({{ spot.review_count }})</div>
            </a>
          {% endfor %}
        {% else %}
          <div style="grid-column: span 3; font-size: 0.85rem; color: rgba(28,28,30,0.5); padding: 12px 0; text-align: center;">
            No local spots data found for this category.
          </div>
        {% endif %}
      </div>
    </div>

    <div class="bento-card">
      <div class="bento-card-header">
        <span>{{ neighborhood.name }} Area News</span>
        <span style="font-size: 0.68rem; opacity: 0.9;">{{ neighborhood["News Region"] }}</span>
      </div>
      
      {% if regionalArticles and regionalArticles.length > 0 %}
        {% for article in regionalArticles %}
          <div class="news-item" {% if loop.last %}style="border:none; padding:0; margin:0;"{% endif %}>
            <div class="news-source">{{ article.source | default("Local Feed") }}</div>
            <h4 class="news-headline">{{ article.title }}</h4>
            <p class="news-summary">{{ article.summary }}</p>
            <div class="news-meta">
              <span>{{ article.date }}</span>
              <a href="{{ article.url }}" class="link-arrow" target="_blank" rel="noopener">Read Story</a>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div style="font-size: 0.85rem; color: rgba(28,28,30,0.5); padding: 12px 0;">
          No regional news articles currently available.
        </div>
      {% endif %}
    </div>

    <div class="bento-card">
      <div class="bento-card-header">
        <span>Welcome to {{ neighborhood.name }}</span>
      </div>
      
      {% if editorialParagraphs and editorialParagraphs.length > 0 %}
        {% for paragraph in editorialParagraphs %}
          <p class="bento-card-body-lg" {% if not loop.last %}style="margin-bottom: 12px;"{% else %}style="margin: 0;"{% endif %}>
            {{ paragraph }}
          </p>
        {% endfor %}
      {% else %}
        <p class="bento-card-body-lg" style="margin: 0; color: rgba(28,28,30,0.5);">
          Editorial narrative for {{ neighborhood.name }} is currently being synced.
        </p>
      {% endif %}
    </div>

  </div>

  <div class="span-4" style="display: flex; flex-direction: column; gap: 24px;">
    
    <div class="bento-card bento-card--action">
      <div class="bento-card-header bento-card-header--action">
        <span>Explore {{ neighborhood.name }}</span>
      </div>
      <ul class="subpage-list">
        <li><a href="/neighborhood/{{ neighborhood.slug }}/weather/"><span>Weather</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/transit-commute/"><span>Transit & Commute</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/municipal/"><span>Municipal Services</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/emergency-safety/"><span>Emergency & Safety</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/data/"><span>Data & Statistics</span> <span>→</span></a></li>
        <li><a href="/neighborhood/{{ neighborhood.slug }}/elections/"><span>Elections</span> <span>→</span></a></li>
      </ul>
    </div>

    <div class="bento-card">
      <div class="bento-card-header">
        <span>Upcoming Events</span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        {% if cityEventList and cityEventList.length > 0 %}
          {% for ev in cityEventList %}
            <div {% if not loop.last %}style="border-bottom: 1px solid rgba(28,28,30,0.06); padding-bottom: 8px;"{% endif %}>
              <div style="font-size: 0.72rem; color: var(--alpine-blue); font-weight: 500; text-transform: uppercase;">{{ ev.type }}</div>
              <div style="font-size: 0.88rem; font-weight: 500; margin: 2px 0;">
                {% if ev.link and ev.link != '#' %}
                  <a href="{{ ev.link }}" target="_blank" rel="noopener" style="color: inherit; text-decoration: none;">{{ ev.title }}</a>
                {% else %}
                  {{ ev.title }}
                {% endif %}
              </div>
              <div style="font-size: 0.78rem; color: rgba(28,28,30,0.6);">{{ ev.date }}{% if ev.time_location %} • {{ ev.time_location }}{% endif %}</div>
            </div>
          {% endfor %}
        {% else %}
          <div style="font-size: 0.85rem; color: rgba(28,28,30,0.5); padding: 4px 0;">
            No upcoming events currently scheduled.
          </div>
        {% endif %}
      </div>
    </div>

    {% if topGame %}
      {{ boards.sportsCard(
        topGame.league,
        topGame.status,
        topGame.homeTeam,
        topGame.homeScore,
        topGame.homeRecord,
        topGame.awayTeam,
        topGame.awayScore,
        topGame.awayRecord,
        topGame.venue,
        "/neighborhood/region-sports/pro/",
        topGame.logoUrl,
        "span-12"
      ) }}
    {% endif %}

  </div>

</div>