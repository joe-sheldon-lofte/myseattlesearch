{
  "name": "myseattlesearch",
  "version": "1.0.0",
  "description": "Programmatic SEO and Static Site Generator configuration platform for Greater Seattle real estate telemetry.",
  "main": "components.js",
  "scripts": {
    "start": "eleventy --serve",
    "fetch-data": "node scripts/fetch-r2-data.js",
    "build": "npm run fetch-data && eleventy && npx pagefind --site _site",
    "index": "npx pagefind --site _site",
    "preview": "eleventy && npx pagefind --site _site && eleventy --serve",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-sheldon-lofte/myseattlesearch.git"
  },
  "keywords": [
    "eleventy",
    "ssg",
    "real-estate",
    "seattle"
  ],
  "author": "Joe Sheldon",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/joe-sheldon-lofte/myseattlesearch/issues"
  },
  "homepage": "https://github.com/joe-sheldon-lofte/myseattlesearch#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@aws-sdk/client-s3": "^3.900.0",
    "wrangler": "^4.156.2"
  }
}
