<script>
class OilTankEvaluator extends HTMLElement {
  connectedCallback() {
    this.selectHeating = this.querySelector('#eval-heating');
    this.selectLocation = this.querySelector('#eval-location');
    this.selectStatus = this.querySelector('#eval-status');
    this.outputTitle = this.querySelector('#eval-output-title');
    this.outputText = this.querySelector('#eval-output-text');

    this.selectHeating?.addEventListener('change', () => this.evaluate());
    this.selectLocation?.addEventListener('change', () => this.evaluate());
    this.selectStatus?.addEventListener('change', () => this.evaluate());

    this.evaluate();
  }

  evaluate() {
    if (!this.outputTitle || !this.outputText) return;

    const heating = this.selectHeating?.value;
    const location = this.selectLocation?.value;
    const status = this.selectStatus?.value;

    if (location === 'basement') {
      this.outputTitle.textContent = '✅ Low Environmental Risk';
      this.outputText.textContent = 'Above-ground basement or garage tanks do not pose hidden soil leakage risks. If disconnected, simply ensure the tank is drained and properly removed or vented.';
      return;
    }

    if (status === 'has-cert') {
      this.outputTitle.textContent = '✅ Verified Decommissioned';
      this.outputText.textContent = 'You have official Fire Department documentation. Keep a copy ready for Form 17 disclosures (sellers) or lender underwriting review (buyers).';
      return;
    }

    if (status === 'no-cert') {
      this.outputTitle.textContent = '⚠️ Paperwork Verification Needed';
      this.outputText.textContent = 'A tank without fire department certificates should be verified with a quick soil boring test ($300-$500) or tank sweep to satisfy buyer lender requirements.';
      return;
    }

    if (heating === 'active-oil' || status === 'not-decomm') {
      this.outputTitle.textContent = '💡 PLIA Grant Opportunity';
      this.outputText.textContent = 'Active or un-decommissioned tanks qualify for Washington State PLIA grants up to $75,000 for decommissioning or soil cleanup. Register with PLIA before starting work!';
      return;
    }

    this.outputTitle.textContent = '🔍 Schedule a Tank Sweep';
    this.outputText.textContent = 'For older homes with unknown heating history, a $150 tank sweep during your home inspection window verifies whether an undisclosed buried tank exists.';
  }
}

if (!customElements.get('oil-tank-evaluator')) {
  customElements.define('oil-tank-evaluator', OilTankEvaluator);
}
</script>