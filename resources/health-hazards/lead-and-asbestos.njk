<script>
class LeadAsbestosEvaluator extends HTMLElement {
  connectedCallback() {
    this.selectYear = this.querySelector('#la-year');
    this.selectProject = this.querySelector('#la-project');
    this.selectMaterial = this.querySelector('#la-material');
    this.outputTitle = this.querySelector('#la-output-title');
    this.outputText = this.querySelector('#la-output-text');

    this.selectYear?.addEventListener('change', () => this.evaluate());
    this.selectProject?.addEventListener('change', () => this.evaluate());
    this.selectMaterial?.addEventListener('change', () => this.evaluate());

    this.evaluate();
  }

  evaluate() {
    if (!this.outputTitle || !this.outputText) return;

    const year = this.selectYear?.value;
    const project = this.selectProject?.value;
    const material = this.selectMaterial?.value;

    if (year === 'post80') {
      this.outputTitle.textContent = '✅ Built 1981 or Newer (Post-Ban Era)';
      this.outputText.textContent = 'Homes built in 1981 or later were constructed after federal bans on lead paint and residential asbestos building materials took full effect. No special Form 22J lead disclosures or asbestos survey rules apply.';
      return;
    }

    if (project === 'asis') {
      this.outputTitle.textContent = '✅ Safe As-Is Living (Encapsulated)';
      this.outputText.textContent = 'Intact, painted-over lead paint and undisturbed building materials pose minimal active health risk. Testing during a home purchase inspection is generally discouraged due to high false-negative rates on buried layers.';
      return;
    }

    if (project === 'remodel') {
      this.outputTitle.textContent = '⚠️ PSCAA Asbestos Survey Required Before Demolition';
      this.outputText.textContent = 'Prior to scraping popcorn ceilings, removing duct wrap, or tearing down walls in a pre-1980 home, Puget Sound Clean Air Agency (PSCAA) regulations require a certified asbestos survey.';
      return;
    }

    this.outputTitle.textContent = '💡 Standard Form 22J & Lead-Safe Practices';
    this.outputText.textContent = 'For pre-1978 homes, ensure Form 22J is attached to your contract. When doing light cosmetic repairs or repainting window sills, use standard wet-sanding lead-safe practices to contain dust.';
  }
}

if (!customElements.get('lead-asbestos-evaluator')) {
  customElements.define('lead-asbestos-evaluator', LeadAsbestosEvaluator);
}
</script>