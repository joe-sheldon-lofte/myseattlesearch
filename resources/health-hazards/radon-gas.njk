<script>
class RadonRiskEvaluator extends HTMLElement {
  connectedCallback() {
    this.selectFoundation = this.querySelector('#radon-foundation');
    this.selectRegion = this.querySelector('#radon-region');
    this.selectSystem = this.querySelector('#radon-system');
    this.outputTitle = this.querySelector('#radon-output-title');
    this.outputText = this.querySelector('#radon-output-text');

    this.selectFoundation?.addEventListener('change', () => this.evaluate());
    this.selectRegion?.addEventListener('change', () => this.evaluate());
    this.selectSystem?.addEventListener('change', () => this.evaluate());

    this.evaluate();
  }

  evaluate() {
    if (!this.outputTitle || !this.outputText) return;

    const foundation = this.selectFoundation?.value;
    const region = this.selectRegion?.value;
    const system = this.selectSystem?.value;

    if (system === 'active') {
      this.outputTitle.textContent = '✅ Active Mitigation System Installed';
      this.outputText.textContent = 'The home already has a sub-slab depressurization fan. Verify the fan manometer gauge is working and conduct a standard 2-year re-test using a free WA DOH kit.';
      return;
    }

    if (region === 'eastern') {
      this.outputTitle.textContent = '⚠️ Higher Risk Zone (Eastern WA)';
      this.outputText.textContent = 'Eastern WA soils carry significantly higher radon potential. A 48-hour continuous radon test is strongly recommended during home purchase inspections.';
      return;
    }

    if (region === 'foothills' && foundation === 'basement') {
      this.outputTitle.textContent = '🔍 Optional / Low-To-Moderate Consideration';
      this.outputText.textContent = 'Basements carved into Cascade foothill soils (Monroe, Sultan, North Bend) have slightly higher potential than coastal areas. Ordering a free WA DOH kit or a $20 DIY test provides easy verification.';
      return;
    }

    this.outputTitle.textContent = '✅ Low Risk (EPA Zone 3)';
    this.outputText.textContent = 'King and Snohomish lowland soils carry very low radon risk. Spending $300 on an inspection contingency is rarely necessary. If curious, request a free test kit directly from the WA Department of Health.';
  }
}

if (!customElements.get('radon-risk-evaluator')) {
  customElements.define('radon-risk-evaluator', RadonRiskEvaluator);
}
</script>