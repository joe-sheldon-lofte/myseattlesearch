<script>
class MoistureEvaluator extends HTMLElement {
  connectedCallback() {
    this.selectSymptom = this.querySelector('#moist-symptom');
    this.selectExhaust = this.querySelector('#moist-exhaust');
    this.selectCrawl = this.querySelector('#moist-crawl');
    this.outputTitle = this.querySelector('#moist-output-title');
    this.outputText = this.querySelector('#moist-output-text');

    this.selectSymptom?.addEventListener('change', () => this.evaluate());
    this.selectExhaust?.addEventListener('change', () => this.evaluate());
    this.selectCrawl?.addEventListener('change', () => this.evaluate());

    this.evaluate();
  }

  evaluate() {
    if (!this.outputTitle || !this.outputText) return;

    const symptom = this.selectSymptom?.value;
    const exhaust = this.selectExhaust?.value;
    const crawl = this.selectCrawl?.value;

    if (exhaust === 'attic-space') {
      this.outputTitle.textContent = '⚠️ Priority Fix: Reroute Exhaust Duct to Exterior Roof Cap';
      this.outputText.textContent = 'Blowing warm, humid bathroom air directly into the attic is the #1 cause of PNW "Attic Rain" and sheathing frost. Hire a contractor to extend ductwork out through a dedicated damper roof cap.';
      return;
    }

    if (symptom === 'crawl' || crawl === 'bare-dirt' || crawl === 'damaged') {
      this.outputTitle.textContent = '🌱 Soil Vapor Barrier Upgrade Recommended';
      this.outputText.textContent = 'Bare earth releases hundreds of gallons of water vapor per year into your crawl space. Laying a continuous 6-mil black polyethylene vapor barrier over 100% of the soil stops damp air from rotting floor joists.';
      return;
    }

    if (symptom === 'window') {
      this.outputTitle.textContent = '✅ Easy Ventilation Fix: Increase Air Circulation';
      this.outputText.textContent = 'Window glass condensation and bath tile mildew are harmless surface issues caused by trapped humidity. Run 80+ CFM bath fans 20 minutes post-shower and open window trickle vents to maintain relative humidity below 50%.';
      return;
    }

    this.outputTitle.textContent = '✅ Proper Moisture & Ventilation Controls in Place';
    this.outputText.textContent = 'Your property setup meets standard PNW moisture guidelines. Keep soffit vents clear of attic insulation and maintain routine bath fan usage to keep indoor air clean and dry.';
  }
}

if (!customElements.get('moisture-evaluator')) {
  customElements.define('moisture-evaluator', MoistureEvaluator);
}
</script>