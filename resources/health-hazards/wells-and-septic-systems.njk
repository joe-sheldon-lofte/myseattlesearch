<script>
class SepticWellEvaluator extends HTMLElement {
  connectedCallback() {
    this.selectCounty = this.querySelector('#sw-county');
    this.selectSystem = this.querySelector('#sw-system');
    this.selectRole = this.querySelector('#sw-role');
    this.outputTitle = this.querySelector('#sw-output-title');
    this.outputText = this.querySelector('#sw-output-text');

    this.selectCounty?.addEventListener('change', () => this.evaluate());
    this.selectSystem?.addEventListener('change', () => this.evaluate());
    this.selectRole?.addEventListener('change', () => this.evaluate());

    this.evaluate();
  }

  evaluate() {
    if (!this.outputTitle || !this.outputText) return;

    const county = this.selectCounty?.value;
    const system = this.selectSystem?.value;
    const role = this.selectRole?.value;

    if (role === 'seller' && county === 'snohomish' && (system === 'both' || system === 'septic-public')) {
      this.outputTitle.textContent = '⚠️ Mandatory Snohomish RSS Inspection Needed';
      this.outputText.textContent = 'Schedule A Wesco Septic 30 days before listing. Snohomish County requires a certified septic tank pumping and Report of System Status (RSS) prior to title transfer.';
      return;
    }

    if (role === 'buyer' && (system === 'both' || system === 'sewer-well')) {
      this.outputTitle.textContent = '🔍 Order 3-Step Well Evaluation';
      this.outputText.textContent = 'Ensure your inspection contingency covers: 1) Handing PAL or AmTest a 5-point water panel (bacteria, nitrates, arsenic, lead), 2) Mechanical pump head inspection, and 3) A 1 to 4-hour GPM continuous flow yield test.';
      return;
    }

    if (role === 'seller' && county === 'king') {
      this.outputTitle.textContent = '📋 King County O&M Maintenance Records Required';
      this.outputText.textContent = 'Locate your King County Public Health On-Site Sewage System (OSM) inspection logs. Gravity systems require records within 3 years; pressure systems require annual service logs.';
      return;
    }

    this.outputTitle.textContent = '💡 Review System Age & Service Logs';
    this.outputText.textContent = 'Request past maintenance logs, pump receipts, and well log reports (driller records from WA Dept of Ecology) during your inspection contingency window.';
  }
}

if (!customElements.get('septic-well-evaluator')) {
  customElements.define('septic-well-evaluator', SepticWellEvaluator);
}
</script>