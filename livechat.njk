---
layout: layouts/base.njk
title: "Live Chat with Joe | Joe Sheldon"
description: "Direct real-time advisory for King and Snohomish County real estate, hyper-local zoning, parcel valuation, and active listings."
permalink: /livechat/index.html
---

<main class="layout-container layout-stack-main">

  <section class="content-section-centered">
    <div class="surface-bento profile-single-card" style="max-width: 680px; margin: 0 auto; width: 100%;">
      
      <!-- SCREEN 1: MINIMAL PRE-FLIGHT INTAKE FORM -->
      <div id="chat-screening-view">
        <header class="section-profile" style="text-align: center; margin-bottom: 1.5rem;">
          <h1 class="text-page-title" style="margin: 0 0 0.5rem 0; font-size: 1.75rem;">Live Chat with Joe</h1>
          <p class="text-body-secondary" style="margin: 0; font-size: 1rem;">
            Enter your first and last name and email address to start chatting.
          </p>
        </header>

        <form id="chat-intake-form" style="display: flex; flex-direction: column; gap: 1rem;">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <div style="display: flex; flex-direction: column; gap: 0.35rem;">
              <label for="chat_first_name" class="text-overline" style="font-weight: 600;">First Name *</label>
              <input type="text" id="chat_first_name" name="first_name" required placeholder="Jane"
                     style="padding: 0.75rem 1rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; font-size: 1rem; background: var(--white); color: var(--premier-charcoal);">
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.35rem;">
              <label for="chat_last_name" class="text-overline" style="font-weight: 600;">Last Name *</label>
              <input type="text" id="chat_last_name" name="last_name" required placeholder="Doe"
                     style="padding: 0.75rem 1rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; font-size: 1rem; background: var(--white); color: var(--premier-charcoal);">
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <label for="chat_email" class="text-overline" style="font-weight: 600;">Email Address *</label>
            <input type="email" id="chat_email" name="email" required placeholder="jane.doe@example.com"
                   style="padding: 0.75rem 1rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; font-size: 1rem; background: var(--white); color: var(--premier-charcoal);">
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <label for="chat_initial_message" class="text-overline" style="font-weight: 600;">Message *</label>
            <textarea id="chat_initial_message" name="message" rows="4" required placeholder="Message"
                      style="padding: 0.75rem 1rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 8px; font-size: 1rem; background: var(--white); color: var(--premier-charcoal); resize: vertical;"></textarea>
          </div>

          <div id="chat-init-error" style="display: none; padding: 0.75rem 1rem; background: rgba(217,35,42,0.1); border: 1px solid var(--card-accent-color); border-radius: 8px; color: var(--premier-charcoal); font-size: 0.9rem;"></div>

          <button type="submit" id="chat-submit-btn" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 0.85rem; font-size: 1rem; margin-top: 0.5rem;">
            <span>Start Chat</span>
          </button>
        </form>
      </div>

      <!-- SCREEN 2: VERIFICATION REQUIRED NOTICE -->
      <div id="chat-verify-view" style="display: none; text-align: center; padding: 2rem 1rem;">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">📬</div>
        <h2 class="text-section-title" style="margin-bottom: 0.5rem;">Check Your Email</h2>
        <p class="text-body" style="max-width: 500px; margin: 0 auto 1.5rem auto;">
          Welcome back! We sent a secure access link to <strong id="verify-email-target">your email</strong> to resume your previous conversation.
        </p>
        <div class="action-tray-constrained" style="justify-content: center;">
          <button type="button" id="chat-reset-btn" class="btn btn-secondary">
            <span>Use a different email</span>
          </button>
        </div>
      </div>

      <!-- SCREEN 3: ACTIVE CONVERSATION CONSOLE -->
      <div id="chat-active-view" style="display: none;">
        
        <header style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.08); margin-bottom: 1rem;">
          <h2 class="text-widget-title" style="margin: 0; font-size: 1.15rem;">Live Chat with Joe</h2>
          <button type="button" id="chat-logout-btn" style="background: none; border: none; color: rgba(0,0,0,0.5); font-size: 0.85rem; text-decoration: underline; cursor: pointer; padding: 0;">
            End chat
          </button>
        </header>

        <!-- Scrollable Message Stream -->
        <div id="chat-message-stream" 
             style="height: 420px; max-height: 55vh; overflow-y: auto; padding: 1rem; border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; background: var(--dynamic-bg-highlight); display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 1rem;">
        </div>

        <!-- Inline Reply Input Tray -->
        <form id="chat-reply-form" style="display: flex; gap: 0.75rem; align-items: center;">
          <input type="text" id="chat-reply-input" placeholder="Type a message..." autocomplete="off" required
                 style="flex: 1; padding: 0.85rem 1.15rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 24px; font-size: 1rem; background: var(--white); color: var(--premier-charcoal);">
          <button type="submit" id="chat-send-btn" class="btn btn-primary" style="border-radius: 24px; padding: 0.85rem 1.5rem; flex-shrink: 0;">
            <span>Send</span>
          </button>
        </form>

      </div>

    </div>
  </section>

</main>

<script>
(function() {
  const API_BASE = window.CHAT_API_URL || "https://myseattlesearch-campaigns.myseattlesearch.workers.dev";

  const screeningView = document.getElementById("chat-screening-view");
  const verifyView = document.getElementById("chat-verify-view");
  const activeView = document.getElementById("chat-active-view");
  const intakeForm = document.getElementById("chat-intake-form");
  const replyForm = document.getElementById("chat-reply-form");
  const replyInput = document.getElementById("chat-reply-input");
  const messageStream = document.getElementById("chat-message-stream");
  const initError = document.getElementById("chat-init-error");
  const submitBtn = document.getElementById("chat-submit-btn");
  const logoutBtn = document.getElementById("chat-logout-btn");
  const resetBtn = document.getElementById("chat-reset-btn");
  const verifyEmailTarget = document.getElementById("verify-email-target");

  let activeSessionId = localStorage.getItem("cf_chat_session") || null;
  let lastMessageTimestamp = "1970-01-01T00:00:00Z";
  let pollIntervalId = null;
  const processedMessageIds = new Set();

  function escapeHtml(text) {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function formatTime(isoString) {
    if (!isoString) return "";
    try {
      const d = new Date(isoString);
      return new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Los_Angeles",
        hour: "numeric",
        minute: "2-digit"
      }).format(d);
    } catch {
      return "";
    }
  }

  function appendBubble(senderId, body, timestamp, messageId) {
    if (messageId && processedMessageIds.has(messageId)) return;
    if (messageId) processedMessageIds.add(messageId);

    const isJoe = senderId === "agent:joe_sheldon";
    const bubbleWrapper = document.createElement("div");
    bubbleWrapper.style.display = "flex";
    bubbleWrapper.style.flexDirection = "column";
    bubbleWrapper.style.alignItems = isJoe ? "flex-start" : "flex-end";
    bubbleWrapper.style.width = "100%";

    const metaLine = document.createElement("span");
    metaLine.className = "text-overline";
    metaLine.style.fontSize = "0.7rem";
    metaLine.style.marginBottom = "0.2rem";
    metaLine.style.color = "rgba(0,0,0,0.5)";
    metaLine.textContent = `${isJoe ? "Joe Sheldon" : "You"} • ${formatTime(timestamp)}`;

    const bubble = document.createElement("div");
    bubble.style.maxWidth = "80%";
    bubble.style.padding = "0.75rem 1.15rem";
    bubble.style.borderRadius = "16px";
    bubble.style.fontSize = "0.95rem";
    bubble.style.lineHeight = "1.45";
    bubble.style.wordBreak = "break-word";

    if (isJoe) {
      bubble.style.backgroundColor = "var(--white)";
      bubble.style.color = "var(--premier-charcoal)";
      bubble.style.border = "1px solid rgba(0,0,0,0.1)";
      bubble.style.borderBottomLeftRadius = "4px";
      bubble.style.boxShadow = "0 1px 3px rgba(0,0,0,0.05)";
    } else {
      bubble.style.backgroundColor = "var(--card-accent-color)";
      bubble.style.color = "var(--white)";
      bubble.style.borderBottomRightRadius = "4px";
    }

    bubble.innerHTML = escapeHtml(body).replace(/\n/g, "<br>");

    bubbleWrapper.appendChild(metaLine);
    bubbleWrapper.appendChild(bubble);
    messageStream.appendChild(bubbleWrapper);
    messageStream.scrollTop = messageStream.scrollHeight;

    if (timestamp && timestamp > lastMessageTimestamp) {
      lastMessageTimestamp = timestamp;
    }
  }

  async function syncMessages() {
    if (!activeSessionId) return;

    try {
      const res = await fetch(`${API_BASE}/api/chat/sync?since=${encodeURIComponent(lastMessageTimestamp)}&session_id=${encodeURIComponent(activeSessionId)}`, {
        method: "GET",
        credentials: "include"
      });

      if (!res.ok) return;
      const data = await res.json();
      const messages = data.messages || [];

      messages.forEach(msg => {
        appendBubble(msg.sender_id, msg.message_body, msg.created_at, msg.message_id);
      });
    } catch (err) {
      console.warn("[livechat] sync poll error:", err);
    }
  }

  function startPolling() {
    stopPolling();
    syncMessages();
    pollIntervalId = setInterval(syncMessages, 3500);
  }

  function stopPolling() {
    if (pollIntervalId) {
      clearInterval(pollIntervalId);
      pollIntervalId = null;
    }
  }

  document.addEventListener("visibilitychange", function() {
    if (document.hidden) {
      stopPolling();
    } else if (activeSessionId) {
      startPolling();
    }
  });

  function openChatConsole() {
    screeningView.style.display = "none";
    verifyView.style.display = "none";
    activeView.style.display = "block";
    replyInput.focus();
    startPolling();
  }

  async function checkForResumeToken() {
    const params = new URLSearchParams(window.location.search);
    const resumeToken = params.get("resume_token");
    if (!resumeToken) return;

    try {
      const res = await fetch(`${API_BASE}/api/chat/resume`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ token: resumeToken })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        activeSessionId = data.session_id;
        localStorage.setItem("cf_chat_session", activeSessionId);
        
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);

        (data.messages || []).forEach(msg => {
          appendBubble(msg.sender_id, msg.message_body, msg.created_at, msg.message_id);
        });

        openChatConsole();
      }
    } catch (err) {
      console.error("[livechat] Magic link verification failed:", err);
    }
  }

  async function checkExistingSession() {
    if (!activeSessionId) return;

    try {
      const res = await fetch(`${API_BASE}/api/chat/sync?session_id=${encodeURIComponent(activeSessionId)}`, {
        method: "GET",
        credentials: "include"
      });

      if (res.ok) {
        const data = await res.json();
        const messages = data.messages || [];
        if (messages.length > 0) {
          messages.forEach(msg => {
            appendBubble(msg.sender_id, msg.message_body, msg.created_at, msg.message_id);
          });
          openChatConsole();
        }
      }
    } catch {
      // Inactive session keeps screening form visible
    }
  }

  intakeForm.addEventListener("submit", async function(e) {
    e.preventDefault();
    initError.style.display = "none";
    submitBtn.disabled = true;
    submitBtn.innerHTML = "<span>Starting Chat...</span>";

    const payload = {
      first_name: document.getElementById("chat_first_name").value,
      last_name: document.getElementById("chat_last_name").value,
      email: document.getElementById("chat_email").value,
      message: document.getElementById("chat_initial_message").value
    };

    try {
      const res = await fetch(`${API_BASE}/api/chat/init`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || "Unable to initialize chat.");
      }

      if (data.status === "verification_required") {
        verifyEmailTarget.textContent = payload.email;
        screeningView.style.display = "none";
        verifyView.style.display = "block";
        return;
      }

      if (data.status === "connected") {
        activeSessionId = data.session_id;
        localStorage.setItem("cf_chat_session", activeSessionId);

        if (data.initial_message) {
          appendBubble(
            data.initial_message.sender_id,
            data.initial_message.message_body,
            data.initial_message.created_at,
            data.initial_message.message_id
          );
        }

        openChatConsole();
      }
    } catch (err) {
      initError.textContent = err.message;
      initError.style.display = "block";
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = "<span>Start Chat</span>";
    }
  });

  replyForm.addEventListener("submit", async function(e) {
    e.preventDefault();
    const text = replyInput.value.trim();
    if (!text || !activeSessionId) return;

    replyInput.value = "";

    const tempId = "temp_" + Date.now();
    const nowIso = new Date().toISOString();
    appendBubble("client", text, nowIso, tempId);

    try {
      const res = await fetch(`${API_BASE}/api/chat/send`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ message: text, session_id: activeSessionId })
      });

      if (!res.ok) {
        console.error("[livechat] send reply failed");
      }
    } catch (err) {
      console.error("[livechat] dispatch network error:", err);
    }
  });

  logoutBtn.addEventListener("click", function() {
    stopPolling();
    localStorage.removeItem("cf_chat_session");
    document.cookie = "cf_chat_session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
    window.location.href = "/livechat/";
  });

  resetBtn.addEventListener("click", function() {
    verifyView.style.display = "none";
    screeningView.style.display = "block";
  });

  checkForResumeToken().then(() => {
    if (!activeSessionId) checkExistingSession();
  });
})();
</script>