---
layout: layouts/base.njk
permalink: "/region/emergency-safety/index.html"
title: "Puget Sound Regional Emergency & Safety | MySeattleSearch"
meta_description: "Regional emergency dashboard tracking school closures, NWS severe weather alerts, utility power outages, felt earthquakes, and wildfires across Puget Sound."
---

{% set city_slug = "region" %}
{% set active_neighborhood = "Puget Sound Region" %}

{# Aggregate unique active alerts across all 58 neighborhoods #}
{% set reg_schools = [] %}
{% set seen_school_keys = [] %}
{% set reg_weather = [] %}
{% set seen_wx_keys = [] %}
{% set reg_power = [] %}
{% set seen_power_keys = [] %}
{% set reg_quakes = [] %}
{% set seen_quake_keys = [] %}
{% set reg_fires = [] %}
{% set seen_fire_keys = [] %}

{% if active_alerts and active_alerts.neighborhoods %}
  {% for slug, n_obj in active_alerts.neighborhoods %}
    {% for rep in (n_obj.school_reports or []) %}
      {% set skey = rep.report_id or (rep.org_name ~ "_" ~ (rep.detail or "")) %}
      {% if skey not in seen_school_keys %}
        {% set _ = seen_school_keys.push(skey) %}
        {% set _ = reg_schools.push({
          "org_name": rep.org_name,
          "category": rep.category,
          "detail": rep.detail,
          "tomorrow_note": rep.tomorrow_note,
          "scope": rep.scope,
          "school_name": rep.school_name,
          "latitude": rep.latitude,
          "longitude": rep.longitude,
          "geometry": rep.geometry,
          "city_name": n_obj.name,
          "city_slug": slug
        }) %}
      {% endif %}
    {% endfor %}

    {% for wx in (n_obj.weather_alerts or []) %}
      {% set wkey = wx.id or (wx.event ~ "_" ~ (wx.headline or "")) %}
      {% if wkey not in seen_wx_keys %}
        {% set _ = seen_wx_keys.push(wkey) %}
        {% set _ = reg_weather.push({
          "event": wx.event,
          "severity": wx.severity,
          "headline": wx.headline,
          "instruction": wx.instruction,
          "geometry": wx.geometry,
          "city_name": n_obj.name,
          "city_slug": slug
        }) %}
      {% endif %}
    {% endfor %}

    {% for inc in (n_obj.power_incidents or []) %}
      {% set pkey = inc.id or (inc.provider ~ "_" ~ inc.latitude ~ "_" ~ inc.longitude) %}
      {% if pkey not in seen_power_keys %}
        {% set _ = seen_power_keys.push(pkey) %}
        {% set _ = reg_power.push({
          "provider": inc.provider,
          "customers_affected": inc.customers_affected,
          "status": inc.status,
          "cause": inc.cause,
          "est_restoration": inc.est_restoration,
          "latitude": inc.latitude,
          "longitude": inc.longitude,
          "geometry": inc.geometry,
          "city_name": n_obj.name,
          "city_slug": slug
        }) %}
      {% endif %}
    {% endfor %}

    {% for q in (n_obj.earthquakes or []) %}
      {% set qkey = q.id or (q.place ~ "_" ~ q.time_ms) %}
      {% if qkey not in seen_quake_keys %}
        {% set _ = seen_quake_keys.push(qkey) %}
        {% set _ = reg_quakes.push({
          "magnitude": q.magnitude,
          "place": q.place,
          "depth": q.depth,
          "distance_miles": q.distance_miles,
          "latitude": q.latitude,
          "longitude": q.longitude,
          "city_name": n_obj.name,
          "city_slug": slug
        }) %}
      {% endif %}
    {% endfor %}

    {% for f in (n_obj.wildfires or []) %}
      {% set fkey = f.id or f.name %}
      {% if fkey not in seen_fire_keys %}
        {% set _ = seen_fire_keys.push(fkey) %}
        {% set _ = reg_fires.push({
          "name": f.name,
          "county": f.county,
          "acres": f.acres,
          "containment_percent": f.containment_percent,
          "distance_miles": f.distance_miles,
          "latitude": f.latitude,
          "longitude": f.longitude,
          "city_name": n_obj.name,
          "city_slug": slug
        }) %}
      {% endif %}
    {% endfor %}
  {% endfor %}
{% endif %}

{% set school_cnt = reg_schools | length %}
{% set weather_cnt = reg_weather | length %}
{% set power_cnt = reg_power | length %}
{% set quake_cnt = reg_quakes | length %}
{% set fire_cnt = reg_fires | length %}

<main class="layout-container layout-stack-main">

  {# ==========================================================================
     SECTION 1: REGIONAL HEADER & EXPLORE NAVIGATION PILLS
     ========================================================================== #}
  <div id="neighborhood-hero" class="portal-section-header">
    {% set city = { "City": "Puget Sound Region" } %}
    {% set hero_welcome_label = "King & Snohomish Counties" %}
    {% set subpage_title = "Emergency & Safety" %}
    {% include "components/widget/neighborhood-subpage-header.njk" %}
  </div>

  <section id="explore-neighborhood" class="portal-section-nav" aria-label="Explore {{ active_neighborhood }}">
    <span class="text-overline text-accent-alpine section-overline-lead">
      EXPLORE {{ active_neighborhood | upper }}
    </span>
    <div class="neighborhood-nav-container">
      <nav class="neighborhood-nav-track" tabindex="0" aria-label="{{ active_neighborhood }} Subpages">
        <a href="/region/" class="neighborhood-nav-pill is-inactive">Regional Home</a>
        <a href="/region/news/" class="neighborhood-nav-pill is-inactive">Regional News</a>
        <a href="/region/events/" class="neighborhood-nav-pill is-inactive">Regional Events</a>
        <a href="/region/transit-commute/" class="neighborhood-nav-pill is-inactive">Regional Transit</a>
        <a href="/sports/pro/" class="neighborhood-nav-pill is-inactive">Pro Sports</a>
      </nav>
    </div>
  </section>

  <hr class="section-divider">

  {# ==========================================================================
     SECTION 2: REGIONAL ACTIVE EMERGENCY INFORMATION (5-Row Color-Coded Accordion)
     ========================================================================== #}
  <section id="active-emergency-info" class="portal-section-widget">
    <h2 class="text-section-title section-title-clean">Active Emergency Information</h2>

    <div class="emergency-accordion-card">

      {# 1. SCHOOL CLOSURES (#F59E0B Amber Gold) #}
      <details id="schools" class="emergency-acc-item {% if school_cnt > 0 %}is-alert-school{% endif %}" {% if school_cnt > 0 %}open{% endif %}>
        <summary class="emergency-acc-summary">
          <div class="emergency-acc-lead">
            <span class="emergency-acc-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 8 L14 5 L18 5 L18 8 Z"/>
                <path d="M16 2 L16 5"/>
                <path d="M4 14 L16 8 L28 14 Z"/>
                <rect x="6" y="14" width="20" height="14" rx="1"/>
                <path d="M13 28 V21 H19 V28"/>
              </svg>
            </span>
            <span class="emergency-acc-title">School Closures</span>
          </div>

          <div class="emergency-acc-status-group">
            <span class="emergency-status-indicator">
              <span class="emergency-status-dot {% if school_cnt > 0 %}dot-school{% else %}dot-optimal{% endif %}" aria-hidden="true"></span>
              <span class="emergency-status-text {% if school_cnt > 0 %}text-school{% endif %}">
                {% if school_cnt > 0 %}
                  {{ school_cnt }} School {% if school_cnt == 1 %}Alert{% else %}Alerts{% endif %}
                {% else %}
                  No active alerts
                {% endif %}
              </span>
            </span>
            <svg class="emergency-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </summary>

        <div class="emergency-acc-drawer">
          {% if school_cnt > 0 %}
            {% for rep in reg_schools %}
              <article class="emergency-alert-entry">
                <div class="emergency-alert-entry-head">
                  <h3 class="emergency-alert-entry-title">{{ rep.org_name }}</h3>
                  {% if rep.category %}<span class="emergency-alert-entry-meta">{{ rep.category }}</span>{% endif %}
                </div>
                {% if rep.detail %}<p class="emergency-alert-entry-body">{{ rep.detail }}</p>{% endif %}
                {% if rep.tomorrow_note %}<p class="emergency-alert-entry-body"><strong>Tomorrow:</strong> {{ rep.tomorrow_note }}</p>{% endif %}
                <a href="/neighborhood/{{ rep.city_slug }}/emergency-safety/" class="emergency-alert-city-link">View {{ rep.city_name }} Emergency Details &rarr;</a>
              </article>
            {% endfor %}
          {% else %}
            <p class="emergency-drawer-empty">No active school closures or schedule delays reported across King and Snohomish Counties.</p>
          {% endif %}
        </div>
      </details>

      {# 2. SEVERE WEATHER (#7C3AED Electric Violet) #}
      <details id="weather" class="emergency-acc-item {% if weather_cnt > 0 %}is-alert-weather{% endif %}" {% if weather_cnt > 0 %}open{% endif %}>
        <summary class="emergency-acc-summary">
          <div class="emergency-acc-lead">
            <span class="emergency-acc-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86a2 2 0 0 1 3.42 0l8.29 14.14A2 2 0 0 1 20.29 21H3.71a2 2 0 0 1-1.71-3L10.29 3.86z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
            </span>
            <span class="emergency-acc-title">Severe Weather</span>
          </div>

          <div class="emergency-acc-status-group">
            <span class="emergency-status-indicator">
              <span class="emergency-status-dot {% if weather_cnt > 0 %}dot-weather{% else %}dot-optimal{% endif %}" aria-hidden="true"></span>
              <span class="emergency-status-text {% if weather_cnt > 0 %}text-weather{% endif %}">
                {% if weather_cnt > 0 %}
                  {{ weather_cnt }} Severe Weather {% if weather_cnt == 1 %}Alert{% else %}Alerts{% endif %}
                {% else %}
                  No active alerts
                {% endif %}
              </span>
            </span>
            <svg class="emergency-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </summary>

        <div class="emergency-acc-drawer">
          {% if weather_cnt > 0 %}
            {% for wx in reg_weather %}
              <article class="emergency-alert-entry">
                <div class="emergency-alert-entry-head">
                  <h3 class="emergency-alert-entry-title">{{ wx.event }}</h3>
                  {% if wx.severity %}<span class="emergency-alert-entry-meta">{{ wx.severity | upper }}</span>{% endif %}
                </div>
                {% if wx.headline %}<p class="emergency-alert-entry-body">{{ wx.headline }}</p>{% endif %}
                {% if wx.instruction %}<p class="emergency-alert-entry-body">{{ wx.instruction }}</p>{% endif %}
                <a href="/neighborhood/{{ wx.city_slug }}/emergency-safety/" class="emergency-alert-city-link">View {{ wx.city_name }} Emergency Details &rarr;</a>
              </article>
            {% endfor %}
          {% else %}
            <p class="emergency-drawer-empty">No active National Weather Service watches or warnings across King and Snohomish Counties.</p>
          {% endif %}
        </div>
      </details>

      {# 3. POWER OUTAGES (#0284C7 Electric Blue) #}
      <details id="power" class="emergency-acc-item {% if power_cnt > 0 %}is-alert-power{% endif %}" {% if power_cnt > 0 %}open{% endif %}>
        <summary class="emergency-acc-summary">
          <div class="emergency-acc-lead">
            <span class="emergency-acc-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
                <path d="M10.29 3.86a2 2 0 0 1 3.42 0l8.29 14.14A2 2 0 0 1 20.29 21H3.71a2 2 0 0 1-1.71-3L10.29 3.86z"/>
                <path d="M12.5 7.5L8.5 13.5h3.5l-1 5 5-6.5h-3.5l1.5-4.5z" fill="currentColor" stroke="none"/>
              </svg>
            </span>
            <span class="emergency-acc-title">Power Outages</span>
          </div>

          <div class="emergency-acc-status-group">
            <span class="emergency-status-indicator">
              <span class="emergency-status-dot {% if power_cnt > 0 %}dot-power{% else %}dot-optimal{% endif %}" aria-hidden="true"></span>
              <span class="emergency-status-text {% if power_cnt > 0 %}text-power{% endif %}">
                {% if power_cnt > 0 %}
                  {{ power_cnt }} Power Outage {% if power_cnt == 1 %}Alert{% else %}Alerts{% endif %}
                {% else %}
                  No active alerts
                {% endif %}
              </span>
            </span>
            <svg class="emergency-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </summary>

        <div class="emergency-acc-drawer">
          {% if power_cnt > 0 %}
            {% for inc in reg_power %}
              <article class="emergency-alert-entry">
                <div class="emergency-alert-entry-head">
                  <h3 class="emergency-alert-entry-title">{{ inc.provider }} ({{ inc.city_name }}) &mdash; {{ inc.customers_affected }} Customers Affected</h3>
                  <span class="emergency-alert-entry-meta">{{ inc.status }}</span>
                </div>
                <p class="emergency-alert-entry-body">
                  Cause: {{ inc.cause }}{% if inc.est_restoration %} &bull; Est. Restoration: {{ inc.est_restoration }}{% endif %}
                </p>
                <a href="/neighborhood/{{ inc.city_slug }}/emergency-safety/" class="emergency-alert-city-link">View {{ inc.city_name }} Outage Map &rarr;</a>
              </article>
            {% endfor %}
          {% else %}
            <p class="emergency-drawer-empty">No active utility power outages detected across King and Snohomish Counties.</p>
          {% endif %}
        </div>
      </details>

      {# 4. EARTHQUAKES (#EA580C Burnt Orange) #}
      <details id="earthquakes" class="emergency-acc-item {% if quake_cnt > 0 %}is-alert-earthquake{% endif %}" {% if quake_cnt > 0 %}open{% endif %}>
        <summary class="emergency-acc-summary">
          <div class="emergency-acc-lead">
            <span class="emergency-acc-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12h5l2-5 3 10 3-10 2 5h5"/>
              </svg>
            </span>
            <span class="emergency-acc-title">Earthquakes</span>
          </div>

          <div class="emergency-acc-status-group">
            <span class="emergency-status-indicator">
              <span class="emergency-status-dot {% if quake_cnt > 0 %}dot-earthquake{% else %}dot-optimal{% endif %}" aria-hidden="true"></span>
              <span class="emergency-status-text {% if quake_cnt > 0 %}text-earthquake{% endif %}">
                {% if quake_cnt > 0 %}
                  {{ quake_cnt }} Seismic {% if quake_cnt == 1 %}Alert{% else %}Alerts{% endif %}
                {% else %}
                  No active alerts
                {% endif %}
              </span>
            </span>
            <svg class="emergency-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </summary>

        <div class="emergency-acc-drawer">
          {% if quake_cnt > 0 %}
            {% for q in reg_quakes %}
              <article class="emergency-alert-entry">
                <div class="emergency-alert-entry-head">
                  <h3 class="emergency-alert-entry-title">M{{ q.magnitude }} Earthquake &mdash; {{ q.place }}</h3>
                  <span class="emergency-alert-entry-meta">Nearest: {{ q.city_name }} ({{ q.distance_miles }} mi)</span>
                </div>
                {% if q.depth is not none %}<p class="emergency-alert-entry-body">Depth: {{ q.depth | round(1) }} km</p>{% endif %}
                <a href="/neighborhood/{{ q.city_slug }}/emergency-safety/" class="emergency-alert-city-link">View {{ q.city_name }} Seismic Map &rarr;</a>
              </article>
            {% endfor %}
          {% else %}
            <p class="emergency-drawer-empty">No recent felt seismic activity within range of the Puget Sound region.</p>
          {% endif %}
        </div>
      </details>

      {# 5. WILDFIRES (#D9232A PNW Crimson) #}
      <details id="wildfires" class="emergency-acc-item {% if fire_cnt > 0 %}is-alert-wildfire{% endif %}" {% if fire_cnt > 0 %}open{% endif %}>
        <summary class="emergency-acc-summary">
          <div class="emergency-acc-lead">
            <span class="emergency-acc-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M12 2c-.5 2.5-3 5-3 8 0 3.3 2.7 6 6 6s6-2.7 6-6c0-2-1-3.5-2-4.5.5 1.5 0 3.5-1.5 4.5-.5-2-2-3.5-2.5-5.5-.5 1-1 2-1 3-1.5-1-2-3.5-2-5.5z" fill="#DC2626"/>
                <path d="M12 9c-.3 1.5-1.8 3-1.8 4.8 0 2 1.6 3.6 3.6 3.6s3.6-1.6 3.6-3.6c0-1.2-.6-2.1-1.2-2.7.3.9 0 2.1-.9 2.7-.3-1.2-1.2-2.1-1.5-3.3-.3.6-.6 1.2-.6 1.8-.9-.6-1.2-2.1-1.2-3.3z" fill="#FBBF24"/>
              </svg>
            </span>
            <span class="emergency-acc-title">Wildfires</span>
          </div>

          <div class="emergency-acc-status-group">
            <span class="emergency-status-indicator">
              <span class="emergency-status-dot {% if fire_cnt > 0 %}dot-wildfire{% else %}dot-optimal{% endif %}" aria-hidden="true"></span>
              <span class="emergency-status-text {% if fire_cnt > 0 %}text-wildfire{% endif %}">
                {% if fire_cnt > 0 %}
                  {{ fire_cnt }} Wildfire {% if fire_cnt == 1 %}Alert{% else %}Alerts{% endif %}
                {% else %}
                  No active alerts
                {% endif %}
              </span>
            </span>
            <svg class="emergency-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </summary>

        <div class="emergency-acc-drawer">
          {% if fire_cnt > 0 %}
            {% for f in reg_fires %}
              <article class="emergency-alert-entry">
                <div class="emergency-alert-entry-head">
                  <h3 class="emergency-alert-entry-title">{{ f.name }}</h3>
                  <span class="emergency-alert-entry-meta">Nearest: {{ f.city_name }} ({{ f.distance_miles }} mi)</span>
                </div>
                <p class="emergency-alert-entry-body">
                  {{ f.acres }} acres{% if f.containment_percent is not none %} &bull; {{ f.containment_percent }}% contained{% endif %}
                </p>
                <a href="/neighborhood/{{ f.city_slug }}/emergency-safety/" class="emergency-alert-city-link">View {{ f.city_name }} Wildfire Map &rarr;</a>
              </article>
            {% endfor %}
          {% else %}
            <p class="emergency-drawer-empty">No active wildland fire incidents within range of the Puget Sound region.</p>
          {% endif %}
        </div>
      </details>

    </div>
  </section>

  <hr class="section-divider">

  {# ==========================================================================
     SECTION 3: ACTIVE EMERGENCY MAP (Regional Hazards & Outages — No PulsePoint)
     ========================================================================== #}
  <section id="emergency-hazards-map" class="portal-section-widget">
    <h2 class="text-section-title section-title-clean">Active Emergency Map</h2>

    <div class="emergency-map-card">
      <header class="emergency-map-header">
        <h3 class="emergency-map-title">Puget Sound Hazard &amp; Outage Radar</h3>
        <div class="airport-board-filter-group" role="group" aria-label="Emergency Map Layers">
          <button type="button" class="btn-apt-tab {% if school_cnt > 0 %}is-active{% endif %}" data-hazard-toggle="school" aria-pressed="{{ 'true' if school_cnt > 0 else 'false' }}">School Closures</button>
          <button type="button" class="btn-apt-tab {% if weather_cnt > 0 %}is-active{% endif %}" data-hazard-toggle="weather" aria-pressed="{{ 'true' if weather_cnt > 0 else 'false' }}">Severe Weather</button>
          <button type="button" class="btn-apt-tab {% if power_cnt > 0 %}is-active{% endif %}" data-hazard-toggle="power" aria-pressed="{{ 'true' if power_cnt > 0 else 'false' }}">Power Outages</button>
          <button type="button" class="btn-apt-tab {% if quake_cnt > 0 %}is-active{% endif %}" data-hazard-toggle="earthquake" aria-pressed="{{ 'true' if quake_cnt > 0 else 'false' }}">Earthquakes</button>
          <button type="button" class="btn-apt-tab {% if fire_cnt > 0 %}is-active{% endif %}" data-hazard-toggle="wildfire" aria-pressed="{{ 'true' if fire_cnt > 0 else 'false' }}">Wildfires</button>
        </div>
      </header>

      <div class="emergency-map-stage">
        <div id="emergencyMapNode"
             class="emergency-map-canvas"
             data-lat="47.6205"
             data-lng="-122.2500"></div>

        <div class="map-attribution-pill">NWS / USGS / NIFC / SCL / PSE / FlashAlert / ESRI</div>
      </div>
    </div>
  </section>

</main>

<script id="regionalEmergencyPayload" type="application/json">
{{ {
  "school_reports": reg_schools,
  "weather_alerts": reg_weather,
  "power_incidents": reg_power,
  "earthquakes": reg_quakes,
  "wildfires": reg_fires
} | dump | safe }}
</script>

<script>
(function() {
  function initRegionalEmergencyMap() {
    const mapEl = document.getElementById("emergencyMapNode");
    if (!mapEl || typeof L === "undefined") return;

    const mapLat = parseFloat(mapEl.getAttribute("data-lat") || "47.6205");
    const mapLon = parseFloat(mapEl.getAttribute("data-lng") || "-122.2500");

    const map = L.map("emergencyMapNode", {
      center: [mapLat, mapLon],
      zoom: 9,
      scrollWheelZoom: false
    });

    L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}", {
      attribution: "Esri, HERE, Garmin",
      maxZoom: 16
    }).addTo(map);

    L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Reference/MapServer/tile/{z}/{y}/{x}", {
      maxZoom: 16,
      pane: "overlayPane"
    }).addTo(map);

    let alerts = {};
    const aPayload = document.getElementById("regionalEmergencyPayload");
    if (aPayload) {
      try {
        alerts = JSON.parse(aPayload.textContent) || {};
      } catch (e) {}
    }

    const layers = {
      school: L.layerGroup(),
      weather: L.layerGroup(),
      power: L.layerGroup(),
      earthquake: L.layerGroup(),
      wildfire: L.layerGroup()
    };

    const framingBounds = L.latLngBounds([]);
    let hasGeometryBounds = false;

    function makePin(pinClass, svgInner) {
      return L.divIcon({
        className: "emergency-marker-divicon",
        html: `<div class="emergency-map-pin ${pinClass}">${svgInner}</div>`,
        iconSize: [0, 0],
        iconAnchor: [0, 0]
      });
    }

    /* 1. School Closures (#F59E0B Amber Gold) */
    const schoolReports = Array.isArray(alerts.school_reports) ? alerts.school_reports : [];
    schoolReports.forEach(rep => {
      if (rep.scope === "school" && rep.latitude && rep.longitude) {
        const icon = makePin("pin-school", '<svg width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 14 L16 8 L28 14 Z"/><rect x="6" y="14" width="20" height="14" rx="1"/></svg>');
        const m = L.marker([rep.latitude, rep.longitude], { icon }).bindPopup(`<strong>${rep.school_name || rep.org_name}</strong><br>${rep.detail || ""}`);
        layers.school.addLayer(m);
        framingBounds.extend([rep.latitude, rep.longitude]);
        hasGeometryBounds = true;
      } else if (rep.geometry) {
        const poly = L.geoJSON(rep.geometry, {
          style: { color: "#D97706", weight: 2, fillColor: "#F59E0B", fillOpacity: 0.16 }
        }).bindPopup(`<strong>${rep.org_name}</strong><br>${rep.detail || ""}`);
        layers.school.addLayer(poly);
        framingBounds.extend(poly.getBounds());
        hasGeometryBounds = true;
      }
    });

    /* 2. Severe Weather (#7C3AED Electric Violet) */
    const weatherList = Array.isArray(alerts.weather_alerts) ? alerts.weather_alerts : [];
    weatherList.forEach(wx => {
      if (wx.geometry) {
        const poly = L.geoJSON(wx.geometry, {
          style: { color: "#7C3AED", weight: 2, fillColor: "#7C3AED", fillOpacity: 0.15 }
        }).bindPopup(`<strong>${wx.event}</strong><br>${wx.headline || ""}`);
        layers.weather.addLayer(poly);
        framingBounds.extend(poly.getBounds());
        hasGeometryBounds = true;
      }
    });

    /* 3. Power Outages (#0284C7 Electric Blue) */
    const powerList = Array.isArray(alerts.power_incidents) ? alerts.power_incidents : [];
    powerList.forEach(inc => {
      const cust = Number(inc.customers_affected || 0);
      const popupHtml = `<strong>${inc.provider} (${cust} Customers)</strong><br>Cause: ${inc.cause || "Investigating"}`;
      if (cust >= 10 && inc.geometry) {
        const poly = L.geoJSON(inc.geometry, {
          style: { color: "#0284C7", weight: 2, fillColor: "#0284C7", fillOpacity: 0.22 }
        }).bindPopup(popupHtml);
        layers.power.addLayer(poly);
        framingBounds.extend(poly.getBounds());
        hasGeometryBounds = true;
      } else if (inc.latitude && inc.longitude) {
        const icon = makePin("pin-power", '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg>');
        const m = L.marker([inc.latitude, inc.longitude], { icon }).bindPopup(popupHtml);
        layers.power.addLayer(m);
        framingBounds.extend([inc.latitude, inc.longitude]);
        hasGeometryBounds = true;
      }
    });

    /* 4. Earthquakes (#EA580C Burnt Orange) */
    const quakeList = Array.isArray(alerts.earthquakes) ? alerts.earthquakes : [];
    quakeList.forEach(q => {
      if (!q.latitude || !q.longitude) return;
      const icon = makePin("pin-earthquake", '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M2 12h5l2-5 3 10 3-10 2 5h5"/></svg>');
      const m = L.marker([q.latitude, q.longitude], { icon })
        .bindPopup(`<strong>M${q.magnitude} Earthquake</strong><br>${q.place || ""}<br>${q.distance_miles} mi away`);
      layers.earthquake.addLayer(m);
      framingBounds.extend([q.latitude, q.longitude]);
      hasGeometryBounds = true;
    });

    /* 5. Wildfires (#D9232A PNW Crimson) */
    const fireList = Array.isArray(alerts.wildfires) ? alerts.wildfires : [];
    fireList.forEach(f => {
      if (!f.latitude || !f.longitude) return;
      const icon = makePin("pin-wildfire", '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-.5 2.5-3 5-3 8 0 3.3 2.7 6 6 6s6-2.7 6-6c0-2-1-3.5-2-4.5.5 1.5 0 3.5-1.5 4.5-.5-2-2-3.5-2.5-5.5-.5 1-1 2-1 3-1.5-1-2-3.5-2-5.5z"/></svg>');
      const m = L.marker([f.latitude, f.longitude], { icon })
        .bindPopup(`<strong>${f.name}</strong><br>${f.acres} acres &bull; ${f.distance_miles} mi away`);
      layers.wildfire.addLayer(m);
      framingBounds.extend([f.latitude, f.longitude]);
      hasGeometryBounds = true;
    });

    const activeState = {
      school: schoolReports.length > 0,
      weather: weatherList.length > 0,
      power: powerList.length > 0,
      earthquake: quakeList.length > 0,
      wildfire: fireList.length > 0
    };

    Object.keys(activeState).forEach(key => {
      if (activeState[key]) layers[key].addTo(map);
    });

    document.querySelectorAll("[data-hazard-toggle]").forEach(btn => {
      btn.addEventListener("click", function() {
        const key = btn.getAttribute("data-hazard-toggle");
        activeState[key] = !activeState[key];
        btn.classList.toggle("is-active", activeState[key]);
        btn.setAttribute("aria-pressed", activeState[key] ? "true" : "false");
        if (activeState[key]) layers[key].addTo(map);
        else map.removeLayer(layers[key]);
      });
    });

    if (hasGeometryBounds && framingBounds.isValid()) {
      map.fitBounds(framingBounds, { padding: [32, 32], maxZoom: 11 });
    }
  }

  if (typeof L !== "undefined") {
    initRegionalEmergencyMap();
  } else {
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
    document.head.appendChild(link);
    const script = document.createElement("script");
    script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
    script.onload = initRegionalEmergencyMap;
    document.body.appendChild(script);
  }
})();
</script>