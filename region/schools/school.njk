---
layout: layouts/base.njk
pagination:
  data: ospi_school_data.schools
  size: 1
  addAllPagesToCollections: true
  alias: school
permalink: "/region/schools/{{ school.district_name | slugify }}/{{ school.school_name | slugify }}/index.html"
eleventyComputed:
  title: "{{ school.school_name }} — {{ school.district_name }} | MySeattleSearch"
  meta_description: "{{ school.school_name }} in {{ school.district_name }}, WA: campus address, PSAI score, and OSPI math, ELA, and science proficiency metrics."
---

{% set district_slug = school.district_name | slugify %}
{% set school_slug = school.school_name | slugify %}
{% set parent_district = ospi_school_data.districts[school.district_name] if (ospi_school_data and ospi_school_data.districts) else null %}
{% set resolved_website = school.website_url if school.website_url else (parent_district.website_url if parent_district else "") %}

<main class="layout-container layout-stack-main">

  {# ==========================================================================
     SECTION 1: PAGE HEADER
     ========================================================================== #}
  <div id="school-hero" class="portal-section-header">
    <div class="hero-header-minimal">
      <span class="text-overline text-accent-alpine">{{ school.district_name | upper }} &bull; {{ (school.county or "Puget Sound") | upper }} COUNTY</span>
      <h1 class="hero-title-primary">{{ school.school_name }}</h1>
      <p class="hero-subtitle-secondary">
        {% if school.address %}{{ school.address }}{% if school.city %}, {{ school.city }}{% endif %}{% if school.zip %} {{ school.zip }}{% endif %}{% else %}{{ school.city or school.district_name }}{% endif %}
      </p>
    </div>
  </div>

  {# ==========================================================================
     SECTION 2: NAVIGATION
     ========================================================================== #}
  <section id="school-navigation" class="portal-section-nav" aria-label="Regional Navigation">
    <span class="text-overline text-accent-alpine section-overline-lead">
      EXPLORE DISTRICT &amp; REGIONAL PORTALS
    </span>
    <div class="neighborhood-nav-container">
      <nav class="neighborhood-nav-track" tabindex="0" aria-label="Regional Navigation Links">
        <a href="/" class="neighborhood-nav-pill is-inactive">Neighborhood Home</a>
        <a href="/region/schools/{{ district_slug }}/" class="neighborhood-nav-pill is-inactive">School District Home</a>
        <a href="/region/schools/" class="neighborhood-nav-pill is-inactive">All Regional Schools</a>
        <a href="/sports/pro/" class="neighborhood-nav-pill is-inactive">Pro Sports</a>
        <a href="/sports/minor/" class="neighborhood-nav-pill is-inactive">Minor League Sports</a>
        <a href="/sports/college/" class="neighborhood-nav-pill is-inactive">College Sports</a>
      </nav>
    </div>
  </section>

  <hr class="section-divider">

  {# ==========================================================================
     SECTION 3: ABOUT CAMPUS (PSAI Ranking + Official School Website Link)
     ========================================================================== #}
  <section id="about-school" class="portal-section-widget" aria-label="About {{ school.school_name }}">
    <div class="realestate-section-head">
      <h2 class="text-section-title section-title-clean">About {{ school.school_name }}</h2>
      {% if resolved_website %}
        <a href="{{ resolved_website }}" class="municipal-ext-pill" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          <span>Official {{ school.school_name }} Website</span>
        </a>
      {% endif %}
    </div>

    {% set school_district_name = school.school_name %}
    {% set school_psai_score = school.psai_score %}
    {% set school_math_prof = (school.latest_math_pct ~ "%") if school.latest_math_pct is not none else "—" %}
    {% set school_ela_prof = (school.latest_ela_pct ~ "%") if school.latest_ela_pct is not none else "—" %}
    {% set school_science_prof = (school.latest_science_pct ~ "%") if school.latest_science_pct is not none else "—" %}
    {% set school_total_count = school.district_name %}
    {% set school_portal_url = "/region/schools/" ~ district_slug ~ "/" %}
    {% include "components/widget/region-school-ranking.njk" %}
  </section>

</main>
