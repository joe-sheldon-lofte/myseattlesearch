<script>
    let isTaxManual = false;
    let autocompleteDebounceTimer = null;

    document.addEventListener('DOMContentLoaded', () => {
        const today = new Date();
         
        const defaultClosing = new Date();
        defaultClosing.setDate(today.getDate() + 30);
        
        const monthStr = String(defaultClosing.getMonth() + 1).padStart(2, '0');
        const dayStr = String(defaultClosing.getDate()).padStart(2, '0');
        document.getElementById('inClosingDate').value = `${defaultClosing.getFullYear()}-${monthStr}-${dayStr}`;

        const currentYear = today.getFullYear();
        const aprilDueLimit = new Date(currentYear, 3, 30);
        const octoberDueLimit = new Date(currentYear, 9, 31);

        if (today > aprilDueLimit) {
            document.getElementById('chkFirstHalf').checked = true;
        }
        if (today > octoberDueLimit) {
            document.getElementById('chkSecondHalf').checked = true;
        }

        document.addEventListener('click', (e) => {
            const suggestionsBox = document.getElementById('addressSuggestions');
            if (!document.getElementById('inSellerAddress').contains(e.target) && !suggestionsBox.contains(e.target)) {
                suggestionsBox.style.display = 'none';
            }
        });

        const params = new URLSearchParams(window.location.search);
        if (params.has('p') || params.has('n') || params.has('ad')) {
            if (params.get('n')) document.getElementById('inSellerName').value = params.get('n');
            if (params.get('ad')) document.getElementById('inSellerAddress').value = params.get('ad');
            if (params.get('p')) {
                const priceVal = parseInt(params.get('p'), 10);
                if (!isNaN(priceVal)) document.getElementById('inPrice').value = priceVal.toLocaleString('en-US');
            }
            if (params.get('b1')) {
                const val = parseInt(params.get('b1'), 10);
                if (!isNaN(val)) document.getElementById('inBalance').value = val.toLocaleString('en-US');
            }
            if (params.get('b2')) {
                const val = parseInt(params.get('b2'), 10);
                if (!isNaN(val)) document.getElementById('inBalance2').value = val.toLocaleString('en-US');
            }
            if (params.get('t')) {
                const val = parseInt(params.get('t'), 10);
                if (!isNaN(val)) {
                    document.getElementById('inAnnualTax').value = val.toLocaleString('en-US');
                    isTaxManual = true;
                }
            }
            if (params.get('l')) document.getElementById('inListingComm').value = params.get('l');
            if (params.get('b')) document.getElementById('inBuyerComm').value = params.get('b');
            if (params.get('c')) {
                const val = parseInt(params.get('c'), 10);
                if (!isNaN(val)) document.getElementById('inCreditAmount').value = val.toLocaleString('en-US');
            }
            if (params.get('pi') === '1') document.getElementById('chkPreInspect').checked = true;
            if (params.get('h1') === '1') document.getElementById('chkFirstHalf').checked = true;
            if (params.get('h2') === '1') document.getElementById('chkSecondHalf').checked = true;
            if (params.get('d')) document.getElementById('inClosingDate').value = params.get('d');
            
            calculateProjections();
        }
    });

    function markTaxAsManual() {
        isTaxManual = true;
    }

    function formatCurrencyInput(inputNode) {
        let numericValue = inputNode.value.replace(/[^0-9]/g, '');
        if (numericValue === '') {
            inputNode.value = '';
            return;
        }
        let parsedNumber = parseInt(numericValue, 10);
        inputNode.value = parsedNumber.toLocaleString('en-US');

        if (inputNode.id === 'inPrice' && !isTaxManual) {
            let autoEstimatedTax = Math.round(parsedNumber * 0.01);
            document.getElementById('inAnnualTax').value = autoEstimatedTax.toLocaleString('en-US');
        }
    }

    function parseFormattedNumber(elementId) {
        let node = document.getElementById(elementId);
        if (!node) return 0;
        let cleanStr = node.value.replace(/[^0-9.]/g, '');
        let floatVal = parseFloat(cleanStr);
        return isNaN(floatVal) ? 0 : floatVal;
    }

    function formatCurrency(num) {
        let isNegative = num < 0;
        let absVal = Math.abs(num);
        let formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(absVal);
        return isNegative ? `(${formatted})` : formatted;
    }

    function calculateWashingtonStateREET(salePrice, countyName) {
        let totalReetTax = 0;
        let tier1Limit = 525000;
        let tier2Limit = 1525000;
        let tier3Limit = 3025000;

        let localRate = 0.0050; 
        if (countyName === 'Snohomish' || countyName === 'Pierce' || countyName === 'Kitsap') {
            localRate = 0.0050;
        } else if (countyName === 'King') {
            localRate = 0.0050;
        }

        if (salePrice <= tier1Limit) {
            totalReetTax += salePrice * (0.0110 + localRate);
        } else if (salePrice <= tier2Limit) {
            totalReetTax += tier1Limit * (0.0110 + localRate);
            totalReetTax += (salePrice - tier1Limit) * (0.0128 + localRate);
        } else if (salePrice <= tier3Limit) {
            totalReetTax += tier1Limit * (0.0110 + localRate);
            totalReetTax += (tier2Limit - tier1Limit) * (0.0128 + localRate);
            totalReetTax += (salePrice - tier2Limit) * (0.0275 + localRate);
        } else {
            totalReetTax += tier1Limit * (0.0110 + localRate);
            totalReetTax += (tier2Limit - tier1Limit) * (0.0128 + localRate);
            totalReetTax += (tier3Limit - tier2Limit) * (0.0275 + localRate);
            totalReetTax += (salePrice - tier3Limit) * (0.0300 + localRate);
        }

        return totalReetTax;
    }

    function calculateProjections() {
        const sellerName = document.getElementById('inSellerName').value.trim();
        const sellerAddress = document.getElementById('inSellerAddress').value.trim();
        const price = parseFormattedNumber('inPrice');
        const firstBal = parseFormattedNumber('inBalance');
        const secondBal = parseFormattedNumber('inBalance2');
        const listingCommPct = parseFloat(document.getElementById('inListingComm').value) || 0;
        const buyerCommPct = parseFloat(document.getElementById('inBuyerComm').value) || 0;
        const buyerCredit = parseFormattedNumber('inCreditAmount');
        const annualTax = parseFormattedNumber('inAnnualTax');
        const titleEscrowFee = parseFormattedNumber('inEscrowFee');
        const miscFees = parseFormattedNumber('inMiscFees');
        const preInspectChecked = document.getElementById('chkPreInspect').checked;
        const countyName = document.getElementById('inCountySelect').value;
        const closingDateVal = document.getElementById('inClosingDate').value;

        if (price <= 0) {
            alert('Please enter a target sale price to calculate proceeds.');
            return;
        }

        const listingCommDollar = price * (listingCommPct / 100);
        const buyerCommDollar = price * (buyerCommPct / 100);
        const totalCommissionDollar = listingCommDollar + buyerCommDollar;

        const stateLocalReetTax = calculateWashingtonStateREET(price, countyName);

        let closingDate = closingDateVal ? new Date(closingDateVal + 'T00:00:00') : new Date();
        let dayOfYear = Math.floor((closingDate - new Date(closingDate.getFullYear(), 0, 0)) / (1000 * 60 * 60 * 24));
        let dailyTaxRate = annualTax / 365;
        let sellerTaxObligationYTD = dailyTaxRate * dayOfYear;

        const firstHalfPaid = document.getElementById('chkFirstHalf').checked;
        const secondHalfPaid = document.getElementById('chkSecondHalf').checked;

        let taxAlreadyPaidBySeller = 0;
        if (firstHalfPaid) taxAlreadyPaidBySeller += (annualTax / 2);
        if (secondHalfPaid) taxAlreadyPaidBySeller += (annualTax / 2);

        let taxProrationNetDebitOrCredit = sellerTaxObligationYTD - taxAlreadyPaidBySeller;

        let preInspectCost = preInspectChecked ? 450 : 0;
        let hoaCertCost = miscFees;
        let otherAmt1 = 0;
        let otherLabel1 = "";
        let otherAmt2 = 0;
        let otherLabel2 = "";

        let totalEncumbrancesAndPayoffs = firstBal + secondBal;

        let totalCostsTally = totalEncumbrancesAndPayoffs + 
                                totalCommissionDollar + 
                                stateLocalReetTax + 
                                buyerCredit + 
                                titleEscrowFee + 
                                preInspectCost + 
                                hoaCertCost;

        if (taxProrationNetDebitOrCredit > 0) {
            totalCostsTally += taxProrationNetDebitOrCredit;
        }

        let totalCreditsTally = price;
        if (taxProrationNetDebitOrCredit < 0) {
            totalCreditsTally += Math.abs(taxProrationNetDebitOrCredit);
        }

        const finalNetCashToSeller = totalCreditsTally - totalCostsTally;

        document.getElementById('txtNetProceeds').textContent = formatCurrency(finalNetCashToSeller);
        document.getElementById('printSellerName').textContent = sellerName ? sellerName : "Client Profile";
        document.getElementById('printSellerAddress').textContent = sellerAddress ? sellerAddress : "Not Specified";

        const tbody = document.getElementById('ledgerTableBody');
        let ledgerBuffer = `
            <tr class="section-row"><td colspan="3">Target Sale Consideration</td></tr>
            <tr>
                <td>Agreed Target Purchase Sale Price</td>
                <td class="val-credit">${formatCurrency(price)}</td>
                <td class="val-cost">$0</td>
            </tr>
            <tr class="section-row"><td colspan="3">Existing Loan Payoffs &amp; Encumbrances</td></tr>
            <tr>
                <td>1st Position Mortgage Payoff (Estimated)</td>
                <td>$0</td>
                <td class="val-cost">${formatCurrency(firstBal)}</td>
            </tr>
            <tr>
                <td>2nd Position Loan / HELOC Payoff (Estimated)</td>
                <td>$0</td>
                <td class="val-cost">${formatCurrency(secondBal)}</td>
            </tr>
            <tr class="section-row"><td colspan="3">Brokerage Commissions &amp; Seller Credits</td></tr>
            <tr>
                <td>Listing Brokerage Fee (${listingCommPct}%)</td>
                <td>$0</td>
                <td class="val-cost">${formatCurrency(listingCommDollar)}</td>
            </tr>
            <tr>
                <td>Buyer Brokerage Fee (${buyerCommPct}%)</td>
                <td>$0</td>
                <td class="val-cost">${formatCurrency(buyerCommDollar)}</td>
            </tr>
            <tr>
                <td>Buyer Closing Cost Concession / Credit</td>
                <td>$0</td>
                <td class="val-cost">${formatCurrency(buyerCredit)}</td>
            </tr>
            <tr class="section-row"><td colspan="3">Government Taxes &amp; Title Escrow Settlement Outlays</td></tr>
            <tr>
                <td>Washington State REET Excise Tax (${countyName})</td>
                <td>$0</td>
                <td class="val-cost">${formatCurrency(stateLocalReetTax)}</td>
            </tr>
            <tr>
                <td>Title Insurance &amp; Escrow Closing Settlement Fee</td>
                <td>$0</td>
                <td class="val-cost">${formatCurrency(titleEscrowFee)}</td>
            </tr>
        `;

        if (taxProrationNetDebitOrCredit > 0) {
            ledgerBuffer += `
                <tr>
                    <td>Property Tax Proration Adjustment (Debit to Seller for Unpaid Days)</td>
                    <td>$0</td>
                    <td class="val-cost">${formatCurrency(taxProrationNetDebitOrCredit)}</td>
                </tr>
            `;
        } else if (taxProrationNetDebitOrCredit < 0) {
            ledgerBuffer += `
                <tr>
                    <td>Property Tax Proration Adjustment (Credit to Seller for Prepaid Days)</td>
                    <td class="val-credit">${formatCurrency(Math.abs(taxProrationNetDebitOrCredit))}</td>
                    <td class="val-cost">$0</td>
                </tr>
            `;
        } else {
            ledgerBuffer += `
                <tr>
                    <td>Property Tax Proration Adjustment (Balanced YTD)</td>
                    <td>$0</td>
                    <td>$0</td>
                </tr>
            `;
        }

        if ((preInspectChecked && preInspectCost > 0) || (hoaCertChecked && hoaCertCost > 0) || otherAmt1 > 0 || otherAmt2 > 0) {
            ledgerBuffer += `<tr class="section-row"><td colspan="3">Additional Settlement Details</td></tr>`;
            if (preInspectChecked && preInspectCost > 0) {
                ledgerBuffer += `<tr><td>Pre-inspection Expense</td><td>$0</td><td class="val-cost">${formatCurrency(preInspectCost)}</td></tr>`;
            }
            if (hoaCertChecked && hoaCertCost > 0) {
                ledgerBuffer += `<tr><td>HOA Resale Certificate Expense</td><td>$0</td><td class="val-cost">${formatCurrency(hoaCertCost)}</td></tr>`;
            }
            if (otherAmt1 > 0) {
                ledgerBuffer += `<tr><td>Additional Expense: ${otherLabel1}</td><td>$0</td><td class="val-cost">${formatCurrency(otherAmt1)}</td></tr>`;
            }
            if (otherAmt2 > 0) {
                ledgerBuffer += `<tr><td>Additional Expense: ${otherLabel2}</td><td>$0</td><td class="val-cost">${formatCurrency(otherAmt2)}</td></tr>`;
            }
        }

        ledgerBuffer += `
            <tr class="total-summary-row">
                <td><strong>Total Summary Tallies</strong></td>
                <td class="val-credit"><strong>${formatCurrency(totalCreditsTally)}</strong></td>
                <td class="val-cost"><strong>${formatCurrency(totalCostsTally)}</strong></td>
            </tr>
            <tr class="section-row" style="background: var(--dynamic-bg-highlight) !important;">
                <td style="font-size: 1.05rem; font-weight: 900; color: var(--card-accent-color);">ESTIMATED NET CASH TO SELLER</td>
                <td colspan="2" style="text-align: right; font-size: 1.25rem; font-weight: 900; color: var(--card-accent-color); padding-right: 1rem;">
                    ${formatCurrency(finalNetCashToSeller)}
                </td>
            </tr>
        `;
        tbody.innerHTML = ledgerBuffer;
        document.getElementById('resultsWrapper').style.display = 'block';
        document.getElementById('resultsWrapper').scrollIntoView({ behavior: 'smooth' });
    }

    function triggerWorksheetPrint() {
        calculateProjections();
        const currentUrl = buildShareableUrlString();
        const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(currentUrl)}`;
        document.getElementById('printQrCodeImg').src = qrApiUrl;

        setTimeout(() => {
            window.print();
        }, 300);
    }

    function buildShareableUrlString() {
        const name = encodeURIComponent(document.getElementById('inSellerName').value.trim());
        const address = encodeURIComponent(document.getElementById('inSellerAddress').value.trim());
        const price = parseFormattedNumber('inPrice');
        const b1 = parseFormattedNumber('inBalance');
        const b2 = parseFormattedNumber('inBalance2');
        const tax = parseFormattedNumber('inAnnualTax');
        const listComm = document.getElementById('listingComm') ? document.getElementById('listingComm').value : document.getElementById('inListingComm').value;
        const buyComm = document.getElementById('buyerComm') ? document.getElementById('buyerComm').value : document.getElementById('inBuyerComm').value;
        const credit = parseFormattedNumber('inCreditAmount');
        const pi = document.getElementById('chkPreInspect').checked ? '1' : '0';
        const h1 = document.getElementById('chkFirstHalf').checked ? '1' : '0';
        const h2 = document.getElementById('chkSecondHalf').checked ? '1' : '0';
        const dateVal = document.getElementById('inClosingDate').value;

        const baseUrl = window.location.origin + window.location.pathname;
        return `${baseUrl}?n=${name}&ad=${address}&p=${price}&b1=${b1}&b2=${b2}&t=${tax}&l=${listComm}&b=${buyComm}&c=${credit}&pi=${pi}&h1=${h1}&h2=${h2}&d=${dateVal}`;
    }

    function copyShareableWorksheetLink() {
        calculateProjections();
        const link = buildShareableUrlString();
        navigator.clipboard.writeText(link).then(() => {
            alert('Custom worksheet scenario link copied to clipboard!');
        }).catch(err => {
            alert('Could not copy link automatically. URL is: ' + link);
        });
    }

    function handleAddressAutocompleteSearch(inputNode) {
        const query = inputNode.value.trim();
        const suggestionsBox = document.getElementById('addressSuggestions');

        if (query.length < 3) {
            suggestionsBox.style.display = 'none';
            return;
        }

        clearTimeout(autocompleteDebounceTimer);
        autocompleteDebounceTimer = setTimeout(() => {
            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=us&limit=5`)
                .then(res => res.json())
                .then(data => {
                    if (!data || data.length === 0) {
                        suggestionsBox.style.display = 'none';
                        return;
                    }

                    let suggestionsHtml = '';
                    data.forEach(item => {
                        suggestionsHtml += `<div class="suggestion-item" onclick="selectAddressSuggestion('${item.display_name.replace(/'/g, "\\'")}')">${item.display_name}</div>`;
                    });

                    suggestionsBox.innerHTML = suggestionsHtml;
                    suggestionsBox.style.display = 'block';
                })
                .catch(() => {
                    suggestionsBox.style.display = 'none';
                });
        }, 300);
    }

    function selectAddressSuggestion(addressString) {
        document.getElementById('inSellerAddress').value = addressString;
        document.getElementById('addressSuggestions').style.display = 'none';
    }
</script>