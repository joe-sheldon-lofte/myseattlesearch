---
layout: layouts/base.njk
permalink: "/neighborhood/region/news/index.html"
title: "Regional News Across Puget Sound | MySeattleSearch"
---
{% set city_slug = "region" %}
{% set active_neighborhood = "Puget Sound Region" %}

<main class="layout-container layout-stack-main">

  {# ==========================================================================
     SECTION 1: CANONICAL REGIONAL HERO HEADER & EXPLORE DOCK
     ========================================================================== #}
  <div id="neighborhood-hero" class="portal-section-header">
    {% set city = { "City": "Puget Sound Region" } %}
    {% set hero_welcome_label = "King & Snohomish Counties" %}
    {% set subpage_title = "Regional News" %}
    {% include "components/widget/neighborhood-subpage-header.njk" %}
  </div>

  <section id="explore-neighborhood" class="portal-section-nav" aria-label="Explore {{ active_neighborhood }}">
    <span class="text-overline text-accent-alpine section-overline-lead">
      EXPLORE {{ active_neighborhood | upper }}
    </span>
    <div class="neighborhood-nav-container">
      <nav class="neighborhood-nav-track" tabindex="0" aria-label="{{ active_neighborhood }} Subpages">
        <a href="/neighborhood/region/" class="neighborhood-nav-pill is-inactive">Regional Home</a>
        <a href="/neighborhood/region/events/" class="neighborhood-nav-pill is-inactive">Regional Events</a>
        <a href="/neighborhood/region/emergency-safety/" class="neighborhood-nav-pill is-inactive">Emergency &amp; Safety</a>
        <a href="/neighborhood/region/transit-commute/" class="neighborhood-nav-pill is-inactive">Regional Transit</a>
        <a href="/sports/pro/" class="neighborhood-nav-pill is-inactive">Pro Sports</a>
      </nav>
    </div>
  </section>

  <hr class="section-divider">

  {# ==========================================================================
     SECTION 2: LATEST NEWS ACROSS PUGET SOUND (Category-Filtered News Wire)
     ========================================================================== #}
  {% set location_tag_exclusions = [
    "seattle", "eastside", "north-sound", "south-king", "snohomish-county", "king-county", "pierce-county", "all"
  ] %}
  {% set city_slug_exclusions = [] %}
  {% if city_data %}
    {% for c_row in city_data %}
      {% if c_row.City %}
        {% set _ = city_slug_exclusions.push(c_row.City | slugify) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% set matched_news = [] %}
  {% set matched_tag_pool = [] %}

  {% if market_news %}
    {% for article in market_news %}
      {% if article.title and (article.url or article.link) %}
        {% set tag_tokens = [] %}
        {% set has_topical_cat = false %}

        {% if article.tags %}
          {% for t_item in article.tags %}
            {% set t_clean = t_item | trim | lower %}
            {% if t_clean == "goodnews" or t_clean == "good-news" %}
              {% if "goodnews" not in tag_tokens %}{% set _ = tag_tokens.push("goodnews") %}{% endif %}
              {% if "goodnews" not in matched_tag_pool %}{% set _ = matched_tag_pool.push("goodnews") %}{% endif %}
              {% set has_topical_cat = true %}
            {% elif t_clean == "business" %}
              {% if "business" not in tag_tokens %}{% set _ = tag_tokens.push("business") %}{% endif %}
              {% if "business" not in matched_tag_pool %}{% set _ = matched_tag_pool.push("business") %}{% endif %}
              {% set has_topical_cat = true %}
            {% elif t_clean == "real-estate" or t_clean == "realestate" %}
              {% if "real-estate" not in tag_tokens %}{% set _ = tag_tokens.push("real-estate") %}{% endif %}
              {% if "real-estate" not in matched_tag_pool %}{% set _ = matched_tag_pool.push("real-estate") %}{% endif %}
              {% set has_topical_cat = true %}
            {% elif t_clean == "local" or t_clean == "local-news" %}
              {% if "local-news" not in tag_tokens %}{% set _ = tag_tokens.push("local-news") %}{% endif %}
              {% if "local-news" not in matched_tag_pool %}{% set _ = matched_tag_pool.push("local-news") %}{% endif %}
              {% set has_topical_cat = true %}
            {% elif t_clean in ["sports", "entertainment", "politics", "transportation", "tech", "education", "environment", "health"] %}
              {% if t_clean not in tag_tokens %}{% set _ = tag_tokens.push(t_clean) %}{% endif %}
              {% if t_clean not in matched_tag_pool %}{% set _ = matched_tag_pool.push(t_clean) %}{% endif %}
              {% set has_topical_cat = true %}
            {% elif (t_clean in location_tag_exclusions) or (t_clean in city_slug_exclusions) %}
              {% if "local-news" not in tag_tokens %}{% set _ = tag_tokens.push("local-news") %}{% endif %}
              {% if "local-news" not in matched_tag_pool %}{% set _ = matched_tag_pool.push("local-news") %}{% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if not has_topical_cat and ("local-news" not in tag_tokens) %}
          {% set _ = tag_tokens.push("local-news") %}
          {% if "local-news" not in matched_tag_pool %}{% set _ = matched_tag_pool.push("local-news") %}{% endif %}
        {% endif %}

        {% set _ = matched_news.push({
          "title": article.title,
          "url": article.url or article.link,
          "source": article.source,
          "paywall": article.paywall,
          "match_tags": tag_tokens | join(" "),
          "excerpt": article.excerpt,
          "date_formatted": article.date_formatted or article.published
        }) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% set canonical_news_cats = [
    { "slug": "local-news", "label": "Local News" },
    { "slug": "business", "label": "Business" },
    { "slug": "real-estate", "label": "Real Estate" },
    { "slug": "goodnews", "label": "Good News" },
    { "slug": "politics", "label": "Politics & Civic" },
    { "slug": "transportation", "label": "Transit & Traffic" },
    { "slug": "sports", "label": "Sports" },
    { "slug": "entertainment", "label": "Entertainment" },
    { "slug": "tech", "label": "Tech" }
  ] %}

  {% set active_news_tabs = [] %}
  {% for cat in canonical_news_cats %}
    {% if cat.slug in matched_tag_pool %}
      {% set _ = active_news_tabs.push(cat) %}
    {% endif %}
  {% endfor %}

  {% if (matched_news | length) > 0 %}
    <section id="regional-news" class="portal-section-news-events">
      <h2 class="text-section-title section-title-clean">Latest News Across Puget Sound</h2>
      {% set city_name = active_neighborhood %}
      {% set overline_text = "REGIONAL NEWS WIRE" %}
      {% set all_news_heading = "Puget Sound News" %}
      {% set all_news_items = matched_news %}
      {% set news_filter_tabs = active_news_tabs %}
      {% set hide_category_tag = true %}
      {% include "components/widget/news-summary-list-all.njk" %}
    </section>
  {% endif %}

</main>