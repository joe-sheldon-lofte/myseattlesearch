---
layout: layouts/base.njk
pagination:
  data: city_data
  size: 1
  addAllPagesToCollections: true
  alias: city
permalink: "/neighborhood/{{ city.City | slugify }}/news-events/index.html"
---
{% set city_slug = city.City | slugify %}
{% set active_neighborhood = city.City %}
{% set primary_district = city['School District'].split(',')[0] | trim if city['School District'] else '' %}

<main class="layout-container layout-stack-main">

  {# ==========================================================================
     SECTION 1: CANONICAL NEIGHBORHOOD HERO HEADER
     ========================================================================== #}
  <div id="neighborhood-hero" class="portal-section-header">
    {% set hero_img_main = city.HeroImageMain %}
    {% set hero_img_left = city.HeroImageLeft %}
    {% set hero_img_right = city.HeroImageRight %}
    {% set hero_welcome_label = "Welcome to the neighborhood" %}
    {% set subpage_topic = "News & Events" %}
    {% include "components/widget/neighborhood-page-header.njk" %}
  </div>

  {# ==========================================================================
     SECTION 2: EXPLORE NAVIGATION PILLS (Shuffled Subpage Dock)
     ========================================================================== #}
  <section id="explore-neighborhood" class="portal-section-nav" aria-label="Explore {{ active_neighborhood }}">
    <span class="text-overline text-accent-alpine section-overline-lead">
      EXPLORE {{ active_neighborhood | upper }}
    </span>
    <div class="neighborhood-nav-container">
      <nav class="neighborhood-nav-track" tabindex="0" aria-label="{{ active_neighborhood }} Subpages">
        <a href="/neighborhood/{{ city_slug }}/" class="neighborhood-nav-pill is-inactive">City Home</a>
        <a href="/neighborhood/{{ city_slug }}/weather/" class="neighborhood-nav-pill is-inactive">Weather</a>
        <a href="/neighborhood/{{ city_slug }}/transit-commute/" class="neighborhood-nav-pill is-inactive">Transit &amp; Commute</a>
        <a href="/neighborhood/{{ city_slug }}/emergency-safety/" class="neighborhood-nav-pill is-inactive">Emergency &amp; Safety</a>
        <a href="/neighborhood/{{ city_slug }}/municipal/" class="neighborhood-nav-pill is-inactive">Municipal</a>
        <a href="/neighborhood/{{ city_slug }}/real-estate/" class="neighborhood-nav-pill is-inactive">Real Estate</a>
        {% if primary_district %}
          <a href="/neighborhood/school/{{ primary_district | slugify }}/" class="neighborhood-nav-pill is-inactive">School District</a>
        {% endif %}
        <a href="/sports/pro/" class="neighborhood-nav-pill is-inactive">Pro Sports</a>
        <a href="/neighborhood/region/transit-commute/" class="neighborhood-nav-pill is-inactive">Regional Transit</a>
      </nav>
    </div>
  </section>

  <hr class="section-divider">

  {# ==========================================================================
     SECTION 3: FULL NEWS WIRE & COMMUNITY EVENTS (1200px 2-Column Split)
     ========================================================================== #}

  {# 3A. Filter market_news.json strictly by: (1) city_slug, (2) News Region, (3) business / real-estate / goodnews #}
  {% set region_labels = {
    "south-king": "South King",
    "north-sound": "North Sound",
    "eastside": "Eastside",
    "seattle": "Seattle",
    "snohomish-county": "Snohomish County"
  } %}

  {% set region_list = [] %}
  {% if city['News Region'] %}
    {% for r_raw in city['News Region'].split(',') %}
      {% set r_clean = r_raw | trim | lower %}
      {% if r_clean %}
        {% set _ = region_list.push(r_clean) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% set matched_news = [] %}
  {% set matched_tag_pool = [] %}

  {% if market_news %}
    {% for article in market_news %}
      {% set hit_city = false %}
      {% set hit_business = false %}
      {% set hit_realestate = false %}
      {% set hit_goodnews = false %}
      {% set article_regions = [] %}

      {% if article.cities %}
        {% for c_item in article.cities %}
          {% if (c_item | trim | lower) == city_slug %}
            {% set hit_city = true %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if article.tags %}
        {% for t_item in article.tags %}
          {% set t_clean = t_item | trim | lower %}
          {% if t_clean == city_slug %}
            {% set hit_city = true %}
          {% elif t_clean in region_list %}
            {% if t_clean not in article_regions %}
              {% set _ = article_regions.push(t_clean) %}
            {% endif %}
          {% elif t_clean == "business" %}
            {% set hit_business = true %}
          {% elif t_clean == "real-estate" %}
            {% set hit_realestate = true %}
          {% elif t_clean == "goodnews" %}
            {% set hit_goodnews = true %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% set is_news_match = hit_city or ((article_regions | length) > 0) or hit_business or hit_realestate or hit_goodnews %}

      {% if is_news_match and article.title and (article.url or article.link) %}
        {% set tag_tokens = [] %}
        {% if hit_city %}
          {% set _ = tag_tokens.push(city_slug) %}
          {% if city_slug not in matched_tag_pool %}
            {% set _ = matched_tag_pool.push(city_slug) %}
          {% endif %}
        {% endif %}
        {% for ar in article_regions %}
          {% set _ = tag_tokens.push(ar) %}
          {% if ar not in matched_tag_pool %}
            {% set _ = matched_tag_pool.push(ar) %}
          {% endif %}
        {% endfor %}
        {% if hit_business %}
          {% set _ = tag_tokens.push("business") %}
          {% if "business" not in matched_tag_pool %}
            {% set _ = matched_tag_pool.push("business") %}
          {% endif %}
        {% endif %}
        {% if hit_realestate %}
          {% set _ = tag_tokens.push("real-estate") %}
          {% if "real-estate" not in matched_tag_pool %}
            {% set _ = matched_tag_pool.push("real-estate") %}
          {% endif %}
        {% endif %}
        {% if hit_goodnews %}
          {% set _ = tag_tokens.push("goodnews") %}
          {% if "goodnews" not in matched_tag_pool %}
            {% set _ = matched_tag_pool.push("goodnews") %}
          {% endif %}
        {% endif %}

        {% set _ = matched_news.push({
          "title": article.title,
          "url": article.url or article.link,
          "source": article.source,
          "paywall": article.paywall,
          "match_tags": tag_tokens | join(" "),
          "excerpt": article.excerpt,
          "date_formatted": article.date_formatted or article.published
        }) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {# Build dynamic filter pills strictly from matched tags #}
  {% set active_news_tabs = [] %}
  {% if city_slug in matched_tag_pool %}
    {% set _ = active_news_tabs.push({ "slug": city_slug, "label": active_neighborhood }) %}
  {% endif %}
  {% for r_slug in region_list %}
    {% if r_slug in matched_tag_pool %}
      {% set r_label = region_labels[r_slug] if region_labels[r_slug] is defined else (r_slug | replace('-', ' ') | title) %}
      {% set _ = active_news_tabs.push({ "slug": r_slug, "label": r_label }) %}
    {% endif %}
  {% endfor %}
  {% if "business" in matched_tag_pool %}
    {% set _ = active_news_tabs.push({ "slug": "business", "label": "Business" }) %}
  {% endif %}
  {% if "real-estate" in matched_tag_pool %}
    {% set _ = active_news_tabs.push({ "slug": "real-estate", "label": "Real Estate" }) %}
  {% endif %}
  {% if "goodnews" in matched_tag_pool %}
    {% set _ = active_news_tabs.push({ "slug": "goodnews", "label": "Good News" }) %}
  {% endif %}

  {# 3B. Filter public_events_feed.json by: (1) city-[slug], (2) county-[county], (3) "all" #}
  {% set city_tag = "city-" ~ city_slug %}
  {% set county_tags = [] %}
  {% if city.County %}
    {% for co_raw in city.County.split(',') %}
      {% set co_clean = co_raw | trim | lower | replace(' ', '-') %}
      {% if co_clean %}
        {% set _ = county_tags.push("county-" ~ co_clean) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% set events_source = public_events_feed if public_events_feed else public_events %}
  {% set matched_events = [] %}
  {% if events_source %}
    {% for ev in events_source %}
      {% set is_event_match = false %}
      {% set ev_city_clean = (ev.city | trim | lower) if ev.city else '' %}
      {% if ev_city_clean == city_slug or ev_city_clean == (city.City | lower) %}
        {% set is_event_match = true %}
      {% endif %}

      {% if ev.tags %}
        {% for et_item in ev.tags %}
          {% set et_clean = et_item | trim | lower %}
          {% if et_clean == city_tag or (et_clean in county_tags) or et_clean == "all" %}
            {% set is_event_match = true %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if is_event_match and ev.title %}
        {% set _ = matched_events.push({
          "title": ev.title,
          "url": ev.url or ev.link,
          "date": ev.date or ev.display_date,
          "time": ev.time or ev.display_time,
          "location": ev.location,
          "category": (ev.categories[0] if (ev.categories and (ev.categories | length) > 0) else (ev.category or "Community")),
          "desc": ev.desc or ev.excerpt,
          "tags": ev.tags
        }) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if (matched_news | length) > 0 or (matched_events | length) > 0 %}
    <section id="news-events" class="portal-section-news-events">
      <h2 class="text-section-title section-title-clean">{{ active_neighborhood }} News &amp; Events</h2>
      <div class="section-grid-static {% if (matched_news | length) > 0 and (matched_events | length) > 0 %}grid-cols-2{% else %}grid-cols-1{% endif %}">

        {# Left Column: Full Tag-Filtered News Wire #}
        {% if (matched_news | length) > 0 %}
          <div>
            {% set city_name = active_neighborhood %}
            {% set all_news_heading = active_neighborhood ~ " News" %}
            {% set all_news_items = matched_news %}
            {% set news_filter_tabs = active_news_tabs %}
            {% include "components/widget/news-summary-list-all.njk" %}
          </div>
        {% endif %}

        {# Right Column: Full Community Events Schedule #}
        {% if (matched_events | length) > 0 %}
          <div>
            {% set events_city_name = active_neighborhood %}
            {% set events_heading = active_neighborhood ~ " Events" %}
            {% set events_all_data = matched_events %}
            {% include "components/widget/events-summary-list-all.njk" %}
          </div>
        {% endif %}

      </div>
    </section>
  {% endif %}

</main>