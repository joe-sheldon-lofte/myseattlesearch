    </div>

    {# Municipal Civic Calendar & Council Agendas Feeds #}
    {% set city_tag = "city-" ~ city_slug %}
    {% set events_source = public_events_feed if public_events_feed else public_events %}
    {% set municipal_events = [] %}

    {% if events_source %}
      {% for ev in events_source %}
        {% if ev.title and ev.tags %}
          {% set has_city_tag = false %}
          {% set has_muni_tag = false %}
          {% for t in ev.tags %}
            {% if t is string %}
              {% set t_low = t | trim | lower %}
              {% if t_low == city_tag %}{% set has_city_tag = true %}{% endif %}
              {% if t_low == "municipal" %}{% set has_muni_tag = true %}{% endif %}
            {% endif %}
          {% endfor %}

          {% if has_city_tag and has_muni_tag %}
            {% set raw_link = ev.link | default('') | trim %}
            {% set raw_excerpt = ev.excerpt | default('') | trim %}
            {% set resolved_url = raw_link if raw_link.slice(0, 4) == 'http' else (raw_excerpt if raw_excerpt.slice(0, 4) == 'http' else '') %}

            {% set _ = municipal_events.push({
              "title": ev.title,
              "url": resolved_url,
              "date": ev.display_date or ev.date,
              "time": ev.display_time or ev.time,
              "location": ev.location
            }) %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% set council_portal = null %}
    {% set calendar_portal = null %}
    {% if municipal_feeds %}
      {% for f in municipal_feeds %}
        {% if f.City == active_neighborhood and f.Scope == 'city' and f.Active == 'Yes' %}
          {% if not council_portal and f.Category == 'City Council' %}
            {% set council_portal = f %}
          {% endif %}
          {% if not calendar_portal and (f.Category == 'Municipal iCal' or f.Category == 'Community Events' or f.Category == 'Municipal RSS') %}
            {% set calendar_portal = f %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="municipal-meetings-grid">
      <div class="municipal-meeting-card">
        <div>
          <header class="municipal-meeting-header">
            <h3 class="municipal-meeting-title">{{ active_neighborhood }} Civic Calendar</h3>
            {% set cal_fallback = (calendar_portal['Fallback Portal URL'] if calendar_portal else '') or city_web %}
            {% if cal_fallback and cal_fallback != 'NO DATA' %}
              <a href="{{ cal_fallback }}" class="municipal-inline-link" target="_blank" rel="noopener noreferrer">City Calendar &rarr;</a>
            {% endif %}
          </header>

          {% if (municipal_events | length) > 0 %}
            <div class="municipal-events-list">
              {% for mev in municipal_events %}
                {% if loop.index0 < 8 %}
                  {% set href_target = mev.url or cal_fallback %}
                  <a href="{{ href_target }}" class="municipal-event-row" target="_blank" rel="noopener noreferrer">
                    <span class="municipal-event-meta">
                      {{ mev.date }}{% if mev.time and mev.time != '12:00 AM' %} &bull; {{ mev.time }}{% endif %}
                    </span>
                    <span class="municipal-event-name">{{ mev.title }}</span>
                    {% if mev.location %}
                      <span class="municipal-event-loc">{{ mev.location }}</span>
                    {% endif %}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          {% else %}
            <div class="municipal-empty-well">
              <h4 class="municipal-empty-title">No Upcoming Municipal Calendar Items</h4>
              <p class="municipal-empty-desc">
                No scheduled public meetings or civic calendar entries are currently posted for {{ active_neighborhood }}.
              </p>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="municipal-meeting-card">
        <div>
          <header class="municipal-meeting-header">
            <h3 class="municipal-meeting-title">Agendas &amp; Minutes</h3>
            {% if council_portal and council_portal['Fallback Portal URL'] %}
              <a href="{{ council_portal['Fallback Portal URL'] }}" class="municipal-inline-link" target="_blank" rel="noopener noreferrer">
                Legislative Portal &rarr;
              </a>
            {% endif %}
          </header>

          <div class="municipal-empty-well">
            <h4 class="municipal-empty-title">Agenda Feed Not Currently Available</h4>
            <p class="municipal-empty-desc">
              {% if council_portal and council_portal['Fallback Portal URL'] %}
                Direct automated agenda packets are unavailable. View official council packets and minutes on the {{ council_portal['Feed Name'] }}.
              {% else %}
                Direct automated council agenda packets are not currently available for {{ active_neighborhood }}.
              {% endif %}
            </p>
            {% if council_portal and council_portal['Fallback Portal URL'] %}
              <a href="{{ council_portal['Fallback Portal URL'] }}" class="municipal-portal-cta" target="_blank" rel="noopener noreferrer">
                Open {{ council_portal['Feed Name'] }} &rarr;
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

{% if show_tides %}
<script id="weatherTidesPayload" type="application/json">
[
  {% for p in tide_list %}
    {% if loop.index0 < 16 %}
      {{ p | dump | safe }}{% if not loop.last and loop.index0 < 15 %},{% endif %}
    {% endif %}
  {% endfor %}
]
</script>
{% endif %}

<script id="ferrySchedulesPayload" type="application/json">
[
  {% if ferry_schedules and ferry_schedules.routes %}
    {% for r_key, r_obj in ferry_schedules.routes %}
      {
        "slug": {{ r_obj.route_slug | dump | safe }},
        "routeId": {{ r_obj.route_id }},
        "description": {{ r_obj.description | dump | safe }},
        "vessels": {{ r_obj.assigned_vessels | dump | safe }},
        "disruptions": {{ (r_obj.service_disruptions or []) | dump | safe }},
        "terminals": [
          {% for t in r_obj.terminals %}
            { "id": {{ t.terminal_id }}, "name": {{ t.name | dump | safe }}, "lat": {{ t.latitude }}, "lon": {{ t.longitude }} }{% if not loop.last %},{% endif %}
          {% endfor %}
        ],
        "sailings": [
          {% for d_key, d_obj in r_obj.schedules %}
            {% for s in d_obj.sailings %}
              {
                "fromId": {{ s.departing_terminal_id }},
                "from": {{ s.departing_terminal_name | dump | safe }},
                "toId": {{ s.arriving_terminal_id }},
                "to": {{ s.arriving_terminal_name | dump | safe }},
                "dep": {{ s.departing_time | dump | safe }},
                "vessel": {{ (s.vessel_name or "") | dump | safe }}
              },
            {% endfor %}
          {% endfor %}
          null
        ]
      }{% if not loop.last %},{% endif %}
    {% endfor %}
  {% endif %}
]
</script>

<script>
(function() {
  var apiBase = "https://livedata.myseattlesearch.com/api";
  var mapLat = parseFloat("{{ city.Latitude | default(47.6062) }}");
  var mapLon = parseFloat("{{ city.Longitude | default(-122.3321) }}");
  var loadNow = new Date();
  var loadMins = loadNow.getHours() * 60 + loadNow.getMinutes();

  function haversineMiles(lat1, lon1, lat2, lon2) {
    var toRad = function(d) { return d * Math.PI / 180; };
    var R = 3958.8;
    var dLat = toRad(lat2 - lat1);
    var dLon = toRad(lon2 - lon1);
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  /* 1. Sync Sunrise & Sunset Dial to Page-Load Clock */
  var solarTile = document.getElementById("weatherSolarTile");
  var solarMarker = document.getElementById("weatherSolarMarker");
  if (solarTile && solarMarker) {
    var riseM = parseInt(solarTile.getAttribute("data-rise-mins"), 10);
    var setM = parseInt(solarTile.getAttribute("data-set-mins"), 10);
    if (!isNaN(riseM) && !isNaN(setM) && setM > riseM) {
      var angle = 90;
      if (loadMins >= riseM && loadMins <= setM) {
        angle = ((loadMins - riseM) / (setM - riseM)) * 180;
      } else {
        var nightDur = (1440 - setM) + riseM;
        var elapsed = loadMins > setM ? (loadMins - setM) : ((1440 - setM) + loadMins);
        angle = 180 + (elapsed / nightDur) * 180;
      }
      solarMarker.setAttribute("transform", "rotate(" + angle.toFixed(1) + ", 50, 50)");
    }
  }

  /* 2. Sync Marine Tides Card to Upcoming Predictions at Page Load */
  var tideRaw = document.getElementById("weatherTidesPayload");
  if (tideRaw) {
    try {
      var preds = JSON.parse(tideRaw.textContent);
      var nowEpoch = loadNow.getTime();
      var parsePredEpoch = function(str) {
        if (!str) return null;
        var s = str.trim();
        var parts = s.indexOf("T") !== -1 ? s.split("T") : s.split(" ");
        if (parts.length < 2) return null;
        var ymd = parts[0].split("-");
        var hm = parts[1].split(":");
        if (ymd.length < 3 || hm.length < 2) return null;
        return new Date(parseInt(ymd[0], 10), parseInt(ymd[1], 10) - 1, parseInt(ymd[2], 10), parseInt(hm[0], 10), parseInt(hm[1], 10), 0).getTime();
      };

      var upcoming = (preds || []).filter(function(p) {
        var ep = parsePredEpoch(p.time);
        return ep !== null && ep >= nowEpoch;
      });

      var nextHigh = upcoming.find(function(p) { return p.type === "High"; });
      var nextLow = upcoming.find(function(p) { return p.type === "Low"; });
      var nextAny = upcoming[0];

      var hLbl = document.getElementById("tideHighLabel");
      var hVal = document.getElementById("tideHighHeight");
      var lLbl = document.getElementById("tideLowLabel");
      var lVal = document.getElementById("tideLowHeight");
      var trLbl = document.getElementById("tideTrendLabel");

      if (nextHigh && hLbl && hVal) {
        hLbl.textContent = "NEXT HIGH " + (nextHigh.time_formatted || nextHigh.time);
        hVal.textContent = nextHigh.height_ft + " ft";
      }
      if (nextLow && lLbl && lVal) {
        lLbl.textContent = "NEXT LOW " + (nextLow.time_formatted || nextLow.time);
        lVal.textContent = nextLow.height_ft + " ft";
      }
      if (nextAny && trLbl) {
        trLbl.innerHTML = nextAny.type === "High" ? "&#9650; Tide<br>Rising" : "&#9660; Tide<br>Falling";
      }
    } catch (e) {}
  }

  /* 3. Airport Distances & Live METAR/FAA Hydration */
  var airportCoords = {
    sea: { lat: 47.4502, lon: -122.3088 },
    pae: { lat: 47.9063, lon: -122.2816 }
  };

  Object.keys(airportCoords).forEach(function(code) {
    var distEl = document.querySelector('[data-apt-dist="' + code + '"]');
    if (distEl && !isNaN(mapLat) && !isNaN(mapLon)) {
      var mi = haversineMiles(mapLat, mapLon, airportCoords[code].lat, airportCoords[code].lon);
      distEl.textContent = mi.toFixed(1) + " mi";
    }
  });

  /* 4. Hydrate Directional Employment Hub Matrix & Airports */
  function getPacificWindowMode() {
    var ptHour = parseInt(
      new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Los_Angeles",
        hour: "numeric",
        hour12: false
      }).format(new Date()),
      10
    );
    if (ptHour >= 6 && ptHour < 11) return "morning";
    if (ptHour >= 14 && ptHour < 20) return "evening";
    return "offpeak";
  }

  function applyCommuteWindowState(mode, hubsPayload) {
    var hubGrid = document.querySelector(".commute-hubs-grid");
    var windowPill = document.querySelector("[data-commute-window-pill]");
    if (!hubGrid) return;

    if (windowPill) {
      if (mode === "morning") {
        windowPill.textContent = "Morning Window Live \u2022 6 AM\u201311 AM";
        windowPill.className = "commute-window-pill is-live";
      } else if (mode === "evening") {
        windowPill.textContent = "Evening Return Live \u2022 2 PM\u20138 PM";
        windowPill.className = "commute-window-pill is-live";
      } else {
        windowPill.textContent = "Off-Peak Baselines";
        windowPill.className = "commute-window-pill";
      }
    }

    hubGrid.querySelectorAll(".commute-hub-card").forEach(function(card) {
      var hId = card.getAttribute("data-hub-id");
      var live = hubsPayload && hubsPayload[hId] ? hubsPayload[hId] : null;

      var dOff = card.getAttribute("data-offpeak-drive") || "";
      var tOff = card.getAttribute("data-offpeak-transit") || "";
      var rdOff = card.getAttribute("data-offpeak-return-drive") || "";
      var rtOff = card.getAttribute("data-offpeak-return-transit") || "";

      var mLeg = card.querySelector('[data-commute-leg="morning"]');
      var eLeg = card.querySelector('[data-commute-leg="evening"]');
      var fDrive = card.querySelector('[data-hub-field="drive_live"]');
      var fTransit = card.querySelector('[data-hub-field="transit_live"]');
      var rDrive = card.querySelector('[data-hub-field="return_drive_live"]');
      var rTransit = card.querySelector('[data-hub-field="return_transit_live"]');

      var subMd = card.querySelector('[data-hub-sub="morning_drive"]');
      var subMt = card.querySelector('[data-hub-sub="morning_transit"]');
      var subEd = card.querySelector('[data-hub-sub="return_drive"]');
      var subEt = card.querySelector('[data-hub-sub="return_transit"]');
      var badge = card.querySelector("[data-hub-badge]");

      if (!dOff) return;

      if (mode === "morning") {
        if (mLeg) mLeg.className = "commute-leg-block is-leg-active";
        if (eLeg) eLeg.className = "commute-leg-block is-leg-inactive";

        if (fDrive) {
          fDrive.className = "commute-metric-value";
          fDrive.textContent = live && live.drive_live_min ? (live.drive_live_min + " min") : (dOff + " min");
        }
        if (fTransit) {
          fTransit.className = "commute-metric-value text-accent-alpine";
          fTransit.textContent = live && live.transit_live_min ? (live.transit_live_min + " min") : (tOff + " min");
        }
        if (subMd) subMd.textContent = "Off-peak: " + dOff + " min";
        if (subMt) subMt.textContent = "Off-peak: " + tOff + " min";

        if (rDrive) {
          rDrive.className = "commute-metric-value is-window-tag";
          rDrive.textContent = "2 PM\u20138 PM";
        }
        if (rTransit) {
          rTransit.className = "commute-metric-value is-window-tag";
          rTransit.textContent = "2 PM\u20138 PM";
        }
        if (subEd) subEd.textContent = "Off-peak: " + rdOff + " min";
        if (subEt) subEt.textContent = "Off-peak: " + rtOff + " min";

        var baseMin = parseFloat(dOff);
        if (badge && live && live.drive_live_min && baseMin > 0) {
          var friction = Math.max(0, Math.round(((live.drive_live_min - baseMin) / baseMin) * 100));
          var fCls = friction <= 15 ? "friction-low" : friction <= 30 ? "friction-moderate" : "friction-high";
          var fLabel = friction <= 15 ? "Low Drag" : friction <= 30 ? "Moderate" : "Heavy Delay";
          badge.className = "commute-friction-badge " + fCls;
          badge.innerHTML = "<span>+" + friction + "%</span><span>" + fLabel + "</span>";
          badge.classList.remove("is-hidden");
        }
      } else if (mode === "evening") {
        if (mLeg) mLeg.className = "commute-leg-block is-leg-inactive";
        if (eLeg) eLeg.className = "commute-leg-block is-leg-active";

        if (fDrive) {
          fDrive.className = "commute-metric-value is-window-tag";
          fDrive.textContent = "6 AM\u201311 AM";
        }
        if (fTransit) {
          fTransit.className = "commute-metric-value is-window-tag";
          fTransit.textContent = "6 AM\u201311 AM";
        }
        if (subMd) subMd.textContent = "Off-peak: " + dOff + " min";
        if (subMt) subMt.textContent = "Off-peak: " + tOff + " min";

        if (rDrive) {
          rDrive.className = "commute-metric-value";
          rDrive.textContent = live && live.return_drive_live_min ? (live.return_drive_live_min + " min") : (rdOff + " min");
        }
        if (rTransit) {
          rTransit.className = "commute-metric-value text-accent-alpine";
          rTransit.textContent = live && live.return_transit_live_min ? (live.return_transit_live_min + " min") : (rtOff + " min");
        }
        if (subEd) subEd.textContent = "Off-peak: " + rdOff + " min";
        if (subEt) subEt.textContent = "Off-peak: " + rtOff + " min";

        var retBaseMin = parseFloat(rdOff);
        if (badge && live && live.return_drive_live_min && retBaseMin > 0) {
          var friction = Math.max(0, Math.round(((live.return_drive_live_min - retBaseMin) / retBaseMin) * 100));
          var fCls = friction <= 15 ? "friction-low" : friction <= 30 ? "friction-moderate" : "friction-high";
          var fLabel = friction <= 15 ? "Low Drag" : friction <= 30 ? "Moderate" : "Heavy Delay";
          badge.className = "commute-friction-badge " + fCls;
          badge.innerHTML = "<span>+" + friction + "%</span><span>" + fLabel + "</span>";
          badge.classList.remove("is-hidden");
        }
      } else {
        if (mLeg) mLeg.className = "commute-leg-block";
        if (eLeg) eLeg.className = "commute-leg-block";
        if (badge) badge.className = "commute-friction-badge is-hidden";

        if (fDrive) {
          fDrive.className = "commute-metric-value is-baseline-primary";
          fDrive.textContent = dOff + " min";
        }
        if (fTransit) {
          fTransit.className = "commute-metric-value text-accent-alpine";
          fTransit.textContent = tOff + " min";
        }
        if (rDrive) {
          rDrive.className = "commute-metric-value is-baseline-primary";
          rDrive.textContent = rdOff + " min";
        }
        if (rTransit) {
          rTransit.className = "commute-metric-value text-accent-alpine";
          rTransit.textContent = rtOff + " min";
        }
        if (subMd) subMd.textContent = "Typical off-peak";
        if (subMt) subMt.textContent = "Typical off-peak";
        if (subEd) subEd.textContent = "Typical off-peak";
        if (subEt) subEt.textContent = "Typical off-peak";
      }
    });
  }

  var initialMode = getPacificWindowMode();
  applyCommuteWindowState(initialMode, null);

  if (initialMode !== "offpeak" && !isNaN(mapLat) && !isNaN(mapLon)) {
    fetch(apiBase + "/transit/commute?lat=" + mapLat + "&lon=" + mapLon)
      .then(function(res) { return res.ok ? res.json() : null; })
      .then(function(data) {
        if (data) applyCommuteWindowState(data.window || initialMode, data.hubs || {});
      })
      .catch(function() {});
  }

  var qs = !isNaN(mapLat) && !isNaN(mapLon) ? ("?lat=" + mapLat + "&lon=" + mapLon) : "";
  fetch(apiBase + "/transit/airports" + qs)
    .then(function(res) { return res.ok ? res.json() : null; })
    .then(function(data) {
      if (!data) return;
      var metars = Array.isArray(data.metar) ? data.metar : [];
      var delays = data.delays || {};
      var travel = data.travel || {};

      ["SEA", "PAE"].forEach(function(code) {
        var card = document.getElementById("aptCard" + code);
        if (!card) return;

        var m = metars.find(function(x) { return x.icaoId === "K" + code; });
        if (m) {
          var cat = (m.fltcat || m.fltCat || "VFR").toLowerCase();
          var rulePill = card.querySelector(".apt-rule-val");
          rulePill.textContent = cat.toUpperCase();
          rulePill.className = "apt-flight-rules-pill " + cat + " apt-rule-val";

          var wdir = m.wdir !== undefined ? (m.wdir + "°") : "VRB";
          var wspd = m.wspd !== undefined ? (m.wspd + " kt") : "Calm";
          card.querySelector(".apt-wind-val").textContent = wdir + " at " + wspd;
          card.querySelector(".apt-vis-val").textContent = m.visib !== undefined ? (m.visib + " sm") : "10+ sm";

          var tempF = m.temp !== undefined ? (Math.round(m.temp * 9 / 5 + 32) + "°F") : "";
          var ceilStr = m.ceil ? (m.ceil + "00 ft") : "Clear";
          card.querySelector(".apt-ceil-val").textContent = tempF ? (ceilStr + " · " + tempF) : ceilStr;
        }

        var statusBadge = card.querySelector(".apt-faa-status");
        if (statusBadge && (m || delays[code])) {
          if (delays[code]) {
            statusBadge.textContent = delays[code];
            statusBadge.className = "ferry-status-pill status-delayed apt-faa-status";
          } else {
            statusBadge.textContent = "Normal Operations";
            statusBadge.className = "ferry-status-pill status-ontime apt-faa-status";
          }
        }

        var low = code.toLowerCase();
        var liveApt = travel[low];
        if (liveApt) {
          var dEl = document.querySelector('[data-apt-drive="' + low + '"]');
          var tEl = document.querySelector('[data-apt-transit="' + low + '"]');
          if (dEl && liveApt.drive_live_min) dEl.textContent = liveApt.drive_live_min + " min";
          if (tEl && liveApt.transit_live_min) tEl.textContent = liveApt.transit_live_min + " min";
        }
      });
    })
    .catch(function() {});

  /* 5. Washington State Ferries Accordion (All Closed by Default) */
  (function initFerries() {
    var container = document.getElementById("ferryAccordionContainer");
    var rawNode = document.getElementById("ferrySchedulesPayload");
    if (!container || !rawNode) return;

    var routes = [];
    try {
      routes = JSON.parse(rawNode.textContent) || [];
    } catch (e) {
      return;
    }

    var nowMs = Date.now();
    var horizonMs = nowMs + 24 * 3600 * 1000;

    routes.forEach(function(r) {
      r.sailings = (r.sailings || [])
        .filter(function(s) { return s && s.dep; })
        .map(function(s) { return Object.assign({}, s, { depMs: Date.parse(s.dep), spaces: null }); })
        .filter(function(s) { return !isNaN(s.depMs) && s.depMs >= (nowMs - 5 * 60000) && s.depMs <= horizonMs; })
        .sort(function(a, b) { return a.depMs - b.depMs; });

      var dists = (r.terminals || []).map(function(t) { return haversineMiles(mapLat, mapLon, t.lat, t.lon); });
      r.minDist = dists.length ? Math.min.apply(null, dists) : 9999;
    });

    routes.sort(function(a, b) { return a.minDist - b.minDist; });

    function formatClock(ms) {
      return new Date(ms).toLocaleTimeString("en-US", {
        timeZone: "America/Los_Angeles",
        hour: "numeric",
        minute: "2-digit"
      });
    }

    function renderAccordion(liveVessels, hasLiveTelemetry) {
      var openSlugs = new Set(
        Array.from(container.querySelectorAll("details[open]")).map(function(el) { return el.getAttribute("data-route-slug"); })
      );

      container.innerHTML = routes.map(function(r) {
        var terms = r.terminals || [];
        var isMultiStop = terms.length > 2;
        var disruptions = Array.isArray(r.disruptions) ? r.disruptions : [];
        var hasDisruption = disruptions.length > 0;

        var statusPillHtml = "";
        if (hasDisruption) {
          statusPillHtml = '<span class="ferry-status-pill status-canceled">Service Alert</span>';
        } else if (hasLiveTelemetry) {
          var activeRouteVessel = (liveVessels || []).find(function(v) {
            return terms.some(function(t) { return t.id === v.departingId; }) && terms.some(function(t) { return t.id === v.arrivingId; });
          });
          if (activeRouteVessel) {
            var isDelayed = activeRouteVessel.scheduledDepMs && activeRouteVessel.leftDockMs &&
              ((activeRouteVessel.leftDockMs - activeRouteVessel.scheduledDepMs) > 10 * 60000);
            statusPillHtml = isDelayed
              ? '<span class="ferry-status-pill status-delayed">Delayed</span>'
              : '<span class="ferry-status-pill status-ontime">On Time</span>';
          }
        }

        var vesselNames = (r.vessels || []).map(function(v) { return "M/V " + v; }).join(", ");
        var summaryHtml = "";
        var drawerHtml = "";

        if (!isMultiStop && terms.length === 2) {
          var tA = terms[0];
          var tB = terms[1];
          var sailA = r.sailings.filter(function(s) { return s.fromId === tA.id; });
          var sailB = r.sailings.filter(function(s) { return s.fromId === tB.id; });

          var next2A = sailA.slice(0, 2).map(function(s) { return formatClock(s.depMs); }).join(", ");
          var next2B = sailB.slice(0, 2).map(function(s) { return formatClock(s.depMs); }).join(", ");

          if (next2A) summaryHtml += '<div class="ferry-sailing-row"><span class="ferry-sailing-label">From ' + tA.name + ':</span><span class="ferry-sailing-times">' + next2A + '</span></div>';
          if (next2B) summaryHtml += '<div class="ferry-sailing-row"><span class="ferry-sailing-label">From ' + tB.name + ':</span><span class="ferry-sailing-times">' + next2B + '</span></div>';

          var buildRows = function(list) {
            return list.map(function(s) {
              return '<div class="ferry-schedule-row"><span class="ferry-sched-time">' + formatClock(s.depMs) + '</span><div><span class="ferry-sched-vessel">' + s.vessel + '</span>' + (s.spaces !== null ? '<span class="ferry-sched-spaces">' + s.spaces + ' spaces</span>' : '') + '</div></div>';
            }).join("");
          };

          drawerHtml = '<div class="ferry-docks-grid">' +
            '<div class="ferry-dock-block"><div class="ferry-dock-header">Departing ' + tA.name + ' (Next 24 Hours)</div>' + (buildRows(sailA) || '<div class="ferry-schedule-row"><span class="ferry-sched-vessel">Departure data unavailable</span></div>') + '</div>' +
            '<div class="ferry-dock-block"><div class="ferry-dock-header">Departing ' + tB.name + ' (Next 24 Hours)</div>' + (buildRows(sailB) || '<div class="ferry-schedule-row"><span class="ferry-sched-vessel">Departure data unavailable</span></div>') + '</div>' +
          '</div>';
        } else {
          var fromAna = r.sailings.filter(function(s) { return s.fromId === 1; });
          var fromIslands = r.sailings.filter(function(s) { return s.fromId !== 1; });
          var next2Ana = Array.from(new Set(fromAna.map(function(s) { return formatClock(s.depMs); }))).slice(0, 2).join(", ");
          var next2Isl = Array.from(new Set(fromIslands.map(function(s) { return formatClock(s.depMs); }))).slice(0, 2).join(", ");

          if (next2Ana) summaryHtml += '<div class="ferry-sailing-row"><span class="ferry-sailing-label">From Anacortes:</span><span class="ferry-sailing-times">' + next2Ana + '</span></div>';
          if (next2Isl) summaryHtml += '<div class="ferry-sailing-row"><span class="ferry-sailing-label">From San Juans:</span><span class="ferry-sailing-times">' + next2Isl + '</span></div>';

          var allRows = r.sailings.map(function(s) {
            return '<div class="ferry-schedule-row"><div><span class="ferry-sched-time">' + formatClock(s.depMs) + '</span><span class="ferry-sched-leg">' + s.from + ' &rarr; ' + s.to + '</span></div><div><span class="ferry-sched-vessel">' + s.vessel + '</span>' + (s.spaces !== null ? '<span class="ferry-sched-spaces">' + s.spaces + ' spaces</span>' : '') + '</div></div>';
          }).join("");

          drawerHtml = '<div class="ferry-docks-grid is-single-col"><div class="ferry-dock-block"><div class="ferry-dock-header">All Scheduled Sailings (Next 24 Hours)</div>' + (allRows || '<div class="ferry-schedule-row"><span class="ferry-sched-vessel">Departure data unavailable</span></div>') + '</div></div>';
        }

        var routeParts = (r.description || "").split("/");
        var routeTitleHtml = routeParts.length === 2
          ? '<span>' + routeParts[0].trim() + '</span><span class="ferry-route-arrow" aria-hidden="true">&#8644;</span><span>' + routeParts[1].trim() + '</span>'
          : '<span>' + r.description + '</span>';

        var disruptionHtml = disruptions.map(function(d) {
          return '<div class="ferry-disruption-banner">' + (d.text || d.title || "") + '</div>';
        }).join("");

        return '<details class="pass-accordion-item" data-route-slug="' + r.slug + '" ' + (openSlugs.has(r.slug) ? "open" : "") + '>' +
          '<summary class="ferry-accordion-summary">' +
            '<div class="ferry-route-col">' +
              (statusPillHtml ? '<div class="pass-badges-row">' + statusPillHtml + '</div>' : '') +
              '<div class="ferry-route-name">' + routeTitleHtml + '</div>' +
              (vesselNames ? '<span class="ferry-vessels-caption">' + vesselNames + '</span>' : '') +
            '</div>' +
            '<div class="ferry-next-sailings-col">' + summaryHtml + '</div>' +
            '<svg class="forecast-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>' +
          '</summary>' +
          '<div class="ferry-acc-details">' + disruptionHtml + drawerHtml + '</div>' +
        '</details>';
      }).join("");
    }

    renderAccordion([], false);

    fetch(apiBase + "/transit/ferries")
      .then(function(res) { return res.ok ? res.json() : null; })
      .then(function(payload) {
        if (!payload) return;
        var liveSpaces = Array.isArray(payload.spaces) ? payload.spaces : [];
        var liveVessels = Array.isArray(payload.vessels) ? payload.vessels : [];

        routes.forEach(function(r) {
          r.sailings.forEach(function(s) {
            var match = liveSpaces.find(function(sp) {
              return sp.fromId === s.fromId && sp.toId === s.toId && Math.abs(sp.depMs - s.depMs) <= 360000;
            });
            if (match && typeof match.driveUpSpaces === "number") {
              s.spaces = match.driveUpSpaces;
            }
          });
        });

        renderAccordion(liveVessels, true);
      })
      .catch(function() {});
  })();

  /* 6. Interactive SVG Chart Crosshair & Floating Readout Tooltip */
  document.querySelectorAll('[data-interactive-chart]').forEach(function(wrap) {
    var tooltip = wrap.querySelector('.chart-floating-tooltip');
    var crosshair = wrap.querySelector('.chart-crosshair-line');
    var dots = wrap.querySelectorAll('.chart-data-dot');
    var bands = wrap.querySelectorAll('.chart-hit-band');
    if (!tooltip || !bands.length) return;

    function clearHighlight() {
      tooltip.classList.remove('is-visible');
      if (crosshair) crosshair.classList.remove('is-visible');
      dots.forEach(function(d) { d.classList.remove('is-active'); });
    }

    bands.forEach(function(band) {
      band.addEventListener('mouseenter', function() {
        var step = band.getAttribute('data-step');
        var cx = parseFloat(band.getAttribute('data-cx') || '0');
        var dateStr = band.getAttribute('data-date') || '';
        var payload = band.getAttribute('data-payload') || '';

        if (crosshair) {
          crosshair.setAttribute('x1', cx);
          crosshair.setAttribute('x2', cx);
          crosshair.classList.add('is-visible');
        }

        dots.forEach(function(d) {
          d.classList.toggle('is-active', d.getAttribute('data-step') === step);
        });

        var rows = payload.split('||').filter(Boolean).map(function(entry) {
          var parts = entry.split('::');
          var cls = parts[0] || 'series-1';
          var label = parts[1] || '';
          var val = parts[2] || '';
          return '<div class="chart-tooltip-row">' +
            '<span class="chart-tooltip-series"><span class="chart-tooltip-dot ' + cls + '"></span>' + label + '</span>' +
            '<span class="chart-tooltip-val">' + val + '</span>' +
          '</div>';
        }).join('');

        tooltip.innerHTML = (dateStr ? '<div class="chart-tooltip-date">' + dateStr + '</div>' : '') + rows;
        tooltip.classList.add('is-visible');

        if (cx > 560) {
          tooltip.style.left = 'auto';
          tooltip.style.right = '16px';
        } else {
          tooltip.style.right = 'auto';
          tooltip.style.left = '16px';
        }
      });
    });

    wrap.addEventListener('mouseleave', clearHighlight);
  });
})();
</script>