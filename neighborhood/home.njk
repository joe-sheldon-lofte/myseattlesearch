---
layout: layouts/base.njk
pagination:
  data: city_data
  size: 1
  addAllPagesToCollections: true
  alias: city
permalink: "/neighborhood/{{ city.City | slugify }}/index.html"
---

{# Initialize core routing keys #}
{% set city_slug = city.City | slugify %}
{% set active_neighborhood = city.City %}

{# Global build-time month resolution for FeatCat business cycling (1-12) #}
{% set current_month = "11" %} 
{% set active_featcat = "FeatCat" ~ current_month %}

<main class="layout-container layout-stack-main">

  {# SECTION 1: CANONICAL HERO HEADER #}
  <div id="neighborhood-hero" class="portal-section-header">
    {% set hero_img_main = city.HeroImageMain %}
    {% set hero_img_left = city.HeroImageLeft %}
    {% set hero_img_right = city.HeroImageRight %}
    {% set hero_welcome_label = "Welcome to the neighborhood" %}
    {% include "components/widget/neighborhood-page-header.njk" ignore missing %}
  </div>

  {# SECTION 2: EXPLORE NAVIGATION PILLS #}
  <section id="explore-neighborhood" class="portal-section-nav">
    <h2 class="text-section-title section-title-clean">Explore {{ active_neighborhood }}</h2>
    <div class="neighborhood-nav-container">
      <div class="neighborhood-nav-track" tabindex="0" role="navigation" aria-label="{{ active_neighborhood }} Subpages">
        <a href="/neighborhood/{{ city_slug }}/news-events/" class="neighborhood-nav-pill is-inactive">News &amp; Events</a>
        <a href="/neighborhood/{{ city_slug }}/weather/" class="neighborhood-nav-pill is-inactive">Weather</a>
        <a href="/neighborhood/{{ city_slug }}/transit-commute/" class="neighborhood-nav-pill is-inactive">Transit &amp; Commute</a>
        <a href="/neighborhood/{{ city_slug }}/emergency-safety/" class="neighborhood-nav-pill is-inactive">Emergency &amp; Safety</a>
        <a href="/neighborhood/{{ city_slug }}/municipal/" class="neighborhood-nav-pill is-inactive">Municipal</a>
        <a href="/neighborhood/{{ city_slug }}/real-estate/" class="neighborhood-nav-pill is-inactive">Real Estate</a>
        <a href="/neighborhood/school/{{ city['School District'] | slugify }}/" class="neighborhood-nav-pill is-inactive">School District</a>
        <a href="/sports/pro/" class="neighborhood-nav-pill is-inactive">Pro Sports</a>
      </div>
    </div>
  </section>

  <hr class="section-divider">

  {# SECTION 3: HAPPENING NOW (Compact Bento Grid) #}
  <section id="happening-now" class="portal-section-glance">
    <h2 class="text-section-title section-title-clean">Happening Now</h2>
    <div class="section-grid-static grid-cols-4">
      
      {# 3.1: Compact Weather Tile #}
      {% set w_city = city_weather[city_slug] if city_weather else null %}
      {% if w_city and w_city.current %}
        <a href="/neighborhood/{{ city_slug }}/weather/" style="text-decoration: none; color: inherit;">
          <div class="surface-bento" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; height: 100%; gap: 0.75rem;">
            <div class="text-overline" style="letter-spacing: 0.1em; color: var(--color-secondary-muted);">WEATHER</div>
            
            <div style="display: flex; align-items: center; gap: 1rem;">
              {% set weather_code = w_city.current.weather_code | int %}
              <div style="width: 42px; height: 42px;">
                <svg viewBox="0 0 32 32" fill="none" style="width: 100%; height: 100%; display: block; overflow: visible;">
                  {% if weather_code >= 50 %}
                    <path d="M7 19a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 19H7z" fill="#94A3B8" />
                    <line x1="10" y1="22" x2="8" y2="27" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" />
                    <line x1="16" y1="22" x2="14" y2="27" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" />
                  {% elif weather_code == 3 %}
                    <path d="M8 22a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 26 22H8z" fill="#94A3B8" />
                  {% else %}
                    <circle cx="16" cy="16" r="7" fill="#FBBF24" />
                    <line x1="16" y1="4" x2="16" y2="7" stroke="#FBBF24" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="16" y1="25" x2="16" y2="28" stroke="#FBBF24" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="4" y1="16" x2="7" y2="16" stroke="#FBBF24" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="25" y1="16" x2="28" y2="16" stroke="#FBBF24" stroke-width="2.5" stroke-linecap="round" />
                  {% endif %}
                </svg>
              </div>
              <div style="font-size: 2.2rem; font-weight: 500; font-family: monospace; letter-spacing: -0.02em; line-height: 1;">{{ w_city.current.temp_f | round }}&deg;</div>
            </div>

            <div style="font-size: 1rem; color: var(--color-secondary-muted);">
              {{ "Rain" if weather_code >= 50 else ("Cloudy" if weather_code == 3 else "Sunny") }}
            </div>
            
            {% if w_city.forecast_7_day and w_city.forecast_7_day.temp_max %}
              <div style="font-size: 1rem; color: var(--color-secondary-muted);">
                H: {{ w_city.forecast_7_day.temp_max[0] | round }}&deg; L: {{ w_city.forecast_7_day.temp_min[0] | round }}&deg;
              </div>
            {% endif %}
          </div>
        </a>
      {% endif %}

      {# 3.2: Sunrise / Sunset Dial #}
      {% if w_city and w_city.astronomy %}
        <a href="/neighborhood/{{ city_slug }}/weather/" style="text-decoration: none; color: inherit;">
          <div class="surface-bento" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; height: 100%; gap: 1rem;">
            <div class="text-overline" style="letter-spacing: 0.1em; color: var(--color-secondary-muted);">SUNRISE &amp; SUNSET</div>
            
            <div style="position: relative; width: 80px; height: 80px;">
              <svg viewBox="0 0 100 100" style="width: 100%; height: 100%; overflow: visible; transform: rotate(-90deg);">
                <path d="M 50 50 m -40 0 a 40 40 0 1 1 80 0" fill="none" stroke="#FBBF24" stroke-width="6" />
                <path d="M 50 50 m 40 0 a 40 40 0 1 1 -80 0" fill="none" stroke="#1C1C1E" stroke-width="6" />
                <polygon points="10,50 4,44 16,44" fill="#1C1C1E" transform="rotate(90, 10, 50)" />
                <polygon points="90,50 84,44 96,44" fill="#FBBF24" transform="rotate(90, 90, 50)" />
                <circle cx="50" cy="10" r="4" fill="#FBBF24" stroke="#1C1C1E" stroke-width="1.5" />
              </svg>
            </div>

            <div style="display: flex; justify-content: space-between; width: 100%; font-size: 0.95rem; font-weight: 500; padding: 0 0.5rem; font-family: monospace;">
              <span>{{ w_city.astronomy.sunrise_today | replace("2026-10-25T", "") | default("6:08 AM") }}</span>
              <span>{{ w_city.astronomy.sunset_today | replace("2026-10-25T", "") | default("8:18 PM") }}</span>
            </div>
          </div>
        </a>
      {% endif %}

      {# 3.3: Active Commute Traffic Score #}
      {% set t_live = transit_radar_live[city_slug] if transit_radar_live else null %}
      {% if t_live and t_live.active_commute_score %}
        <a href="/neighborhood/{{ city_slug }}/transit-commute/" style="text-decoration: none; color: inherit;">
          <div class="surface-bento" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; height: 100%; gap: 1rem; text-align: center;">
            <div class="text-overline" style="letter-spacing: 0.1em; color: var(--color-secondary-muted);">COMMUTE SCORE</div>
            
            {% set score_val = t_live.active_commute_score | int %}
            {% set score_color = "var(--status-emerald)" if score_val >= 80 else ("var(--status-amber)" if score_val >= 50 else "var(--pnw-red)") %}
            
            <div style="width: 64px; height: 64px; border-radius: 16px; display: flex; align-items: center; justify-content: center; background: {{ score_color }}; color: #FFFFFF; font-size: 1.85rem; font-family: monospace; font-weight: 500;">
              {{ score_val }}
            </div>
            
            <div style="font-size: 1rem; font-weight: 500; color: {{ score_color }};">
              {{ "Smooth Arterials" if score_val >= 80 else ("Moderate Traffic" if score_val >= 50 else "Arterial Congestion") }}
            </div>
          </div>
        </a>
      {% endif %}

      {# 3.4: Real Estate Market Gauge #}
      {% set local_stats = redfin_stats | selectattr("city", "equalto", city.City) | first if redfin_stats else null %}
      {% if local_stats and local_stats.months_of_supply %}
        <a href="/neighborhood/{{ city_slug }}/real-estate/" style="text-decoration: none; color: inherit;">
          <div class="surface-bento" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; height: 100%; gap: 1rem;">
            <div class="text-overline" style="letter-spacing: 0.1em; color: var(--color-secondary-muted);">REAL ESTATE MARKET</div>
            
            {% set m_supply = local_stats.months_of_supply | float %}
            {% set m_angle = -90 + ((m_supply / 6) * 180) %}
            {% set m_angle_capped = m_angle if m_angle <= 90 else 90 %}

            <div style="position: relative; width: 100px; height: 50px;">
              <svg viewBox="0 0 100 50" style="width: 100%; height: 100%; overflow: visible;">
                <path d="M 10 50 A 40 40 0 0 1 90 50" fill="none" stroke="#D9232A" stroke-width="12" stroke-linecap="round" />
                <path d="M 33 22 A 40 40 0 0 1 67 22" fill="none" stroke="#3B82F6" stroke-width="12" />
                
                <g transform="translate(50, 50) rotate({{ m_angle_capped }})">
                  <polygon points="-2,0 2,0 0,-38" fill="#1C1C1E" />
                  <circle cx="0" cy="0" r="4" fill="#1C1C1E" />
                </g>
              </svg>
            </div>

            <div style="font-size: 1.05rem; font-weight: 500; color: var(--premier-charcoal); margin-top: 0.25rem;">
              {{ "Seller's Market" if m_supply < 2 else ("Balanced Market" if m_supply <= 4 else "Buyer's Market") }}
            </div>
          </div>
        </a>
      {% endif %}

    </div>
  </section>

  <hr class="section-divider">

  {# SECTION 4: FEATURED LOCAL BUSINESSES #}
  {% set feat_cat_raw = city[active_featcat] if city[active_featcat] else "coffee" %}
  {% set primary_cat = feat_cat_raw.split(',') | first | trim %}
  {% set local_biz_list = city_businesses[city_slug].categories[primary_cat] if city_businesses and city_businesses[city_slug] and city_businesses[city_slug].categories else null %}

  {% if local_biz_list and local_biz_list.length > 0 %}
    <section id="featured-businesses" class="portal-section-businesses">
      <h2 class="text-section-title section-title-clean">Featured Local Businesses</h2>
      <div class="horizontal-scroll-section scroll-variant-medium" tabindex="0">
        {% for biz in local_biz_list | slice(0, 3) %}
          {% if biz.name %}
            <div class="horizontal-scroll-item">
              {% set business_name = biz.name %}
              {% set business_category = biz.category | default(primary_cat) %}
              {% set business_price_level = biz.price_level %}
              {% set business_rating = biz.rating %}
              {% set business_reviews_count = biz.review_count %}
              {% set business_address = biz.location %}
              {% set business_summary = biz.summary %}
              {% set business_image_url = biz.image_url %}
              {% set business_url = biz.url %}
              {% include "components/widget/business-listing.njk" ignore missing %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>
    <hr class="section-divider">
  {% endif %}

  {# SECTION 5: RECENT NEWS (Clean Feed) #}
  {% if market_news %}
    <section id="recent-news" class="portal-section-news-events section-widget">
      <h2 class="text-section-title section-title-clean">Recent News</h2>
      
      <div class="surface-bento" style="padding: 1.5rem;">
        <div style="display: flex; flex-direction: column;">
          {% set count = 0 %}
          {% for item in market_news %}
            {% set item_cat = (item.category or (item.tags[0] if item.tags else 'local')) | lower %}
            {% if (item_cat == news_region_slug or item_cat == city_slug) and count < 5 %}
              {% set count = count + 1 %}
              <article style="padding: 1rem 0; border-bottom: 1px solid var(--color-border-light);">
                <div style="font-size: 0.65rem; color: var(--color-secondary-muted); text-transform: uppercase; margin-bottom: 0.25rem;">
                  {{ item.source | default("REGIONAL DISPATCH") }} • {{ item.date_formatted | default(item.published) }}
                </div>
                <h4 style="margin: 0 0 0.5rem 0; font-size: 1.05rem; font-weight: 500;">
                  <a href="{{ item.url | default(item.link) }}" target="_blank" rel="noopener noreferrer" style="color: var(--premier-charcoal); text-decoration: none;">
                    {{ item.title }}
                  </a>
                </h4>
                {% if item.excerpt %}
                  <p style="margin: 0; font-size: 0.85rem; color: var(--color-secondary-muted); line-height: 1.4;">{{ item.excerpt }}</p>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <div style="margin-top: 1rem; text-align: center;">
          <a href="/neighborhood/{{ city_slug }}/news-events/" style="font-size: 0.85rem; font-weight: 500; color: var(--alpine-blue); text-decoration: none;">See all news →</a>
        </div>
      </div>
    </section>
    <hr class="section-divider">
  {% endif %}

  {# SECTION 6: UPCOMING EVENTS (Clean Schedule) #}
  {% set feed_source = public_events_feed if public_events_feed else public_events %}
  {% if feed_source %}
    <section id="upcoming-events" class="portal-section-news-events section-widget">
      <h2 class="text-section-title section-title-clean">Upcoming Events</h2>
      
      <div class="surface-bento" style="padding: 1.5rem;">
        <div style="display: flex; flex-direction: column;">
          {% set count = 0 %}
          {% for item in feed_source %}
            {% set item_tags = (item.tags | join(' ')) | lower if item.tags else '' %}
            {% if (item.city == city.City or event_region_slug in item_tags) and count < 5 %}
              {% set count = count + 1 %}
              <article style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border-light);">
                <div style="flex: 1;">
                  <h4 style="margin: 0 0 0.25rem 0; font-size: 0.95rem; font-weight: 500;">
                    {% if item.url or item.link %}
                      <a href="{{ item.url | default(item.link) }}" target="_blank" rel="noopener noreferrer" style="color: var(--premier-charcoal); text-decoration: none;">
                        {{ item.title }}
                      </a>
                    {% else %}
                      {{ item.title }}
                    {% endif %}
                  </h4>
                  {% if item.location or item['Location Name'] %}
                    <div style="font-size: 0.75rem; color: var(--color-secondary-muted);">📍 {{ item.location | default(item['Location Name']) }}</div>
                  {% endif %}
                </div>
                <div style="text-align: right; flex-shrink: 0;">
                  <div style="font-size: 0.8rem; font-weight: 500; font-family: monospace; color: var(--alpine-blue);">{{ item.date | default(item.display_date) | default(item.Date) }}</div>
                  {% if item.time or item.display_time or item['Start Time'] %}
                    <div style="font-size: 0.75rem; color: var(--color-secondary-muted);">{{ item.time | default(item.display_time) | default(item['Start Time']) }}</div>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <div style="margin-top: 1rem; text-align: center;">
          <a href="/neighborhood/{{ city_slug }}/news-events/" style="font-size: 0.85rem; font-weight: 500; color: var(--alpine-blue); text-decoration: none;">See all events →</a>
        </div>
      </div>
    </section>
    <hr class="section-divider">
  {% endif %}

  {# SECTION 7: SPORTS #}
  {% if sports_data and sports_data.teams %}
    <section id="local-sports" class="portal-section-sports">
      <h2 class="text-section-title section-title-clean">Sports</h2>
      <div class="horizontal-scroll-section scroll-variant-medium" tabindex="0">
        {% set display_levels = ["Professional", "Minor League", "Collegiate"] %}
        {% for target_level in display_levels %}
          {% set level_team = sports_data.teams | selectattr("level", "equalto", target_level) | first %}
          {% set level_game = level_team.recentGames | first if level_team else null %}
          
          {% if level_game %}
            <div class="horizontal-scroll-item">
              <article class="surface-bento" style="padding: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem; margin-bottom: 1.15rem;">
                  <span style="font-size: 0.7rem; color: var(--color-secondary-muted); text-transform: uppercase; font-weight: 500;">
                    {{ level_team.sport | upper }} • {{ level_team.teamName | upper }}
                  </span>
                  <span style="font-size: 0.7rem; font-weight: 500; padding: 0.2rem 0.55rem; border-radius: 999px; background: var(--color-surface-gray); color: var(--premier-charcoal);">
                    {{ level_game.status | upper }}
                  </span>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                      <span style="font-size: 1.05rem; font-weight: 500; color: var(--premier-charcoal);">{{ level_game.home_team }}</span>
                      <span style="font-size: 0.75rem; color: var(--color-secondary-muted); margin-left: 0.5rem;">({{ level_team.currentRecord }})</span>
                    </div>
                    <span style="font-size: 1.35rem; font-weight: 500; font-family: monospace;">{{ level_game.home_score }}</span>
                  </div>
                  
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 1.05rem; font-weight: 500; color: var(--color-secondary-muted);">{{ level_game.away_team }}</span>
                    <span style="font-size: 1.35rem; font-weight: 500; font-family: monospace; color: var(--color-secondary-muted);">{{ level_game.away_score }}</span>
                  </div>
                </div>
                
                <div style="margin-top: 1.25rem; padding-top: 0.85rem; border-top: 1px solid var(--color-border-light); text-align: right;">
                  <a href="/sports/{{ level_team.slug }}/" style="font-size: 0.8rem; font-weight: 500; color: var(--alpine-blue); text-decoration: none;">Score Recap →</a>
                </div>
              </article>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>
    <hr class="section-divider">
  {% endif %}

  {# SECTION 8: ABOUT NEIGHBORHOOD #}
  <section id="about-neighborhood" class="portal-section-editorial section-widget">
    {% set editorial_headline = "About " ~ active_neighborhood %}
    {% set editorial_overline = active_neighborhood | upper %}
    {% include "components/widget/neighborhood-editorial.njk" ignore missing %}
  </section>

</main>