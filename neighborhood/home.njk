---
layout: layouts/base.njk
pagination:
  data: city_data
  size: 1
  addAllPagesToCollections: true
  alias: city
permalink: "/neighborhood/{{ city.City | slugify }}/index.html"
---
{% set city_slug = city.City | slugify %}
{% set active_neighborhood = city.City %}

{% set last_upd = stats['Last Update'] if (stats and stats['Last Update']) else "Nov 12, 2026" %}
{% set month_map = {
  "Jan": 1, "Feb": 2, "Mar": 3, "Apr": 4, "May": 5, "Jun": 6,
  "Jul": 7, "Aug": 8, "Sep": 9, "Oct": 10, "Nov": 11, "Dec": 12
} %}
{% set upd_month_str = last_upd | truncate(3, true, "") %}
{% set current_month = month_map[upd_month_str] | default(11) %}
{% set mm_pad = ("0" ~ current_month) if current_month < 10 else ("" ~ current_month) %}
{% set dd_raw = last_upd.split(' ')[1] | replace(',', '') if (' ' in last_upd) else "12" %}
{% set dd_pad = ("0" ~ dd_raw) if (dd_raw | length) == 1 else dd_raw %}
{% set today_mmdd = mm_pad ~ "-" ~ dd_pad %}

<main class="layout-container layout-stack-main">

  {# ==========================================================================
     SECTION 1: CANONICAL HERO HEADER
     ========================================================================== #}
  <div id="neighborhood-hero" class="portal-section-header">
    {% set hero_img_main = city.HeroImageMain %}
    {% set hero_img_left = city.HeroImageLeft %}
    {% set hero_img_right = city.HeroImageRight %}
    {% set hero_welcome_label = "Welcome to the neighborhood" %}
    {% include "components/widget/neighborhood-page-header.njk" %}
  </div>

  {# ==========================================================================
     SECTION 2: EXPLORE NAVIGATION PILLS (Adaptive Centered Dock)
     ========================================================================== #}
  <section id="explore-neighborhood" class="portal-section-nav" aria-label="Explore {{ active_neighborhood }}">
    <span class="text-overline text-accent-alpine section-overline-lead">
      EXPLORE {{ active_neighborhood | upper }}
    </span>
    <div class="neighborhood-nav-container">
      <nav class="neighborhood-nav-track" tabindex="0" aria-label="{{ active_neighborhood }} Subpages">
        <a href="/neighborhood/{{ city_slug }}/news-events/" class="neighborhood-nav-pill is-inactive">News &amp; Events</a>
        <a href="/neighborhood/{{ city_slug }}/weather/" class="neighborhood-nav-pill is-inactive">Weather</a>
        <a href="/neighborhood/{{ city_slug }}/transit-commute/" class="neighborhood-nav-pill is-inactive">Transit &amp; Commute</a>
        <a href="/neighborhood/{{ city_slug }}/emergency-safety/" class="neighborhood-nav-pill is-inactive">Emergency &amp; Safety</a>
        <a href="/neighborhood/{{ city_slug }}/municipal/" class="neighborhood-nav-pill is-inactive">Municipal</a>
        <a href="/neighborhood/{{ city_slug }}/real-estate/" class="neighborhood-nav-pill is-inactive">Real Estate</a>
        <a href="/neighborhood/school/{{ city['School District'] | slugify }}/" class="neighborhood-nav-pill is-inactive">School District</a>
        <a href="/sports/pro/" class="neighborhood-nav-pill is-inactive">Pro Sports</a>
        <a href="/neighborhood/region/transit-commute/" class="neighborhood-nav-pill is-inactive">Regional Transit</a>
      </nav>
    </div>
  </section>

  <hr class="section-divider">

  {# ==========================================================================
     SECTION 3: HAPPENING NOW (Half-Height 5-Tile Telemetry Strip)
     ========================================================================== #}
  {% set w_city = city_weather[city_slug] if city_weather else null %}
  {% set t_live = transit_radar_live[city_slug] if transit_radar_live else null %}

  {% set supply_val = null %}
  {% if infosparks_stats and infosparks_stats.feeds %}
    {% for feed_id, feed_obj in infosparks_stats.feeds %}
      {% if feed_obj.meta and feed_obj.meta.metric == "Months Supply Closed" and feed_obj.meta.geographies and (city.City in feed_obj.meta.geographies) and feed_obj.data and (feed_obj.data | length) > 0 %}
        {% set latest_row = feed_obj.data | last %}
        {% if latest_row[city.City] is defined and latest_row[city.City] is not none %}
          {% set supply_val = latest_row[city.City] %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if supply_val is none and redfin_stats %}
    {% for r in redfin_stats %}
      {% if r.city == city.City and r.months_of_supply is not none %}
        {% set supply_val = r.months_of_supply %}
      {% endif %}
    {% endfor %}
  {% endif %}

  <section id="happening-now" class="portal-section-glance">
    <h2 class="text-section-title section-title-clean">Happening Now</h2>
    <div class="glance-five-grid">

      {# 3.1: Current Weather #}
      {% if w_city and w_city.current and w_city.current.temp_f is not none %}
        {% set w_code = w_city.current.weather_code | int %}
        {% set w_label = "Rain" if w_code >= 50 else ("Cloudy" if w_code == 3 else "Sunny") %}
        <a href="/neighborhood/{{ city_slug }}/weather/" class="glance-tile-link">
          <article class="glance-tile-card">
            <span class="text-overline text-accent-alpine">CURRENT WEATHER</span>
            <div class="glance-tile-body">
              <div class="glance-weather-left">
                <div class="glance-weather-icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32" fill="none" class="glance-weather-svg">
                    {% if w_code >= 50 %}
                      <path d="M7 19a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 19H7z" class="weather-vector-cloud" />
                      <line x1="10" y1="22" x2="8" y2="27" class="weather-vector-rain" />
                      <line x1="16" y1="22" x2="14" y2="27" class="weather-vector-rain" />
                    {% elif w_code == 3 %}
                      <path d="M8 22a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 26 22H8z" class="weather-vector-cloud" />
                    {% else %}
                      <circle cx="16" cy="16" r="7" class="weather-vector-sun-core" />
                      <line x1="16" y1="4" x2="16" y2="7" class="weather-vector-sun-rays" />
                      <line x1="16" y1="25" x2="16" y2="28" class="weather-vector-sun-rays" />
                      <line x1="4" y1="16" x2="7" y2="16" class="weather-vector-sun-rays" />
                      <line x1="25" y1="16" x2="28" y2="16" class="weather-vector-sun-rays" />
                    {% endif %}
                  </svg>
                </div>
                <span class="glance-temp-numeral">{{ w_city.current.temp_f | round }}&deg;</span>
              </div>
              <div class="glance-weather-right">
                <span class="glance-status-primary">{{ w_label }}</span>
                {% if w_city.forecast_7_day and w_city.forecast_7_day.temp_max and w_city.forecast_7_day.temp_min %}
                  <span class="glance-status-sub">H: {{ w_city.forecast_7_day.temp_max[0] | round }}&deg; L: {{ w_city.forecast_7_day.temp_min[0] | round }}&deg;</span>
                {% endif %}
              </div>
            </div>
          </article>
        </a>
      {% endif %}

      {# 3.2: Sunrise & Sunset #}
      {% if w_city and w_city.astronomy and w_city.astronomy.sunrise_today and w_city.astronomy.sunset_today %}
        {% set raw_rise = w_city.astronomy.sunrise_today %}
        {% set raw_set = w_city.astronomy.sunset_today %}
        {% set rise_h = raw_rise.split('T')[1].split(':')[0] | int %}
        {% set rise_m = raw_rise.split('T')[1].split(':')[1] %}
        {% set rise_mins = rise_h * 60 + (rise_m | int) %}
        {% set rise_disp = (12 if rise_h == 0 else (rise_h if rise_h <= 12 else rise_h - 12)) ~ ':' ~ rise_m ~ (' AM' if rise_h < 12 else ' PM') %}

        {% set set_h = raw_set.split('T')[1].split(':')[0] | int %}
        {% set set_m = raw_set.split('T')[1].split(':')[1] %}
        {% set set_mins = set_h * 60 + (set_m | int) %}
        {% set set_disp = (12 if set_h == 0 else (set_h if set_h <= 12 else set_h - 12)) ~ ':' ~ set_m ~ (' AM' if set_h < 12 else ' PM') %}

        {% set sun_angle = 90 %}
        {% if w_city.last_updated and ('T' in w_city.last_updated) %}
          {% set u_h = w_city.last_updated.split('T')[1].split(':')[0] | int %}
          {% set u_m = w_city.last_updated.split('T')[1].split(':')[1] | int %}
          {% set cur_h = (u_h - 8 + 24) % 24 %}
          {% set cur_mins = cur_h * 60 + u_m %}
          {% if cur_mins >= rise_mins and cur_mins <= set_mins %}
            {% set sun_angle = (((cur_mins - rise_mins) / (set_mins - rise_mins)) * 180) | round(1) %}
          {% else %}
            {% set night_dur = (1440 - set_mins) + rise_mins %}
            {% set elapsed = (cur_mins - set_mins) if cur_mins > set_mins else ((1440 - set_mins) + cur_mins) %}
            {% set sun_angle = (180 + ((elapsed / night_dur) * 180)) | round(1) %}
          {% endif %}
        {% endif %}

        <a href="/neighborhood/{{ city_slug }}/weather/" class="glance-tile-link">
          <article class="glance-tile-card">
            <span class="text-overline text-accent-alpine">SUNRISE &amp; SUNSET</span>
            <div class="glance-solar-row">
              <span class="glance-solar-time">{{ rise_disp }}</span>
              <div class="glance-solar-dial" aria-hidden="true">
                <svg viewBox="0 0 100 100" class="glance-solar-svg">
                  <path d="M 10 50 A 40 40 0 0 1 90 50" class="glance-solar-day" />
                  <path d="M 90 50 A 40 40 0 0 1 10 50" class="glance-solar-night" />
                  <polygon points="6,54 14,54 10,45" class="glance-solar-arrow-rise" />
                  <polygon points="86,46 94,46 90,55" class="glance-solar-arrow-set" />
                  <g transform="rotate({{ sun_angle }}, 50, 50)">
                    <circle cx="10" cy="50" r="5" class="glance-solar-dot" />
                  </g>
                </svg>
              </div>
              <span class="glance-solar-time">{{ set_disp }}</span>
            </div>
          </article>
        </a>
      {% endif %}

      {# 3.3: Active Commute Score #}
      {% if t_live and t_live.active_commute_score is not none %}
        {% set c_val = t_live.active_commute_score | int %}
        {% set c_tier = "score-tier-emerald" if c_val >= 80 else ("score-tier-alpine" if c_val >= 50 else "score-tier-crimson") %}
        {% set c_label = "Light Traffic" if c_val >= 80 else ("Moderate Traffic" if c_val >= 50 else "Heavy Traffic") %}
        <a href="/neighborhood/{{ city_slug }}/transit-commute/" class="glance-tile-link">
          <article class="glance-tile-card">
            <span class="text-overline text-accent-alpine">ACTIVE COMMUTE SCORE</span>
            <div class="glance-score-row">
              <span class="glance-score-badge {{ c_tier }}">{{ c_val }}</span>
              <span class="glance-status-primary">{{ c_label }}</span>
            </div>
          </article>
        </a>
      {% endif %}

      {# 3.4: Active Transit Score #}
      {% if t_live and t_live.active_transit_score is not none %}
        {% set tr_val = t_live.active_transit_score | int %}
        {% set tr_tier = "score-tier-emerald" if tr_val >= 80 else ("score-tier-alpine" if tr_val >= 40 else "score-tier-crimson") %}
        {% set tr_label = "High Service" if tr_val >= 80 else ("Moderate Service" if tr_val >= 40 else "Low Service") %}
        <a href="/neighborhood/{{ city_slug }}/transit-commute/" class="glance-tile-link">
          <article class="glance-tile-card">
            <span class="text-overline text-accent-alpine">ACTIVE TRANSIT SCORE</span>
            <div class="glance-score-row">
              <span class="glance-score-badge {{ tr_tier }}">{{ tr_val }}</span>
              <span class="glance-status-primary">{{ tr_label }}</span>
            </div>
          </article>
        </a>
      {% endif %}

      {# 3.5: Real Estate Market Gauge #}
      {% if supply_val is not none %}
        {% set m_supply = supply_val | float %}
        {% set m_capped = 6.0 if m_supply > 6.0 else (0.0 if m_supply < 0.0 else m_supply) %}
        {% set m_angle = -90 + ((m_capped / 6.0) * 180) %}
        {% set m_state = "Seller's Market" if m_supply < 2.0 else ("Balanced Market" if m_supply <= 4.0 else "Buyer's Market") %}
        <a href="/neighborhood/{{ city_slug }}/real-estate/" class="glance-tile-link">
          <article class="glance-tile-card">
            <span class="text-overline text-accent-alpine">REAL ESTATE MARKET</span>
            <div class="glance-gauge-row">
              <div class="glance-gauge-stage" aria-hidden="true">
                <svg viewBox="0 0 100 54" class="glance-gauge-svg">
                  <defs>
                    <linearGradient id="glanceMarketGrad-{{ city_slug }}" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#D9232A" />
                      <stop offset="28%" stop-color="#D9232A" />
                      <stop offset="38%" stop-color="#1E4D6B" />
                      <stop offset="62%" stop-color="#1E4D6B" />
                      <stop offset="72%" stop-color="#D9232A" />
                      <stop offset="100%" stop-color="#D9232A" />
                    </linearGradient>
                  </defs>
                  <path d="M 10 48 A 40 40 0 0 1 90 48" fill="none" stroke="url(#glanceMarketGrad-{{ city_slug }})" stroke-width="11" stroke-linecap="round" />
                  <g transform="translate(50, 48) rotate({{ m_angle }})">
                    <polygon points="-2,0 2,0 0,-36" class="glance-gauge-needle" />
                    <circle cx="0" cy="0" r="4" class="glance-gauge-needle" />
                  </g>
                </svg>
              </div>
              <span class="glance-status-primary">{{ m_state }}</span>
            </div>
          </article>
        </a>
      {% endif %}

    </div>
  </section>

  <hr class="section-divider">

  {# ==========================================================================
     SECTION 4: FEATURED LOCAL BUSINESSES
     ========================================================================== #}
  {% set city_cats = city_businesses[city_slug].categories if (city_businesses and city_businesses[city_slug] and city_businesses[city_slug].categories) else null %}
  {% set active_featcat_key = "FeatCat" ~ current_month %}
  {% set feat_raw = city[active_featcat_key] | default("coffee") %}
  {% set feat_tags = feat_raw.split(',') %}
  {% set tag_aliases = {
    "breakfast_brunch": "coffee",
    "coffeeroasters": "coffee",
    "desserts": "bakeries",
    "icecream": "bakeries",
    "gelato": "bakeries",
    "italian": "pizza",
    "tacos": "mexican",
    "foodtrucks": "mexican",
    "fishnchips": "seafood",
    "beer_gardens": "breweries",
    "pubs": "breweries",
    "sportsbars": "breweries",
    "vietnamese": "thai",
    "ramen": "thai",
    "newamerican": "steak"
  } %}

  {% set resolved_biz_list = [] %}
  {% set resolved_cat_name = "" %}
  {% if city_cats %}
    {% for raw_tag in feat_tags %}
      {% set t_clean = raw_tag | trim | lower %}
      {% set mapped_key = t_clean if city_cats[t_clean] is defined else tag_aliases[t_clean] %}
      {% if (resolved_biz_list | length) == 0 and mapped_key and city_cats[mapped_key] and (city_cats[mapped_key] | length) > 0 %}
        {% set resolved_biz_list = city_cats[mapped_key] %}
        {% set resolved_cat_name = mapped_key %}
      {% endif %}
    {% endfor %}
    {% if (resolved_biz_list | length) == 0 %}
      {% for cat_k, cat_arr in city_cats %}
        {% if (resolved_biz_list | length) == 0 and cat_arr and (cat_arr | length) > 0 %}
          {% set resolved_biz_list = cat_arr %}
          {% set resolved_cat_name = cat_k %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endif %}

  {% if (resolved_biz_list | length) > 0 %}
    <section id="featured-businesses" class="portal-section-businesses">
      <h2 class="text-section-title section-title-clean">Featured Local Businesses</h2>
      <div class="horizontal-scroll-section scroll-variant-medium" tabindex="0">
        {% for biz in resolved_biz_list %}
          {% if biz.name and loop.index0 < 3 %}
            <div class="horizontal-scroll-item">
              {% set business_name = biz.name %}
              {% set business_category = resolved_cat_name or biz.category %}
              {% set business_price_level = biz.price_level %}
              {% set business_rating = biz.rating %}
              {% set business_reviews_count = biz.review_count %}
              {% set business_address = biz.location %}
              {% set business_summary = biz.summary %}
              {% set business_image_url = biz.image_url %}
              {% set business_url = biz.url %}
              {% include "components/widget/business-listing.njk" %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <hr class="section-divider">
  {% endif %}

  {# ==========================================================================
     SECTION 5: NEWS & EVENTS (Full 1200px Side-by-Side 2-Column Split)
     ========================================================================== #}
  {% set news_region_primary = city['News Region'].split(',')[0] | trim | lower if city['News Region'] else city_slug %}
  {% set filtered_news = [] %}
  {% if market_news %}
    {% for article in market_news %}
      {% set a_tags = (article.tags | join(' ') | lower) if article.tags else '' %}
      {% set a_cities = (article.cities | join(' ') | lower) if article.cities else '' %}
      {% if (city_slug in a_tags) or (city_slug in a_cities) or (news_region_primary in a_tags) %}
        {% set filtered_news = (filtered_news.push(article), filtered_news) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% set county_tag = "county-" ~ (city.County | lower | replace(' ', '-')) %}
  {% set city_tag = "city-" ~ city_slug %}
  {% set events_source = public_events_feed if public_events_feed else public_events %}
  {% set filtered_events = [] %}
  {% if events_source %}
    {% for ev in events_source %}
      {% set ev_tags = (ev.tags | join(' ') | lower) if ev.tags else '' %}
      {% set ev_city = (ev.city | lower) if ev.city else '' %}
      {% if (ev_city == city_slug) or (ev_city == (city.City | lower)) or (city_tag in ev_tags) or (county_tag in ev_tags) %}
        {% set filtered_events = (filtered_events.push(ev), filtered_events) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if (filtered_news | length) > 0 or (filtered_events | length) > 0 %}
    <section id="news-events" class="portal-section-news-events">
      <h2 class="text-section-title section-title-clean">News &amp; Events</h2>
      <div class="section-grid-static grid-cols-2">

        {% if (filtered_news | length) > 0 %}
          <div>
            {% set city_name = active_neighborhood %}
            {% set news_heading = "Recent News" %}
            {% set news_items = filtered_news %}
            {% set predefined_category = null %}
            {% set news_all_url = "/neighborhood/" ~ city_slug ~ "/news-events/" %}
            {% include "components/widget/news-summary-list-five.njk" %}
          </div>
        {% endif %}

        {% if (filtered_events | length) > 0 %}
          <div>
            {% set city_name = active_neighborhood %}
            {% set events_heading = "Upcoming Events" %}
            {% set events_items = filtered_events %}
            {% set predefined_category = null %}
            {% set events_all_url = "/neighborhood/" ~ city_slug ~ "/news-events/" %}
            {% include "components/widget/events-summary-list-five.njk" %}
          </div>
        {% endif %}

      </div>
    </section>

    <hr class="section-divider">
  {% endif %}

  {# ==========================================================================
     SECTION 6: SPORTS (Compact 3-Column Level Scoreboards)
     ========================================================================== #}
  {% if sports_data and sports_data.teams %}
    <section id="local-sports" class="portal-section-sports">
      <h2 class="text-section-title section-title-clean">Sports</h2>
      <div class="section-grid-static grid-cols-3 sports-compact-grid">
        {% set display_levels = ["Professional", "Minor League", "Collegiate"] %}
        {% for target_level in display_levels %}
          {% set matched_team = null %}
          {% for team in sports_data.teams %}
            {% if not matched_team and team.level == target_level and team.recentGames and (team.recentGames | length) > 0 %}
              {% set matched_team = team %}
            {% endif %}
          {% endfor %}

          {% if matched_team %}
            {% set latest_game = matched_team.recentGames[0] %}
            <div>
              {% set scorebox_header = (latest_game.league or matched_team.sport) ~ " • " ~ matched_team.teamName %}
              {% set scorebox_status_text = (latest_game.status or "FINAL") | upper %}
              {% set scorebox_local_name = latest_game.home_team %}
              {% set scorebox_local_record = "(" ~ matched_team.currentRecord ~ ")" if matched_team.currentRecord else "" %}
              {% set scorebox_local_score = latest_game.home_score %}
              {% set scorebox_opp_name = latest_game.away_team %}
              {% set scorebox_opp_record = "" %}
              {% set scorebox_opp_score = latest_game.away_score %}
              {% set scorebox_recap_url = "/sports/" ~ matched_team.slug ~ "/" %}
              {% include "components/widget/sports-score-box.njk" %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <hr class="section-divider">
  {% endif %}

  {# ==========================================================================
     SECTION 7: ABOUT NEIGHBORHOOD (Single Section Heading + Prose Card)
     ========================================================================== #}
  {% set active_ep = "EP12" %}
  {% for m in range(1, 13) %}
    {% set ep_date_str = city["EPDate" ~ m] %}
    {% if ep_date_str and (ep_date_str | length) >= 10 %}
      {% set ep_parts = ep_date_str.split('-') %}
      {% set ep_mmdd = ep_parts[1] ~ "-" ~ ep_parts[2] %}
      {% if today_mmdd >= ep_mmdd %}
        {% set active_ep = "EP" ~ m %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% set raw_editorial_md %}{% include "editorials/" ~ city_slug ~ ".md" ignore missing %}{% endset %}
  {% set normalized_md = raw_editorial_md | replace("\r\n", "\n") %}
  {% set ep_marker = active_ep ~ "**" %}
  {% set editorial_html = "" %}
  {% if normalized_md and (ep_marker in normalized_md) %}
    {% set md_blocks = normalized_md.split("### **") %}
    {% for block in md_blocks %}
      {% if block.startsWith(ep_marker) %}
        {% set clean_prose = block.replace(ep_marker, "") | trim %}
        {% set para_list = clean_prose.split("\n\n") %}
        {% for para in para_list %}
          {% set p_trimmed = para | trim %}
          {% if p_trimmed %}
            {% set editorial_html = editorial_html ~ "<p>" ~ p_trimmed ~ "</p>" %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if editorial_html %}
    <section id="about-neighborhood" class="portal-section-editorial" aria-label="About {{ active_neighborhood }}">
      <h2 class="text-section-title section-title-clean">About {{ active_neighborhood }}</h2>
      <article class="surface-bento neighborhood-editorial-card">
        <div class="editorial-prose-body text-body">
          {{ editorial_html | safe }}
        </div>
      </article>
    </section>
  {% endif %}

</main>