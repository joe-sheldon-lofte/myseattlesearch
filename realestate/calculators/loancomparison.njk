<script>
  let uniqueCardIndex = 0;
  const conformingLoanCapBoundary = 832750;

  let coreProgramRateRegistry = {
    'Conventional': 6.50,
    'FHA': 6.125,
    'VA': 6.125,
    'Conventional-DPA': 7.00,
    'FHA-DPA': 6.625
  };

  document.addEventListener('DOMContentLoaded', () => {
    fetch('/data/hourly_rates.json')
      .then(response => response.json())
      .then(rows => {
        if (rows && rows.length > 0) {
          const validRows = rows.filter(r => Object.values(r)[0] && String(Object.values(r)[0]).trim() !== '');
          validRows.sort((a, b) => new Date(Object.values(a)[0].split(' ')[0]) - new Date(Object.values(b)[0].split(' ')[0]));
          const latestRow = validRows[validRows.length - 1];
          const latestVals = Object.values(latestRow);
          
          const convRate = parseFloat(latestVals[1]);
          const fhaRate = parseFloat(latestVals[2]);
          const vaRate = parseFloat(latestVals[3]);

          if (!isNaN(convRate)) {
            coreProgramRateRegistry['Conventional'] = convRate;
            coreProgramRateRegistry['Conventional-DPA'] = convRate + 0.50;
          }
          if (!isNaN(fhaRate)) {
            coreProgramRateRegistry['FHA'] = fhaRate;
            coreProgramRateRegistry['FHA-DPA'] = fhaRate + 0.50;
          }
          if (!isNaN(vaRate)) coreProgramRateRegistry['VA'] = vaRate;
          
          addNewStrategyInputCard('Strategy A', 'Conventional', '', '', '%', coreProgramRateRegistry['Conventional'].toFixed(3), '', '');
          addNewStrategyInputCard('Strategy B', 'FHA', '', '', '%', coreProgramRateRegistry['FHA'].toFixed(3), '', '');
        } else {
          throw new Error("No live rates found");
        }
      })
      .catch(error => {
        console.error("Error loading live rates, defaulting to baselines", error);
        addNewStrategyInputCard('Strategy A', 'Conventional', '', '', '%', 6.50, '', '');
        addNewStrategyInputCard('Strategy B', 'FHA', '', '', '%', 6.125, '', '');
      });
  });

  function addNewStrategyInputCard(label = '', type = 'Conventional', price = '', downVal = '', downUnit = '%', rate = '', fees = '', closing = '') {
    uniqueCardIndex++;
    const id = uniqueCardIndex;
    const deckContainer = document.getElementById('strategyDeckContainer');
    const cardEl = document.createElement('article');
    cardEl.className = 'surface-bento calc-strategy-card';
    cardEl.id = `strategy_card_${id}`;
    const cardLabel = label || `Strategy Profile ${id}`;
    const matchedRate = rate || coreProgramRateRegistry[type] || 6.50;

    cardEl.innerHTML = `
      <div>
        <div class="card-header-split">
          <h3><input type="text" class="input-profile-name calc-card-title-input" value="${cardLabel}" aria-label="Strategy Profile Name"></h3>
          <button type="button" class="btn-delete-card" onclick="deleteStrategyCardNode(${id})">Delete</button>
        </div>
        <div class="section-grid-static grid-cols-2">
          <div class="calc-field-group">
            <label for="type_${id}">Loan Program</label>
            <select class="input-loan-type" id="type_${id}" onchange="handleProgramTypeRateShift(${id}, this.value)">
              <option value="Conventional" ${type==='Conventional'?'selected':''}>Conventional</option>
              <option value="FHA" ${type==='FHA'?'selected':''}>Standard FHA</option>
              <option value="VA" ${type==='VA'?'selected':''}>VA Loan</option>
              <option value="Conventional-DPA" ${type==='Conventional-DPA'?'selected':''}>Conventional + WA DPA</option>
              <option value="FHA-DPA" ${type==='FHA-DPA'?'selected':''}>FHA + WA DPA</option>
            </select>
          </div>
          <div class="calc-field-group">
            <label for="price_${id}">Purchase Price ($)</label>
            <input type="number" class="input-purchase-price" id="price_${id}" value="${price}" oninput="evaluateCardUnderwritingConstraints(${id}, 'price')">
          </div>
          <div class="calc-field-group">
            <label for="rate_${id}">Interest Rate (%)</label>
            <input type="number" class="input-interest-rate" id="rate_${id}" value="${matchedRate}" step="0.125">
          </div>
          <div class="calc-field-group">
            <label for="down_${id}">Down Payment</label>
            <div class="calc-input-combo">
              <input type="number" class="input-down-value" id="down_${id}" value="${downVal}" oninput="evaluateCardUnderwritingConstraints(${id}, 'down')">
              <select class="input-down-unit" id="unit_${id}" onchange="evaluateCardUnderwritingConstraints(${id}, 'unit')" aria-label="Down Payment Unit">
                <option value="%" ${downUnit==='%'?'selected':''}>%</option>
                <option value="$" ${downUnit==='$'?'selected':''}>$</option>
              </select>
            </div>
          </div>
          <div class="calc-field-group">
            <label for="fees_${id}">Points &amp; Fees ($)</label>
            <input type="number" class="input-program-fees" id="fees_${id}" value="${fees}">
          </div>
          <div class="calc-field-group">
            <label for="closing_${id}">Closing Costs ($)</label>
            <input type="number" class="input-closing-costs" id="closing_${id}" value="${closing}">
            <button type="button" class="btn-estimate-trigger" onclick="runAutoEstimateForCard(${id})">Estimate for me</button>
          </div>
        </div>
      </div>
      <div class="action-tray-constrained">
        <button type="button" class="btn btn-secondary" onclick="replicateStrategyCardNode(${id})">Duplicate Strategy</button>
      </div>
    `;
    deckContainer.appendChild(cardEl);
    evaluateCardUnderwritingConstraints(id, 'init');
  }

  function deleteStrategyCardNode(id) {
    const node = document.getElementById(`strategy_card_${id}`);
    if (node) node.remove();
  }

  function replicateStrategyCardNode(id) {
    const card = document.getElementById(`strategy_card_${id}`);
    if (!card) return;
    addNewStrategyInputCard(
      card.querySelector('.input-profile-name').value + ' Copy',
      card.querySelector('.input-loan-type').value,
      card.querySelector('.input-purchase-price').value,
      card.querySelector('.input-down-value').value,
      card.querySelector('.input-down-unit').value,
      card.querySelector('.input-interest-rate').value,
      card.querySelector('.input-program-fees').value,
      card.querySelector('.input-closing-costs').value
    );
  }

  function handleProgramTypeRateShift(id, val) {
    const card = document.getElementById(`strategy_card_${id}`);
    if (card) card.dataset.automated = "true";
    const rateInput = document.getElementById(`rate_${id}`);
    if (rateInput && coreProgramRateRegistry[val]) rateInput.value = coreProgramRateRegistry[val].toFixed(3);
    evaluateCardUnderwritingConstraints(id, 'program');
  }

  function runAutoEstimateForCard(id) {
    const price = parseFloat(document.getElementById(`price_${id}`).value) || 0;
    const closingEl = document.getElementById(`closing_${id}`);
    if (price > 0) {
      const lenderFlatFees = 1250;
      const escrowTitleClosingScale = (price * 0.004) + 1200;
      const upfrontEscrowTaxes = price * 0.009;
      let computedAnnualInsurance = 1200;
      if (price > 500000) computedAnnualInsurance += (price - 500000) * (1800 / 1000000);
      closingEl.value = Math.round(lenderFlatFees + escrowTitleClosingScale + upfrontEscrowTaxes + computedAnnualInsurance);
    } else {
      alert("Please enter a purchase price first to estimate closing costs.");
    }
  }

  function evaluateCardUnderwritingConstraints(id, source) {
    const card = document.getElementById(`strategy_card_${id}`);
    if (!card) return;
    const type = card.querySelector('.input-loan-type').value;
    const price = parseFloat(document.getElementById(`price_${id}`).value) || 0;
    const downValEl = document.getElementById('down_' + id);
    const feesEl = document.getElementById('fees_' + id);
    const unitEl = document.getElementById('unit_' + id);

    if (source === 'down' || source === 'unit') card.dataset.automated = "false";
    if (price === 0) return;

    if (type.includes('DPA')) {
      const isHighBalance = (price * 0.97 > conformingLoanCapBoundary);
      if (card.dataset.automated !== "false") {
        if (isHighBalance) {
          downValEl.value = Math.round(price * 0.01);
          unitEl.value = '$';
        } else {
          downValEl.value = 0;
          unitEl.value = '$';
        }
        card.dataset.automated = "true";
      }
      if (isHighBalance) {
        feesEl.value = Math.round((price * 0.95) * 0.02);
      } else {
        feesEl.value = Math.round(Math.min(price * 0.97, conformingLoanCapBoundary) * 0.01);
      }
    } else {
      if (source === 'program') {
        feesEl.value = '';
        downValEl.value = (type === 'FHA') ? 3.5 : (type === 'VA' ? 0 : 5);
        unitEl.value = '%';
        card.dataset.automated = "false";
      }
    }
  }

  function calculateMortgageAmortization(principal, annualRate) {
    if (principal <= 0) return 0;
    const monthlyRate = (annualRate / 100) / 12;
    const totalPaymentsCount = 360;
    if (monthlyRate === 0) return principal / totalPaymentsCount;
    return principal * (monthlyRate * Math.pow(1 + monthlyRate, totalPaymentsCount)) / (Math.pow(1 + monthlyRate, totalPaymentsCount) - 1);
  }

  function processStrategyComparisonMatrix() {
    const cards = document.querySelectorAll('.calc-strategy-card');
    const outputBody = document.getElementById('matrixTableBodyOutput');
    if (cards.length === 0) return;
    let outputBuffer = '';

    cards.forEach(card => {
      const id = card.id.replace('strategy_card_', '');
      const profileName = card.querySelector('.input-profile-name').value || `Strategy ${id}`;
      const programType = card.querySelector('.input-loan-type').value;
      const price = parseFloat(document.getElementById(`price_${id}`).value) || 0;
      const rate = parseFloat(document.getElementById(`rate_${id}`).value) || 0;
      const downValue = parseFloat(document.getElementById(`down_${id}`).value) || 0;
      const downUnit = document.getElementById(`unit_${id}`).value;
      const programPoints = parseFloat(document.getElementById(`fees_${id}`).value) || 0;
      const closingCosts = parseFloat(document.getElementById(`closing_${id}`).value) || 0;

      let calculatedDownPaymentDollars = downValue;
      if (downUnit === '%') calculatedDownPaymentDollars = price * (downValue / 100);

      let principalFirstMortgage = price - calculatedDownPaymentDollars;
      
      if (programType.includes('DPA') && price > 0) {
        if (price * 0.97 <= conformingLoanCapBoundary) {
          principalFirstMortgage = Math.min(price * 0.97, conformingLoanCapBoundary);
          calculatedDownPaymentDollars = 0;
        } else {
          principalFirstMortgage = price * 0.95;
          calculatedDownPaymentDollars = price * 0.01;
        }
      }

      const absoluteCashRequiredAtClosing = calculatedDownPaymentDollars + programPoints + closingCosts;
      const monthlyPrincipalAndInterest = calculateMortgageAmortization(principalFirstMortgage, rate);

      outputBuffer += `
        <tr>
          <td class="cell-year-header">${profileName}<br><span class="cell-year-sub">${programType} @ ${rate.toFixed(3)}%</span></td>
          <td>${formatCurrency(price)}</td>
          <td>${formatCurrency(principalFirstMortgage)}</td>
          <td>${formatCurrency(calculatedDownPaymentDollars)}</td>
          <td>${programPoints > 0 ? formatCurrency(programPoints) : '$0'}</td>
          <td>${formatCurrency(closingCosts)}</td>
          <td class="cell-cash-highlight">${formatCurrency(absoluteCashRequiredAtClosing)}</td>
          <td class="cell-payment-large">${formatCurrency(monthlyPrincipalAndInterest)}</td>
        </tr>
      `;
    });

    outputBody.innerHTML = outputBuffer;
    const resultsStage = document.getElementById('resultsCardWrapper');
    resultsStage.style.display = 'block';
    resultsStage.scrollIntoView({ behavior: 'smooth' });
  }

  function formatCurrency(num) {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(num);
  }
</script>