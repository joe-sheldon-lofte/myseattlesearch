<script>
  document.addEventListener('DOMContentLoaded', () => {
    const citySelect = document.getElementById('radarCitySelect');
    const yearInput = document.getElementById('radarYearBuilt');
    const chkOil = document.getElementById('chkOilTank');
    const chkSeptic = document.getElementById('chkSepticWell');
    const chkBasement = document.getElementById('chkBasementCrawl');
    const presetBtns = document.querySelectorAll('.radar-preset-btn');
    const allCards = document.querySelectorAll('.radar-result-node');
    const noResultsMsg = document.getElementById('no-results-msg');
    const badge = document.getElementById('radarResultsBadge');

    let citiesDataset = [];

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => {
          b.classList.remove('is-active');
          b.classList.add('is-inactive');
        });
        btn.classList.remove('is-inactive');
        btn.classList.add('is-active');

        yearInput.value = btn.getAttribute('data-year');
        evaluateRadar();
      });
    });

    [citySelect, yearInput, chkOil, chkSeptic, chkBasement].forEach(ctrl => {
      if (!ctrl) return;
      ctrl.addEventListener('change', evaluateRadar);
      if (ctrl.tagName === 'INPUT' && ctrl.type === 'number') {
        ctrl.addEventListener('input', evaluateRadar);
      }
    });

    // We only fetch city_data to get the string tags for the selected city.
    fetch('/data/city_data.json').then(r => r.ok ? r.json() : []).then(cities => {
      citiesDataset = Array.isArray(cities) ? cities : [];
      evaluateRadar();
    }).catch(err => {
      console.warn('City dataset sync fallback:', err);
      evaluateRadar();
    });

    function evaluateRadar() {
      const cityName = citySelect ? citySelect.value : 'Lynnwood';
      const year = parseInt(yearInput ? yearInput.value : 1975, 10) || 1975;
      const hasOil = chkOil ? chkOil.checked : false;
      const hasSeptic = chkSeptic ? chkSeptic.checked : false;
      const hasBasement = chkBasement ? chkBasement.checked : true;

      const cityObj = citiesDataset.find(c => c.City === cityName) || {};
      const rawTags = cityObj['Health Hazards'] || cityObj['health_hazards'] || '';
      const tags = rawTags.split(',').map(t => t.trim().toLowerCase()).filter(Boolean);

      let visibleCount = 0;

      allCards.forEach(card => {
        let isMatch = false;
        const triggerType = card.getAttribute('data-trigger-type');
        const triggerKey = card.getAttribute('data-trigger-key');

        if (triggerType === 'always') {
          isMatch = true;
        } else if (triggerType === 'city_tag' && tags.includes(triggerKey.toLowerCase())) {
          isMatch = true;
        } else if (triggerType === 'year_built_before' && year < parseInt(triggerKey, 10)) {
          isMatch = true;
        } else if (triggerType === 'feature') {
          if (triggerKey === 'has_oil_tank' && hasOil) isMatch = true;
          if (triggerKey === 'has_septic_well' && hasSeptic) isMatch = true;
          if (triggerKey === 'has_basement_crawl' && hasBasement) isMatch = true;
        }

        if (isMatch) {
          card.classList.remove('radar-card-hidden');
          visibleCount++;
        } else {
          card.classList.add('radar-card-hidden');
        }
      });

      if (badge) {
        badge.textContent = `${visibleCount} Factors Identified for ${cityName} (${year})`;
      }

      if (visibleCount === 0) {
        noResultsMsg.classList.remove('radar-card-hidden');
      } else {
        noResultsMsg.classList.add('radar-card-hidden');
      }
    }
  });
</script>