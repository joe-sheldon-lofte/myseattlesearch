<script>
  document.addEventListener('DOMContentLoaded', () => {
    const citySelect = document.getElementById('radarCitySelect');
    const yearInput = document.getElementById('radarYearBuilt');
    const chkOil = document.getElementById('chkOilTank');
    const chkSeptic = document.getElementById('chkSepticWell');
    const chkBasement = document.getElementById('chkBasementCrawl');
    const presetBtns = document.querySelectorAll('.radar-preset-btn');
    const container = document.getElementById('radarResultsContainer');
    const badge = document.getElementById('radarResultsBadge');

    let citiesDataset = [];
    let masterHazardsDataset = [];

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => {
          b.classList.remove('is-active');
          b.classList.add('is-inactive');
        });
        btn.classList.remove('is-inactive');
        btn.classList.add('is-active');

        yearInput.value = btn.getAttribute('data-year');
        evaluateRadar();
      });
    });

    [citySelect, yearInput, chkOil, chkSeptic, chkBasement].forEach(ctrl => {
      if (!ctrl) return;
      ctrl.addEventListener('change', evaluateRadar);
      if (ctrl.tagName === 'INPUT' && ctrl.type === 'number') {
        ctrl.addEventListener('input', evaluateRadar);
      }
    });

    Promise.all([
      fetch('/data/city_data.json').then(r => r.ok ? r.json() : []),
      fetch('/data/hazards_master.json').then(r => r.ok ? r.json() : [])
    ]).then(([cities, hazards]) => {
      citiesDataset = Array.isArray(cities) ? cities : [];
      masterHazardsDataset = Array.isArray(hazards) ? hazards : [];
      evaluateRadar();
    }).catch(err => {
      console.warn('Radar data sync fallback engaged:', err);
    });

    function evaluateRadar() {
      if (!masterHazardsDataset.length) return;

      const cityName = citySelect ? citySelect.value : 'Lynnwood';
      const year = parseInt(yearInput ? yearInput.value : 1975, 10) || 1975;
      const hasOil = chkOil ? chkOil.checked : false;
      const hasSeptic = chkSeptic ? chkSeptic.checked : false;
      const hasBasement = chkBasement ? chkBasement.checked : true;

      const cityObj = citiesDataset.find(c => c.City === cityName) || {};
      const rawTags = cityObj['Health Hazards'] || cityObj['health_hazards'] || '';
      const tags = rawTags.split(',').map(t => t.trim().toLowerCase()).filter(Boolean);

      const matchedHazards = [];

      masterHazardsDataset.forEach(item => {
        let isMatch = false;

        if (item.trigger_type === 'always') {
          isMatch = true;
        } else if (item.trigger_type === 'city_tag' && tags.includes(String(item.trigger_key).toLowerCase())) {
          isMatch = true;
        } else if (item.trigger_type === 'year_built_before' && year < parseInt(item.trigger_key, 10)) {
          isMatch = true;
        } else if (item.trigger_type === 'feature') {
          if (item.trigger_key === 'has_oil_tank' && hasOil) isMatch = true;
          if (item.trigger_key === 'has_septic_well' && hasSeptic) isMatch = true;
          if (item.trigger_key === 'has_basement_crawl' && hasBasement) isMatch = true;
        }

        if (isMatch) matchedHazards.push(item);
      });

      renderRadar(matchedHazards, cityName, year);
    }

    function renderRadar(hazards, cityName, year) {
      if (!container) return;

      if (badge) {
        badge.textContent = `${hazards.length} Factors Identified for ${cityName} (${year})`;
      }

      if (hazards.length === 0) {
        container.innerHTML = `
          <div class="calc-breakdown-row row-gross" style="grid-column: 1 / -1;">
            <span class="text-body">No localized environmental hazards identified for this exact selection. Standard Washington State safety codes apply.</span>
          </div>
        `;
        return;
      }

      container.innerHTML = hazards.map(item => {
        const canonicalUrl = (item.url || '#').replace('/resources/health-hazards/', '/realestate/resources/healthhazards/');
        const catLabel = item.category ? item.category.toUpperCase() : 'PROPERTY FACTOR';

        return `
          <article class="surface-bento calc-strategy-card">
            <header class="text-center">
              <div class="text-overline text-accent-alpine">${catLabel}</div>
              <h3 class="text-widget-title">${item.title}</h3>
            </header>
            <div class="calc-field-group">
              <p class="text-body">${item.summary}</p>
            </div>
            <div class="action-tray-constrained section-action-tray">
              <a href="${canonicalUrl}" class="btn btn-secondary">
                <span>Read Full Guide &rarr;</span>
              </a>
            </div>
          </article>
        `;
      }).join('');
    }
  });
</script>