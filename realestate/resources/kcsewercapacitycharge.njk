  <section id="sewer-calculator" class="content-section-centered">
    <h2 class="text-section-title">Sewer Capacity Payoff &amp; Statement Estimator</h2>
    <p class="text-body section-body-prose">
      Model your recurring quarterly statements, remaining standard gross balance, and estimated early lump-sum payoff savings.
    </p>

    <div class="surface-bento">
      <div class="section-grid-static grid-cols-2">
        <div class="calc-field-group">
          <label for="sewer-tier">Property Size &amp; Layout Class</label>
          <select id="sewer-tier" onchange="calculateSewerPayoff()">
            <option value="46.01">Accessory Dwelling Unit / ADU ($46.01/mo)</option>
