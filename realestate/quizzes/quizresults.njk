---
layout: layouts/base.njk
title: "Your Assessment Results | Joe Sheldon"
meta_description: "Review your personalized psychographic playbook and strategy recommendations."
permalink: /realestate/quizzes/results/index.html
---

<main class="layout-container layout-stack-main">
  <header class="surface-bento page-hero-bento">
    <div class="text-overline text-accent-alpine" id="res-overline">Analyzing Strategy...</div>
    <h1 class="text-page-title" id="res-heading">Generating Your Blueprint</h1>
    <p class="text-body page-hero-lead" id="res-subheading"></p>
  </header>

  <hr class="section-divider">

  <section class="content-section-centered quiz-results-section" id="res-content-section">
    <article class="surface-bento calc-strategy-card">
      <h2 class="text-widget-title">Your Playbook Overview</h2>
      <p class="text-body quiz-details-lead" id="res-details"></p>

      <div class="quiz-directives-callout">
        <h3 class="text-primary-charcoal quiz-directives-heading">Strategic Directives</h3>
        <p class="text-body quiz-directives-body" id="res-additional-details"></p>
      </div>

      <div class="action-tray-constrained section-action-tray quiz-return-tray">
        <a href="/" class="btn btn-secondary">Return to Homepage</a>
      </div>
    </article>
  </section>
</main>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const params = new URLSearchParams(window.location.search);
    const quizId = params.get('quizId');
    const resultKey = params.get('result');
    const headingEl = document.getElementById('res-heading');
    const subheadingEl = document.getElementById('res-subheading');
    const overlineEl = document.getElementById('res-overline');

    if (!quizId || !resultKey) {
      overlineEl.textContent = "Assessment";
      headingEl.textContent = "Result Not Found";
      subheadingEl.textContent = "No assessment result parameters were supplied in this link.";
      return;
    }

    try {
      const res = await fetch('/data/quizzes.json');
      if (!res.ok) throw new Error("Failed to load quizzes.json");
      const data = await res.json();
      const quiz = data[quizId];

      if (!quiz || !Array.isArray(quiz.routing) || quiz.routing.length === 0) {
        overlineEl.textContent = "Assessment";
        headingEl.textContent = "Result Not Found";
        subheadingEl.textContent = "We could not locate a matching playbook for this assessment.";
        return;
      }

      const match = quiz.routing.find(r => r.key === resultKey) || quiz.routing[0];

      overlineEl.textContent = quiz.name;
      headingEl.textContent = match.heading;
      subheadingEl.textContent = match.subheading;

      document.getElementById('res-details').textContent = match.details;

      const cleanDetails = (match.additionalDetails || match.details).replace("Joe's Coaching Blueprint For You: ", "");
      document.getElementById('res-additional-details').textContent = cleanDetails;

      document.getElementById('res-content-section').classList.add('is-visible');
    } catch (err) {
      console.error("Result parsing fault:", err);
      overlineEl.textContent = "Assessment";
      headingEl.textContent = "Unable to Load Result";
      subheadingEl.textContent = "Please refresh the page or return to the quiz directory to try again.";
    }
  });
</script>
