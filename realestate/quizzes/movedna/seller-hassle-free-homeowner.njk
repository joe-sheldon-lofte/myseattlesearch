<script>
  document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const clientName = urlParams.get('name') || '';
      if (clientName) {
          document.querySelectorAll('.client-dynamic-name-marker').forEach(el => el.textContent = clientName);
      }
      const canvas = document.getElementById('sharing-badge-canvas');
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.lineWidth = 6;
      ctx.strokeStyle = '#111111'; 
      ctx.strokeRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#111111';
      ctx.font = 'bold 11px system-ui, sans-serif';
      ctx.fillText('MOVEDNA™ REAL ESTATE PROFILE', 25, 35);
      ctx.fillStyle = '#333333';
      ctx.font = '15px system-ui, sans-serif';
      const userStr = clientName ? `I took Joe Sheldon's quiz and` : "I took Joe Sheldon's MoveDNA™ quiz and";
      ctx.fillText(userStr, 25, 70);
      ctx.fillText("my profile archetype is locked in as a:", 25, 95);
      ctx.fillStyle = '#0a84ff'; 
      ctx.font = 'italic bold 24px system-ui, sans-serif';
      ctx.fillText('Hassle-Free Homeowner!', 25, 135);
      ctx.fillStyle = '#777777';
      ctx.font = '11px system-ui, sans-serif';
      ctx.fillText('Uncover your default strategy at myseattlesearch.com', 25, 160);

      document.getElementById('download-badge-trigger').addEventListener('click', () => {
          const dl = document.createElement('a');
          dl.href = canvas.toDataURL('image/png');
          dl.download = (clientName ? clientName.toLowerCase() + '-' : '') + 'movedna-hasslefree.png';
          document.body.appendChild(dl);
          dl.click();
          document.body.removeChild(dl);
      });
  });
</script>