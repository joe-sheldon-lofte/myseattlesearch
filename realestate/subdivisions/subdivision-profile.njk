---
layout: layouts/base.njk
pagination:
  data: all_subdivisions
  size: 1
  alias: subdivision
permalink: "realestate/subdivisions/{{ subdivision.slug | slugify }}/index.html"
eleventyComputed:
  title: "{{ subdivision.name }} | Subdivision Plat Intelligence"
  search_scope: "subdivision"
---
<article class="subdivision-canvas" data-pagefind-body data-pagefind-filter="type:subdivision">
  {% set search_scope = "subdivision" %}
  {% set search_placeholder = "Search planned communities, plats, and subdivisions..." %}
  {% set search_title = "Subdivision & Community Directory" %}
  {% set search_overline = "REGIONAL SUBDIVISION INDEX" %}
  {% set search_element_id = "pagefind-subdivisions" %}
  {% include "components/widget/search-box.njk" %}

  {# Section 2.0: Core Community Plat Overview #}
  <section class="subdivision-section" id="subdivision-overview" aria-label="Subdivision Overview">
    {% set card_overline = "SUBDIVISION OVERVIEW" %}
    {% set card_title = subdivision.name %}
    {% set card_body_html = "<div class='subdivision-profile-meta'><p class='subdivision-meta-location'>" ~ subdivision.city ~ ", WA</p><p class='subdivision-meta-county'>County: " ~ subdivision.county ~ "</p><p class='subdivision-meta-lots'><span class='meta-label'>Number of Lots:</span> <span class='tabular-digit font-mono'>" ~ (subdivision.lot_count | default("N/A")) ~ "</span></p><p class='subdivision-meta-timestamp'><span class='meta-label'>Last Updated:</span> <span class='tabular-digit font-mono'>" ~ subdivision.last_updated ~ "</span></p></div>" %}
    {% include "components/widget/card-prose.njk" %}
  </section>

  {# Section 3.0: Official County Records & GIS Portal #}
  <nav class="subdivision-section subdivision-links-strip" aria-label="Official Public Records">
    {% set nav_label = "County Assessor Record" %}
    {% set nav_url = subdivision.assessor_url %}
    {% set is_active = false %}
    {% set is_external = true %}
    {% include "components/widget/neighborhood-nav-links.njk" %}

    {% set nav_label = "GIS Parcel Viewer" %}
    {% set nav_url = subdivision.gis_viewer_url %}
    {% set is_active = false %}
    {% set is_external = true %}
    {% include "components/widget/neighborhood-nav-links.njk" %}
  </nav>

  {# Section 4.0: Plat Geographic Location #}
  <section class="subdivision-section" id="plat-location" aria-label="{{ subdivision.name }} Community Location">
    <div class="section-title-stack">
      <span class="text-overline text-accent-alpine">GEOGRAPHIC ENCLAVE</span>
      <h2 class="text-section-title">Community Plat Location</h2>
    </div>

    {% if subdivision.latitude and subdivision.longitude %}
      {% set map_id = "plat-map-" ~ (subdivision.slug | slugify) %}
      {% set map_center = [subdivision.latitude, subdivision.longitude] %}
      {% set map_zoom = 15 %}
      {% set marker_component = "graphic.map.subdivision" %}
      {% set markers = [{
        name: subdivision.name,
        slug: subdivision.slug,
        lat: subdivision.latitude,
        lng: subdivision.longitude,
        lots: subdivision.lot_count,
        url: "/realestate/subdivisions/" ~ (subdivision.slug | slugify) ~ "/"
      }] %}
      {% include "components/widget/map-custom.njk" %}
    {% else %}
      <div class="subdivision-empty-shield">
        <div class="subdivision-empty-inner">
          <span class="text-overline text-muted">CARTOGRAPHIC TELEMETRY PENDING</span>
          <h3 class="subdivision-empty-title">Plat Geolocation Inactive</h3>
          <p class="subdivision-empty-subtext">Verified survey coordinates for {{ subdivision.name }} are currently pending county recorder indexing.</p>
          <div class="subdivision-empty-badge">NO DATA</div>
        </div>
      </div>
    {% endif %}
  </section>
</article>