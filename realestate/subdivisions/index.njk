<div class="map-viewport" id="subdivisions-map" aria-label="Interactive Regional Plat & Subdivision Directory">
  {% for plat in all_subdivisions %}
    {% if plat.latitude and plat.longitude %}
      {# Compile-time marker pin template instantiation #}
      {% include "components/graphic/map-subdivision.njk" with {
        plat_name: plat.name,
        plat_slug: plat.slug,
        lot_count: plat.lot_count
      } %}
    {% endif %}
  {% endfor %}
</div>