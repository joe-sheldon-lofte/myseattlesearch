{# Leaflet Library & ESRI Base Layer Execution #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script type="module" src="/assets/js/local-reviews.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", async function() {
        const mapContainer = document.getElementById('sales-spatial-map');
        if (!mapContainer || typeof L === 'undefined') return;

        // 1. Initialize Map View
        const mapInstance = L.map('sales-spatial-map', {
            center: [47.75, -122.28],
            zoom: 10,
            scrollWheelZoom: false
        });

        // 2. High-Performance Esri Light Gray Base Canvas Layer
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
            maxZoom: 16
        }).addTo(mapInstance);

        // 3. In-Memory Data Pipeline (Eleventy Array or Dynamic Fetch Fallback)
        let salesData = [];
        {% if sales and sales.length %}
            salesData = {{ sales | dump | safe }};
        {% else %}
            try {
                const res = await fetch('/data/sales.json');
                if (res.ok) {
                    salesData = await res.json();
                }
            } catch (err) {
                console.warn('Local sales telemetry fallback engaged:', err);
            }
        {% endif %}

        if (!Array.isArray(salesData) || !salesData.length) return;

        // 4. Map Over Sales with Native SVG Circle Markers (Zero CSS required)
        salesData.forEach(function(property) {
            const rawLat = property.Latitude || property.latitude;
            const rawLng = property.Longitude || property.longitude;
            if (!rawLat || !rawLng) return;

            const lat = parseFloat(rawLat);
            const lng = parseFloat(rawLng);
            if (isNaN(lat) || isNaN(lng)) return;

            const statusStr = (property.Status || property.status || '').toLowerCase();
            
            // Color Mapping: Red (Sold), Green (Active), Yellow/Amber (Pending)
            let markerColor = '#D9232A'; // Default Sold
            let statusLabel = 'Sold / Closed';
            
            if (statusStr.includes('active')) {
                markerColor = '#10B981';
                statusLabel = 'Active';
            } else if (statusStr.includes('pending')) {
                markerColor = '#D97706';
                statusLabel = 'Pending';
            }

            const circleMarker = L.circleMarker([lat, lng], {
                radius: 6,
                fillColor: markerColor,
                color: '#FFFFFF',
                weight: 1.5,
                opacity: 1,
                fillOpacity: 0.9
            });

            const priceNum = property['Selling Price'] || property.sellingPrice || property['Listing Price'] || property.listingPrice || 0;
            const priceFormatted = Number(priceNum) > 0 ? '$' + Number(priceNum).toLocaleString('en-US') : 'Price Undisclosed';
            const propAddress = property.Address || property.address || 'Puget Sound Residence';
            const propCity = property.City || property.city || 'Washington';
            const propMls = property['MLS Number'] || property.mlsNumber || '';
            const propSlug = propAddress.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
            const detailUrl = propMls ? `/sales/${propSlug}-${propMls}/` : '#';

            const popupHtml = `
                <div style="font-family: system-ui, -apple-system, sans-serif; font-size: 13px; padding: 4px; width: 190px; line-height: 1.4;">
                    <strong style="font-size: 14px; color: #1C1C1E; display: block; margin-bottom: 2px;">${propAddress}</strong>
                    <span style="color: #6E6E73; font-size: 12px; display: block; margin-bottom: 8px;">${propCity}, WA &bull; ${statusLabel}</span>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 6px;">
                        <span style="font-weight: 600; color: #1C1C1E; font-variant-numeric: tabular-nums;">${priceFormatted}</span>
                        ${propMls ? `<a href="${detailUrl}" style="color: #1E4D6B; font-weight: 500; text-decoration: none;">Details &rarr;</a>` : ''}
                    </div>
                </div>
            `;

            circleMarker.bindPopup(popupHtml).addTo(mapInstance);
        });
    });
</script>