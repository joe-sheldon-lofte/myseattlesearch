---
layout: layouts/base.njk
pagination:
  data: unique_condos
  size: 1
  alias: condo
permalink: "realestate/condos/{{ condo.building_id | slugify }}/index.html"
eleventyComputed:
  title: "{{ condo.name }} | Condominium Intelligence Profile"
  search_scope: "condo"
---
<article class="condo-canvas" data-pagefind-body data-pagefind-filter="type:condo">
  {% set search_scope = "condo" %}
  {% set search_placeholder = "Search regional condo communities, buildings, or HOAs..." %}
  {% set search_title = "Condominium Community Directory" %}
  {% set search_overline = "REGIONAL CONDO INDEX" %}
  {% set search_element_id = "pagefind-condos" %}
  {% include "components/widget/search-box.njk" %}

  {# Section 2.0: Core Profile #}
  <section class="condo-section" id="condo-overview" aria-label="Condominium Overview">
    {% set card_overline = "COMMUNITY PROFILE" %}
    {% set card_title = condo.name %}
    {% set card_body_html = "<div class='condo-profile-meta'><p class='condo-meta-address'>" ~ condo.address ~ "<br>" ~ condo.city ~ ", " ~ condo.state ~ "</p><p class='condo-meta-county'>" ~ condo.county ~ " County</p><p class='condo-meta-timestamp'><span class='meta-timestamp-label'>Last Updated:</span> <span class='tabular-digit font-mono'>" ~ condo.last_updated ~ "</span></p></div>" %}
    {% include "components/widget/card-prose.njk" %}
  </section>

  {# Section 3.0: Underwriting & Physical Telemetry #}
  <section class="condo-section" id="condo-telemetry" aria-label="Financing and Building Telemetry">
    <div class="section-title-stack">
      <span class="text-overline text-accent-alpine">FINANCING & SPECIFICATIONS</span>
      <h2 class="text-section-title">Underwriting & Physical Telemetry</h2>
    </div>

    <div class="condo-telemetry-grid">
      {# Position 1: FHA Approval Status #}
      {% set stat_label = "FHA FINANCING" %}
      {% set stat_value = "APPROVED" if condo.fha_approved else "NOT APPROVED" %}
      {% set stat_subtext = "Eligible for FHA Loans" if condo.fha_approved else "Ineligible / Uncertified" %}
      {% set stat_accent = "var(--status-emerald)" if condo.fha_approved else "var(--color-secondary-muted)" %}
      {% set stat_tabular = false %}
      {% include "components/widget/stat-card.njk" %}

      {# Position 2: FHA Expiration Date #}
      {% set stat_label = "FHA EXPIRATION" %}
      {% set stat_value = condo.fha_expiration_date if condo.fha_expiration_date else "N/A" %}
      {% set stat_subtext = "Certification Renewal Due" if condo.fha_expiration_date else "No Active Certification" %}
      {% set stat_accent = "var(--color-primary-default)" %}
      {% set stat_tabular = true %}
      {% include "components/widget/stat-card.njk" %}

      {# Position 3: VA Approval Status #}
      {% set stat_label = "VA FINANCING" %}
      {% set stat_value = "APPROVED" if condo.va_approved else "NOT APPROVED" %}
      {% set stat_subtext = condo.va_status if condo.va_status else "Department of Veterans Affairs" %}
      {% set stat_accent = "var(--status-emerald)" if condo.va_approved else "var(--color-secondary-muted)" %}
      {% set stat_tabular = false %}
      {% include "components/widget/stat-card.njk" %}

      {# Position 4: Total Units #}
      {% set stat_label = "COMMUNITY SCALE" %}
      {% set stat_value = condo.total_units if condo.total_units else "N/A" %}
      {% set stat_subtext = "Total Recorded Residential Units" %}
      {% set stat_accent = "var(--color-secondary-default)" %}
      {% set stat_tabular = true %}
      {% include "components/widget/stat-card.njk" %}

      {# Position 5: Has Elevator #}
      {% set elevator_display = "N/A" %}
      {% if condo.has_elevator === true %}
        {% set elevator_display = "YES" %}
      {% elif condo.has_elevator === false %}
        {% set elevator_display = "NO" %}
      {% endif %}
      {% set stat_label = "ACCESSIBILITY" %}
      {% set stat_value = elevator_display %}
      {% set stat_subtext = "Elevator Service to Floors" %}
      {% set stat_accent = "var(--color-primary-default)" %}
      {% set stat_tabular = false %}
      {% include "components/widget/stat-card.njk" %}
    </div>
  </section>
</article>