---
layout: layouts/base.njk
permalink: "realestate/condos/index.html"
eleventyComputed:
  title: "Regional Condominium Directory | MySeattleSearch"
  search_scope: "condo"
---
<div class="directory-canvas">
  <header class="directory-header">
    <div class="section-title-stack">
      <span class="text-overline text-accent-alpine">MULTIFAMILY HOUSING TELEMETRY</span>
      <h1 class="text-section-title">Regional Condominium Directory</h1>
    </div>
  </header>

  {# Transform valid records into the markers payload expected by map-custom.njk #}
  {% set condo_markers = [] %}
  {% for condo in all_condos %}
    {% if condo.latitude and condo.longitude %}
      {% set marker_item = {
        name: condo.name,
        slug: condo.building_id,
        lat: condo.latitude,
        lng: condo.longitude,
        units: condo.total_units,
        fha: condo.fha_approved,
        va: condo.va_approved,
        url: "/realestate/condos/" ~ (condo.building_id | slugify) ~ "/"
      } %}
      {% set condo_markers = (condo_markers.push(marker_item), condo_markers) %}
    {% endif %}
  {% endfor %}

  {# Primary Cartographic Canvas #}
  <section class="directory-map-section" aria-label="Interactive Condominium Directory Map">
    {% set map_id = "master-condos-map" %}
    {% set map_center = [47.6062, -122.3321] %}
    {% set map_zoom = 11 %}
    {% set marker_component = "graphic.map.condobuilding" %}
    {% set markers = condo_markers %}
    {% include "components/widget/map-custom.njk" %}
  </section>
</div>