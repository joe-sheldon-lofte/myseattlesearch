---
layout: base.njk
title: Design System Component Catalog | MySeattleSearch
permalink: /city-test/
---

{% import "components/cards.njk" as cards %}
{% import "components/gauges.njk" as gauges %}
{% import "components/media.njk" as media %}
{% import "components/boards.njk" as boards %}

<!-- Left Margin Scroll Nodes (Desktop) -->
<div class="scroll-nodes-container">
  <div class="scroll-node"><span class="scroll-node-label">Page Surfaces</span></div>
  <div class="scroll-node"><span class="scroll-node-label">At-a-Glance Bar</span></div>
  <div class="scroll-node"><span class="scroll-node-label">Bento Cards</span></div>
  <div class="scroll-node"><span class="scroll-node-label">Floating Tray</span></div>
</div>

<header class="catalog-header">
  <h1>Design System Component Catalog</h1>
  <p>Sequential Element Inspection & Visual Testing Bench</p>
</header>

<!-- CATEGORY 1: CONTAINERS, SURFACES & ACTION TRAYS -->
<div class="catalog-section-title">Category 1: Containers, Surfaces & Action Trays</div>

<div class="element-block">
  <span class="element-badge">Element 01: Base Bento Card (1x1 Square = span-2)</span>
  <div class="bento-grid">
    {{ cards.bentoCard("1x1 Square", "Solid white (`#FFFFFF`), 18px squircle, ambient shadow.", "span-2") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 02: Callout Bento Card (Left Accent Edge)</span>
  <div class="bento-grid">
    {{ cards.bentoCard("Callout Bento Card", "Featuring a refined 4px Alpine Blue left accent border.", "span-4", "callout") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 03: Action Bento Card (1.5px Full Border Wrap)</span>
  <div class="bento-grid">
    {{ cards.bentoCard("Action Bento Card", "Wrapped in a 1.5px full Alpine Blue border for interactive tools and forms.", "span-4", "action") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 04: 6-Slot At-a-Glance Bento Bar (Full Span)</span>
  {{ gauges.glanceBar([
    { label: "Weather", value: "72° Sunny" },
    { label: "Tides", value: "High 11.2 ft" },
    { label: "Sunrise/Set", value: "6:12A / 8:24P" },
    { label: "Sports", value: "SEA 5 - LAA 2" },
    { label: "Market", value: "Seller's Market" },
    { label: "Transit", value: "82/100" }
  ]) }}
</div>

<!-- CATEGORY 2: MICRO-WIDGETS & PRECISION GAUGES -->
<div class="catalog-section-title">Category 2: Micro-Widgets & Precision Gauges</div>

<div class="element-block">
  <span class="element-badge">Element 05: Universal Info Trigger (+)</span>
  <div class="bento-grid">
    {{ gauges.infoMetric("Data Metric", "82/100", "active_transit_score", "span-2") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 06: SVG Score Progress Ring (1x1 Square)</span>
  <div class="bento-grid">
    {{ gauges.progressRing(82, "Academic Index", "academic_index", "span-2") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 07: Sunrise / Sunset Ring Widget (1x1 Square)</span>
  <div class="bento-grid">
    {{ gauges.sunRing("6:12 AM", "8:24 PM", false, 0.45, "span-2") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 08: 2x1 Wide Tides Container (Rich Alpine Blue Layer)</span>
  <div class="bento-grid">
    {{ gauges.tideCard("8:04 PM", "11.2 ft", "6.4 ft", "5:08 AM", "1.4 ft", "span-4") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 09: Market Hotness Gauge (Red / Electric Blue / Red Band)</span>
  <div class="bento-grid">
    {{ gauges.marketGauge("Seller's Market", "Market Hotness", "span-2") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 10: Months of Supply Bar (Red / Electric Blue / Red Band)</span>
  <div class="bento-grid">
    {{ gauges.supplyBar("0 Months (Seller's Market)", "1.8 Months Supply", "6 Months (Buyer's Market)", "28%", "span-6") }}
  </div>
</div>

<!-- CATEGORY 3: CONTENT, FEEDS & MEDIA -->
<div class="catalog-section-title">Category 3: Content, Feeds & Media</div>

<div class="element-block">
  <span class="element-badge">Element 11: 3D Hero Carousel with Centered Glass Badge</span>
  {{ media.heroCarousel("Mukilteo", "Weather & Radar", [], "King") }}
</div>

<div class="element-block">
  <span class="element-badge">Element 12: Local News Article List Card</span>
  <div class="bento-grid">
    {{ media.newsCard("Kirkland Reporter", "City Council Approves Marina Park Upgrades", "Phase two clears environmental review, expanding public docks and waterfront green space.", "Today at 8:30 AM", "#", "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 13: Yelp Local Business Showcase</span>
  <div class="bento-grid">
    {{ media.yelpShowcase("Top Rated Coffee Shops", [
      { name: "Zoka Roasters", rating: "4.8", imgUrl: "https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=300", url: "#" },
      { name: "DERU Market", rating: "4.9", imgUrl: "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=300", url: "#" },
      { name: "Caffe Ladro", rating: "4.7", imgUrl: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=300", url: "#" }
    ], "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 14: Real Estate Client Review Card</span>
  <div class="bento-grid">
    {{ cards.reviewCard("Joe made our Kirkland home search smooth and stress-free. His local market knowledge gave us a major edge in a competitive market!", "Real Estate Client in Kirkland", "★★★★★", "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 15: Sports Summary Card (2x1 Wide with Frosted Logo Background)</span>
  <div class="bento-grid">
    {{ boards.sportsCard("MLB Pro Baseball", "FINAL", "Seattle Mariners", "5", "88-74", "LA Angels", "2", "63-99", "T-Mobile Park • Home Game", "/neighborhood/region-sports/pro/", "https://assets.myseattlesearch.com/repomove/mariners-logo.webp", "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 16: Airport Arrival/Departure Board with Toggle Switch</span>
  <div class="bento-grid">
    {{ boards.flightBoard("Sea-Tac (SEA) Flights", [
      { flight: "AS 1042", destination: "San Francisco", status: "On Time", time: "11:45 AM" },
      { flight: "DL 882", destination: "New York (JFK)", status: "Delayed", time: "12:10 PM" }
    ], "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 17: Toll Rates Board with Toggle Switch</span>
  <div class="bento-grid">
    {{ boards.tollBoard("SR 520 Bridge Tolls", [
      { type: "PEAK AUTO", rate: "$4.50", alert: false },
      { type: "OFF-PEAK", rate: "$2.80", alert: false },
      { type: "PAY BY MAIL", rate: "$6.50", alert: true }
    ], "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 18: Notebook Post & Article Card</span>
  <div class="bento-grid">
    {{ media.notebookCard("Joe Sheldon", "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100", "August 15, 2026", "Eastside Housing Inventory Shifts Fast", "Just completed a thorough walk-through of a classic mid-century home in Houghton. Inventory is tightening fast across Kirkland!", "/posts/post-101/", "Post", "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 19: Team Member Cards (Squircle Avatars & Single-Row Height 2x1)</span>
  <div class="bento-grid">
    {{ cards.teamCard("Joe Sheldon", "Founder & Managing Broker", "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300", "/about-joe/", "2x2", "span-6") }}
    {{ cards.teamCard("Alex Rivera", "Senior Market Analyst", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200", "#", "2x1", "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 20: Image Carousel (Frosted Letterboxing & Centered Thumbs)</span>
  <div class="bento-grid">
    {{ media.imageCarousel([
      "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600",
      "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=600",
      "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=600"
    ], "span-6") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 21: Subpage Directory List Item</span>
  <div class="bento-grid">
    {{ boards.directoryList("Explore Directory", [
      { label: "Weather", url: "#" },
      { label: "Transit", url: "#" },
      { label: "Elections", url: "#" }
    ], "span-4") }}
  </div>
</div>

<div class="element-block">
  <span class="element-badge">Element 22: Long-Tail FAQ Accordion Component</span>
  <div class="bento-grid">
    {{ boards.faqAccordion("How are active transit scores calculated?", "Active transit scores combine real-time bus frequencies, train proximity, and historical on-time performance on a 100-point scale.", "active_transit_score", "span-6") }}
  </div>
</div>