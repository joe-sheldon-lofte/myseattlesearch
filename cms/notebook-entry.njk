---
layout: layouts/base.njk
pagination:
  data: notebook
  size: 1
  alias: post
permalink: /cms/notebook/{{ post.slug }}/index.html
eleventyComputed:
  title: "{{ post.title }} | The Social Notebook | Joe Sheldon"
  description: "{{ post.body | striptags | truncate(150) }}"
---

<main class="layout-container layout-stack-main">
  
  <div class="content-section-centered">

    <article class="surface-bento profile-single-card">
      
      <nav class="entry-subnav">
        <a href="/cms/notebook/" class="btn btn-secondary">
          <span>&larr; Back to Notebook</span>
        </a>
      </nav>

      <header class="entry-header">
        {% if post.published_at %}
          <time class="text-body-secondary tabular-nums">
            {{ post.published_at }}
          </time>
        {% endif %}
        <h1 class="text-section-title">
          {{ post.title }}
        </h1>
      </header>

      <div class="text-body profile-prose-body">
        {{ post.body | safe }}
      </div>

      <footer class="card-footer-strip">
        <div class="author-lockup">
          <img src="{{ post.author_image }}" alt="{{ post.author }}" width="44" height="44" class="avatar-squircle">
          <div>
            <strong class="text-primary-charcoal">{{ post.author }}</strong>
            <span class="text-overline">{{ post.author_role }}</span>
          </div>
        </div>

        <div class="action-cluster">
          <a href="/chat/?topic={{ post.title | urlencode }}" class="btn btn-secondary">
            <span>Reply</span>
          </a>
          <button type="button" 
                  class="btn btn-primary" 
                  onclick="if(navigator.share){navigator.share({title:'{{ post.title | escape }}',url:window.location.href})}else{navigator.clipboard.writeText(window.location.href);alert('Link copied to clipboard!');}">
            <span>Share</span>
          </button>
        </div>
      </footer>

      {% if post.external_links and post.external_links.length %}
        {% set link = post.external_links[0] %}
        <div class="section-divider"></div>
        <div class="action-tray-constrained">
          <a href="{{ link.url or link }}" target="_blank" rel="noopener noreferrer" class="surface-bento callout-feature-card">
            <span class="text-overline text-accent-alpine">{{ link.domain | default('EXTERNAL RESOURCE') | upper }}</span>
            <h4 class="text-widget-title">{{ link.title | default(post.title) }}</h4>
            {% if link.snippet or link.description %}
              <p class="text-body-secondary">{{ link.snippet or link.description }}</p>
            {% endif %}
            <span class="text-overline">&nearr; Open Resource</span>
          </a>
        </div>
      {% endif %}

    </article>

  </div>

</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ post.title | escape }}",
  "datePublished": "{{ post.published_at }}",
  "author": {
    "@type": "Person",
    "name": "{{ post.author }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "MySeattleSearch",
    "url": "https://myseattlesearch.com"
  }
}
</script>