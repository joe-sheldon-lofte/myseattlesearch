<!-- INTERACTIVE LEAFLET SPATIAL MAP ENGINE SCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const mapContainer = document.getElementById('sales-spatial-map');
        if (!mapContainer || typeof L === 'undefined') return;

        const leafletMapInstance = L.map('sales-spatial-map', {
            center: [47.75, -122.28],
            zoom: 10,
            scrollWheelZoom: false
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(leafletMapInstance);

        const compiledPropertiesPayload = [
            {% for listing in sales %}
            {
                "MLS Number": "{{ listing['MLS Number'] or listing.mlsNumber }}",
                "Status": "{{ listing.Status or listing.status }}",
                "Representation": "{{ listing.Representation }}",
                "Address": "{{ listing.Address or listing.address }}",
                "City": "{{ listing.City or listing.city }}",
                "Listing Price": {{ listing['Listing Price'] if listing['Listing Price'] else (listing.price if listing.price else 0) }},
                "Selling Price": {{ listing['Selling Price'] if listing['Selling Price'] else (listing.price if listing.price else 0) }},
                "Latitude": {{ listing.Latitude if listing.Latitude else "null" }},
                "Longitude": {{ listing.Longitude if listing.Longitude else "null" }},
                "url": "/sales/{{ (listing.Address or listing.address) | slugify }}-{{ (listing['MLS Number'] or listing.mlsNumber) | slugify }}/"
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ];

        compiledPropertiesPayload.forEach(function(property) {
            if (!property.Latitude || !property.Longitude) return;
            
            const latNum = parseFloat(property.Latitude);
            const lngNum = parseFloat(property.Longitude);
            if (isNaN(latNum) || isNaN(lngNum)) return;

            let classConfig = "map-marker-dot marker-sold";
            if (property.Status === "Active" || property.Status === "Pending") {
                classConfig = "map-marker-dot marker-active-pending pulsing-glow";
            }

            const cleanMarkerElementIcon = L.divIcon({
                className: classConfig,
                iconSize: [12, 12],
                iconAnchor: [6, 6]
            });

            const priceDisplay = property.Status === 'Sold' ? 
                '$' + Number(property['Selling Price']).toLocaleString('en-US') : 
                '$' + Number(property['Listing Price']).toLocaleString('en-US');

            const popupHtml = `
                <div style="font-family: system-ui, sans-serif; font-size: 13px; padding: 2px; width: 180px;">
                    <strong style="font-size: 14px; color: var(--premier-charcoal); display: block; margin-bottom: 2px;">${property.Address}</strong>
                    <span style="color: var(--premier-charcoal); opacity: 0.8; display: block; margin-bottom: 6px;">${property.City}, WA</span>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--premier-beige); padding-top: 6px;">
                        <span style="font-weight: 700; color: var(--card-accent-color);">${priceDisplay}</span>
                        <a href="${property.url}" style="color: var(--card-accent-color); font-weight: bold; text-decoration: none;">View details &rarr;</a>
                    </div>
                </div>
            `;

            L.marker([latNum, lngNum], { icon: cleanMarkerElementIcon })
             .bindPopup(popupHtml)
             .addTo(leafletMapInstance);
        });
    });
</script>