<style>
    /* Mobile Fix for Stats Container */
    .stats-mobile-fix {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 3rem;
        text-align: center;
    }
    @media (max-width: 600px) {
        .stats-mobile-fix {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
    @media (min-width: 768px) {
        .stats-mobile-fix {
            display: flex;
            justify-content: center;
            gap: 4rem;
        }
    }

    /* Inline CTA Button Row */
    .inline-cta {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin: 2.5rem 0;
        flex-wrap: wrap;
    }

    /* Responsive Images */
    .section-image {
        width: 100%;
        height: auto;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        object-fit: cover;
    }
    .hero-image { max-height: 400px; }
    .sign-image { max-height: 300px; width: auto; max-width: 100%;
        display: block; margin-left: auto; margin-right: auto; }

    /* Rocket LO Mini Profile */
