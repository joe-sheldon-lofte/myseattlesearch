        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--premier-beige);
        text-align: left;
    }
    .lo-img {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--card-accent-color);
    }
    .lo-info { font-size: 0.9rem; line-height: 1.3; }
    .lo-info strong { color: var(--premier-charcoal); font-size: 1rem; }
    .lo-info a { color: var(--card-accent-color); font-weight: bold; text-decoration: none; }

    /* Refined Architectural Layout: Centered Seller Incentive Container Box */
    .universal-incentives-box {
        background-color: var(--dynamic-bg-highlight);
        border: 2px dashed var(--card-accent-color);
        border-radius: 12px;
        padding: 2.5rem 2rem;
        margin: 2rem auto 3rem auto;
        text-align: center;
        max-width: 900px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    @media (max-width: 480px) {
        .universal-incentives-box {
            padding: 1.5rem 1rem;
        }
    }
    .universal-incentives-box h3 {
        color: var(--card-accent-color);
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }
    .universal-incentives-box p.box-intro {
        font-size: 0.95rem;
        opacity: 0.85;
        max-width: 750px;
        margin: 0 auto 1.5rem auto;
        line-height: 1.5;
        color: var(--premier-charcoal);
    }
    .scenarios-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: 1.5rem;
    }
    @media (min-width: 768px) {
        .scenarios-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    .scenario-card {
        background-color: var(--white);
        border-top: 4px solid var(--premier-charcoal);
        padding: 1.5rem;
        border-radius: 8px;
        text-align: left;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
