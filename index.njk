---
layout: layouts/base.njk
title: "Joe Sheldon | Redfin Senior Agent"
description: "Greater Seattle real estate insights, hyper-local market stats, and buyer & seller guides with Redfin Senior Agent Joe Sheldon."
permalink: /index.html
page_scripts:
  - /assets/js/youtube-lite.js
  - /assets/js/local-reviews.js
---

<main class="layout-container layout-stack-main">
  
    {# Section 1.0: Profile #}
    <section id="agent-profile" class="section-profile">
        <div class="profile-avatar-wrapper">
          <img src="https://assets.myseattlesearch.com/repomove/joe.webp" alt="Joe Sheldon" width="150" height="150" class="avatar-squircle">
        </div>
        
        <div class="text-overline">Redfin Senior Agent</div>
        <h1 class="text-display display-tight">{{ stats.short_name }}</h1>
        <p class="text-body-secondary">Serving North King & South Snohomish Counties, WA</p>

        <div class="profile-metrics-grid">
            <div class="metric-block">
                <div class="text-data-huge text-primary-charcoal tabular-nums">{{ stats['Closed Sales'] }}</div>
                <div class="text-overline">TRANSACTIONS</div>
            </div>
            <div class="metric-block">
                <div class="text-data-huge text-primary-charcoal tabular-nums">${{ (stats['Total Sales Volume'] / 1000000) | round(0, "floor") }}M</div>
                <div class="text-overline">VOLUME</div>
            </div>
            <div class="metric-block">
                <div class="text-data-huge text-primary-charcoal tabular-nums">{{ stats['Average Rating'] }}</div>
                <div class="text-overline">AVG RATING</div>
            </div>
        </div>

        <div class="profile-contact-links">
            <a href="tel:{{ stats.universal_contact_phone }}" class="title-link title-link-large tabular-nums">(206) 657-7493</a>
            <a href="mailto:joe.sheldon@redfin.com" class="title-link title-link-large">joe.sheldon@redfin.com</a>
        </div>

        <div class="drawer-actions-stack action-tray-constrained">
            <a href="/contact.vcf" class="btn btn-secondary">Save My Contact Info</a>
            <a href="https://www.redfin.com/real-estate-agents/joe-sheldon?loyalty=true" class="btn btn-primary" target="_blank">View My Redfin Profile</a>
            <a href="/sales/" class="btn btn-secondary">Listings & Sales</a>
        </div>
    </section>

    <hr class="section-divider">

    {# Section 2.0: Educational Resource #}
    <section id="educational-resources" class="section-widget">
      {% set resource_title = "Free Home Buying Classes" %}
      {% set resource_content = "Join us to learn everything you need to know about navigating the current real estate market." %}
      {% set resource_button_text = "View Upcoming Classes & Register" %}
      {% set resource_button_url = "/events/" %}
      {% include "components/widget/resource-card.njk" %}
    </section>

    <hr class="section-divider">

    {# Section 3.0: Video Player #}
    <section id="featured-video" class="section-widget">
      {% set video_title = "Won't you be my neighbor?" %}
      {% set video_id = "e3o5FIXoK84" %}
      {% set video_poster = "https://assets.myseattlesearch.com/repomove/youtubeneighborthumbnail.webp" %}
      {% set video_label = "Won't you be my neighbor video" %}
      {% include "components/widget/video-player.njk" %}
    </section>

    <hr class="section-divider">

    {# Section 4.0: Client Reviews #}
    <section id="client-reviews" class="section-widget">
      {% set reviews_data = homepageReviews %}
      {% include "components/widget/reviews.njk" %}
    </section>

</main>