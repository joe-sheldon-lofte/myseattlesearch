{# 
  COMPONENT: BarkScore® Pet Friendliness (score.custom.bark)
  PURPOSE: Canine infrastructure measuring dog parks (3x) and pet supply stores (1x) per 10k residents.
#}

{% set val = score_bark_val if score_bark_val is defined else (scores.bark if scores else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 80 else ("score-tier-alpine" if val >= 50 else "score-tier-crimson") %}
  {% set tier_text = "text-tier-emerald" if val >= 80 else ("text-tier-alpine" if val >= 50 else "text-tier-crimson") %}
  {% set tier_label = "Dog Lover's Haven" if val >= 80 else ("Pet Friendly" if val >= 50 else "Limited Pet Amenities") %}

  {% set score = {
    id: "bark",
    title: "BarkScore® Pet Index",
    overline: "CANINE & PET INFRASTRUCTURE",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_bark_detail or "Off-leash dog parks (3x) and pet supply services (1x) per 10k residents.",
    source: "Regional Municipal GIS & Pet Registries",
    scale: "Scale 0–100",
    methodology: "Quantifies pet livability by weighting dedicated off-leash dog parks (3x weight) and pet supply/veterinary centers (1x weight) per 10,000 residents against a regional benchmark of 15 weighted points per 10k residents.",
    formula: "Formula: MIN(100, ROUND((((Dog_Parks * 3) + (Pet_Stores * 1)) / (Pop / 10000)) / 15 * 100, 0))",
    scale_notes: "80+: Dog Lover's Haven • 50–79: Pet Friendly • <50: Limited Pet Amenities"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}