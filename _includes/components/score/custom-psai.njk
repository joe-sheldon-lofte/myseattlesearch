{# 
  COMPONENT: Puget Sound Academic Index (score.custom.psai)
  PURPOSE: Aggregated SBA Math, ELA, and WCAS Science public school proficiency.
#}

{% set val = score_psai_val if score_psai_val is defined else (scores.psai if scores else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 75 else ("score-tier-alpine" if val >= 55 else ("score-tier-amber" if val >= 40 else "score-tier-crimson")) %}
  {% set tier_text = "text-tier-emerald" if val >= 75 else ("text-tier-alpine" if val >= 55 else ("text-tier-amber" if val >= 40 else "text-tier-crimson")) %}
  {% set tier_label = "Academic Distinction" if val >= 75 else ("Above State Baseline" if val >= 55 else ("Regional Average" if val >= 40 else "Targeted Growth Area")) %}

  {% set score = {
    id: "psai",
    title: "PSAI Academic Rating",
    overline: "ACADEMIC PROFICIENCY",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_psai_detail or "Aggregated Smarter Balanced Assessment passing rates across local public schools.",
    source: "WA OSPI Report Card",
    scale: "Scale 0–100",
    methodology: "Evaluates overall academic proficiency across public school districts serving the neighborhood by normalizing Smarter Balanced Assessment (SBA) passing rates for Math, ELA, and Science onto a standardized scale.",
    formula: "Formula: ROUND((Math% + ELA% + Science%) / 3, 1)",
    scale_notes: "75+: Academic Distinction • 55–74: Above State Baseline • 40–54: Regional Average"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}