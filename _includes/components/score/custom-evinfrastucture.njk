{# 
  COMPONENT: EV Charging Infrastructure Rating (score.custom.evinfrastructure)
  PURPOSE: Weighted EV charging ports (L1, L2, DC Fast) per 10,000 residents.
#}

{% set val = score_ev_val if score_ev_val is defined else (scores.ev if scores else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 75 else ("score-tier-alpine" if val >= 40 else "score-tier-crimson") %}
  {% set tier_text = "text-tier-emerald" if val >= 75 else ("text-tier-alpine" if val >= 40 else "text-tier-crimson") %}
  {% set tier_label = "EV Pioneer Community" if val >= 75 else ("Growing Network" if val >= 40 else "Emerging Infrastructure") %}

  {% set score = {
    id: "ev",
    title: "EV Infrastructure Rating",
    overline: "CLEAN ENERGY ACCESSIBILITY",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_ev_detail or "Weighted public Level 2 and DC Fast charging ports per 10k residents.",
    source: "NREL Alternative Fuel Stations",
    scale: "Scale 0–100",
    methodology: "Evaluates public electric vehicle charging accessibility by weighting charger power levels per 10,000 residents against a regional benchmark of 30 weighted ports per 10k residents.",
    formula: "Formula: MIN(100, ROUND((((L1*1)+(L2*2)+(DC*4)) / (Pop / 10000)) / 30 * 100, 0))",
    scale_notes: "Weights: Level 1 (1 pt), Level 2 (2 pts), DC Fast (4 pts) • 75+: Pioneer • 40–74: Growing"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}