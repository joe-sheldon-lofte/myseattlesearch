{# 
  COMPONENT: Municipal Surveillance Density Profile (score.custom.surveillance)
  PURPOSE: ALPR, traffic cameras, and CCTV sensor density normalized against population.
  MODE: Inverse (Lower density is optimal).
#}

{% set val = score_surv_val if score_surv_val is defined else (scores.surveillance if scores else null) %}
{% set agency = police_department or (neighborhood.police_agency if neighborhood else null) or "Regional Law Enforcement" %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val < 40 else ("score-tier-amber" if val < 80 else "score-tier-crimson") %}
  {% set tier_text = "text-tier-emerald" if val < 40 else ("text-tier-amber" if val < 80 else "text-tier-crimson") %}
  {% set tier_label = "Minimal Monitoring" if val < 40 else ("Moderate Density" if val < 80 else "High Density") %}

  {% set score = {
    id: "surveillance",
    title: "Surveillance Score",
    overline: "POLICE AGENCY: " ~ (agency | upper),
    value: val,
    color_scale: "inverse",
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_surv_detail or "Automated license plate readers (ALPR), traffic cameras, and public CCTV density.",
    source: "Deflocked Open Surveillance Registry",
    scale: "Scale 0–100",
    methodology: "Quantifies municipal and police surveillance infrastructure (ALPR cameras, intersection traffic feeds, CCTV nodes) normalized against neighborhood population density.",
    formula: "Formula: MIN(100, ROUND(24.16 * LN(device_density + 1) + 5.82, 0))",
    scale_notes: "<40: Minimal Monitoring • 40–79: Moderate Density • 80+: High Density"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}