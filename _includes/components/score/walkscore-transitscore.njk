{# 
  COMPONENT: Transit Score® Regional Connectivity Index (score.walkscore.transitscore)
  PURPOSE: Official Transit Score® measurement based on bus, rail, and ferry frequency.
#}

{% set val = score_transit_val if score_transit_val is defined else (walkscore.transit if walkscore else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 90 else ("score-tier-alpine" if val >= 70 else ("score-tier-amber" if val >= 50 else "score-tier-crimson")) %}
  {% set tier_text = "text-tier-emerald" if val >= 90 else ("text-tier-alpine" if val >= 70 else ("text-tier-amber" if val >= 50 else "text-tier-crimson")) %}
  {% set tier_label = "Rider's Paradise" if val >= 90 else ("Excellent Transit" if val >= 70 else ("Good Transit" if val >= 50 else "Some Transit")) %}

  {% set score = {
    id: "transitscore",
    title: "TransitScore® Access",
    overline: "PUBLIC TRANSPORTATION",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_transit_detail or "Frequent public transit connectivity within immediate walking distance.",
    source: "Walk Score® Index",
    scale: "Scale 0–100",
    methodology: "Calculates transit accessibility based on distance to nearest stops, route frequency, and transit mode weighting (light rail, commuter rail, and bus lines).",
    formula: "Formula: Proprietary Transit Score® route frequency algorithm",
    scale_notes: "90–100: Rider's Paradise • 70–89: Excellent Transit • 50–69: Good Transit • <50: Some Transit"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}