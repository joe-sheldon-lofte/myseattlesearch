{# 
  COMPONENT: Walk Score® Pedestrian Mobility Index (score.walkscore.walkscore)
  PURPOSE: Official Walk Score® walkability measurement based on nearby amenity density.
#}

{% set val = score_walk_val if score_walk_val is defined else (walkscore.walk if walkscore else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 90 else ("score-tier-alpine" if val >= 70 else ("score-tier-amber" if val >= 50 else "score-tier-crimson")) %}
  {% set tier_text = "text-tier-emerald" if val >= 90 else ("text-tier-alpine" if val >= 70 else ("text-tier-amber" if val >= 50 else "text-tier-crimson")) %}
  {% set tier_label = "Walker's Paradise" if val >= 90 else ("Very Walkable" if val >= 70 else ("Somewhat Walkable" if val >= 50 else "Car-Dependent")) %}

  {% set score = {
    id: "walkscore",
    title: "WalkScore® Walkability",
    overline: "PEDESTRIAN MOBILITY",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_walk_detail or "Daily errands do not require an automobile.",
    source: "Walk Score® Index",
    scale: "Scale 0–100",
    methodology: "Analyzes pedestrian route distances to nearby grocery stores, schools, parks, dining, and retail. Points are awarded based on walking distance, decaying to zero after a 30-minute threshold.",
    formula: "Formula: Proprietary Walk Score® gravity decay algorithm",
    scale_notes: "90–100: Walker's Paradise • 70–89: Very Walkable • 50–69: Somewhat Walkable • <50: Car-Dependent"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}