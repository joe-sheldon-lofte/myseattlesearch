{# 
  COMPONENT: Transit Schedule On-Time Reliability (score.custom.activetransit.ontimeperformance)
  PURPOSE: APTA standard vehicle punctuality rate across Sound Transit, Metro, and Community Transit.
#}

{% set val = score_ontime_val if score_ontime_val is defined else (scores.ontime if scores else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 90 else ("score-tier-amber" if val >= 75 else "score-tier-crimson") %}
  {% set tier_text = "text-tier-emerald" if val >= 90 else ("text-tier-amber" if val >= 75 else "text-tier-crimson") %}
  {% set tier_label = "High Reliability" if val >= 90 else ("Minor Delay Alerts" if val >= 75 else "System Congestion") %}

  {% set score = {
    id: "ontime",
    title: "Transit On-Time Rate",
    overline: "SCHEDULE RELIABILITY",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_ontime_detail or "Percentage of active transit vehicles operating on published schedule.",
    source: "OneBusAway GTFS-RT",
    scale: "APTA Standard",
    methodology: "Evaluates the percentage of active in-bounds transit vehicles (Sound Transit, Community Transit, King County Metro) operating within the APTA standard schedule window of -60s early to +300s late.",
    formula: "Formula: IF(total_vehicles > 0, ROUND((on_time / total_vehicles) * 100, 0), 100)",
    scale_notes: "90%+: High Reliability • 75–89%: Minor Delays • <75%: System Congestion"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}