{# 
  COMPONENT: Active Commute Score (score.custom.activecommute)
  PURPOSE: Arterial traffic flow efficiency normalized against live free-flow baselines.
#}

{% set val = score_activecommute_val if score_activecommute_val is defined else (scores.activecommute if scores else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 80 else ("score-tier-alpine" if val >= 50 else "score-tier-crimson") %}
  {% set tier_text = "text-tier-emerald" if val >= 80 else ("text-tier-alpine" if val >= 50 else "text-tier-crimson") %}
  {% set tier_label = "Smooth Arterials" if val >= 80 else ("Moderate Traffic" if val >= 50 else "Arterial Congestion") %}

  {% set score = {
    id: "activecommute",
    title: "Active Commute Score",
    overline: "LOCAL TRAFFIC VELOCITY",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_activecommute_detail or "Live arterial travel times normalized against uncongested baselines.",
    source: "WSDOT & Regional Traffic GIS",
    scale: "Scale 0–100",
    methodology: "Calculates drive times across arterial corridors within the neighborhood perimeter, comparing current telemetry against uncongested baselines (1 = severe congestion, 100 = free flow).",
    formula: "Formula: MIN(100, ROUND((baseline_mins / current_mins) * 100, 0))",
    scale_notes: "80–100: Smooth Arterials • 50–79: Moderate Traffic • <50: Arterial Congestion"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}