{# 
  COMPONENT: Property Tax Stability Index (score.custom.propertytaxstability)
  PURPOSE: 5-year municipal levy escalation predictability and voter bond volatility.
  MODE: Inverse (Lower escalation is optimal).
#}

{% set val = score_tax_val if score_tax_val is defined else (scores.tax_stability if scores else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val < 36 else ("score-tier-amber" if val < 66 else "score-tier-crimson") %}
  {% set tier_text = "text-tier-emerald" if val < 36 else ("text-tier-amber" if val < 66 else "text-tier-crimson") %}
  {% set tier_label = "Highly Predictable" if val < 36 else ("Regional Average" if val < 66 else "Accelerating Levies") %}

  {% set score = {
    id: "tax",
    title: "Property Tax Stability",
    overline: "FISCAL PREDICTABILITY",
    value: val,
    color_scale: "inverse",
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_tax_detail or "5-year cumulative property tax levy escalation and municipal bond risk.",
    source: "County Assessor Records",
    scale: "5-Yr Index (0–100)",
    methodology: "Measures the 5-year escalation rate of municipal property taxes and normalizes it on a 0–100 scale. A lower score reflects a more predictable tax environment, while a higher score reflects aggressive bond-driven increases.",
    formula: "Formula: MIN(100, MAX(0, ROUND(((tax_current - tax_5yr_ago) / tax_5yr_ago) / 0.35 * 100, 0)))",
    scale_notes: "0–35: Highly Predictable • 36–65: Regional Average • 66–100: Rapid Escalation"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}