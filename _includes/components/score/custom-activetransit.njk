{# 
  COMPONENT: Active Transit Capacity Score (score.custom.activetransit)
  PURPOSE: Ground transit seats per 1,000 residents normalized to regional availability.
#}

{% set val = score_activetransit_val if score_activetransit_val is defined else (scores.activetransit if scores else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 80 else ("score-tier-alpine" if val >= 40 else "score-tier-crimson") %}
  {% set tier_text = "text-tier-emerald" if val >= 80 else ("text-tier-alpine" if val >= 40 else "text-tier-crimson") %}
  {% set tier_label = "Exceptional Transit Access" if val >= 80 else ("Moderate Coverage" if val >= 40 else "Limited Local Transit") %}

  {% set score = {
    id: "activetransit",
    title: "Active Transit Score",
    overline: "GROUND TRANSIT CAPACITY",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_activetransit_detail or "Active transit seating capacity normalized per 1,000 local residents.",
    source: "OneBusAway GTFS-RT & WA OFM",
    scale: "Scale 0–100",
    methodology: "Measures real-time transit capacity by normalizing total active in-bounds ground transit seats (bus, light rail, commuter rail) per 1,000 local residents against a regional benchmark of 50 seats/1k residents.",
    formula: "Formula: MIN(100, ROUND((Seats / (Pop / 1000)) / 50 * 100, 0))",
    scale_notes: "80+: Exceptional Access • 40–79: Moderate Coverage • <40: Limited Transit"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}