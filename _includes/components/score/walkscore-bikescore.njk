{# 
  COMPONENT: Bike Score® Cycling Infrastructure Index (score.walkscore.bikescore)
  PURPOSE: Official Bike Score® measurement based on bike lanes, hills, and road connectivity.
#}

{% set val = score_bike_val if score_bike_val is defined else (walkscore.bike if walkscore else null) %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val >= 90 else ("score-tier-alpine" if val >= 70 else ("score-tier-amber" if val >= 50 else "score-tier-crimson")) %}
  {% set tier_text = "text-tier-emerald" if val >= 90 else ("text-tier-alpine" if val >= 70 else ("text-tier-amber" if val >= 50 else "text-tier-crimson")) %}
  {% set tier_label = "Biker's Paradise" if val >= 90 else ("Very Bikeable" if val >= 70 else ("Bikeable" if val >= 50 else "Somewhat Bikeable")) %}

  {% set score = {
    id: "bikescore",
    title: "BikeScore® Cycling Index",
    overline: "CYCLING & MICRO-MOBILITY",
    value: val,
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_bike_detail or "Biking is convenient for daily commutes and recreational errands.",
    source: "Walk Score® Index",
    scale: "Scale 0–100",
    methodology: "Evaluates bicycle friendliness by analyzing bike lane infrastructure, street topography (gradient slope penalty), road network connectivity, and destination density.",
    formula: "Formula: Proprietary Bike Score® multi-factor topographic algorithm",
    scale_notes: "90–100: Biker's Paradise • 70–89: Very Bikeable • 50–69: Bikeable • <50: Somewhat Bikeable"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}