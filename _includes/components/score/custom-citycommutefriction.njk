{# 
  COMPONENT: Corridor Commute Friction (score.custom.citycommutefriction)
  PURPOSE: Peak-hour travel time penalty toward primary employment hubs (Seattle / Bellevue).
  MODE: Inverse (Lower delay penalty is optimal).
#}

{% set val = score_friction_val if score_friction_val is defined else (scores.friction if scores else null) %}
{% set hub_name = score_friction_hub or "Regional Employment Hub" %}

{% if val is defined and val is not none %}
  {% set tier_badge = "score-tier-emerald" if val < 16 else ("score-tier-amber" if val < 41 else "score-tier-crimson") %}
  {% set tier_text = "text-tier-emerald" if val < 16 else ("text-tier-amber" if val < 41 else "text-tier-crimson") %}
  {% set tier_label = "Free Flowing" if val < 16 else ("Moderate Delay" if val < 41 else "Heavy Delay") %}

  {% set score = {
    id: "friction",
    title: hub_name ~ " Delay Penalty",
    overline: "CORRIDOR COMMUTE FRICTION",
    value: val,
    color_scale: "inverse",
    label: tier_label,
    tier_badge: tier_badge,
    tier_text: tier_text,
    detail: score_friction_detail or "Peak corridor travel time delay compared against WSDOT uncongested baselines.",
    source: "WSDOT Travel Times API",
    scale: "Delay Penalty %",
    methodology: "Calculates the percentage increase in travel time from this neighborhood to the central business hub during peak commute hours versus posted speed limit speeds.",
    formula: "Formula: ROUND(((Peak_Time - Freeflow_Time) / Freeflow_Time) * 100, 0)",
    scale_notes: "0–15%: Free Flowing • 16–40%: Moderate Delay • 41%+: Heavy Delay Penalty"
  } %}

  {% include "components/widget/custom-score.njk" %}
{% endif %}