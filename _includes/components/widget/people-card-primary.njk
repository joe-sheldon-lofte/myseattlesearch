<!-- File: _includes/components/widget/people-card-primary.njk -->
{% set person_name = person_primary_name | default("Joe Sheldon") %}
{% set person_role = person_primary_role | default("SENIOR REAL ESTATE AGENT") %}
{% set person_avatar = person_primary_image | default("/assets/images/joe-sheldon-headshot.webp") %}
{% set person_bio = person_primary_bio | default("Puget Sound real estate strategist specializing in North Sound residential listings, rapid market absorption analysis, and competitive buyer positioning.") %}
{% set person_phone = person_primary_phone | default("(206) 657-7493") %}
{% set person_tel = person_primary_tel | default("2066577493") %}
{% set person_email = person_primary_email | default("joe.sheldon@redfin.com") %}
{% set person_license = person_primary_license | default("WA DOL #115714") %}
{% set person_url = person_primary_url | default("/#agent") %}
{% set is_vendor = person_is_vendor | default(false) %}

<article class="widget-card people-card-primary" style="display: flex; flex-direction: column; justify-content: space-between; padding: 2rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); text-align: center; box-sizing: border-box;">
  
  {# Header & Circular Avatar (SOP 6 Compliant) #}
  <div style="display: flex; flex-direction: column; align-items: center;">
    <div style="position: relative; width: 150px; height: 150px; margin-bottom: 1.25rem;">
      <img src="{{ person_avatar }}" 
           alt="{{ person_name }}" 
           width="150" 
           height="150" 
           loading="lazy" 
           decoding="async" 
           style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; object-position: center; border: 3px solid var(--color-background-universal); box-shadow: 0 4px 16px rgba(0,0,0,0.08); display: block;">
      
      {% if is_vendor %}
        <span style="position: absolute; bottom: 4px; right: 4px; width: 28px; height: 28px; border-radius: 50%; background: #10B981; color: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.15);" title="Verified Licensed Professional" aria-label="Verified Professional">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
      {% endif %}
    </div>

    <span class="text-overline" style="color: var(--color-secondary-default); margin-bottom: 0.35rem;">
      {{ person_role }}
    </span>

    <h3 class="text-widget-title" style="font-size: 1.35rem; margin: 0 0 0.5rem 0;">
      {{ person_name }}
    </h3>

    <p class="text-body-secondary" style="font-size: 0.85rem; line-height: 1.5; margin: 0 0 1.25rem 0; max-width: 380px;">
      {{ person_bio }}
    </p>
  </div>

  {# Contact Details & Verification #}
  <div style="display: flex; flex-direction: column; gap: 0.75rem; border-top: 1px solid var(--color-border-light); padding-top: 1rem;">
    <div style="display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.8rem;">
      <a href="tel:{{ person_tel }}" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; color: var(--color-primary-default); font-weight: 700; text-decoration: none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{{ person_phone }}</span>
      </a>

      {% if person_email %}
        <a href="mailto:{{ person_email }}" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; color: #86868b; text-decoration: none;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>{{ person_email }}</span>
        </a>
      {% endif %}

      {% if person_license %}
        <div class="text-body-secondary" style="font-size: 0.7rem; color: #86868b;">
          {{ person_license }}
        </div>
      {% endif %}
    </div>

    {# Primary Action Pill #}
    <div style="margin-top: 0.5rem;">
      <a href="{{ person_url }}" 
         style="display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; width: 100%; padding: 0.7rem 1.25rem; background: var(--color-secondary-default); color: #FFFFFF; border-radius: 999px; font-size: 0.85rem; font-weight: 700; text-decoration: none; box-shadow: 0 2px 8px rgba(30, 77, 107, 0.15);">
        <span>{% if is_vendor %}View Full Profile & Credentials{% else %}View Profile & Strategy{% endif %}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

</article>