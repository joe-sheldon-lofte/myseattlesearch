{# 
  COMPONENT: Chamber 2 - Down Payment Tier & PMI Impact (widget.realestate.housing.affordability.downpaymenttier)
  CONTRACT:
    - downpayment_tier_matrix: Array of Objects [Required]
      Each row expects:
      - row.tier: String [Required, e.g. "3.5% Down"]
      - row.down: String [Required, e.g. "$23,975"]
      - row.mort: String [Required, e.g. "$4,082"]
      - row.tax: String [Required, e.g. "$645"]
      - row.ins: String [Required, e.g. "$145"]
      - row.pmi: String [Required, e.g. "$289"]
      - row.total: String [Required, e.g. "$5,161"]
      - row.income: String [Required, e.g. "$193,500"]
      - row.p_mort: Number [Required, percentage]
      - row.p_tax: Number [Required, percentage]
      - row.p_ins: Number [Required, percentage]
      - row.p_pmi: Number [Required, percentage]
#}

{% set dp_data = downpayment_tier_matrix %}

{% if dp_data and dp_data.length > 0 %}
<div class="affordability-subpanel affordability-downpayment-card" aria-label="Down Payment Tier & PMI Impact">
  
  {# Header #}
  <div class="affordability-subpanel-header">
    <h4 class="text-widget-title affordability-subpanel-title">
      Down Payment Tier &amp; PMI Impact
    </h4>
  </div>

  {# 100% Stacked Proportional Cost Bars #}
  <div class="dp-stacked-card">
    <div class="affordability-legend-row">
      <span class="affordability-legend-item">
        <span class="legend-swatch swatch-alpine"></span> P&amp;I Loan
      </span>
      <span class="affordability-legend-item">
        <span class="legend-swatch swatch-teal"></span> Property Tax
      </span>
      <span class="affordability-legend-item">
        <span class="legend-swatch swatch-emerald"></span> Hazard Ins
      </span>
      <span class="affordability-legend-item">
        <span class="legend-swatch swatch-crimson"></span> PMI
      </span>
    </div>

    {% for row in dp_data %}
      <div class="dp-stacked-card">
        <div class="dp-meta-row">
          <span class="dp-tier-name">{{ row.tier }} ({{ row.down }})</span>
          <span class="dp-total-num">Total: {{ row.total }}/mo</span>
        </div>

        {# 100% Stacked Bar #}
        <div class="dp-stacked-track">
          <div class="dp-seg-mort" style="width: {{ row.p_mort }}%;" title="Mortgage: {{ row.mort }}"></div>
          <div class="dp-seg-tax" style="width: {{ row.p_tax }}%;" title="Tax: {{ row.tax }}"></div>
          <div class="dp-seg-ins" style="width: {{ row.p_ins }}%;" title="Insurance: {{ row.ins }}"></div>
          {% if row.p_pmi > 0 %}
            <div class="dp-seg-pmi" style="width: {{ row.p_pmi }}%;" title="PMI: {{ row.pmi }}"></div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {# Matrix Table #}
  <div class="affordability-table-wrap">
    <table class="affordability-table">
      <thead>
        <tr>
          <th>TIER</th>
          <th style="text-align: right;">DOWN $</th>
          <th style="text-align: right;">P&amp;I</th>
          <th style="text-align: right;">TAX</th>
          <th style="text-align: right;">INS</th>
          <th style="text-align: right;">PMI</th>
          <th style="text-align: right;">TOTAL PITI</th>
          <th style="text-align: right;">REQ. INC</th>
        </tr>
      </thead>
      <tbody>
        {% for row in dp_data %}
          <tr>
            <td class="table-cell-lead">{{ row.tier }}</td>
            <td class="table-cell-num">{{ row.down }}</td>
            <td class="table-cell-num">{{ row.mort }}</td>
            <td class="table-cell-num">{{ row.tax }}</td>
            <td class="table-cell-num">{{ row.ins }}</td>
            <td class="table-cell-num {% if row.pmi != '$0' %}cell-color-crimson{% else %}cell-color-muted{% endif %}">{{ row.pmi }}</td>
            <td class="table-cell-num">{{ row.total }}</td>
            <td class="table-cell-num cell-color-amber">{{ row.income }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>
{% endif %}