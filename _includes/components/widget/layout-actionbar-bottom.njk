<!-- File: _includes/components/widget/layout-actionbar-bottom.njk -->
{% set phone_number = "(206) 657-7493" %}
{% set tel_link = "2066577493" %}

<aside class="floating-actionbar-container" 
       role="toolbar" 
       aria-label="Quick Actions and Navigation Bar"
       style="position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 1000; width: calc(100% - 32px); max-width: 620px; pointer-events: none;">
  
  <div class="floating-actionbar-inner" 
       style="pointer-events: auto; background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.6); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12), 0 1px 3px rgba(0, 0, 0, 0.06); border-radius: 999px; padding: 0.4rem 0.5rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; box-sizing: border-box;">
    
    {# Mobile Contact Toggle (Hidden on Desktop) per edit #}
    <button type="button" 
            class="actionbar-mobile-contact-trigger" 
            aria-label="Open Contact Options"
            onclick="openContactDrawer()"
            style="display: none; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--color-secondary-default); color: #FFFFFF; border: none; font-size: 1.15rem; cursor: pointer; flex-shrink: 0; box-shadow: 0 2px 8px rgba(30, 77, 107, 0.25);">
      💬
    </button>

    {# Desktop Contact Actions #}
    <div class="actionbar-desktop-contact" style="display: flex; align-items: center; gap: 0.35rem;">
      <a href="sms:+1{{ tel_link }}" 
         class="actionbar-btn" 
         aria-label="Text Joe Sheldon"
         style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.85rem; border-radius: 999px; background: var(--color-secondary-default); color: #FFFFFF; font-size: 0.75rem; font-weight: 700; text-decoration: none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span class="actionbar-btn-text">Text</span>
      </a>

      <a href="/chat/" 
         class="actionbar-btn" 
         aria-label="Chat with Joe Sheldon"
         style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.85rem; border-radius: 999px; background: var(--color-secondary-default); color: #FFFFFF; font-size: 0.75rem; font-weight: 700; text-decoration: none;">
        <span class="actionbar-btn-text">Chat</span>
      </a>

      <a href="tel:{{ tel_link }}" 
         class="actionbar-btn" 
         aria-label="Call Joe Sheldon"
         style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.85rem; border-radius: 999px; background: var(--color-background-universal); border: 1px solid var(--color-secondary-default); color: var(--color-secondary-default); font-size: 0.75rem; font-weight: 700; text-decoration: none;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="actionbar-btn-text">Call</span>
      </a>
    </div>

    {# Search Trigger Field per edit: "Search..." #}
    <div style="flex-grow: 1; max-width: 260px; min-width: 60px;">
      <button type="button" 
              class="actionbar-search-trigger" 
              aria-label="Open Search"
              onclick="const sm=document.getElementById('dialog-search-modal');if(sm){sm.showModal();}else{window.location.href='/#search';}"
              style="width: 100%; display: flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.75rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 999px; color: #86868b; font-size: 0.75rem; cursor: pointer; text-align: left;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="actionbar-search-text" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Search...</span>
      </button>
    </div>

    {# Navigate Drawer Trigger #}
    <div>
      <button type="button" 
              class="actionbar-nav-trigger" 
              aria-label="Open Page Section Navigation"
              onclick="const dn=document.getElementById('drawer-action-navigate');if(dn){dn.classList.toggle('open');}else{window.scrollTo({top:0,behavior:'smooth'});}"
              style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.85rem; border-radius: 999px; background: var(--color-background-universal); border: 1px solid var(--color-border-light); color: var(--color-primary-default); font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: background 0.15s ease;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
        </svg>
        <span class="actionbar-btn-text">Navigate</span>
      </button>
    </div>

  </div>

  <style>
    @media (max-width: 580px) {
      .actionbar-desktop-contact {
        display: none !important;
      }
      .actionbar-mobile-contact-trigger {
        display: flex !important;
      }
      .actionbar-btn-text, .actionbar-search-text {
        display: none !important;
      }
      .actionbar-nav-trigger {
        padding: 0.5rem 0.65rem !important;
      }
      .actionbar-search-trigger {
        justify-content: center !important;
        padding: 0.5rem !important;
      }
    }
  </style>

</aside>