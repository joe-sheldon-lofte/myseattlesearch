<!-- File: _includes/components/widget/layout-actionbar-bottom.njk -->
{# 
  COMPONENT: Floating Bottom Action & Navigation Tray (widget.layout.actionbar.bottom)
  CHANNELS: Joe Sheldon Direct Line (SMS, Chat, Tel)
  BEHAVIOR:
    - Desktop: Displays full [Text] [Chat] [Call] pills, [Search...] field, and [Navigate] drawer trigger.
    - Mobile (<=768px): Collapses to single [Contact] pill, [Search...] field, and [Navigate] pill.
#}

<aside class="floating-actionbar-container" 
       role="toolbar" 
       aria-label="Quick Actions and Navigation Bar">
  
  <div class="floating-actionbar-inner">
    
    {# 1. Mobile Contact Trigger (Collapsed Pill) #}
    <button type="button" 
            class="actionbar-pill-btn actionbar-pill-primary actionbar-mobile-contact-pill" 
            aria-label="Open Contact Options"
            onclick="openContactDrawer()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="actionbar-btn-text">Contact</span>
    </button>

    {# 2. Desktop Contact Action Cluster #}
    <div class="actionbar-contact-cluster actionbar-desktop-contact">
      {# Text Line #}
      <a href="sms:+12066577493" 
         class="actionbar-pill-btn actionbar-pill-primary" 
         aria-label="Send a Text to Joe Sheldon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <span class="actionbar-btn-text">Text</span>
      </a>

      {# Live Chat / Client Portal #}
      <a href="/chat/" 
         class="actionbar-pill-btn actionbar-pill-primary" 
         aria-label="Chat with Joe Sheldon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <span class="actionbar-btn-text">Chat</span>
      </a>

      {# Voice Call #}
      <a href="tel:2066577493" 
         class="actionbar-pill-btn actionbar-pill-secondary" 
         aria-label="Call Joe Sheldon">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="actionbar-btn-text">Call</span>
      </a>
    </div>

    {# 3. Search Trigger Field #}
    <div class="actionbar-search-cluster">
      <button type="button" 
              class="actionbar-search-trigger" 
              aria-label="Open Search"
              onclick="const sm=document.getElementById('dialog-search-modal');if(sm){sm.showModal();}else{window.location.href='/#search';}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        <span class="actionbar-search-text">Search...</span>
      </button>
    </div>

    {# 4. Universal Page Section Navigation Trigger #}
    <div>
      <button type="button" 
              class="actionbar-pill-btn actionbar-pill-neutral actionbar-nav-trigger" 
              aria-label="Open Page Section Navigation"
              onclick="openNavigateDrawer()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
        </svg>
        <span class="actionbar-btn-text">Navigate</span>
      </button>
    </div>

  </div>

</aside>