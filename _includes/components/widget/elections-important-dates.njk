{# 
  COMPONENT: Key Election Dates & Milestones (widget.elections.important.dates)
  CONTRACT:
    - election_name / election.ElectionName / election.name: String [Required]
    - election_milestones / milestones / election.milestones: Array of Objects [Required]
      Each milestone expects:
      - item.date: String (e.g. "OCTOBER 16, 2026" or ISO formatted date) [Required]
      - item.label: String (e.g. "Official Ballots Mailed to Registered Voters") [Required]
      - item.desc: String (e.g. "Drop boxes open 24 hours daily...") [Optional]
    - election_badge_label: String [Optional, defaults to "Washington State Schedule"]
    - election_source_url: String [Optional, defaults to "https://voter.votewa.gov"]
#}

{% set name = election_name or (election.ElectionName if election else '') or (election.name if election else '') %}
{% set schedule_items = election_milestones or milestones or (election.milestones if election else []) %}
{% set badge_text = election_badge_label or "Washington State Schedule" %}
{% set source_href = election_source_url or "https://voter.votewa.gov" %}

{% if name and schedule_items and schedule_items.length > 0 %}
<div class="widget-card elections-timeline-card">
  
  {# Header Row: Election Overline & Status Badge #}
  <div class="card-header-split timeline-header-strip">
    <div>
      <span class="text-overline text-accent-alpine">
        {{ name | upper }}
      </span>
      <h3 class="text-widget-title timeline-headline">
        Key Election Dates
      </h3>
    </div>
    
    {% if badge_text %}
      <div class="badge-status-emerald">
        {{ badge_text }}
      </div>
    {% endif %}
  </div>

  {# Chronological Milestones Stack #}
  <div class="timeline-milestones-stack">
    {% for item in schedule_items %}
      {% if item.date and item.label %}
        <div class="timeline-milestone-item">
          <div class="timeline-indicator-dot" aria-hidden="true"></div>
          <div class="timeline-milestone-content">
            <time class="timeline-date-label">
              {{ item.date }}
            </time>
            <div class="timeline-entry-title">
              {{ item.label }}
            </div>
            {% if item.desc %}
              <p class="text-body-secondary timeline-entry-desc">
                {{ item.desc }}
              </p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Footer: Verification Source Link #}
  <div class="card-footer-strip text-body-secondary">
    <span>Source: Washington Secretary of State</span>
    <a href="{{ source_href }}" target="_blank" rel="noopener noreferrer" class="link-arrow">
      <span>VoteWA Portal</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </a>
  </div>

</div>
{% endif %}