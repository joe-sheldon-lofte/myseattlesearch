<!-- File: _includes/components/widget/elections-important-dates.njk -->
{% set election_name = election_official_name | default("2026 GENERAL ELECTION") %}

{% set milestones = [
  { date: "OCTOBER 16, 2026", label: "Official Ballots Mailed to Registered Voters", desc: "Drop boxes open 24 hours daily across Snohomish and King Counties." },
  { date: "OCTOBER 26, 2026", label: "Online & Mail Voter Registration Deadline", desc: "Last day to register or update address online before Election Day." },
  { date: "NOVEMBER 03, 2026", label: "Election Day (Ballot Return Deadline)", desc: "Drop box return deadline: 8:00 PM PDT sharp. Mail must be postmarked today." },
  { date: "NOVEMBER 24, 2026", label: "Official Election Certification", desc: "County canvassing board certifies final verified vote tabulation." }
] %}

<div class="widget-card elections-important-dates-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row per edit: Name of election in overline, "Key Election Dates" as title #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        {{ election_name }}
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        Key Election Dates
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: #10B981; background: rgba(16, 185, 129, 0.12); padding: 0.2rem 0.65rem; border-radius: 999px;">
      Statewide Schedule
    </div>
  </div>

  {# Chronological Milestones #}
  <div style="display: flex; flex-direction: column; gap: 0.85rem;">
    {% for item in milestones %}
      <div style="display: flex; align-items: flex-start; gap: 1rem; padding: 0.75rem; background: var(--color-surface-gray); border-radius: 10px;">
        <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--color-secondary-default); margin-top: 5px; flex-shrink: 0;"></div>
        <div>
          <div style="font-size: 0.75rem; font-weight: 800; font-family: monospace; color: var(--color-secondary-default);">
            {{ item.date }}
          </div>
          <div style="font-size: 0.9rem; font-weight: 700; color: var(--color-primary-default); margin-top: 0.15rem;">
            {{ item.label }}
          </div>
          <p class="text-body-secondary" style="font-size: 0.75rem; margin: 0.2rem 0 0 0; line-height: 1.4;">
            {{ item.desc }}
          </p>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Footer #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.65rem; font-size: 0.75rem;" class="text-body-secondary">
    <span>Washington Secretary of State Elections Division</span>
    <a href="https://voter.votewa.gov" target="_blank" rel="noopener" style="color: var(--color-secondary-default); font-weight: 700; text-decoration: none;">VoteWA Portal ↗</a>
  </div>

</div>