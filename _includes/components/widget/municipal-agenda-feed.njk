<!-- File: _includes/components/widget/municipal-agenda-feed.njk -->
{% set city = municipal_city_name | default("Edmonds") %}
{% set agendas = municipal_agendas_data | default([
  { body: "City Council", title: "Regular Business Meeting & Public Hearing on 2026 Comprehensive Plan", date: "Tuesday, Oct 27, 2026", time: "7:00 PM", status: "Published", url: "#" },
  { body: "Planning Board", title: "Study Session: Missing-Middle Design Standards & Arterial Infill", date: "Wednesday, Oct 28, 2026", time: "6:00 PM", status: "Published", url: "#" },
  { body: "Hearing Examiner", title: "Conditional Use Permit Review: Mixed-Use Infill Development", date: "Thursday, Nov 05, 2026", time: "10:00 AM", status: "Draft", url: "#" }
]) %}

<div class="widget-card municipal-agenda-feed-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row per edit: "CITY GOVERNMENT" #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        CITY GOVERNMENT
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ city }} Council &amp; Commission Agendas
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: #10B981; background: rgba(16, 185, 129, 0.12); padding: 0.2rem 0.65rem; border-radius: 999px;">
      Public Meeting Notice
    </div>
  </div>

  {# Agendas Feed #}
  <div style="display: flex; flex-direction: column; gap: 0.85rem;">
    {% for item in agendas %}
      <div style="background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 1rem; display: flex; flex-direction: column; gap: 0.35rem;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span class="text-overline" style="font-size: 0.6rem; color: var(--color-secondary-default);">
            {{ item.body | upper }}
          </span>
          <span style="font-size: 0.7rem; font-weight: 700; font-family: monospace; color: #86868b;">
            {{ item.date }} • {{ item.time }}
          </span>
        </div>

        <div style="font-size: 0.9rem; font-weight: 700; color: var(--color-primary-default); line-height: 1.35;">
          {{ item.title }}
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.25rem; font-size: 0.75rem;">
          <span class="text-body-secondary">Official Clerk Packet Available</span>
          <a href="{{ item.url }}" style="color: var(--color-secondary-default); font-weight: 700; text-decoration: none;">Download Agenda PDF →</a>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Footer per edit #}
  <div style="border-top: 1px solid var(--color-border-light); padding-top: 0.65rem; font-size: 0.75rem;" class="text-body-secondary">
    Agendas sourced directly from municipal portals. Subject to change based on city policies.
  </div>

</div>