{# 
  COMPONENT: Municipal Agenda Feed & Public Hearings (widget.municipal.agenda.feed)
  CONTRACT:
    - municipal_neighborhood_name / neighborhood.name / city.City / city: String [Required]
    - municipal_agendas_data / agendas / municipal_agendas: Array of Objects [Required]
      Each agenda object expects:
      - item.body: String [Required, e.g. "City Council", "Planning Board"]
      - item.title: String [Required]
      - item.date: String [Required, e.g. "Tuesday, Oct 27, 2026"]
      - item.time: String [Optional, e.g. "7:00 PM"]
      - item.url: String [Optional, link to official PDF packet]
      - item.status: String [Optional, e.g. "Published", "Draft"]
    - municipal_badge_label: String [Optional, defaults to "Public Meeting Documents"]
    - municipal_disclaimer_text: String [Optional]
#}

{% set active_neighborhood = municipal_neighborhood_name or (neighborhood.name if neighborhood else '') or city.City or city %}
{% set agenda_list = municipal_agendas_data or agendas or municipal_agendas %}
{% set badge_text = municipal_badge_label or "Public Meeting Documents" %}
{% set disclaimer_text = municipal_disclaimer_text or "Agendas sourced directly from municipal portals. Subject to change based on city policies." %}

{% if active_neighborhood and agenda_list and agenda_list.length > 0 %}
<div class="widget-card municipal-agenda-card">
  
  {# Header Row: Civic Overline, Title & Verification Badge #}
  <div class="card-header-split municipal-header-strip">
    <div>
      <span class="text-overline text-accent-alpine">
        CITY GOVERNMENT
      </span>
      <h3 class="text-widget-title municipal-headline">
        {{ active_neighborhood }} Council &amp; Commission Agendas
      </h3>
    </div>
    
    {% if badge_text %}
      <div class="badge-status-emerald">
        {{ badge_text }}
      </div>
    {% endif %}
  </div>

  {# Agendas Feed #}
  <div class="municipal-agenda-stack">
    {% for item in agenda_list %}
      {% if item.title %}
        <div class="agenda-entry-card">
          
          {# Item Top: Governing Body & Timestamp #}
          <div class="agenda-entry-top">
            {% if item.body %}
              <span class="text-overline agenda-body-tag">
                {{ item.body | upper }}
              </span>
            {% else %}
              <span></span>
            {% endif %}

            {% if item.date %}
              <time class="agenda-entry-time">
                {{ item.date }}{% if item.time %} • {{ item.time }}{% endif %}
              </time>
            {% endif %}
          </div>

          {# Meeting Agenda Title #}
          <h4 class="agenda-entry-title">
            {{ item.title }}
          </h4>

          {# Item Footer: Packet Status & Download Action #}
          <div class="agenda-entry-footer">
            <span class="text-body-secondary">Official Clerk Packet Available</span>
            {% if item.url %}
              <a href="{{ item.url }}" class="agenda-download-link" target="_blank" rel="noopener noreferrer">
                <span>Download Agenda PDF</span>
                <svg class="agenda-download-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            {% endif %}
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Card Footer: Disclaimer #}
  {% if disclaimer_text %}
    <div class="card-footer-strip text-body-secondary">
      <span>{{ disclaimer_text }}</span>
    </div>
  {% endif %}

</div>
{% endif %}