<!-- File: _includes/components/widget/layout-hub-grid.njk -->
{# 
  COMPONENT: Portal Hub Grid Layout Chassis (widget.layout.hub.grid)
  CONTRACT:
    - content: String (HTML safe markup from paired shortcode or layout wrapper) [Optional]
    - hub_grid_slot: String (HTML safe markup) [Optional]
    - hub_grid_items / grid_items: Array of Objects [Optional]
      Each object expects attributes matching element-card-hubitem.njk:
      - title / card_hub_title: String [Required]
      - url / card_hub_url: String [Required]
      - summary / desc / card_hub_summary: String [Optional]
      - tag / card_hub_tag: String [Optional]
      - cta / card_hub_cta: String [Optional]
      - icon / card_hub_icon: String [Optional]
#}

{% set items = hub_grid_items or grid_items %}
{% set has_slot = content or hub_grid_slot %}
{% set has_items = items and items.length > 0 %}

{% if has_slot or has_items %}
<div class="widget-layout-hub-grid">
  <div class="hub-grid-container">
    {% if content %}
      {{ content | safe }}
    {% elif hub_grid_slot %}
      {{ hub_grid_slot | safe }}
    {% elif has_items %}
      {% for item in items %}
        {% set card_hub_title = item.title or item.card_hub_title %}
        {% set card_hub_url = item.url or item.card_hub_url %}
        {% set card_hub_summary = item.summary or item.desc or item.card_hub_summary %}
        {% set card_hub_tag = item.tag or item.card_hub_tag %}
        {% set card_hub_cta = item.cta or item.card_hub_cta %}
        {% set card_hub_icon = item.icon or item.card_hub_icon %}
        {% include "components/widget/element-card-hubitem.njk" ignore missing %}
      {% endfor %}
    {% endif %}
  </div>
</div>
{% endif %}