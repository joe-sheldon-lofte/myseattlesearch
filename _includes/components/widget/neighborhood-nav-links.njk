<!-- File: _includes/components/widget/neighborhood-nav-links.njk -->
{% set city_slug = current_city_slug | default("edmonds") %}
{% set active_tab = current_nav_tab | default("hub") %}

{% set default_nav_items = [
  { id: "hub", label: "Neighborhood Hub", url: "/communities/" + city_slug + "/" },
  { id: "weather", label: "Weather", url: "/communities/" + city_slug + "/weather/" },
  { id: "transit", label: "Transit & Commute", url: "/communities/" + city_slug + "/transit-commute/" },
  { id: "news", label: "News & Events", url: "/communities/" + city_slug + "/news-events/" },
  { id: "municipal", label: "Municipal Services", url: "/communities/" + city_slug + "/municipal/" },
  { id: "emergency", label: "Emergency & Safety", url: "/communities/" + city_slug + "/emergency-safety/" },
  { id: "elections", label: "Elections & Voting", url: "/communities/" + city_slug + "/elections/" },
  { id: "realestate", label: "Real Estate & Data", url: "/communities/" + city_slug + "/real-estate/" }
] %}

{# Responsive Horizontal Scroll Container per Edit #}
<nav class="widget-card neighborhood-nav-links-scroll" aria-label="Neighborhood Sections" style="width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); padding: 0.5rem; display: flex; gap: 0.5rem; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; scroll-snap-type: x mandatory; box-sizing: border-box;">
  {% for item in default_nav_items %}
    {% set is_current = (item.id == active_tab) %}
    <a href="{{ item.url }}" 
       style="flex: 0 0 auto; scroll-snap-align: start; padding: 0.65rem 1.15rem; border-radius: 999px; text-decoration: none; font-size: 0.8rem; font-weight: 700; white-space: nowrap; transition: all 0.15s ease; {% if is_current %}background: var(--color-secondary-default); color: #FFFFFF;{% else %}background: var(--color-surface-gray); color: var(--color-primary-default); border: 1px solid var(--color-border-light);{% endif %}">
      {{ item.label }}
    </a>
  {% endfor %}
</nav>
<style>.neighborhood-nav-links-scroll::-webkit-scrollbar { display: none; }</style>