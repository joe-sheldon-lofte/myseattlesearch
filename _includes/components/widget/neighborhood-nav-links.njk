<!-- File: _includes/components/widget/neighborhood-nav-links.njk -->
{# 
  COMPONENT: Atomic Navigation Pill Link (widget.neighborhood.nav.links)
  PURPOSE: Atomic text-only navigation link button for subpage routers, category tabs, and civic links.
  CONTRACT:
    - nav_label / link_label / label: String [Required, e.g. "Weather", "City Website"]
    - nav_url / link_url / url: String [Required, e.g. "/neighborhood/bellevue/weather/", "https://bellevuewa.gov"]
    - is_active / is_current: Boolean [Optional, true if current route]
    - is_external: Boolean [Optional, true for external http/https links]
#}

{% set label_text = nav_label or link_label or label %}
{% set target_url = nav_url or link_url or url %}
{% set active_state = is_active or is_current or false %}
{% set external_state = is_external or (target_url and ('http://' in target_url or 'https://' in target_url)) %}

{% if label_text and target_url %}
  <a href="{{ target_url }}" 
     class="neighborhood-nav-pill {% if active_state %}is-active{% else %}is-inactive{% endif %}"
     {% if active_state %}aria-current="page"{% endif %}
     {% if external_state %}target="_blank" rel="noopener noreferrer"{% endif %}>
    {{ label_text }}
  </a>
{% else %}
  <span class="neighborhood-nav-pill is-inactive" style="opacity: 0.4;">NO DATA</span>
{% endif %}