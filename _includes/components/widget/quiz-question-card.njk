<!-- File: _includes/components/widget/quiz-question-card.njk -->
{% set step_current = question_current_index | default(1) %}
{% set step_total = question_total_count | default(12) %}
{% set progress_pct = (step_current / step_total) * 100 %}
{% set prompt_text = question_prompt | default("I prefer having saltwater shoreline walking access within a 10-minute walk, even if it means smaller interior lot acreage.") %}
{% set hub_cancel_url = question_cancel_url | default("/quizzes/") %}

<div class="widget-card quiz-question-card" style="padding: 2.25rem; width: 100%; max-width: 680px; margin: 0 auto; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.75rem; box-sizing: border-box;">
  
  {# Progress Bar & Tracker #}
  <div style="display: flex; flex-direction: column; gap: 0.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.7rem; font-weight: 800;">
        STATEMENT {{ step_current }} OF {{ step_total }}
      </span>
      <span style="font-size: 0.75rem; font-weight: 700; color: #86868b; font-family: monospace;">
        {{ progress_pct | round }}% Completed
      </span>
    </div>

    {# Horizontal Progress Fill Bar #}
    <div style="width: 100%; height: 6px; background: var(--color-surface-gray); border-radius: 999px; overflow: hidden;">
      <div style="width: {{ progress_pct }}%; height: 100%; background: var(--color-secondary-default); border-radius: 999px; transition: width 0.3s ease;"></div>
    </div>
  </div>

  {# Question Prompt #}
  <div style="text-align: center; padding: 1rem 0;">
    <h3 class="text-widget-title" style="font-size: 1.35rem; line-height: 1.45; margin: 0; color: var(--color-primary-default); font-weight: 700;">
      "{{ prompt_text }}"
    </h3>
  </div>

  {# Rating Scale Selector (1–10) #}
  <div style="display: flex; flex-direction: column; gap: 0.75rem;">
    <div style="display: grid; grid-template-columns: repeat(10, 1fr); gap: 0.35rem;" role="radiogroup" aria-label="1 to 10 agreement scale">
      {% for num in range(1, 11) %}
        <button type="button" 
                class="btn-quiz-scale" 
                data-value="{{ num }}"
                onclick="document.querySelectorAll('.btn-quiz-scale').forEach(b => { b.style.background='var(--color-surface-gray)'; b.style.color='var(--color-primary-default)'; b.style.borderColor='var(--color-border-light)'; }); this.style.background='var(--color-secondary-default)'; this.style.color='#FFFFFF'; this.style.borderColor='var(--color-secondary-default)';"
                style="aspect-ratio: 1 / 1; min-height: 38px; border-radius: 8px; border: 1px solid var(--color-border-light); background: var(--color-surface-gray); color: var(--color-primary-default); font-size: 0.85rem; font-weight: 800; cursor: pointer; transition: all 0.15s ease; padding: 0;">
          {{ num }}
        </button>
      {% endfor %}
    </div>

    {# Outer Text Anchors Below Buttons #}
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0 0.25rem;">
      <span class="text-overline" style="font-size: 0.65rem; color: #86868b;">
        COMPLETELY DISAGREE
      </span>
      <span class="text-overline" style="font-size: 0.65rem; color: #86868b;">
        COMPLETELY AGREE
      </span>
    </div>
  </div>

  {# Navigation Controls & Footer Ghost Link #}
  <div style="display: flex; flex-direction: column; gap: 1rem; border-top: 1px solid var(--color-border-light); padding-top: 1.25rem; margin-top: 0.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
      <button type="button" 
              style="flex: 1; padding: 0.75rem 1.25rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); color: var(--color-primary-default); border-radius: 999px; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: background 0.15s ease;">
        ← Back
      </button>

      <button type="button" 
              style="flex: 2; padding: 0.75rem 1.5rem; background: var(--color-secondary-default); color: #FFFFFF; border: none; border-radius: 999px; font-size: 0.85rem; font-weight: 800; cursor: pointer; transition: opacity 0.15s ease; box-shadow: 0 2px 8px rgba(30, 77, 107, 0.2);">
        Next Statement →
      </button>
    </div>

    <div style="text-align: center;">
      <a href="{{ hub_cancel_url }}" 
         class="text-action" 
         style="color: #86868b; font-size: 0.75rem; font-weight: 600; text-decoration: none; padding: 0.35rem;">
        ← Cancel and Go Back to Quizzes
      </a>
    </div>
  </div>

</div>