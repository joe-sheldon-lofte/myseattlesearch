<!-- File: _includes/components/widget/quiz-question-card.njk -->
{# 
  COMPONENT: Neighborhood Lifestyle Fit Quiz Question Card (widget.quiz.question.card)
  ARCHITECTURE: Semantic Zero-Hydration Radio Rating Scale (1-10)
  CONTRACT:
    - question_prompt / prompt_text / prompt: String [Required]
    - question_current_index / step_current: Number [Optional, defaults to 1]
    - question_total_count / step_total: Number [Optional, defaults to 12]
    - question_cancel_url / hub_cancel_url: String [Optional, defaults to "/quizzes/"]
    - question_name / input_name: String [Optional, defaults to "rating"]
#}

{% set prompt = question_prompt or prompt_text or prompt %}
{% set step_curr = question_current_index or step_current or 1 %}
{% set step_tot = question_total_count or step_total or 12 %}
{% set progress_pct = (step_curr / step_tot) * 100 %}
{% set cancel_url = question_cancel_url or hub_cancel_url or "/quizzes/" %}
{% set radio_name = question_name or input_name or "rating" %}

{% if prompt %}
<div class="widget-card quiz-question-card" role="region" aria-label="Lifestyle Quiz Question {{ step_curr }} of {{ step_tot }}">
  
  {# Progress Tracker #}
  <div class="quiz-progress-block">
    <div class="quiz-progress-meta">
      <span class="text-overline quiz-step-tag">
        STATEMENT {{ step_curr }} OF {{ step_tot }}
      </span>
      <span class="quiz-pct-text">
        {{ progress_pct | round }}% Completed
      </span>
    </div>

    {# Horizontal Progress Fill Bar #}
    <div class="quiz-track" role="progressbar" aria-valuenow="{{ progress_pct | round }}" aria-valuemin="0" aria-valuemax="100">
      <div class="quiz-progress-fill" style="width: {{ progress_pct }}%;"></div>
    </div>
  </div>

  {# Question Prompt #}
  <div class="quiz-prompt-stage">
    <h3 class="text-widget-title quiz-prompt-headline">
      &ldquo;{{ prompt }}&rdquo;
    </h3>
  </div>

  {# Rating Scale Selector (1–10) #}
  <div class="quiz-scale-group">
    <div class="quiz-scale-grid" role="radiogroup" aria-label="Agreement rating from 1 completely disagree to 10 completely agree">
      {% for num in range(1, 11) %}
        {% set input_id = "scale-" ~ radio_name ~ "-" ~ num %}
        <div>
          <input type="radio" 
                 name="{{ radio_name }}" 
                 id="{{ input_id }}" 
                 value="{{ num }}" 
                 class="quiz-radio-input"
                 {% if num == 5 %}checked{% endif %}>
          <label for="{{ input_id }}" class="btn-quiz-scale-label">
            {{ num }}
          </label>
        </div>
      {% endfor %}
    </div>

    {# Outer Text Anchors Below Buttons #}
    <div class="quiz-scale-anchors">
      <span class="text-overline quiz-anchor-caption">
        COMPLETELY DISAGREE
      </span>
      <span class="text-overline quiz-anchor-caption">
        COMPLETELY AGREE
      </span>
    </div>
  </div>

  {# Navigation Controls & Footer Return Link #}
  <div class="quiz-nav-cluster">
    <div class="quiz-nav-row">
      <button type="button" class="btn-quiz-back" aria-label="Return to previous statement">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back</span>
      </button>

      <button type="button" class="btn-quiz-next" aria-label="Advance to next statement">
        <span>Next Statement</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>

    <div class="quiz-cancel-wrap">
      <a href="{{ cancel_url }}" class="quiz-cancel-link">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Cancel and Go Back to Quizzes</span>
      </a>
    </div>
  </div>

</div>
{% endif %}