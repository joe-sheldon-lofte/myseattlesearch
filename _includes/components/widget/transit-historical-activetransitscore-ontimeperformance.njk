<!-- File: _includes/components/widget/transit-historical-activetransitscore-ontimeperformance.njk -->
{% set demo_days = [
  { day: "Wednesday", date: "Aug 19, 2026", avg_score: 84, on_time_rate: "92%" },
  { day: "Tuesday", date: "Aug 18, 2026", avg_score: 82, on_time_rate: "90%" },
  { day: "Monday", date: "Aug 17, 2026", avg_score: 79, on_time_rate: "88%" },
  { day: "Sunday", date: "Aug 16, 2026", avg_score: 91, on_time_rate: "96%" },
  { day: "Saturday", date: "Aug 15, 2026", avg_score: 89, on_time_rate: "94%" },
  { day: "Friday", date: "Aug 14, 2026", avg_score: 76, on_time_rate: "84%" },
  { day: "Thursday", date: "Aug 13, 2026", avg_score: 81, on_time_rate: "89%" }
] %}

<section class="widget-card transit-historical-log-card" style="padding: 1.75rem; width: 100%;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 1rem;">
    <div>
      <span class="text-overline">HISTORICAL SERVICE AUDIT</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">
        7-Day Transit Score & Schedule Reliability Log
      </h3>
      <p class="text-body-secondary" style="font-size: 0.85rem; margin-top: 0.25rem;">
        168-hour chronological audit log compiled from OneBusAway GTFS-RT APIs against APTA schedule windows.
      </p>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: var(--color-secondary-default); background: var(--color-background-universal); border: 1px solid var(--color-border-light); padding: 0.35rem 0.75rem; border-radius: 999px;">
      Rolling 7-Day Window
    </div>
  </div>

  {# 7 Daily Accordion Rows using Native Semantic <details> #}
  <div style="display: flex; flex-direction: column; gap: 0.75rem;">
    {% for row in historical_transit_days | default(demo_days) %}
      <details style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; overflow: hidden; transition: border-color 0.2s ease;">
        
        {# Accordion Summary Row #}
        <summary style="list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; cursor: pointer; user-select: none; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--color-secondary-default); width: 16px; text-align: center;" aria-hidden="true">⌄</span>
            <div>
              <span style="font-size: 0.95rem; font-weight: 700; color: var(--color-primary-default);">{{ row.day }}</span>
              <span class="text-body-secondary" style="font-size: 0.8rem; margin-left: 0.35rem;">{{ row.date }}</span>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.85rem;">
            <div style="text-align: right;">
              <span class="text-overline" style="font-size: 0.65rem;">Daily Score</span>
              <div style="font-weight: 700; color: var(--color-secondary-default);">{{ row.avg_score }}/100</div>
            </div>
            <div style="text-align: right;">
              <span class="text-overline" style="font-size: 0.65rem;">On-Time</span>
              <div style="font-weight: 700; color: var(--color-primary-default);">{{ row.on_time_rate }}</div>
            </div>
          </div>
        </summary>

        {# Expanded 24-Hour Breakdown Table (12 AM to 11 PM) #}
        <div style="padding: 0 1.25rem 1.25rem 1.25rem; border-top: 1px solid var(--color-border-light);">
          <div style="overflow-x: auto; margin-top: 0.75rem;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8rem;">
              <thead>
                <tr style="border-bottom: 1px solid var(--color-border-light); color: var(--color-primary-default); opacity: 0.7;">
                  <th class="text-overline" style="padding: 0.5rem 0.25rem;">Hour Slot</th>
                  <th class="text-overline" style="padding: 0.5rem 0.25rem; text-align: center;">Active Transit Score</th>
                  <th class="text-overline" style="padding: 0.5rem 0.25rem; text-align: right;">On-Time Rate</th>
                </tr>
              </thead>
              <tbody>
                {% set hours = [
                  { time: "06:00 AM", score: 86, rate: "93%" },
                  { time: "07:00 AM (Peak)", score: 81, rate: "88%" },
                  { time: "08:00 AM (Peak)", score: 78, rate: "85%" },
                  { time: "09:00 AM", score: 84, rate: "91%" },
                  { time: "12:00 PM (Midday)", score: 85, rate: "92%" },
                  { time: "04:00 PM (Peak)", score: 79, rate: "87%" },
                  { time: "05:00 PM (Peak)", score: 75, rate: "82%" },
                  { time: "06:00 PM (Peak)", score: 80, rate: "86%" },
                  { time: "09:00 PM", score: 88, rate: "95%" }
                ] %}
                {% for hr in hours %}
                <tr style="border-bottom: 1px solid var(--color-border-light);">
                  <td style="padding: 0.4rem 0.25rem; font-weight: 600; color: var(--color-primary-default);">
                    {{ hr.time }}
                  </td>
                  <td style="padding: 0.4rem 0.25rem; text-align: center; font-weight: 700; color: var(--color-secondary-default);">
                    {{ hr.score }}
                  </td>
                  <td style="padding: 0.4rem 0.25rem; text-align: right; font-weight: 600; color: var(--color-primary-default);">
                    {{ hr.rate }}
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

      </details>
    {% endfor %}
  </div>

  {# Methodology Footer #}
  <div style="margin-top: 1.25rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.75rem;" class="text-body-secondary">
    APTA on-time standard: -60s early to +300s late. Raw historical readings archived hourly in <code>data/transit_historical.json</code>.
  </div>

</section>