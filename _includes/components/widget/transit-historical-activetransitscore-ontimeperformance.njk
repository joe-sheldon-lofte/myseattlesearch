{# 
  COMPONENT: 7-Day Transit Score & Schedule Reliability Log (widget.transit.historical.activetransitscore.ontimeperformance)
  PURPOSE: Rolling reliability log and hourly punctuality breakdown for regional transit lines.
  CONTRACT:
    - transit_history_days / transit_days: Array of Objects [Required]
      Each day object expects:
      - day.day / day.name: String [Required, e.g. "Today", "Thursday"]
      - day.date: String [Required, e.g. "Oct 23"]
      - day.score: Number [Required, 0-100 transit score]
      - day.ontime: String [Required, e.g. "92%"]
      - day.hourly: Array of Objects [Optional, hourly telemetry logs]
        Each hourly item expects: { hour, score, ontime, status, status_type }
    - transit_hist_title / hist_title: String [Optional, defaults to "7-Day Transit Score & Schedule Reliability"]
    - transit_hist_overline / hist_overline: String [Optional, defaults to "TRANSIT RELIABILITY"]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set active_neighborhood = active_neighborhood or (neighborhood.name if neighborhood else '') or (city.City if city else '') %}
{% set transit_days = transit_history_days or transit_days %}
{% set default_title = (active_neighborhood ~ " Transit Score & Schedule Reliability") if active_neighborhood else "7-Day Transit Score & Schedule Reliability" %}
{% set card_title = transit_hist_title or hist_title or default_title %}
{% set overline_text = transit_hist_overline or hist_overline or "TRANSIT RELIABILITY" %}

{% if transit_days and transit_days.length > 0 %}
<section class="widget-card transit-historical-log-card" aria-label="{{ card_title }}">
  
  {# Header Row #}
  <header class="transit-hist-header">
    <div class="transit-hist-title-stack">
      <span class="text-overline text-accent-alpine">
        {{ overline_text }}
      </span>
      <h3 class="text-widget-title transit-hist-title">
        {{ card_title }}
      </h3>
    </div>
    <div class="transit-audit-badge">
      7-Day Audit Log
    </div>
  </header>

  {# 7 Daily Accordion Rows (Pure Zero-Hydration SSG) #}
  <div class="transit-days-stack">
    {% for day in transit_days %}
      {% set day_name = day.day or day.name %}
      {% if day_name and day.score is defined and day.score is not none %}
        <details class="transit-day-accordion" {% if loop.first %}open{% endif %}>
          <summary class="transit-day-summary">
            <div class="transit-day-lead">
              <svg class="transit-toggle-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
              <span class="transit-day-name">{{ day_name }}</span>
              {% if day.date %}
                <span class="transit-day-date">{{ day.date }}</span>
              {% endif %}
            </div>

            <div class="transit-day-metrics">
              <span><span class="metric-score-label">Score:</span> <span class="metric-score-val">{{ day.score }}</span></span>
              {% if day.ontime %}
                <span><span class="metric-ontime-label">On-Time:</span> <span class="metric-ontime-val">{{ day.ontime }}</span></span>
              {% endif %}
            </div>
          </summary>

          {# Expanded Hourly Performance Table #}
          {% if day.hourly and day.hourly.length > 0 %}
            <div class="transit-hourly-pane">
              <table class="transit-hourly-table">
                <thead>
                  <tr>
                    <th>Hour</th>
                    <th>Transit Score</th>
                    <th>On-Time Rate</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {% for h in day.hourly %}
                    {% set status_type = h.status_type or "normal" %}
                    <tr>
                      <td class="cell-hour-stamp">{{ h.hour }}</td>
                      <td class="cell-hour-score">{{ h.score }}</td>
                      <td class="cell-hour-ontime">{{ h.ontime }}</td>
                      <td class="cell-hour-status status-{{ status_type }}">{{ h.status | default("Normal") }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
        </details>
      {% endif %}
    {% endfor %}
  </div>

</section>
{% endif %}