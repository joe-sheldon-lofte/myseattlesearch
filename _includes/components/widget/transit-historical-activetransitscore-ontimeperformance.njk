{% set hist_title = transit_hist_title | default("7-Day Transit Score & Schedule Reliability") %}
{% set hist_overline = transit_hist_overline | default("TRANSIT RELIABILITY") %}

{% set demo_days = [
  { day: "Today", date: "Friday, Oct 23", score: 84, ontime: "92%" },
  { day: "Thursday", date: "Oct 22", score: 82, ontime: "90%" },
  { day: "Wednesday", date: "Oct 21", score: 85, ontime: "93%" },
  { day: "Tuesday", date: "Oct 20", score: 79, ontime: "88%" },
  { day: "Monday", date: "Oct 19", score: 81, ontime: "89%" },
  { day: "Sunday", date: "Oct 18", score: 76, ontime: "94%" },
  { day: "Saturday", date: "Oct 17", score: 77, ontime: "95%" }
] %}

<div class="widget-card transit-historical-log-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        {{ hist_overline }}
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ hist_title }}
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: #10B981; background: rgba(16, 185, 129, 0.12); padding: 0.2rem 0.65rem; border-radius: 999px;">
      7-Day Audit Log
    </div>
  </div>

  {# 7 Daily Accordion Rows #}
  <div style="display: flex; flex-direction: column; gap: 0.5rem;">
    {% for day in demo_days %}
      <details class="transit-day-accordion" style="background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 0.75rem 1rem; cursor: pointer;" {% if loop.first %}open{% endif %}>
        <summary style="display: flex; justify-content: space-between; align-items: center; list-style: none; font-size: 0.85rem; font-weight: 700;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="transit-toggle-arrow" style="color: var(--color-secondary-default); font-size: 0.8rem; display: inline-block; transition: transform 0.2s ease;">▶</span>
            <span style="color: var(--color-primary-default);">{{ day.day }}</span>
            <span class="text-body-secondary" style="font-size: 0.75rem; font-weight: 500;">{{ day.date }}</span>
          </div>

          <div style="display: flex; align-items: center; gap: 1rem; font-family: monospace;">
            <span>Score: <strong style="color: var(--color-secondary-default);">{{ day.score }}</strong></span>
            <span>On-Time: <strong style="color: #10B981;">{{ day.ontime }}</strong></span>
          </div>
        </summary>

        {# Expanded 24-Hour Table #}
        <div style="margin-top: 0.75rem; border-top: 1px solid var(--color-border-light); padding-top: 0.75rem; overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.75rem; text-align: left;">
            <thead>
              <tr style="color: #86868b; border-bottom: 1px solid var(--color-border-light);">
                <th style="padding: 0.35rem 0.5rem;">Hour</th>
                <th style="padding: 0.35rem 0.5rem;">Transit Score</th>
                <th style="padding: 0.35rem 0.5rem;">On-Time Rate</th>
                <th style="padding: 0.35rem 0.5rem;">Status</th>
              </tr>
            </thead>
            <tbody>
              {% for h in range(6, 22) %}
                <tr style="border-bottom: 1px solid rgba(0,0,0,0.04);">
                  <td style="padding: 0.35rem 0.5rem; font-family: monospace; font-weight: 600;">{{ h }}:00</td>
                  <td style="padding: 0.35rem 0.5rem; font-family: monospace; font-weight: 700; color: var(--color-secondary-default);">{{ day.score + ((h % 5) - 2) }}</td>
                  <td style="padding: 0.35rem 0.5rem; font-family: monospace; font-weight: 700; color: #10B981;">{{ 90 + ((h % 4) - 1) }}%</td>
                  <td style="padding: 0.35rem 0.5rem; color: #10B981; font-weight: 600;">Normal</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    {% endfor %}
  </div>

  <style>
    .transit-day-accordion summary::-webkit-details-marker { display: none; }
    .transit-day-accordion[open] summary .transit-toggle-arrow { transform: rotate(90deg); }
  </style>

</div>