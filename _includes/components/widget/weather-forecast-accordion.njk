<!-- File: _includes/components/widget/weather-forecast-accordion.njk -->
{% set w_city = city_weather[city_slug] if city_weather else null %}
{% set fc_src = w_city.forecast_11_day if (w_city and w_city.forecast_11_day and w_city.forecast_11_day.dates) else (w_city.forecast_7_day if w_city else null) %}
{% set aqi_fc = w_city.air_quality.forecast_7_day if (w_city and w_city.air_quality and w_city.air_quality.forecast_7_day) else null %}

{% set weekday_names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] %}
{% set month_names = ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] %}
{% set sakamoto_t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4] %}

{% if fc_src and fc_src.dates %}
<section class="widget-card weather-forecast-sevenday-card" aria-label="10-Day Outlook">
  <header class="forecast-header-row">
    <div class="forecast-title-stack">
      <span class="text-overline text-accent-alpine">EXTENDED OUTLOOK</span>
      <h3 class="forecast-card-title text-widget-title">10-Day Forecast</h3>
    </div>
  </header>

  <div class="forecast-days-stack">
    {% for date_str in fc_src.dates %}
      {% if loop.index0 < 10 %}
        {% set max_t = fc_src.temp_max[loop.index0] | round %}
        {% set min_t = fc_src.temp_min[loop.index0] | round %}
        {% set p_prob = fc_src.precip_prob_max[loop.index0] | round %}
        {% set w_code = (fc_src.weather_code[loop.index0] | int) if (fc_src.weather_code and fc_src.weather_code[loop.index0] is not none) else -1 %}
        {% set has_uv = (fc_src.uv_index_max and fc_src.uv_index_max[loop.index0] is not none) %}
        {% set uv_idx = (fc_src.uv_index_max[loop.index0] | round) if has_uv else null %}

        {% set has_aqi = (aqi_fc and aqi_fc.us_aqi_max and loop.index0 < (aqi_fc.us_aqi_max | length) and aqi_fc.us_aqi_max[loop.index0] is not none) %}
        {% set day_aqi = (aqi_fc.us_aqi_max[loop.index0] | round) if has_aqi else null %}
        {% set day_aqi_label = aqi_fc.status_label[loop.index0] if (has_aqi and aqi_fc.status_label) else "" %}

        {# Map WMO weather_code to condition label and icon key #}
        {% set icon_key = "sun" %}
        {% set cond_label = "Clear" %}
        {% if w_code in [95, 96, 99] %}
          {% set icon_key = "thunder" %}{% set cond_label = "Thunderstorm" %}
        {% elif w_code in [71, 73, 75, 77, 85, 86] %}
          {% set icon_key = "snow" %}{% set cond_label = "Snow" %}
        {% elif w_code in [61, 63, 65, 66, 67, 80, 81, 82] %}
          {% set icon_key = "rain" %}{% set cond_label = "Rain" %}
        {% elif w_code in [51, 53, 55, 56, 57] %}
          {% set icon_key = "rain" %}{% set cond_label = "Drizzle" %}
        {% elif w_code in [45, 48] %}
          {% set icon_key = "fog" %}{% set cond_label = "Fog" %}
        {% elif w_code == 3 %}
          {% set icon_key = "cloud" %}{% set cond_label = "Overcast" %}
        {% elif w_code == 2 %}
          {% set icon_key = "partly" %}{% set cond_label = "Partly Cloudy" %}
        {% elif w_code == 1 %}
          {% set icon_key = "sun" %}{% set cond_label = "Mostly Clear" %}
        {% elif p_prob >= 40 %}
          {% set icon_key = "rain" %}{% set cond_label = "Rain" %}
        {% endif %}

        {# Compute true weekday & formatted date from YYYY-MM-DD #}
        {% set d_parts = date_str.split('-') %}
        {% set d_y = d_parts[0] | int %}
        {% set d_m = d_parts[1] | int %}
        {% set d_day = d_parts[2] | int %}
        {% set calc_y = (d_y - 1) if d_m < 3 else d_y %}
        {% set dow_idx = (calc_y + (calc_y // 4) - (calc_y // 100) + (calc_y // 400) + sakamoto_t[d_m - 1] + d_day) % 7 %}
        {% set day_label = "Today" if loop.first else weekday_names[dow_idx] %}
        {% set date_label = month_names[d_m] ~ " " ~ d_day %}

        <details class="forecast-accordion-item" {% if loop.first %}open{% endif %}>
          <summary class="forecast-accordion-summary">
            <div class="forecast-acc-day-col">
              <span class="forecast-acc-day">{{ day_label }}</span>
              <span class="forecast-acc-date">{{ date_label }}</span>
            </div>

            <div class="forecast-acc-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" class="forecast-condition-svg">
                {% if icon_key == "thunder" %}
                  <path d="M7 18a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 18H7z" class="weather-vector-cloud" />
                  <polyline points="16,18 13,24 17,24 14,30" class="weather-vector-lightning" />
                {% elif icon_key == "snow" %}
                  <path d="M7 18a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 18H7z" class="weather-vector-cloud" />
                  <circle cx="11" cy="23" r="1.5" class="weather-vector-cloud" />
                  <circle cx="16" cy="26" r="1.5" class="weather-vector-cloud" />
                  <circle cx="21" cy="23" r="1.5" class="weather-vector-cloud" />
                {% elif icon_key == "rain" %}
                  <path d="M7 19a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 19H7z" class="weather-vector-cloud" />
                  <line x1="11" y1="22" x2="9" y2="27" class="weather-vector-rain" />
                  <line x1="16" y1="22" x2="14" y2="27" class="weather-vector-rain" />
                  <line x1="21" y1="22" x2="19" y2="27" class="weather-vector-rain" />
                {% elif icon_key == "fog" %}
                  <line x1="6" y1="12" x2="26" y2="12" class="weather-vector-cloud" />
                  <line x1="4" y1="17" x2="28" y2="17" class="weather-vector-cloud" />
                  <line x1="7" y1="22" x2="25" y2="22" class="weather-vector-cloud" />
                {% elif icon_key == "partly" %}
                  <circle cx="12" cy="12" r="5" class="weather-vector-sun-core" />
                  <path d="M10 23a4.5 4.5 0 0 1 .9-8.9 6 6 0 0 1 11.6 1.6A4 4 0 0 1 25.5 23H10z" class="weather-vector-cloud" />
                {% elif icon_key == "cloud" %}
                  <path d="M8 22a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 26 22H8z" class="weather-vector-cloud" />
                {% else %}
                  <circle cx="16" cy="16" r="7" class="weather-vector-sun-core" />
                  <line x1="16" y1="4" x2="16" y2="7" class="weather-vector-sun-rays" />
                  <line x1="16" y1="25" x2="16" y2="28" class="weather-vector-sun-rays" />
                  <line x1="4" y1="16" x2="7" y2="16" class="weather-vector-sun-rays" />
                  <line x1="25" y1="16" x2="28" y2="16" class="weather-vector-sun-rays" />
                  <line x1="7.5" y1="7.5" x2="9.6" y2="9.6" class="weather-vector-sun-rays" />
                  <line x1="22.4" y1="22.4" x2="24.5" y2="24.5" class="weather-vector-sun-rays" />
                  <line x1="24.5" y1="7.5" x2="22.4" y2="9.6" class="weather-vector-sun-rays" />
                  <line x1="9.6" y1="22.4" x2="7.5" y2="24.5" class="weather-vector-sun-rays" />
                {% endif %}
              </svg>
            </div>

            <div class="forecast-acc-rain">{{ p_prob }}%</div>

            <div class="forecast-acc-temps">
              <span class="forecast-acc-high">{{ max_t }}&deg;</span>
              <span class="forecast-acc-low">{{ min_t }}&deg;</span>
            </div>

            <svg class="forecast-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>

          <div class="forecast-acc-details">
            <div class="forecast-acc-detail-block">
              <span class="forecast-acc-detail-label">Condition</span>
              <span class="forecast-acc-detail-value">{{ cond_label }}</span>
            </div>
            <div class="forecast-acc-detail-block">
              <span class="forecast-acc-detail-label">Daytime High</span>
              <span class="forecast-acc-detail-value">{{ max_t }}&deg;F</span>
            </div>
            <div class="forecast-acc-detail-block">
              <span class="forecast-acc-detail-label">Overnight Low</span>
              <span class="forecast-acc-detail-value">{{ min_t }}&deg;F</span>
            </div>
            <div class="forecast-acc-detail-block">
              <span class="forecast-acc-detail-label">Precipitation</span>
              <span class="forecast-acc-detail-value">{{ p_prob }}%</span>
            </div>
            {% if has_uv %}
              <div class="forecast-acc-detail-block">
                <span class="forecast-acc-detail-label">Max UV Index</span>
                <span class="forecast-acc-detail-value">{{ uv_idx }}</span>
              </div>
            {% endif %}
            {% if has_aqi %}
              <div class="forecast-acc-detail-block">
                <span class="forecast-acc-detail-label">Air Quality</span>
                <span class="forecast-acc-detail-value">{{ day_aqi_label }} ({{ day_aqi }})</span>
              </div>
            {% endif %}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}