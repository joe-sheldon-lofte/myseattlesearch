<!-- File: _includes/components/widget/cms-widget-linkpreview.njk -->
{# 
  COMPONENT: Rich External Link Preview Card (widget.cms.widget.linkpreview)
  CONTRACT:
    - link_preview_url / preview.url / url: String [Required]
    - link_preview_title / preview.title / title: String [Required]
    - link_preview_domain / preview.domain / domain: String [Optional, e.g. "ELECTREK.CO"]
    - link_preview_snippet / preview.snippet / snippet / description: String [Optional]
#}

{% set href = link_preview_url or (preview.url if preview else '') or url %}
{% set title = link_preview_title or (preview.title if preview else '') or title %}
{% set domain = link_preview_domain or (preview.domain if preview else '') or domain %}
{% set snippet = link_preview_snippet or (preview.snippet if preview else '') or snippet or description %}

{% if href and title %}
<a href="{{ href }}" 
   target="_blank" 
   rel="noopener noreferrer" 
   class="widget-card widget-card-interactive link-preview-card">
  
  {# Leading SVG Globe / External Link Icon (graphic.globe.link) #}
  <div class="link-preview-icon" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <line x1="2" y1="12" x2="22" y2="12"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
  </div>

  {# Main Preview Text Content #}
  <div class="link-preview-content">
    <div class="card-header-split">
      {% if domain %}
        <span class="text-overline text-accent-alpine">
          {{ domain | upper }}
        </span>
      {% else %}
        <span></span>
      {% endif %}
      <span class="link-external-arrow" aria-hidden="true">↗</span>
    </div>

    <h4 class="text-widget-title link-preview-headline">
      {{ title }}
    </h4>

    {% if snippet %}
      <p class="text-body-secondary link-preview-snippet">
        {{ snippet }}
      </p>
    {% endif %}
  </div>

</a>
{% endif %}