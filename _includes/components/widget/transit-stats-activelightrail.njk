{# 
  COMPONENT: Live Transit Active Link Light Rail Fleet Metric (widget.transit.stats.activelightrail)
  PURPOSE: Real-time telemetry counter for active Sound Transit 1 Line & 2 Line light rail trains.
  CONTRACT:
    - transit_lightrail_count / active_lightrail_count / lightrail_count: Number or String [Required]
    - transit_stat_label / lightrail_label: String [Optional, defaults to "CURRENTLY ACTIVE LOCAL LINK LIGHT RAIL"]
    - transit_stat_overline / lightrail_overline: String [Optional, defaults to "SOUND TRANSIT LINK LIGHT RAIL"]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set rail_count = transit_lightrail_count if transit_lightrail_count is defined else (active_lightrail_count if active_lightrail_count is defined else lightrail_count) %}
{% set stat_label = transit_stat_label or lightrail_label or "CURRENTLY ACTIVE LOCAL LINK LIGHT RAIL" %}
{% set stat_overline = transit_stat_overline or lightrail_overline or "SOUND TRANSIT LINK LIGHT RAIL" %}

{% if rail_count is not none and rail_count != '' %}
<div class="widget-card transit-stat-item-card" role="region" aria-label="{{ stat_overline }}: {{ rail_count }} {{ stat_label }}">
  
  {# Graphic Icon Well #}
  <div class="transit-stat-icon-frame" aria-hidden="true">
    {% include "components/graphic/map-train-linklightrail.njk" ignore missing %}
  </div>

  {# Quantitative Telemetry Stack #}
  <div class="transit-stat-content">
    <span class="text-overline transit-stat-overline">
      {{ stat_overline }}
    </span>
    <div class="transit-stat-number">
      {{ rail_count }}
    </div>
    <div class="transit-stat-descriptor">
      {{ stat_label }}
    </div>
  </div>

</div>
{% endif %}