{# 
  COMPONENT: Top 5 Curated Local News Feed (widget.news.summary.list.five)
  PURPOSE: High-density five-article wire with category filters, dynamic city naming, and zero inline CSS.
  CONTRACT:
    - news_items / news_feed: Array of Objects [Required]
      Each article expects:
      - item.title: String [Required]
      - item.url / item.link: String [Required]
      - item.source: String [Optional, e.g. "THE SEATAC BLOG"]
      - item.category / item.tags[0]: String [Optional, e.g. "local", "business", "sports"]
      - item.excerpt: String [Optional]
      - item.date_formatted / item.published: String [Optional]
    - city_name / active_neighborhood / city.City: String [Optional]
    - news_heading: String [Optional]
    - predefined_category: String [Optional, locks feed to a single category]
    - enable_category_pills: Boolean [Optional, defaults to false for 5-item summary]
    - news_all_url: String [Optional, defaults to '/neighborhood/' + city_slug + '/news-events/']
#}

{% set city_label = city_name or active_neighborhood or (city.City if city else '') %}
{% set heading_text = news_heading or (city_label ~ " Dispatches & Wire" if city_label else "Latest Regional Coverage") %}
{% set overline_text = (city_label ~ " NEWS WIRE") if city_label else "REGIONAL NEWS WIRE" %}
{% set feed = news_items or news_feed %}
{% set target_cat = (predefined_category | lower) if predefined_category else null %}

{% if feed and feed.length > 0 %}
<section class="widget-card news-summary-list-card" aria-label="{{ heading_text }}">
  
  {# Header Row #}
  <header class="news-list-header">
    <div class="news-list-title-stack">
      <span class="text-overline text-accent-alpine">{{ overline_text }}</span>
      <h3 class="text-widget-title news-list-headline">{{ heading_text }}</h3>
    </div>
    
    {% if target_cat %}
      <span class="news-wire-category-tag is-locked">{{ target_cat | upper }}</span>
    {% else %}
      <span class="news-count-caption">TOP 5 MOST RECENT</span>
    {% endif %}
  </header>

  {# Optional Interactive Pill Filter Toggles #}
  {% if enable_category_pills and not target_cat %}
    <nav class="news-filter-pills" role="tablist" aria-label="Filter wire categories">
      <button type="button" class="btn-filter-pill is-active" data-filter="all" role="tab" aria-selected="true">All</button>
      <button type="button" class="btn-filter-pill" data-filter="local" role="tab" aria-selected="false">Local</button>
      <button type="button" class="btn-filter-pill" data-filter="business" role="tab" aria-selected="false">Business</button>
      <button type="button" class="btn-filter-pill" data-filter="real-estate" role="tab" aria-selected="false">Real Estate</button>
      <button type="button" class="btn-filter-pill" data-filter="sports" role="tab" aria-selected="false">Sports</button>
    </nav>
  {% endif %}

  {# 5-Article Stream #}
  <div class="news-feed-stack">
    {% set count = 0 %}
    {% for item in feed %}
      {% set item_cat = (item.category or (item.tags[0] if item.tags else 'local')) | lower %}
      {% if (not target_cat or target_cat == item_cat) and count < 5 %}
        {% set count = count + 1 %}
        {% set item_url = item.url or item.link %}
        {% set item_time = item.date_formatted or item.published %}

        <article class="news-feed-item" data-category="{{ item_cat }}">
          <div class="news-item-source-row">
            <span class="text-overline news-item-source">{{ item.source | default("REGIONAL DISPATCH") }}</span>
            {% if item_cat %}
              <span class="news-wire-dot" aria-hidden="true">•</span>
              <span class="news-wire-category-tag">{{ item_cat }}</span>
            {% endif %}
          </div>

          <h4 class="news-item-title">
            <a href="{{ item_url }}" class="news-item-link" target="_blank" rel="noopener noreferrer">
              {{ item.title }}
            </a>
          </h4>

          {% if item.excerpt %}
            <p class="text-body-secondary news-item-excerpt">
              {{ item.excerpt }}
            </p>
          {% endif %}

          <div class="news-item-meta-strip">
            <time class="news-item-time">{{ item_time }}</time>
            <a href="{{ item_url }}" class="news-item-read-link" target="_blank" rel="noopener noreferrer">
              <span>Read Story</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  {# Footer Routing Strip #}
  <footer class="news-list-footer">
    <a href="{{ news_all_url | default('/neighborhood/' ~ (city_label | slugify) ~ '/news-events/') }}" class="news-all-action-link">
      <span>See all {{ city_label | default("regional") }} news &amp; archives</span>
      <span aria-hidden="true">→</span>
    </a>
  </footer>

</section>
{% endif %}