<!-- File: _includes/components/widget/elections-guide-candidates.njk -->
{% set guide_title = candidates_guide_title | default("Candidates Reference Guide") %}
{% set guide_sub = "Candidates appearing on your ballot." %}
{% set disclaimer_text = "Candidate statements published exactly as submitted to the County." %}

{% set demo_races = [
  {
    office: "Mayor • City of Edmonds",
    candidates: [
      { name: "Mike Rosen", title: "Incumbent Mayor", bio: "Focusing on municipal fiscal discipline, waterfront environmental preservation, and downtown business district support." },
      { name: "Challenger Name", title: "Community Advocate", bio: "Advocating for missing-middle housing acceleration, pedestrian sidewalk connectivity, and climate resilience." }
    ]
  },
  {
    office: "City Council • Position 1",
    candidates: [
      { name: "Candidate A", title: "Business Owner", bio: "Small business advocacy, budget transparency, and public safety infrastructure prioritization." },
      { name: "Candidate B", title: "Transit Planner", bio: "Promoting regional bus transit integration, walkability, and stormwater infrastructure investments." }
    ]
  }
] %}

<div class="widget-card elections-guide-candidates-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row per edit: "CANDIDATES REFERENCE GUIDE" #}
  <div style="border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
      CANDIDATES REFERENCE GUIDE
    </span>
    <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.25rem;">
      {{ guide_title }}
    </h3>
    <p class="text-body-secondary" style="font-size: 0.85rem; line-height: 1.5; margin: 0.25rem 0 0 0;">
      {{ guide_sub }}
    </p>
  </div>

  {# Accordion of Races #}
  <div style="display: flex; flex-direction: column; gap: 0.85rem;">
    {% for race in demo_races %}
      <details class="election-race-accordion" style="background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer;" {% if loop.first %}open{% endif %}>
        <summary style="display: flex; justify-content: space-between; align-items: center; list-style: none; font-size: 0.95rem; font-weight: 800; color: var(--color-primary-default);">
          <span>{{ race.office }}</span>
          <span style="font-size: 0.75rem; color: var(--color-secondary-default);">▼</span>
        </summary>

        <div style="margin-top: 1rem; border-top: 1px solid var(--color-border-light); padding-top: 0.75rem; display: flex; flex-direction: column; gap: 0.85rem;">
          {% for cand in race.candidates %}
            <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 8px; padding: 0.85rem;">
              <div style="display: flex; justify-content: space-between; align-items: baseline;">
                <h5 style="margin: 0; font-size: 0.9rem; font-weight: 800; color: var(--color-primary-default);">{{ cand.name }}</h5>
                <span class="text-overline" style="font-size: 0.6rem; color: #86868b;">{{ cand.title }}</span>
              </div>
              <p class="text-body-secondary" style="font-size: 0.8rem; line-height: 1.45; margin: 0.35rem 0 0 0;">
                {{ cand.bio }}
              </p>
            </div>
          {% endfor %}
        </div>
      </details>
    {% endfor %}
  </div>

  {# Footer per edit #}
  <div style="border-top: 1px solid var(--color-border-light); padding-top: 0.65rem; font-size: 0.75rem;" class="text-body-secondary">
    {{ disclaimer_text }}
  </div>

</div>