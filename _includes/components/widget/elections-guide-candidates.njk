<!-- File: _includes/components/widget/elections-guide-candidates.njk -->
{# 
  COMPONENT: Candidate Reference Guide Accordion (widget.elections.guide.candidates)
  CONTRACT:
    - elections_races / races: Array of Objects [Required]
      Each race object expects:
      - race.office / race.title: String [Required]
      - race.candidates: Array of Objects [Required]
        Each candidate expects:
        - cand.name: String [Required]
        - cand.title / cand.role: String [Optional]
        - cand.bio / cand.statement: String [Optional]
    - candidates_guide_title / guide_title: String [Optional, defaults to "Candidate Reference Guide"]
    - candidates_disclaimer / disclaimer_text: String [Optional]
#}

{% set race_list = elections_races or races %}
{% set title = candidates_guide_title or guide_title or "Candidate Reference Guide" %}
{% set disclaimer = candidates_disclaimer or disclaimer_text %}

{% if race_list and race_list.length > 0 %}
<div class="widget-card elections-guide-card">
  
  {# Header Row #}
  <div class="card-header-clean">
    <h3 class="text-widget-title">{{ title }}</h3>
  </div>

  {# Accordion Stack of Contested Races #}
  <div class="election-races-stack">
    {% for race in race_list %}
      {% set race_office = race.office or race.title %}
      {% if race_office and race.candidates and race.candidates.length > 0 %}
        <details class="election-race-accordion" {% if loop.first %}open{% endif %}>
          <summary class="accordion-summary">
            <span class="accordion-office-title">{{ race_office }}</span>
            <svg class="accordion-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>

          <div class="accordion-candidate-list">
            {% for cand in race.candidates %}
              {% if cand.name %}
                <div class="candidate-entry-card">
                  <div class="candidate-entry-header">
                    <h5 class="candidate-name">{{ cand.name }}</h5>
                    {% set role = cand.title or cand.role %}
                    {% if role %}
                      <span class="text-overline candidate-role-tag">{{ role }}</span>
                    {% endif %}
                  </div>
                  
                  {% set statement = cand.bio or cand.statement %}
                  {% if statement %}
                    <p class="text-body-secondary candidate-bio-text">
                      {{ statement }}
                    </p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>

  {# Legal / Official Disclaimer Footer #}
  {% if disclaimer %}
    <div class="card-footer-strip text-body-secondary">
      <span>{{ disclaimer }}</span>
    </div>
  {% endif %}

</div>
{% endif %}