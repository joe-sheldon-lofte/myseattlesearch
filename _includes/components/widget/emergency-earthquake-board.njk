{# 
  COMPONENT: Recent Earthquakes & Seismic Activity Board (widget.emergency.earthquake.board)
  CONTRACT:
    - earthquake_events / quakes / earthquake_events_data: Array of Objects [Required]
      Each event object expects:
      - q.mag: String / Number [Required, e.g. "2.4"]
      - q.loc: String [Required, e.g. "4 km SSW of Carnation, WA"]
      - q.depth: String [Optional, e.g. "18.2 km"]
      - q.time: String [Required, e.g. "4 hours ago"]
      - q.felt: String [Optional, e.g. "None" or "12 reports"]
      - q.status: String [Optional, e.g. "Minor", "Micro", "Light"]
    - earthquake_title: String [Optional, defaults to "Recent Earthquakes"]
    - earthquake_badge: String [Optional, defaults to "72-Hour Tracking"]
    - earthquake_source: String [Optional, defaults to "USGS / Pacific Northwest Seismic Network (PNSN)"]
#}

{% set quake_list = earthquake_events or quakes or earthquake_events_data %}
{% set title = earthquake_title or "Recent Earthquakes" %}
{% set badge_text = earthquake_badge or "72-Hour Tracking" %}
{% set source_text = earthquake_source or "USGS / Pacific Northwest Seismic Network (PNSN)" %}

{% if quake_list and quake_list.length > 0 %}
<div class="widget-card emergency-board-card">
  
  {# Header Row: Seismic Overline, Title & 72-Hour Status Badge #}
  <div class="card-header-split emergency-board-header">
    <div>
      <span class="text-overline text-accent-alpine">
        SEISMIC ACTIVITY REPORTS
      </span>
      <h3 class="text-widget-title emergency-board-title">
        {{ title }}
      </h3>
    </div>

    {% if badge_text %}
      <div class="badge-status-emerald">
        {{ badge_text }}
      </div>
    {% endif %}
  </div>

  {# Seismic Events Stack #}
  <div class="emergency-events-stack">
    {% for q in quake_list %}
      {% if q.mag and q.loc %}
        <div class="emergency-event-row">
          <div class="emergency-event-lead">
            
            {# Magnitude Metric Badge (52x42 squircle with tabular monospace numeral) #}
            <div class="emergency-metric-badge" aria-label="Magnitude {{ q.mag }}">
              <span class="emergency-metric-value text-accent-alpine">M{{ q.mag }}</span>
            </div>

            {# Incident Metadata Stack #}
            <div class="emergency-event-content">
              <div class="emergency-event-title">
                {{ q.loc }}
              </div>
              <div class="text-body-secondary emergency-event-meta">
                {% if q.depth %}Depth: {{ q.depth }}{% endif %}
                {% if q.depth and q.felt %} • {% endif %}
                {% if q.felt %}Felt: {{ q.felt }}{% elif q.status %}Class: {{ q.status }}{% endif %}
              </div>
            </div>

          </div>

          {# Right-Aligned Relative Timestamp #}
          {% if q.time %}
            <time class="emergency-event-time text-body-secondary">
              {{ q.time }}
            </time>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Footer: Official PNSN / USGS Scientific Attribution #}
  <div class="card-footer-strip text-body-secondary">
    <span>Data Source: {{ source_text }}</span>
  </div>

</div>
{% endif %}