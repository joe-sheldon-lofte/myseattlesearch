<!-- File: _includes/components/widget/quiz-results-view.njk -->
{# 
  COMPONENT: Neighborhood Lifestyle Quiz Results & Archetype Dossier (widget.quiz.results.view)
  CONTRACT:
    - result_archetype_title / archetype_title / archetype_name: String [Required]
    - result_archetype_subtitle / archetype_subtitle: String [Optional]
    - result_match_neighborhood / match_neighborhood / result_match_city: String [Optional]
    - result_share_url / share_url: String [Optional]
    - result_narrative_content / content: String (HTML safe prose) [Optional]
#}

{% set archetype = result_archetype_title or archetype_title or archetype_name %}
{% set subtitle = result_archetype_subtitle or archetype_subtitle %}
{% set match_neighborhood = result_match_neighborhood or match_neighborhood or result_match_city %}
{% set share_href = result_share_url or share_url %}
{% set narrative = result_narrative_content or content %}

{% if archetype %}
<section class="widget-card quiz-results-view-card" aria-label="Lifestyle Match Results: {{ archetype }}">
  
  {# Hero Archetype Banner #}
  <header class="quiz-results-header">
    <span class="text-overline quiz-results-overline">
      RESULTS LOCKED IN
    </span>
    <h1 class="text-display quiz-archetype-title">
      {{ archetype }}
    </h1>
    {% if subtitle %}
      <p class="quiz-archetype-subtitle">
        {{ subtitle }}
      </p>
    {% endif %}
  </header>

  {# Social Share Summary Card #}
  {% if match_neighborhood or share_href %}
    <div class="quiz-match-bar">
      <div class="quiz-match-lead">
        <div class="quiz-match-icon-frame" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="m4.93 4.93 4.24 4.24"/>
            <path d="m14.83 9.17 4.24-4.24"/>
            <path d="m14.83 14.83 4.24 4.24"/>
            <path d="m9.17 14.83-4.24 4.24"/>
            <circle cx="12" cy="12" r="4"/>
          </svg>
        </div>

        <div class="quiz-match-identity">
          <span class="text-overline quiz-match-caption">YOUR NEIGHBORHOOD MATCH</span>
          {% if match_neighborhood %}
            <div class="quiz-match-name">
              {{ match_neighborhood }}
            </div>
          {% endif %}
        </div>
      </div>

      {% if share_href %}
        <button type="button" 
                class="btn-quiz-share" 
                aria-label="Share your quiz results"
                data-share-title="My Neighborhood Match: {{ archetype }}"
                data-share-url="{{ share_href }}"
                onclick="if(navigator.share){navigator.share({title:this.dataset.shareTitle,url:this.dataset.shareUrl})}else{navigator.clipboard.writeText(this.dataset.shareUrl);}">
          <svg class="quiz-share-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
            <polyline points="16 6 12 2 8 6"/>
            <line x1="12" y1="2" x2="12" y2="15"/>
          </svg>
          <span>Share Results</span>
        </button>
      {% endif %}
    </div>
  {% endif %}

  {# Narrative Assessment #}
  {% if narrative %}
    <div class="narrative-assessment text-body quiz-narrative-prose">
      {{ narrative | safe }}
    </div>
  {% endif %}

</section>
{% endif %}