{# 
  COMPONENT: Comprehensive Community News Wire & Categorized Feed (widget.news.summary.list.all)
  PURPOSE: Full article feed with interactive non-geographic topic filter pills and city-aware headlines.
#}

{% set city_label = city_name or active_neighborhood or (city.City if city else '') %}
{% set heading_text = all_news_heading or news_heading or (city_label ~ " Community & Regional Coverage" if city_label else "All Regional Coverage") %}
{% set overline_text = (city_label ~ " NEWS WIRE") if city_label else "REGIONAL NEWS WIRE" %}
{% set news_feed = all_news_items or news_items or news_all_data or news %}

{% if news_feed and news_feed.length > 0 %}
<section class="widget-card news-summary-list-all-card" aria-label="{{ heading_text }}">
  
  {# Header Row #}
  <header class="news-all-header">
    <div class="news-all-title-stack">
      <span class="text-overline text-accent-alpine">{{ overline_text }}</span>
      <h3 class="text-widget-title news-all-headline">{{ heading_text }}</h3>
    </div>
    <div class="news-filter-caption">Filter Wire by Topic</div>
  </header>

  {# Topic Filter Pills (Non-Geographic Only) #}
  <nav class="news-filter-pills" role="tablist" aria-label="Filter wire by category">
    <button type="button" class="btn-filter-pill is-active" data-filter="all" role="tab" aria-selected="true">All Wire</button>
    <button type="button" class="btn-filter-pill" data-filter="local" role="tab" aria-selected="false">Local</button>
    <button type="button" class="btn-filter-pill" data-filter="business" role="tab" aria-selected="false">Business</button>
    <button type="button" class="btn-filter-pill" data-filter="real-estate" role="tab" aria-selected="false">Real Estate</button>
    <button type="button" class="btn-filter-pill" data-filter="sports" role="tab" aria-selected="false">Sports</button>
    <button type="button" class="btn-filter-pill" data-filter="goodnews" role="tab" aria-selected="false">Civic Spotlight</button>
  </nav>

  {# Full Article Stream #}
  <div class="news-list-container">
    {% for item in news_feed %}
      {% set item_url = item.url or item.link %}
      {% if item.title and item_url %}
        {% set item_cat = (item.category or (item.tags[0] if item.tags else 'local')) | lower %}
        <article class="news-wire-item" data-category="{{ item_cat }}">
          
          <div class="news-wire-meta">
            <span class="text-overline news-wire-source">{{ item.source | default("REGIONAL DISPATCH") }}</span>
            <span class="news-wire-dot" aria-hidden="true">•</span>
            <span class="news-wire-category-tag">{{ item_cat }}</span>
          </div>

          <h4 class="news-wire-title">
            <a href="{{ item_url }}" class="news-wire-title-link" target="_blank" rel="noopener noreferrer">
              {{ item.title }}
            </a>
          </h4>

          {% if item.excerpt %}
            <p class="text-body-secondary news-wire-excerpt">
              {{ item.excerpt }}
            </p>
          {% endif %}

          <div class="news-wire-footer">
            <time class="news-wire-time">{{ item.date_formatted or item.published }}</time>
            <a href="{{ item_url }}" class="news-read-link" target="_blank" rel="noopener noreferrer">
              <span>Read Story</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

        </article>
      {% endif %}
    {% endfor %}
  </div>

  {# Client-Side Controller (Toggles display state classes) #}
  <script>
    (function() {
      const container = document.currentScript ? document.currentScript.closest('.news-summary-list-all-card') : document.querySelector('.news-summary-list-all-card');
      if (!container) return;
      const pills = container.querySelectorAll('.btn-filter-pill');
      const items = container.querySelectorAll('.news-wire-item');

      pills.forEach(pill => {
        pill.addEventListener('click', function() {
          pills.forEach(p => {
            p.classList.remove('is-active');
            p.setAttribute('aria-selected', 'false');
          });
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          const filter = this.getAttribute('data-filter');
          items.forEach(item => {
            const cat = item.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              item.classList.remove('is-hidden');
            } else {
              item.classList.add('is-hidden');
            }
          });
        });
      });
    })();
  </script>

</section>
{% endif %}