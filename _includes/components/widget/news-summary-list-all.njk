{% set widget_id = news_widget_id or ("news-wire-" ~ (city_name | default("regional") | slugify)) %}
{% set heading_text = all_news_heading or ((city_name ~ " News") if city_name else "Local News") %}
{% set overline_label = overline_text or (city_name | upper if city_name else "REGIONAL WIRE") %}
{% set items = all_news_items or [] %}
{% set tabs = news_filter_tabs if news_filter_tabs is defined else [
  { "slug": "business", "label": "Business" },
  { "slug": "real-estate", "label": "Real Estate" },
  { "slug": "goodnews", "label": "Good News" }
] %}

{% if (items | length) > 0 %}
<section id="{{ widget_id }}" class="surface-bento" aria-label="{{ heading_text }}">
  <header class="airport-board-header">
    <div class="airport-board-title-stack">
      <span class="text-overline text-accent-alpine">{{ overline_label }}</span>
      <h3 class="text-widget-title airport-board-title">{{ heading_text }}</h3>
    </div>

    {% if (tabs | length) > 0 %}
      <div class="airport-board-filter-group" role="tablist" aria-label="Filter {{ heading_text }}">
        <button type="button" class="btn-apt-tab is-active" data-news-filter="all" aria-pressed="true">All</button>
        {% for tab in tabs %}
          <button type="button" class="btn-apt-tab" data-news-filter="{{ tab.slug }}" aria-pressed="false">{{ tab.label }}</button>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <div class="news-wire-stream">
    {% for item in items %}
      {% set item_url = item.url or item.link %}
      {% set item_date = item.date_formatted or item.published %}
      {% set item_tags = item.match_tags or (item.tags | join(" ") if item.tags else "") %}
      {% if item.title and item_url %}
        <article class="flight-row news-wire-entry" data-news-tags="{{ item_tags }}">
          <div class="text-overline">
            {{ item.source | default("REGIONAL PRESS") }}{% if item_date %} &bull; {{ item_date }}{% endif %}{% if item.paywall %} &bull; SUBSCRIPTION{% endif %}
          </div>
          <h4 class="team-card-title">
            <a href="{{ item_url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
          </h4>
          {% if item.excerpt %}
            <p class="climate-summary-snippet">{{ item.excerpt }}</p>
          {% endif %}
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% if (tabs | length) > 0 %}
<script>
(function() {
  var root = document.getElementById("{{ widget_id }}");
  if (!root) return;
  var buttons = root.querySelectorAll("[data-news-filter]");
  var articles = root.querySelectorAll("[data-news-tags]");

  buttons.forEach(function(btn) {
    btn.addEventListener("click", function() {
      var target = btn.getAttribute("data-news-filter");
      buttons.forEach(function(b) {
        var active = b === btn;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-pressed", active ? "true" : "false");
      });
      articles.forEach(function(el) {
        if (target === "all") {
          el.classList.remove("is-hidden");
          return;
        }
        var tags = (el.getAttribute("data-news-tags") || "").toLowerCase().split(/\s+/);
        el.classList.toggle("is-hidden", tags.indexOf(target.toLowerCase()) === -1);
      });
    });
  });
})();
</script>
{% endif %}
{% else %}
<section id="{{ widget_id }}" class="sports-stat-empty-shield" aria-label="{{ heading_text }}">
  <div class="stat-empty-inner">
    <span class="text-overline text-accent-alpine">{{ overline_label }}</span>
    <h3 class="stat-empty-title">No Recent Articles</h3>
    <p class="stat-empty-subtext">No verified news dispatches are currently indexed for {{ city_name | default("this area") }}.</p>
  </div>
</section>
{% endif %}