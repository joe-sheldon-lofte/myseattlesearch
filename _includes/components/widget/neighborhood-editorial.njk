<!-- File: _includes/components/widget/neighborhood-editorial.njk -->
{# 
  COMPONENT: Neighborhood Editorial & Seasonal Narrative (widget.neighborhood.editorial)
  DATA CONTRACT:
    - active_neighborhood / neighborhood.name / city.City / city: String [Required]
    - editorial_content / editorial_html / content: String (HTML safe markup) [Required]
    - editorial_headline / custom_headline: String [Optional, defaults to "About [Neighborhood]"]
    - editorial_overline: String [Optional, defaults to "LOCAL PERSPECTIVE"]
#}

{% set active_neighborhood = active_neighborhood or (neighborhood.name if neighborhood else '') or (city.City if city else '') or (city_data[0].City if city_data else '') or city %}
{% set body_html = editorial_content or editorial_html or (editorials[active_neighborhood | lower | replace(" ", "-")] if editorials else null) or content %}
{% set headline = editorial_headline or custom_headline or ("About " ~ active_neighborhood if active_neighborhood else "About This Neighborhood") %}
{% set overline_label = editorial_overline or "LOCAL PERSPECTIVE" %}

{% if active_neighborhood and body_html %}
<article class="widget-card neighborhood-editorial-card" aria-label="Editorial overview for {{ active_neighborhood }}">

  {# Header Row: Civic Overline & Semantic Heading #}
  <header class="editorial-header-strip">
    <span class="text-overline text-accent-alpine">
      {{ overline_label }}
    </span>
    <h2 class="text-widget-title editorial-headline">
      {{ headline }}
    </h2>
  </header>

  {# Main Editorial Prose Body (Zero client hydration, pure static HTML) #}
  <div class="editorial-prose-body text-body">
    {{ body_html | safe }}
  </div>

</article>
{% endif %}