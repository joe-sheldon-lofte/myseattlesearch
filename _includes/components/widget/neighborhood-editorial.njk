<!-- File: _includes/components/widget/neighborhood-editorial.njk -->
{% set active_city = city or (city_data[0] if city_data else null) or (cityData[0] if cityData else null) %}
{% set city_name = editorial_city_name or active_city.City or active_city.name %}
{% set city_slug = (active_city.slug or city_name) | lower | replace(" ", "-") %}
{% set headline = "About " + city_name if city_name else "About" %}
{% set editorial_html = editorial_content or (editorials[city_slug] if editorials else null) or (editorials[city_name | lower] if editorials else null) or (editorials[city_name] if editorials else null) %}

<article class="widget-card neighborhood-editorial-card" style="padding: 2.25rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.5rem; box-sizing: border-box;">

  <header style="border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.85rem;">
    <h2 class="text-widget-title" style="margin: 0; font-size: 1.5rem; line-height: 1.25; color: var(--color-primary-default);">
      {{ headline }}
    </h2>
  </header>

  {# Main Editorial Prose Body #}
  <div class="editorial-body text-body" style="font-size: 1rem; line-height: 1.7; display: flex; flex-direction: column; gap: 1.25rem; color: var(--color-primary-default);">
    {% if editorial_html %}
      {{ editorial_html | safe }}
    {% elif content %}
      {{ content | safe }}
    {% endif %}
  </div>

</article>