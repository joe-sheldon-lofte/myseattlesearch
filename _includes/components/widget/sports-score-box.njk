{# 
  COMPONENT: Compact Athletic Score Box & Outcome Summary (widget.sports.score.box)
  PURPOSE: Box score display for regional sports matchups with records and game states.
  CONTRACT:
    - scorebox_header / scorebox_league_sport: String [Optional, e.g. "MLB BASEBALL"]
    - scorebox_status_text / scorebox_status: String [Optional, e.g. "FINAL", "IN PROGRESS", "7:10 PM"]
    - scorebox_local_name / team_local_name: String [Required]
    - scorebox_local_record / team_local_record: String [Optional, e.g. "(85-77)"]
    - scorebox_local_score / team_local_score: String or Number [Optional]
    - scorebox_opp_name / team_opp_name: String [Required]
    - scorebox_opp_record / team_opp_record: String [Optional, e.g. "(88-74)"]
    - scorebox_opp_score / team_opp_score: String or Number [Optional]
    - scorebox_recap_url / recap_url: String [Optional, link to game details]
#}

{% set league_text = scorebox_header or scorebox_league_sport %}
{% set status_raw = scorebox_status_text or scorebox_status or "FINAL" %}
{% set team_local = scorebox_local_name or team_local_name %}
{% set record_local = scorebox_local_record or team_local_record %}
{% set score_local = scorebox_local_score if scorebox_local_score is defined else team_local_score %}
{% set team_opp = scorebox_opp_name or team_opp_name %}
{% set record_opp = scorebox_opp_record or team_opp_record %}
{% set score_opp = scorebox_opp_score if scorebox_opp_score is defined else team_opp_score %}
{% set recap_href = scorebox_recap_url or recap_url %}

{% if team_local and team_opp %}
  {% set status_upper = status_raw | upper %}
  {% set is_live = (status_upper == "IN PROGRESS" or status_upper == "LIVE") %}
  {% set is_scheduled = (":" in status_raw or "PM" in status_upper or "AM" in status_upper) %}

  {% set status_pill_class = "status-final" %}
  {% if is_live %}
    {% set status_pill_class = "status-live" %}
  {% elif is_scheduled %}
    {% set status_pill_class = "status-scheduled" %}
  {% endif %}

  <article class="widget-card sports-score-box-card" aria-label="{{ team_local }} vs {{ team_opp }} Score Box">
    
    {# Header Bar: League/Sport & Status Pill #}
    <header class="score-box-header">
      <span class="text-overline score-box-league">
        {{ league_text | default("REGIONAL ATHLETICS") }}
      </span>

      <span class="score-box-status-pill {{ status_pill_class }}">
        {{ status_raw }}
      </span>
    </header>

    {# Stacked Team Rows: Local on Top, Opponent on Bottom #}
    <div class="score-box-teams-stack">
      
      {# Row 1: Local Team #}
      <div class="score-box-team-row row-local">
        <div class="score-box-team-info">
          <span class="score-box-team-name">
            {{ team_local }}
          </span>
          {% if record_local %}
            <span class="score-box-team-record">
              {{ record_local }}
            </span>
          {% endif %}
        </div>
        
        {% if score_local is not none and score_local != '' %}
          <span class="score-box-score-value">
            {{ score_local }}
          </span>
        {% endif %}
      </div>

      {# Row 2: Opposing Team #}
      <div class="score-box-team-row row-opp">
        <div class="score-box-team-info">
          <span class="score-box-team-name name-opp">
            {{ team_opp }}
          </span>
          {% if record_opp %}
            <span class="score-box-team-record">
              {{ record_opp }}
            </span>
          {% endif %}
        </div>

        {% if score_opp is not none and score_opp != '' %}
          <span class="score-box-score-value score-opp">
            {{ score_opp }}
          </span>
        {% endif %}
      </div>

    </div>

    {# Box Score Footer #}
    <footer class="score-box-footer">
      {% if recap_href %}
        <a href="{{ recap_href }}" class="score-box-recap-link">
          <span>Score Recap</span>
          <svg class="score-box-recap-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% else %}
        <span class="text-body-secondary" style="font-size: 0.7rem;">Pacific Northwest Athletics</span>
      {% endif %}
    </footer>

  </article>
{% endif %}