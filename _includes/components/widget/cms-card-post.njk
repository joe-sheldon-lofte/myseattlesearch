<!-- File: _includes/components/widget/cms-card-post.njk -->
<article class="widget-card cms-post-card" style="padding: 1.5rem; width: 100%; display: flex; flex-direction: column; gap: 1rem;">
  
  {# Header Bar #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <span class="text-overline" style="color: var(--color-secondary-default); font-weight: 800; letter-spacing: 0.08em;">POST</span>
      <span style="font-size: 0.75rem; color: var(--color-primary-default); opacity: 0.6;">•</span>
      <time class="text-body-secondary" style="font-size: 0.75rem;" datetime="{{ post_iso_date | default('2026-07-27T10:14:00-07:00') }}">
        {{ post_date | default("July 27, 2026") }}
      </time>
    </div>
    <a href="{{ post_url | default('/notebook/') }}" class="text-action" style="font-size: 0.8rem; font-weight: 600; color: var(--color-secondary-default); text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;">
      <span>View Post</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

  {# Body Content #}
  <div class="text-body" style="line-height: 1.6; word-break: break-word;">
    {{ post_content | default("Regional inventory across the North Sound continues to compress. Snohomish County active listings turned over in an average of 9 days last week, with strong demand clustering around transit-accessible starter inventory. Solid underwriting upfront remains critical.") | safe }}
  </div>

  {# Link Preview Embed (if preview metadata provided) #}
  {% if post_preview_url or post_preview_title %}
  <a href="{{ post_preview_url | default('https://myseattlesearch.com/news/north-sound/') }}" target="_blank" rel="noopener noreferrer" style="text-decoration: none; display: flex; flex-direction: column; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: var(--border-radius-squircle); overflow: hidden; padding: 1rem; gap: 0.35rem; transition: border-color 0.2s ease;">
    <span class="text-overline" style="font-size: 0.65rem; color: var(--color-secondary-default);">{{ post_preview_domain | default("MYSEATTLESEARCH.COM") }}</span>
    <span style="font-size: 0.95rem; font-weight: 700; color: var(--color-primary-default); line-height: 1.3;">{{ post_preview_title | default("North Sound Housing Inventory Analysis & Commuter Rail Corridor Impact") }}</span>
    <span class="text-body-secondary" style="font-size: 0.8rem; line-height: 1.4;">{{ post_preview_snippet | default("In-depth analysis of single-family absorption rates adjacent to regional Sounder rail stations.") }}</span>
  </a>
  {% endif %}

  {# Media Viewport (fluid aspect ratio, WebP) #}
  {% if post_image %}
  <div style="width: 100%; border-radius: var(--border-radius-squircle); overflow: hidden; background: var(--color-surface-gray); aspect-ratio: 16 / 9;">
    <img src="{{ post_image }}" alt="{{ post_image_alt | default('Post media attachment') }}" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover;">
  </div>
  {% endif %}

  {# Footer Metadata Bar #}
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.8rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <div style="width: 28px; height: 28px; border-radius: 50%; overflow: hidden; background: var(--color-surface-gray); flex-shrink: 0; border: 1px solid var(--color-border-light);">
        <img src="/assets/images/joe-sheldon-headshot.webp" alt="Joe Sheldon" width="28" height="28" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
      <div>
        <a href="/#agent" style="color: var(--color-primary-default); font-weight: 700; text-decoration: none;">Joe Sheldon</a>
        <span class="text-body-secondary" style="font-size: 0.75rem;"> • Redfin</span>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 0.5rem;">
      {# Share Action #}
      <button type="button" 
              class="btn-post-action" 
              aria-label="Share this post" 
              onclick="if(navigator.share){navigator.share({title:'Joe Sheldon Update',url:'{{ post_url | default('/notebook/') }}'})}else{navigator.clipboard.writeText('{{ post_url | default('/notebook/') }}');alert('Link copied to clipboard');}" 
              style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.65rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 999px; color: var(--color-primary-default); font-size: 0.75rem; font-weight: 600; cursor: pointer;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
        <span>Share</span>
      </button>

      {# Reply / Inquiry via SMS #}
      <a href="sms:+12066577493" 
         class="btn-post-action" 
         aria-label="Text Joe Sheldon regarding this post" 
         style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.65rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 999px; color: var(--color-secondary-default); font-size: 0.75rem; font-weight: 600; text-decoration: none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>Text Joe</span>
      </a>
    </div>
  </div>

</article>