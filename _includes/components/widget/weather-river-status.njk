{# 
  COMPONENT: USGS Hydrological Sensor & River Flood Status (widget.weather.river.status)[cite: 30]
  PURPOSE: Real-time river discharge (CFS) and gauge stage height telemetry for valley flood safety[cite: 30].
  CONTRACT:
    - river_station_name / river_name / river.station_name: String [Required][cite: 30]
    - river_flow_cfs / flow_cfs / river.flow_cfs: String or Number [Optional, e.g. "2,850"][cite: 30]
    - river_gauge_ft / gauge_ft / river.gauge_ft: String or Number [Optional, e.g. "10.42"][cite: 30]
    - river_flood_stage_ft / flood_stage_ft: String or Number [Optional, benchmark height e.g. "15.0"][cite: 30]
    - river_flood_status / flood_status: String [Optional, e.g. "Below Flood Stage", "Action Stage", "Flood Warning"][cite: 30]
    - river_usgs_id / usgs_id / river.usgs_id: String [Optional, e.g. "USGS 12150800"][cite: 30]
    - river_obs_time / obs_time / river.obs_time: String [Optional, timestamp string][cite: 30]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set station_title = river_station_name or river_name or (river.station_name if river else '') %}[cite: 30]
{% set flow_val = river_flow_cfs if river_flow_cfs is defined else (flow_cfs if flow_cfs is defined else (river.flow_cfs if river else null)) %}[cite: 30]
{% set stage_val = river_gauge_ft if river_gauge_ft is defined else (gauge_ft if gauge_ft is defined else (river.gauge_ft if river else null)) %}[cite: 30]
{% set threshold_val = river_flood_stage_ft or flood_stage_ft or (river.flood_stage_ft if river else null) %}[cite: 30]
{% set raw_status = river_flood_status or flood_status or (river.flood_status if river else '') %}[cite: 30]
{% set sensor_id = river_usgs_id or usgs_id or (river.usgs_id if river else '') %}[cite: 30]
{% set timestamp = river_obs_time or obs_time or (river.obs_time if river else '') %}[cite: 30]
{% set active_neighborhood = active_neighborhood or (neighborhood.name if neighborhood else '') or (city.City if city else '') %}

{% if station_title or flow_val or stage_val %}
  {# Semantic Flood Tier Classification #}
  {% set status_lower = (raw_status | default('Below Flood Stage')) | lower %}[cite: 30]
  {% set status_class = "status-river-normal" %}
  {% if 'flood' in status_lower and ('warning' in status_lower or 'major' in status_lower or 'moderate' in status_lower or 'minor' in status_lower or 'above' in status_lower) %}
    {% set status_class = "status-river-alert" %}
  {% elif 'action' in status_lower or 'near' in status_lower or 'advisory' in status_lower %}
    {% set status_class = "status-river-warning" %}
  {% endif %}

  <section class="widget-card weather-river-status-card" aria-label="USGS River Status: {{ station_title | default('Regional River Sensor') }} — {{ raw_status | default('Below Flood Stage') }}">[cite: 30]
    
    {# Header Row #}
    <header class="river-header-row">[cite: 30]
      <div class="river-title-stack">[cite: 30]
        <span class="text-overline text-accent-alpine">
          USGS HYDROLOGICAL SENSOR[cite: 30]
        </span>
        <h3 class="text-widget-title river-station-title">[cite: 30]
          {{ station_title }}[cite: 30]
        </h3>
      </div>
      <div class="river-status-pill {{ status_class }}">[cite: 30]
        {{ raw_status | default("Below Flood Stage") }}[cite: 30]
      </div>
    </header>

    {# Dual Metrics Grid: Flow Rate & Gauge Height #}
    <div class="river-metrics-grid">[cite: 30]
      
      {# Flow Rate Tile #}
      {% if flow_val is not none and flow_val != '' %}
        <div class="river-metric-tile">[cite: 30]
          <span class="text-overline river-metric-overline">Flow Discharge</span>[cite: 30]
          <div class="river-metric-figure val-flow">[cite: 30]
            {{ flow_val }}[cite: 30]
          </div>
          <div class="river-metric-unit">[cite: 30]
            ft³/s (cfs)[cite: 30]
          </div>
        </div>
      {% endif %}

      {# Gauge Height Tile #}
      {% if stage_val is not none and stage_val != '' %}
        <div class="river-metric-tile">[cite: 30]
          <span class="text-overline river-metric-overline">Gauge Stage</span>[cite: 30]
          <div class="river-metric-figure">[cite: 30]
            {{ stage_val }}[cite: 30]
          </div>
          <div class="river-metric-unit">[cite: 30]
            ft{% if threshold_val %} (Flood: {{ threshold_val }} ft){% endif %}[cite: 30]
          </div>
        </div>
      {% endif %}

    </div>

    {# Footer Telemetry Strip #}
    {% if sensor_id or timestamp %}
      <footer class="river-footer-row">[cite: 30]
        {% if sensor_id %}
          <span>Station: <span class="river-footer-value">{{ sensor_id }}</span></span>[cite: 30]
        {% endif %}
        {% if timestamp %}
          <span>Observed: <span class="river-footer-value">{{ timestamp }}</span></span>[cite: 30]
        {% endif %}
      </footer>
    {% endif %}

  </section>
{% endif %}