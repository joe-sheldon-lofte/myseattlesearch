{# 
  COMPONENT: USGS Hydrological Sensor & River Flood Status (widget.weather.river.status)
  CONTRACT:
    - river_stations / rivers: Array of Objects [Optional, renders all regional stations]
    - river_station_name / river_name: String [Optional, single station fallback]
    - river_flow_cfs: String or Number [Optional]
    - river_gauge_ft: String or Number [Optional]
    - river_flood_stage_ft: String or Number [Optional]
    - river_flood_status: String [Optional]
    - river_usgs_id: String [Optional]
    - river_obs_time: String [Optional]
#}

{% set stations_list = river_stations or rivers %}

{# Single-station fallback normalization #}
{% if not stations_list and (river_station_name or river_flow_cfs or river_gauge_ft) %}
  {% set stations_list = [{
    station_name: river_station_name or river_name,
    flow_cfs: river_flow_cfs,
    gauge_ft: river_gauge_ft,
    flood_stage_ft: river_flood_stage_ft,
    flood_status: river_flood_status,
    usgs_id: river_usgs_id,
    obs_time: river_obs_time
  }] %}
{% endif %}

{% if stations_list and stations_list.length > 0 %}
<div class="section-grid-static grid-cols-2">
  {% for r in stations_list %}
    {% set station_title = r.station_name %}
    {% set flow_val = r.flow_cfs %}
    {% set stage_val = r.gauge_ft %}
    {% set threshold_val = r.flood_stage_ft %}
    {% set raw_status = r.flood_status %}
    {% set sensor_id = r.usgs_id %}
    {% set timestamp = r.obs_time %}

    {% set status_lower = (raw_status | default('Below Flood Stage')) | lower %}
    {% set status_class = "status-river-normal" %}
    {% if 'no data' in status_lower %}
      {% set status_class = "status-river-nodata" %}
    {% elif 'flood' in status_lower and ('warning' in status_lower or 'alert' in status_lower) %}
      {% set status_class = "status-river-alert" %}
    {% elif 'action' in status_lower or 'advisory' in status_lower %}
      {% set status_class = "status-river-warning" %}
    {% endif %}

    <article class="widget-card weather-river-status-card" aria-label="USGS River Status: {{ station_title }}">
      {# Header Row #}
      <header class="river-header-row">
        <div class="river-title-stack">
          <span class="text-overline text-accent-alpine">USGS HYDROLOGICAL SENSOR</span>
          <h3 class="text-widget-title river-station-title">{{ station_title }}</h3>
        </div>
        <div class="river-status-pill {{ status_class }}">
          {{ raw_status | default("Below Flood Stage") }}
        </div>
      </header>

      {# Dual Metrics Grid #}
      <div class="river-metrics-grid">
        <div class="river-metric-tile">
          <span class="text-overline river-metric-overline">Flow Discharge</span>
          <div class="river-metric-figure val-flow">{{ flow_val | default("NO DATA") }}</div>
          <div class="river-metric-unit">ft³/s (cfs)</div>
        </div>

        <div class="river-metric-tile">
          <span class="text-overline river-metric-overline">Gauge Stage</span>
          <div class="river-metric-figure">{{ stage_val | default("NO DATA") }}</div>
          <div class="river-metric-unit">
            ft{% if threshold_val and threshold_val != "NO DATA" %} (Flood: {{ threshold_val }} ft){% endif %}
          </div>
        </div>
      </div>

      {# Footer Telemetry Strip #}
      <footer class="river-footer-row">
        <span>Station: <span class="river-footer-value">{{ sensor_id | default("NO DATA") }}</span></span>
        <span>Observed: <span class="river-footer-value">{{ timestamp | default("NO DATA") }}</span></span>
      </footer>
    </article>
  {% endfor %}
</div>
{% endif %}