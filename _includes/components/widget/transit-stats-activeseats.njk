<!-- File: _includes/components/widget/transit-stats-activeseats.njk -->
{# 
  COMPONENT: Live Transit Active Capacity & Seating Metric (widget.transit.stats.activeseats)
  PURPOSE: Real-time aggregated passenger seating capacity currently deployed across local lines.
  CONTRACT:
    - transit_seats_count / active_seats_count / seats_count: Number or String [Required]
    - transit_stat_label / seats_label: String [Optional, defaults to "CURRENTLY ACTIVE LOCAL TRANSIT SEATS"]
    - transit_stat_overline / seats_overline: String [Optional, defaults to "TRANSIT SEATING CAPACITY"]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set seats_num = transit_seats_count if transit_seats_count is defined else (active_seats_count if active_seats_count is defined else seats_count) %}
{% set stat_label = transit_stat_label or seats_label or "CURRENTLY ACTIVE LOCAL TRANSIT SEATS" %}
{% set stat_overline = transit_stat_overline or seats_overline or "TRANSIT SEATING CAPACITY" %}

{% if seats_num is not none and seats_num != '' %}
<div class="widget-card transit-stat-item-card" role="region" aria-label="{{ stat_overline }}: {{ seats_num }} {{ stat_label }}">
  
  {# Graphic Icon Well #}
  <div class="transit-stat-icon-frame" aria-hidden="true">
    {% include "components/graphic/transit-active-seats.njk" ignore missing %}
  </div>

  {# Quantitative Telemetry Stack #}
  <div class="transit-stat-content">
    <span class="text-overline transit-stat-overline">
      {{ stat_overline }}
    </span>
    <div class="transit-stat-number">
      {{ seats_num }}
    </div>
    <div class="transit-stat-descriptor">
      {{ stat_label }}
    </div>
  </div>

</div>
{% endif %}