{# 
  COMPONENT: Local Public Safety Profile & Crime Rates (widget.municipal.emergency.crime.stats)
  CONTRACT:
    - crime_violent_rate / violent_rate: Number / String [Required, e.g. "1.12"]
    - crime_property_rate / property_rate: Number / String [Required, e.g. "16.4"]
    - police_department_name / neighborhood.police_dept: String [Optional]
    - crime_map_url: String [Optional, defaults to "https://communitycrimemap.com"]
    - crime_source_text: String [Optional, defaults to "Source: WASPC / FBI NIBRS"]
#}

{% set v_rate = crime_violent_rate if crime_violent_rate is defined else violent_rate %}
{% set p_rate = crime_property_rate if crime_property_rate is defined else property_rate %}
{% set dept_name = police_department_name or (neighborhood.police_dept if neighborhood else '') %}
{% set map_href = crime_map_url or "https://communitycrimemap.com" %}
{% set source_text = crime_source_text or "Source: WASPC / FBI NIBRS" %}

{% if v_rate is defined and p_rate is defined %}
<div class="widget-card crime-stats-card">
  
  {# Header Row: Civic Overline, Widget Title, and Department #}
  <div class="crime-stats-header">
    <span class="text-overline text-accent-alpine">
      LOCAL PUBLIC SAFETY PROFILE
    </span>
    <h3 class="text-widget-title crime-stats-title">
      Crime &amp; Public Safety
    </h3>
    {% if dept_name %}
      <div class="text-body-secondary crime-stats-dept-lead">
        Police Department: <span class="crime-dept-highlight">{{ dept_name }}</span>
      </div>
    {% endif %}
  </div>

  {# Dual Metric Grid: Violent vs Property Crime Rate #}
  <div class="crime-metrics-grid">
    
    {# Violent Crime Card #}
    <div class="crime-metric-well">
      <span class="text-overline crime-metric-caption">Violent Crime</span>
      <div class="crime-metric-numeral text-primary-default">
        {{ v_rate }}
      </div>
      <div class="text-body-secondary crime-metric-rate-unit">
        per 1,000 residents
      </div>
    </div>

    {# Property Crime Card #}
    <div class="crime-metric-well">
      <span class="text-overline crime-metric-caption">Property Crime</span>
      <div class="crime-metric-numeral text-accent-alpine">
        {{ p_rate }}
      </div>
      <div class="text-body-secondary crime-metric-rate-unit">
        per 1,000 residents
      </div>
    </div>

  </div>

  {# Footer: Scientific Source & Crime Map Action #}
  <div class="crime-stats-footer">
    <span class="text-body-secondary crime-source-caption">{{ source_text }}</span>
    <a href="{{ map_href }}" 
       target="_blank" 
       rel="noopener noreferrer" 
       class="crime-map-action-link">
      <span>View crime map</span>
      <svg class="crime-map-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

</div>
{% endif %}