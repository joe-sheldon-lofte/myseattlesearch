<!-- File: _includes/components/widget/quiz-start-intake.njk -->
{# 
  COMPONENT: Neighborhood Lifestyle Quiz Intake Gate (widget.quiz.start.intake)
  CONTRACT:
    - intake_quiz_title / quiz_title / title: String [Required]
    - intake_quiz_summary / quiz_desc / description: String [Optional]
    - intake_quiz_duration / quiz_duration: String [Optional, e.g. "3-minute psychographic test"]
    - intake_cancel_url / quiz_hub_url: String [Optional, defaults to "/quizzes/"]
    - intake_action_url / form_action: String [Optional, defaults to "#"]
#}

{% set q_title = intake_quiz_title or quiz_title or title %}
{% set q_desc = intake_quiz_summary or quiz_desc or description %}
{% set q_duration = intake_quiz_duration or quiz_duration %}
{% set q_cancel = intake_cancel_url or quiz_hub_url or "/quizzes/" %}
{% set q_action = intake_action_url or form_action or "#" %}

{% if q_title %}
<div class="widget-card quiz-start-intake-card" role="region" aria-label="Quiz Registration Intake">
  
  {# Header & Context #}
  <header class="quiz-intake-header">
    <div class="quiz-intake-meta-strip">
      <span class="text-overline quiz-intake-overline">
        INTERACTIVE ASSESSMENT
      </span>
      {% if q_duration %}
        <span class="quiz-intake-dot" aria-hidden="true">•</span>
        <span class="quiz-duration-pill">
          {{ q_duration }}
        </span>
      {% endif %}
    </div>

    <h2 class="text-page-title quiz-intake-title">
      {{ q_title }}
    </h2>

    {% if q_desc %}
      <p class="text-body-secondary quiz-intake-desc">
        {{ q_desc }}
      </p>
    {% endif %}
  </header>

  {# Intake Form #}
  <form class="quiz-intake-form" action="{{ q_action }}" method="POST">
    
    <div class="quiz-intake-fields-grid">
      
      {# First Name #}
      <div class="quiz-intake-field-group">
        <label for="intake-first-name" class="text-overline quiz-intake-label">
          First Name
        </label>
        <input type="text" 
               id="intake-first-name" 
               name="first_name" 
               required 
               autocomplete="given-name"
               placeholder="Jane"
               class="quiz-intake-input">
      </div>

      {# Last Name #}
      <div class="quiz-intake-field-group">
        <label for="intake-last-name" class="text-overline quiz-intake-label">
          Last Name
        </label>
        <input type="text" 
               id="intake-last-name" 
               name="last_name" 
               required 
               autocomplete="family-name"
               placeholder="Doe"
               class="quiz-intake-input">
      </div>

      {# Email Address #}
      <div class="quiz-intake-field-group">
        <label for="intake-email" class="text-overline quiz-intake-label">
          Email Address
        </label>
        <input type="email" 
               id="intake-email" 
               name="email" 
               required 
               autocomplete="email"
               placeholder="jane.doe@example.com"
               class="quiz-intake-input">
      </div>

      {# Phone Number #}
      <div class="quiz-intake-field-group">
        <label for="intake-phone" class="text-overline quiz-intake-label">
          Phone Number (SMS Results)
        </label>
        <input type="tel" 
               id="intake-phone" 
               name="phone" 
               autocomplete="tel"
               placeholder="(206) 555-0199"
               class="quiz-intake-input">
      </div>

    </div>

    {# Actions #}
    <div class="quiz-intake-actions">
      <button type="submit" class="btn-quiz-start">
        <span>Start the Quiz</span>
        <svg class="btn-quiz-start-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>

      <a href="{{ q_cancel }}" class="quiz-intake-cancel">
        <svg class="quiz-intake-cancel-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Cancel and Go Back to Quizzes</span>
      </a>
    </div>

  </form>

</div>
{% endif %}