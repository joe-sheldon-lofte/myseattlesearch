<!-- File: _includes/components/widget/quiz-start-intake.njk -->
{% set quiz_title = intake_quiz_title | default("Puget Sound Lifestyle & Neighborhood Matcher") %}
{% set quiz_duration = intake_quiz_duration | default("3-minute psychographic test") %}
{% set quiz_desc = intake_quiz_summary | default("Discover which North Sound or Seattle metro community aligns with your commute tolerance, architectural tastes, and lifestyle priorities.") %}
{% set quiz_hub_url = intake_cancel_url | default("/quizzes/") %}

<div class="widget-card quiz-start-intake-card" style="padding: 2.25rem; width: 100%; max-width: 680px; margin: 0 auto; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.75rem; box-sizing: border-box;">
  
  {# Header & Overview #}
  <div style="text-align: center; display: flex; flex-direction: column; gap: 0.5rem;">
    <span class="text-overline" style="color: var(--color-secondary-default);">
      INTERACTIVE COMMUNITY ASSESSMENT
    </span>
    <h2 class="text-page-title" style="margin: 0; font-size: 1.65rem; line-height: 1.25;">
      {{ quiz_title }}
    </h2>
    <div style="display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 700; color: #86868b; margin-top: 0.25rem;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>{{ quiz_duration }}</span>
    </div>
    <p class="text-body-secondary" style="font-size: 0.9rem; line-height: 1.5; margin: 0.5rem 0 0 0;">
      {{ quiz_desc }}
    </p>
  </div>

  {# Form Layout: Liquid Glass Form Inputs #}
  <form class="quiz-intake-form" onsubmit="event.preventDefault();" style="display: flex; flex-direction: column; gap: 1.25rem;">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
      
      {# First Name #}
      <div style="display: flex; flex-direction: column; gap: 0.35rem;">
        <label for="intake-first-name" class="text-overline" style="font-size: 0.65rem; color: #86868b;">
          First Name
        </label>
        <input type="text" 
               id="intake-first-name" 
               name="first_name" 
               required 
               placeholder="Jane"
               style="width: 100%; padding: 0.75rem 1rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; font-size: 0.9rem; color: var(--color-primary-default); outline: none; transition: border-color 0.2s ease; box-sizing: border-box;">
      </div>

      {# Last Name #}
      <div style="display: flex; flex-direction: column; gap: 0.35rem;">
        <label for="intake-last-name" class="text-overline" style="font-size: 0.65rem; color: #86868b;">
          Last Name
        </label>
        <input type="text" 
               id="intake-last-name" 
               name="last_name" 
               required 
               placeholder="Doe"
               style="width: 100%; padding: 0.75rem 1rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; font-size: 0.9rem; color: var(--color-primary-default); outline: none; transition: border-color 0.2s ease; box-sizing: border-box;">
      </div>

      {# Email Address #}
      <div style="display: flex; flex-direction: column; gap: 0.35rem;">
        <label for="intake-email" class="text-overline" style="font-size: 0.65rem; color: #86868b;">
          Email Address
        </label>
        <input type="email" 
               id="intake-email" 
               name="email" 
               required 
               placeholder="jane.doe@example.com"
               style="width: 100%; padding: 0.75rem 1rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; font-size: 0.9rem; color: var(--color-primary-default); outline: none; transition: border-color 0.2s ease; box-sizing: border-box;">
      </div>

      {# Phone Number #}
      <div style="display: flex; flex-direction: column; gap: 0.35rem;">
        <label for="intake-phone" class="text-overline" style="font-size: 0.65rem; color: #86868b;">
          Phone Number (SMS Results)
        </label>
        <input type="tel" 
               id="intake-phone" 
               name="phone" 
               placeholder="(206) 555-0199"
               style="width: 100%; padding: 0.75rem 1rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; font-size: 0.9rem; color: var(--color-primary-default); outline: none; transition: border-color 0.2s ease; box-sizing: border-box;">
      </div>

    </div>

    {# Actions #}
    <div style="display: flex; flex-direction: column; align-items: center; gap: 0.85rem; margin-top: 0.5rem;">
      <button type="submit" 
              style="width: 100%; padding: 0.95rem 1.5rem; background: var(--color-secondary-default); color: #FFFFFF; border: none; border-radius: 999px; font-size: 0.95rem; font-weight: 800; letter-spacing: 0.04em; cursor: pointer; transition: opacity 0.2s ease; box-shadow: 0 4px 12px rgba(30, 77, 107, 0.25);">
        Start the Quiz →
      </button>

      <a href="{{ quiz_hub_url }}" 
         class="text-action" 
         style="color: #86868b; font-size: 0.8rem; font-weight: 600; text-decoration: none; padding: 0.35rem;">
        ← Cancel and Return to Hub
      </a>
    </div>

  </form>

</div>