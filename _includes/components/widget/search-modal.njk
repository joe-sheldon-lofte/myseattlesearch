<!-- File: _includes/components/widget/search-modal.njk -->
{# 
  COMPONENT: Interactive Site Search & Discovery Drawer (widget.search.modal)
  MATERIAL: Liquid Glass Modal Surface with Frosted Backdrop
  CONTRACT:
    - search_modal_title / modal_title: String [Optional, defaults to "Search"]
    - search_modal_overline / modal_overline: String [Optional, defaults to "DISCOVERY ENGINE"]
    - search_modal_placeholder: String [Optional, defaults to "Search neighborhoods, schools, transit, market data..."]
    - search_modal_suggestions: String [Optional, defaults to "Edmonds, Sounder Train, PSAI Rankings, REET"]
    - search_initial_results: Array of Objects [Optional]
      Each result expects: { title, category, snippet, url }
#}

{% set title_text = search_modal_title or modal_title or "Search" %}
{% set overline_text = search_modal_overline or modal_overline or "DISCOVERY ENGINE" %}
{% set placeholder_text = search_modal_placeholder or "Search neighborhoods, schools, transit, market data..." %}
{% set suggestions_text = search_modal_suggestions or "Edmonds, Sounder Train, PSAI Rankings, REET" %}
{% set initial_feed = search_initial_results %}

<dialog id="dialog-search-modal" 
        class="search-modal-dialog" 
        aria-labelledby="search-modal-title">
  
  <div class="search-modal-chassis">
    
    {# Header Bar #}
    <header class="search-modal-header">
      <div class="search-modal-title-wrap">
        <span class="text-overline text-accent-alpine">
          {{ overline_text }}
        </span>
        <h3 id="search-modal-title" class="search-modal-title">
          {{ title_text }}
        </h3>
      </div>
      <button type="button" 
              class="btn-modal-close" 
              aria-label="Close search modal" 
              onclick="this.closest('dialog').close();">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    {# Search Input Bar #}
    <div class="search-input-stage">
      <div class="search-input-wrapper">
        <span class="search-field-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </span>
        <input type="search" 
               id="site-search-input" 
               class="search-field-pill"
               placeholder="{{ placeholder_text }}" 
               autocomplete="off"
               aria-label="Search site content">
        <button type="button" 
                id="btn-search-clear" 
                class="btn-search-clear"
                aria-label="Clear search input">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="search-meta-bar">
        <span class="search-suggestions-label">
          Suggested: {{ suggestions_text }}
        </span>
        <span id="search-counter" class="search-live-counter" aria-live="polite"></span>
      </div>
    </div>

    {# Scrollable Results Feed #}
    <div id="search-results-container" class="search-results-viewport" role="region" aria-live="polite">
      {% if initial_feed and initial_feed.length > 0 %}
        {% for item in initial_feed %}
          <a href="{{ item.url }}" class="search-result-card">
            <div class="search-result-header">
              <span class="search-result-title">{{ item.title }}</span>
              {% if item.category %}
                <span class="text-overline text-accent-alpine">{{ item.category }}</span>
              {% endif %}
            </div>
            {% if item.snippet %}
              <p class="search-result-snippet">{{ item.snippet }}</p>
            {% endif %}
          </a>
        {% endfor %}
      {% else %}
        <div class="search-empty-prompt" id="search-empty-prompt">
          <svg class="search-empty-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
          <span>Type a query to search neighborhoods, schools, or market metrics</span>
        </div>
      {% endif %}
    </div>

    {# Footer #}
    <footer class="search-modal-footer">
      <span>Press <kbd class="search-kbd-tag">ESC</kbd> to close</span>
      <span>MySeattleSearch</span>
    </footer>

  </div>

  {# Scoped Zero-Dependency Dialog Controller #}
  <script>
    (function() {
      const dialog = document.getElementById('dialog-search-modal');
      const input = document.getElementById('site-search-input');
      const clearBtn = document.getElementById('btn-search-clear');
      const counter = document.getElementById('search-counter');
      if (!dialog || !input) return;

      // Close on backdrop click
      dialog.addEventListener('click', function(e) {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          dialog.close();
        }
      });

      // Clear input button handling
      if (clearBtn) {
        clearBtn.addEventListener('click', function() {
          input.value = '';
          clearBtn.style.display = 'none';
          if (counter) counter.textContent = '';
          input.focus();
        });
      }

      // Live search input observation
      input.addEventListener('input', function() {
        const val = this.value.trim();
        if (clearBtn) {
          clearBtn.style.display = val.length > 0 ? 'inline-flex' : 'none';
        }
        if (counter) {
          counter.textContent = val.length > 0 ? 'Searching...' : '';
        }
      });
    })();
  </script>

</dialog>