<!-- File: _includes/components/widget/search-modal.njk -->
{# 
  COMPONENT: Interactive Site Search & Discovery Drawer (widget.search.modal)
  MATERIAL: Liquid Glass Modal Surface with Frosted Backdrop
  CONTRACT:
    - search_modal_title / modal_title: String [Optional, defaults to "Search"]
    - search_modal_overline / modal_overline: String [Optional, defaults to "DISCOVERY ENGINE"]
    - search_modal_placeholder: String [Optional, defaults to "Search neighborhoods, schools, transit, market data..."]
    - search_modal_suggestions: String [Optional, defaults to "Edmonds, Sounder Train, PSAI Rankings, REET"]
    - search_initial_results: Array of Objects [Optional]
      Each result expects: { title, category, snippet, url }
#}

{% set title_text = search_modal_title or modal_title or "Search" %}
{% set overline_text = search_modal_overline or modal_overline or "DISCOVERY ENGINE" %}
{% set placeholder_text = search_modal_placeholder or "Search neighborhoods, schools, transit, market data..." %}
{% set suggestions_text = search_modal_suggestions or "Edmonds, Sounder Train, PSAI Rankings, REET" %}
{% set suggestion_items = suggestions_text.split(",") %}
{% set initial_feed = search_initial_results %}

<dialog id="dialog-search-modal" 
        class="search-modal-dialog" 
        aria-labelledby="search-modal-title">
  
  <div class="search-modal-chassis">
    
    {# Header Bar #}
    <header class="search-modal-header">
      <div class="search-modal-title-wrap">
        <span class="text-overline text-accent-alpine">
          {{ overline_text }}
        </span>
        <h3 id="search-modal-title" class="search-modal-title">
          {{ title_text }}
        </h3>
      </div>
      <button type="button" 
              class="btn-modal-close" 
              aria-label="Close search modal" 
              onclick="this.closest('dialog').close();">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    {# Search Input Bar #}
    <div class="search-input-stage">
      <div class="search-input-wrapper">
        <span class="search-field-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </span>
        <input type="search" 
               id="site-search-input" 
               class="search-field-pill"
               placeholder="{{ placeholder_text }}" 
               autocomplete="off"
               aria-label="Search site content">
        <button type="button" 
                id="btn-search-clear" 
                class="btn-search-clear"
                aria-label="Clear search input">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="search-meta-bar">
        <div class="search-suggestions-row">
          <span class="search-suggestions-label">Suggested:</span>
          {% for raw_tag in suggestion_items %}
            {% set tag_clean = raw_tag | trim %}
            {% if tag_clean %}
              <button type="button" class="search-suggestion-chip" data-search-suggestion="{{ tag_clean }}">{{ tag_clean }}</button>
            {% endif %}
          {% endfor %}
        </div>
        <span id="search-counter" class="search-live-counter" aria-live="polite"></span>
      </div>
    </div>

    {# Scrollable Results Feed #}
    <div id="search-results-container" class="search-results-viewport" role="region" aria-live="polite">
      {% if initial_feed and initial_feed.length > 0 %}
        {% for item in initial_feed %}
          <a href="{{ item.url }}" class="search-result-card">
            <div class="search-result-header">
              <span class="search-result-title">{{ item.title }}</span>
              {% if item.category %}
                <span class="text-overline text-accent-alpine">{{ item.category }}</span>
              {% endif %}
            </div>
            {% if item.snippet %}
              <p class="search-result-snippet">{{ item.snippet }}</p>
            {% endif %}
          </a>
        {% endfor %}
      {% else %}
        <div class="search-empty-prompt" id="search-empty-prompt">
          <svg class="search-empty-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
          <span>Type a query to search neighborhoods, schools, or market metrics</span>
        </div>
      {% endif %}
    </div>

    {# Footer #}
    <footer class="search-modal-footer">
      <span>Press <kbd class="search-kbd-tag">ESC</kbd> to close</span>
      <span>MySeattleSearch</span>
    </footer>

  </div>

  {# Scoped Pagefind Modal Controller #}
  <script>
    (function() {
      const dialog = document.getElementById('dialog-search-modal');
      const input = document.getElementById('site-search-input');
      const clearBtn = document.getElementById('btn-search-clear');
      const counter = document.getElementById('search-counter');
      const resultsBox = document.getElementById('search-results-container');
      if (!dialog || !input || !resultsBox) return;

      const defaultEmptyMarkup = resultsBox.innerHTML;
      let pagefindEngine = null;
      let pagefindLoadPromise = null;
      let debounceTimer = null;
      let searchSeq = 0;

      function escapeHtml(str) {
        return String(str || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function inferCategory(url) {
        const path = String(url || '').toLowerCase();
        if (path.startsWith('/region/schools')) return 'Schools';
        if (path.startsWith('/region/sports')) return 'Sports';
        if (path.startsWith('/region/transit')) return 'Regional Transit';
        if (path.startsWith('/neighborhood/')) {
          if (path.includes('/weather')) return 'Weather';
          if (path.includes('/transit-commute')) return 'Transit & Commute';
          if (path.includes('/emergency-safety')) return 'Emergency & Safety';
          if (path.includes('/municipal')) return 'Municipal';
          if (path.includes('/real-estate')) return 'Real Estate';
          if (path.includes('/news-events')) return 'News & Events';
          return 'Neighborhood';
        }
        if (path.startsWith('/realestate/')) return 'Real Estate';
        if (path.startsWith('/cms/')) return 'Notebook';
        if (path.startsWith('/travel/')) return 'Travel';
        if (path.startsWith('/apps/')) return 'Tools & Apps';
        return 'Directory';
      }

      async function getPagefind() {
        if (pagefindEngine) return pagefindEngine;
        if (!pagefindLoadPromise) {
          pagefindLoadPromise = import('/pagefind/pagefind.js')
            .then(async (mod) => {
              if (typeof mod.init === 'function') {
                await mod.init();
              }
              pagefindEngine = mod;
              return mod;
            })
            .catch((err) => {
              pagefindLoadPromise = null;
              throw err;
            });
        }
        return pagefindLoadPromise;
      }

      function renderPrompt(message) {
        resultsBox.innerHTML = `<div class="search-empty-prompt"><span>${escapeHtml(message)}</span></div>`;
      }

      async function runPagefindQuery(rawQuery) {
        const query = rawQuery.trim();
        const currentSeq = ++searchSeq;

        if (!query) {
          resultsBox.innerHTML = defaultEmptyMarkup;
          if (counter) counter.textContent = '';
          return;
        }

        if (counter) counter.textContent = 'Searching...';

        try {
          const pf = await getPagefind();
          if (currentSeq !== searchSeq) return;

          const search = await pf.search(query);
          if (currentSeq !== searchSeq) return;

          const total = search.results.length;
          if (counter) {
            counter.textContent = `${total} ${total === 1 ? 'result' : 'results'}`;
          }

          if (total === 0) {
            renderPrompt(`No matches found for "${query}". Try a neighborhood, school district, or topic.`);
            return;
          }

          const topItems = await Promise.all(
            search.results.slice(0, 12).map((res) => res.data())
          );
          if (currentSeq !== searchSeq) return;

          resultsBox.innerHTML = topItems.map((item) => {
            const title = escapeHtml((item.meta && item.meta.title) || item.url);
            const category = escapeHtml((item.filters && item.filters.type && item.filters.type[0]) || inferCategory(item.url));
            const excerpt = item.excerpt || '';
            const href = escapeHtml(item.url);

            return `
              <a href="${href}" class="search-result-card">
                <div class="search-result-header">
                  <span class="search-result-title">${title}</span>
                  <span class="text-overline text-accent-alpine">${category}</span>
                </div>
                ${excerpt ? `<p class="search-result-snippet">${excerpt}</p>` : ''}
              </a>
            `;
          }).join('');
        } catch (err) {
          if (currentSeq !== searchSeq) return;
          if (counter) counter.textContent = 'Index offline';
          renderPrompt('Pagefind search index not found yet. Run "npm run build" to generate _site/pagefind.');
        }
      }

      window.openSearchModal = function(initialQuery) {
        if (!dialog.open) {
          dialog.showModal();
        }
        getPagefind().catch(() => {});
        if (typeof initialQuery === 'string' && initialQuery.trim()) {
          input.value = initialQuery.trim();
          if (clearBtn) clearBtn.style.display = 'inline-flex';
          runPagefindQuery(input.value);
        }
        requestAnimationFrame(() => input.focus());
      };

      // Close on backdrop click
      dialog.addEventListener('click', function(e) {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          dialog.close();
        }
      });

      // Clear input button handling
      if (clearBtn) {
        clearBtn.addEventListener('click', function() {
          input.value = '';
          clearBtn.style.display = 'none';
          searchSeq++;
          resultsBox.innerHTML = defaultEmptyMarkup;
          if (counter) counter.textContent = '';
          input.focus();
        });
      }

      // Suggestion chips
      dialog.querySelectorAll('[data-search-suggestion]').forEach((chip) => {
        chip.addEventListener('click', function() {
          const term = this.getAttribute('data-search-suggestion') || '';
          input.value = term;
          if (clearBtn) clearBtn.style.display = term ? 'inline-flex' : 'none';
          runPagefindQuery(term);
          input.focus();
        });
      });

      // Debounced live search input
      input.addEventListener('input', function() {
        const val = this.value;
        if (clearBtn) {
          clearBtn.style.display = val.trim().length > 0 ? 'inline-flex' : 'none';
        }
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => runPagefindQuery(val), 140);
      });

      // Global Cmd+K / Ctrl+K shortcut
      document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (dialog.open) {
            dialog.close();
          } else {
            window.openSearchModal();
          }
        }
      });
    })();
  </script>

</dialog>
