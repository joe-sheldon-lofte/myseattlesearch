{# 
  COMPONENT: Regional Flight Board Telemetry (widget.regional.airport.board)
  PURPOSE: Solari-style flight arrivals and departures across SEA and PAE.
  CONTRACT:
    - flight_board_items / flights / airport_flights: Array of Objects [Required]
      Each flight expects:
      - f.type: String [Required: "dep" or "arr"]
      - f.airport: String [Required: e.g. "SEA", "PAE"]
      - f.code: String [Required: e.g. "AS 1124"]
      - f.city: String [Required: e.g. "San Francisco (SFO)"]
      - f.time: String [Required: e.g. "3:45 PM"]
      - f.gate: String [Optional: e.g. "C12"]
      - f.status: String [Required: e.g. "On Time", "Boarding", "Delayed 15m"]
      - f.status_type: String [Optional: "good", "active", "warning", "alert"]
    - airport_board_title / board_title: String [Optional, defaults to "Regional Flight Board"]
    - airport_board_name / board_airport: String [Optional, defaults to "Seattle-Tacoma (SEA) & Paine Field (PAE)"]
    - airport_source_label: String [Optional, defaults to "Source: FAA and ADS-B Data"]
#}

{% set flight_list = flight_board_items or flights or airport_flights %}
{% set card_title = airport_board_title or board_title or "Regional Flight Board" %}
{% set hub_caption = airport_board_name or board_airport or "Seattle-Tacoma (SEA) & Paine Field (PAE)" %}
{% set source_text = airport_source_label or "Source: FAA and ADS-B Data" %}

{% if flight_list and flight_list.length > 0 %}
<section class="widget-card regional-airport-board-card" aria-label="{{ card_title }}">
  
  {# Header Row #}
  <header class="airport-board-header">
    <div class="airport-board-title-stack">
      <span class="text-overline text-accent-alpine">
        TRANSIT &amp; AVIATION
      </span>
      <h3 class="text-widget-title airport-board-title">
        {{ card_title }}
      </h3>
      <div class="airport-board-subtitle">
        {{ hub_caption }}
      </div>
    </div>

    {# Filter Buttons #}
    <nav class="airport-board-filter-group" role="tablist" aria-label="Filter flight board">
      <button type="button" class="btn-apt-tab is-active" data-flight-filter="all" role="tab" aria-selected="true">All</button>
      <button type="button" class="btn-apt-tab" data-flight-filter="dep" role="tab" aria-selected="false">Departures</button>
      <button type="button" class="btn-apt-tab" data-flight-filter="arr" role="tab" aria-selected="false">Arrivals</button>
    </nav>
  </header>

  {# Solari / Flight Board Table #}
  <div class="airport-board-table-wrap">
    <table class="airport-board-table">
      <thead>
        <tr>
          <th>HUB</th>
          <th>FLIGHT</th>
          <th>DESTINATION / ORIGIN</th>
          <th>TIME</th>
          <th style="text-align: center;">GATE</th>
          <th style="text-align: right;">STATUS</th>
        </tr>
      </thead>
      <tbody>
        {% for f in flight_list %}
          {% if f.code and f.city %}
            {% set hub_class = "hub-pae" if f.airport == "PAE" else "hub-sea" %}
            {% set status_class = "status-good" %}
            {% if f.status_type == "active" %}
              {% set status_class = "status-active" %}
            {% elif f.status_type == "warning" %}
              {% set status_class = "status-warning" %}
            {% elif f.status_type == "alert" %}
              {% set status_class = "status-alert" %}
            {% endif %}

            <tr class="flight-row" data-type="{{ f.type | default('dep') }}">
              <td class="cell-apt-hub {{ hub_class }}">
                {{ f.airport }}
              </td>
              <td class="cell-apt-flight">
                {{ f.code }}
              </td>
              <td class="cell-apt-destination">
                {{ f.city }}
              </td>
              <td class="cell-apt-time">
                {{ f.time }}
              </td>
              <td class="cell-apt-gate">
                {{ f.gate | default("—") }}
              </td>
              <td class="cell-apt-status">
                <span class="apt-status-pill {{ status_class }}">
                  {{ f.status }}
                </span>
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# Footer Attribution #}
  <footer class="airport-board-footer">
    <span>{{ source_text }}</span>
  </footer>

  {# Scoped Zero-Hydration Filter Controller #}
  <script>
    (function() {
      const container = document.currentScript ? document.currentScript.closest('.regional-airport-board-card') : document.querySelector('.regional-airport-board-card');
      if (!container) return;
      const tabs = container.querySelectorAll('.btn-apt-tab');
      const rows = container.querySelectorAll('.flight-row');

      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          tabs.forEach(t => {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          const filter = this.getAttribute('data-flight-filter');
          rows.forEach(r => {
            if (filter === 'all' || r.getAttribute('data-type') === filter) {
              r.classList.remove('is-hidden');
            } else {
              r.classList.add('is-hidden');
            }
          });
        });
      });
    })();
  </script>

</section>
{% endif %}