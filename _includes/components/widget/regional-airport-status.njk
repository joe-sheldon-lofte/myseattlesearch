<!-- File: _includes/components/widget/regional-airport-status.njk -->
<div class="widget-card airport-status-card" style="display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; width: 100%;">
  
  {# Header Row: Airport Code & Status Badge #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; margin-bottom: 1rem;">
    <div>
      <span class="text-overline">{{ airport_overline | default("REGIONAL AIRPORT") }}</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">
        {{ airport_name | default("Paine Field") }}
        <span style="color: var(--color-secondary-default); font-weight: 700;">({{ airport_code | default("PAE") }})</span>
      </h3>
    </div>

    {% set op_status = airport_status | default("Normal Operations") %}
    {% set badge_bg = "rgba(16, 185, 129, 0.12)" %}
    {% set badge_color = "#059669" %}
    {% if op_status == "Minor Delays" %}
      {% set badge_bg = "rgba(245, 158, 11, 0.15)" %}
      {% set badge_color = "#D97706" %}
    {% elif op_status == "Severe Delays" %}
      {% set badge_bg = "rgba(217, 35, 42, 0.15)" %}
      {% set badge_color = "var(--color-tertiary-default)" %}
    {% endif %}
    <span style="display: inline-block; padding: 0.25rem 0.65rem; background: {{ badge_bg }}; color: {{ badge_color }}; border-radius: 999px; font-size: 0.75rem; font-weight: 700; white-space: nowrap;">
      {{ op_status }}
    </span>
  </div>

  {# Travel Time Grid: Drive vs. Transit #}
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
    
    {# Drive Time Tile #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 0.85rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.65rem;">Drive Time</div>
      <div class="text-data-huge" style="font-size: 1.75rem; margin-top: 0.35rem; line-height: 1;">
        {{ airport_drive_time | default("18 min") }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.35rem;">
        Via {{ airport_drive_route | default("I-5 N / SR 526") }}
      </div>
    </div>

    {# Transit Time Tile #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 0.85rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.65rem;">Transit Time</div>
      <div class="text-data-huge" style="font-size: 1.75rem; margin-top: 0.35rem; line-height: 1; color: var(--color-primary-default);">
        {{ airport_transit_time | default("36 min") }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.35rem;">
        {{ airport_transit_route | default("Swift Green Line") }}
      </div>
    </div>

  </div>

  {# Bottom Metadata #}
  <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.75rem;" class="text-body-secondary">
    <span>FAA Status: <strong>{{ faa_delay | default("No Delays") }}</strong></span>
    <span>Security Wait: <strong>{{ security_wait | default("< 5 min") }}</strong></span>
  </div>

</div>