<!-- File: _includes/components/widget/cms-entry-single.njk -->
{# 
  COMPONENT: Long-form Editorial Article & Notebook Entry (widget.cms.entry.single)
  CONTRACT:
    - entry_title / single_entry_title / title: String [Required]
    - entry_content / single_entry_content / content: String (HTML/Markdown rendered) [Required]
    - entry_excerpt / single_entry_excerpt / excerpt: String [Optional]
    - entry_date / single_entry_date / date: String [Optional]
    - entry_time / single_entry_time / time: String [Optional]
    - entry_author / single_entry_author / author: String [Optional]
    - entry_author_role / single_entry_author_role: String [Optional]
    - entry_author_image / single_entry_author_image: String [Optional]
    - entry_back_url / single_entry_back_url: String [Optional, defaults to "/notebook/"]
#}

{% set title = single_entry_title or entry_title or title %}
{% set content = single_entry_content or entry_content or content %}
{% set excerpt = single_entry_excerpt or entry_excerpt or excerpt %}
{% set date = single_entry_date or entry_date or date %}
{% set time = single_entry_time or entry_time or time %}
{% set author = single_entry_author or entry_author or author %}
{% set author_role = single_entry_author_role or entry_author_role or "Senior Real Estate Agent • Redfin" %}
{% set author_image = single_entry_author_image or entry_author_image or "/assets/images/joe-sheldon-headshot.webp" %}
{% set back_url = single_entry_back_url or entry_back_url or "/notebook/" %}

{% if title and content %}
<article class="widget-card cms-entry-article">
  
  {# Top Navigation Bar #}
  <nav class="entry-subnav" aria-label="Entry Navigation">
    <a href="{{ back_url }}" class="link-arrow">
      <span aria-hidden="true">←</span>
      <span>Back to Notebook</span>
    </a>
  </nav>

  {# Header Area #}
  <header class="entry-header">
    {% if date %}
      <time class="text-body-secondary card-timestamp">
        {{ date }}{% if time %} at {{ time }}{% endif %}
      </time>
    {% endif %}

    <h1 class="text-section-title">
      {{ title }}
    </h1>

    {% if excerpt %}
      <p class="text-body-secondary entry-lead">
        {{ excerpt }}
      </p>
    {% endif %}
  </header>

  {# Main Body Copy #}
  <div class="text-body entry-prose-body">
    {{ content | safe }}
  </div>

  {# Footer Bar: Author Attribution & Action Triggers #}
  <footer class="card-footer-strip">
    <div class="author-lockup">
      {% if author_image %}
        <img src="{{ author_image }}" alt="{{ author }}" width="36" height="36" loading="lazy" class="avatar-circle avatar-sm">
      {% endif %}
      <div>
        {% if author %}
          <div class="text-body">{{ author }}</div>
        {% endif %}
        {% if author_role %}
          <div class="text-body-secondary author-caption">{{ author_role }}</div>
        {% endif %}
      </div>
    </div>

    <div class="action-cluster">
      <a href="/chat/?topic={{ title | urlencode }}" class="link-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <span>Reply</span>
      </a>

      <button type="button" 
              class="link-pill link-pill-primary"
              onclick="if(navigator.share){navigator.share({title:'{{ title | escape }}',url:window.location.href})}else{navigator.clipboard.writeText(window.location.href);alert('Entry link copied to clipboard!');}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
        </svg>
        <span>Share</span>
      </button>
    </div>
  </footer>

</article>
{% endif %}