<!-- File: _includes/components/widget/municipal-broadcast-player.njk -->
{% set city = broadcast_city_name | default("Edmonds") %}
{% set is_live = broadcast_is_live | default(false) %}
{% set stream_title = broadcast_title | default("City Council Regular Business Meeting") %}
{% set stream_date = broadcast_date | default("Tuesday, Oct 27, 2026 • 7:00 PM PDT") %}
{% set youtube_id = broadcast_youtube_id | default("dQw4w9WgXcQ") %}

<div class="widget-card municipal-broadcast-player-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row per edit: "CITY BROADCAST & ARCHIVES" (OPMA disclosure removed) #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        CITY BROADCAST &amp; ARCHIVES
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ city }} Civic Chamber Video Stream
      </h3>
    </div>

    {% if is_live %}
      <div style="display: flex; align-items: center; gap: 0.4rem; padding: 0.2rem 0.65rem; border-radius: 999px; background: rgba(217, 35, 42, 0.12); color: var(--color-tertiary-default); font-size: 0.7rem; font-weight: 800;">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--color-tertiary-default); animation: blink 1.5s infinite;"></span>
        <span>BROADCASTING LIVE</span>
      </div>
    {% else %}
      <span style="font-size: 0.75rem; color: #86868b; font-weight: 600;">Recorded Archive</span>
    {% endif %}
  </div>

  {# 16:9 Video Embed Player #}
  <div style="width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #000000; position: relative;">
    <iframe style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
            src="https://www.youtube.com/embed/{{ youtube_id }}" 
            title="{{ city }} City Council Stream" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen></iframe>
  </div>

  {# Stream Meta #}
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; font-size: 0.8rem;">
    <div>
      <strong style="color: var(--color-primary-default);">{{ stream_title }}</strong>
      <div class="text-body-secondary" style="font-size: 0.75rem;">{{ stream_date }}</div>
    </div>
    <a href="#" style="color: var(--color-secondary-default); font-weight: 700; text-decoration: none;">All Past Archives →</a>
  </div>

</div>