<!-- File: _includes/components/widget/neighborhood-page-header.njk -->
{# 
  COMPONENT: Neighborhood Page Header & Hero Triptych (widget.neighborhood.page.header)
  CONTRACT:
    - active_neighborhood / neighborhood.name / neighborhood_city_name / city.City / city.name: String [Required]
    - hero_img_main / city.HeroImageMain: String (Image URL) [Required]
    - hero_img_left / city.HeroImageLeft: String (Image URL) [Optional]
    - hero_img_right / city.HeroImageRight: String (Image URL) [Optional]
    - hero_welcome_label: String [Optional, defaults to "Welcome to the neighborhood"]
#}

{% set active_neighborhood = active_neighborhood or neighborhood_city_name or (neighborhood.name if neighborhood else '') or (city.City if city else '') or city.name %}
{% set img_main = hero_img_main or (neighborhood.HeroImageMain if neighborhood else '') or (city.HeroImageMain if city else '') %}
{% set img_left = hero_img_left or (neighborhood.HeroImageLeft if neighborhood else '') or (city.HeroImageLeft if city else '') %}
{% set img_right = hero_img_right or (neighborhood.HeroImageRight if neighborhood else '') or (city.HeroImageRight if city else '') %}
{% set welcome_text = hero_welcome_label or "Welcome to the neighborhood" %}

{% if active_neighborhood %}
<header class="neighborhood-hero-header" aria-label="Welcome banner for {{ active_neighborhood }}">
  
  {# Symmetrical 3-Image Triptych Wall #}
  <div class="hero-image-wall" aria-hidden="true">
    
    {# Left Flank Image #}
    <div class="hero-image-flank">
      {% if img_left %}
        <img src="{{ img_left }}" alt="" loading="eager" decoding="async" class="hero-flank-img">
      {% elif img_main %}
        <img src="{{ img_main }}" alt="" loading="eager" decoding="async" class="hero-flank-img">
      {% endif %}
    </div>
    
    {# Center Image (Locked 50% Horizontal Center) #}
    <div class="hero-image-flank">
      {% if img_main %}
        <img src="{{ img_main }}" alt="" loading="eager" decoding="async" class="hero-flank-img">
      {% endif %}
    </div>
    
    {# Right Flank Image #}
    <div class="hero-image-flank">
      {% if img_right %}
        <img src="{{ img_right }}" alt="" loading="eager" decoding="async" class="hero-flank-img">
      {% elif img_main %}
        <img src="{{ img_main }}" alt="" loading="eager" decoding="async" class="hero-flank-img">
      {% endif %}
    </div>
  </div>

  {# Darkening Ambient Scrim Overlay #}
  <div class="hero-scrim-overlay" aria-hidden="true"></div>

  {# Foreground: Layered Liquid Glass Center Box #}
  <div class="hero-frosted-box">
    <div class="hero-script-tag">
      {{ welcome_text }}
    </div>
    <h1 class="hero-neighborhood-title">
      {{ active_neighborhood }}
    </h1>
  </div>

</header>
{% endif %}