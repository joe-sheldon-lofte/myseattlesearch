<!-- File: _includes/components/widget/drawer-action-navigate.njk -->
{% set demo_sections = [
  { id: "overview", label: "Neighborhood Overview", icon: "📍" },
  { id: "market-stats", label: "Market Statistics & Trends", icon: "📊" },
  { id: "housing-affordability", label: "Housing Affordability Matrix", icon: "🏡" },
  { id: "transit-commute", label: "Transit & Commute Times", icon: "🚆" },
  { id: "weather-environment", label: "Weather, Tides & Atmosphere", icon: "☀️" },
  { id: "schools", label: "Schools & PSAI Rankings", icon: "🎓" },
  { id: "civic-governance", label: "Municipal Agendas & Governance", icon: "🏛️" },
  { id: "emergency-safety", label: "Live Emergency & 911 Dispatch", icon: "🚨" },
  { id: "agent-strategy", label: "About Joe Sheldon & Consultation", icon: "🤝" }
] %}

{% set nav_sections = page_nav_sections | default(demo_sections) %}

<div id="drawer-action-navigate" 
     class="action-drawer-bottom navigate-drawer" 
     role="dialog" 
     aria-modal="true" 
     aria-label="Page Section Navigation"
     style="position: fixed; inset: 0; z-index: 2000; display: none; align-items: flex-end; justify-content: center; pointer-events: none;">
  
  {# Backdrop Scrim #}
  <div class="drawer-scrim" 
       onclick="closeNavigateDrawer()" 
       style="position: absolute; inset: 0; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); pointer-events: auto; opacity: 0; transition: opacity 0.3s ease;"></div>

  {# Slide-Up Panel / Popover in Liquid Frosted Glass #}
  <div class="drawer-panel" 
       style="position: relative; z-index: 10; width: 100%; max-width: 520px; max-height: 80vh; background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255, 255, 255, 0.7); border-radius: var(--border-radius-squircle) var(--border-radius-squircle) 0 0; box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.15); padding: 1.5rem 1.75rem 2.25rem 1.75rem; display: flex; flex-direction: column; gap: 1rem; transform: translateY(100%); transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); pointer-events: auto; box-sizing: border-box;">
    
    {# Drag Pill #}
    <div style="width: 36px; height: 4px; border-radius: 2px; background: #D1D5DB; margin: -0.5rem auto 0 auto;"></div>

    {# Header & Close #}
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: var(--color-secondary-default); font-size: 1rem;" aria-hidden="true">🧭</span>
        <div>
          <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
            QUICK JUMP NAVIGATION
          </span>
          <h3 class="text-widget-title" style="margin: 0; font-size: 1.15rem;">
            On This Page
          </h3>
        </div>
      </div>

      <button type="button" 
              class="btn-drawer-close" 
              aria-label="Close navigation drawer" 
              onclick="closeNavigateDrawer()"
              style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--color-primary-default); transition: background 0.15s ease;">
        ✕
      </button>
    </div>

    {# Itemized List of Page Sections #}
    <div class="navigate-section-list" style="display: flex; flex-direction: column; gap: 0.5rem; overflow-y: auto; padding-right: 0.25rem;">
      {% for sec in nav_sections %}
        <a href="#{{ sec.id }}" 
           onclick="handleSectionJump(event, '{{ sec.id }}')"
           style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 10px; text-decoration: none; font-size: 0.85rem; font-weight: 700; color: var(--color-primary-default); transition: background 0.15s ease, border-color 0.15s ease;">
          <div style="display: flex; align-items: center; gap: 0.65rem;">
            <span style="font-size: 0.95rem;">{{ sec.icon }}</span>
            <span>{{ sec.label }}</span>
          </div>
          <span style="font-size: 0.8rem; color: var(--color-secondary-default);" aria-hidden="true">↓</span>
        </a>
      {% endfor %}
    </div>

    {# Top Jump Button #}
    <div style="text-align: center; padding-top: 0.25rem;">
      <a href="#top" 
         onclick="handleSectionJump(event, 'top')"
         style="color: var(--color-secondary-default); font-size: 0.75rem; font-weight: 700; text-decoration: none;">
        ↑ Return to Top of Page
      </a>
    </div>

  </div>

  <script>
    function openNavigateDrawer() {
      const d = document.getElementById('drawer-action-navigate');
      if (!d) return;
      d.style.display = 'flex';
      setTimeout(() => {
        d.querySelector('.drawer-scrim').style.opacity = '1';
        d.querySelector('.drawer-panel').style.transform = 'translateY(0)';
      }, 10);
    }
    function closeNavigateDrawer() {
      const d = document.getElementById('drawer-action-navigate');
      if (!d) return;
      d.querySelector('.drawer-scrim').style.opacity = '0';
      d.querySelector('.drawer-panel').style.transform = 'translateY(100%)';
      setTimeout(() => {
        d.style.display = 'none';
      }, 350);
    }
    function handleSectionJump(e, id) {
      e.preventDefault();
      closeNavigateDrawer();
      if (id === 'top') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      } else {
        window.location.hash = id;
      }
    }
  </script>

</div>