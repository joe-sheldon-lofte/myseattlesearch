<div id="drawer-action-navigate" 
     class="action-drawer-bottom navigate-drawer" 
     role="dialog" 
     aria-modal="true" 
     aria-label="Page Navigation">
  
  {# Backdrop Scrim #}
  <div class="drawer-scrim" onclick="closeNavigateDrawer()"></div>

  {# Slide-Up Panel #}
  <div class="drawer-panel">
    <div class="drawer-grab-handle" aria-hidden="true"></div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
      <h3 class="text-widget-title" style="margin: 0; font-size: 1.15rem;">On This Page</h3>
      <button type="button" 
              class="btn-drawer-close" 
              aria-label="Close navigation drawer" 
              onclick="closeNavigateDrawer()">✕</button>
    </div>

    <nav class="navigate-section-list" id="navigateSectionList">
      <a href="#main-content" onclick="handleSectionJump(event, 'main-content')" class="navigate-list-item">
        <span>Return to Top</span>
        <span aria-hidden="true">&uarr;</span>
      </a>
      {# Sections Populated Dynamically via JS #}
    </nav>
  </div>

  <script>
    function openNavigateDrawer() {
      const drawer = document.getElementById('drawer-action-navigate');
      if (!drawer) return;
      
      const list = document.getElementById('navigateSectionList');
      const sections = document.querySelectorAll('section[id]');
      
      if (list && sections.length > 0 && list.children.length === 1) {
        sections.forEach(sec => {
          const heading = sec.querySelector('h1, h2, h3');
          const title = heading ? heading.textContent.trim() : sec.id;
          const link = document.createElement('a');
          link.href = '#' + sec.id;
          link.className = 'navigate-list-item';
          link.innerHTML = `<span>${title}</span><span aria-hidden="true">&rarr;</span>`;
          link.onclick = (e) => handleSectionJump(e, sec.id);
          list.appendChild(link);
        });
      }

      drawer.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeNavigateDrawer() {
      const drawer = document.getElementById('drawer-action-navigate');
      if (drawer) {
        drawer.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    }

    function handleSectionJump(e, id) {
      e.preventDefault();
      closeNavigateDrawer();
      if (id === 'main-content' || id === 'top') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      const el = document.getElementById(id);
      if (el) {
        setTimeout(() => el.scrollIntoView({ behavior: 'smooth' }), 120);
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeNavigateDrawer();
    });
  </script>
</div>