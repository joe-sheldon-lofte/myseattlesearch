{# 
  COMPONENT: Comprehensive Climate Profile & Environmental Matrix (widget.weather.climate.comfort.index.full)
  PURPOSE: Full environmental breakdown of summer highs, winter lows, rainfall, and sunny days.
  CONTRACT:
    - climate_comfort_score / full_score: Number [Optional, 0-100]
    - climate_station_id / station_id: String [Optional, e.g. "KPAE (Paine Field Coastal Station)"]
    - climate_full_summary / summary_narrative: String [Optional]
    - climate_summer_high / summer_high: String [Optional, e.g. "73°F"]
    - climate_winter_low / winter_low: String [Optional, e.g. "36°F"]
    - climate_rainfall / annual_rain: String [Optional, e.g. "38.2 in"]
    - climate_sunny_days / sunny_days: String or Number [Optional, e.g. "158"]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set active_neighborhood = active_neighborhood or (neighborhood.name if neighborhood else '') or (city.City if city else '') %}
{% set score_val = climate_comfort_score if climate_comfort_score is defined else full_score %}
{% set station_label = climate_station_id or station_id %}
{% set narrative = climate_full_summary or summary_narrative %}
{% set summer_val = climate_summer_high or summer_high %}
{% set winter_val = climate_winter_low or winter_low %}
{% set rain_val = climate_rainfall or annual_rain %}
{% set sun_val = climate_sunny_days if climate_sunny_days is defined else sunny_days %}

{% if score_val or summer_val or winter_val or rain_val or sun_val %}
<section class="widget-card climate-comfort-full-card" aria-label="Climate Profile for {{ active_neighborhood | default('This Neighborhood') }}">
  
  {# Header Row #}
  <header class="climate-full-header-row">
    <div class="climate-title-stack">
      <span class="text-overline text-accent-alpine">
        ENVIRONMENTAL INTELLIGENCE
      </span>
      <h3 class="text-widget-title climate-card-title">
        Climate Profile &amp; Comfort Index
      </h3>
      {% if station_label %}
        <div class="climate-station-caption">
          Station: {{ station_label }}
        </div>
      {% endif %}
    </div>
    
    {% if score_val %}
      <div class="climate-score-pill-badge" aria-label="Climate Comfort Score: {{ score_val }} out of 100">
        <span class="text-overline climate-score-pill-label">Score</span>
        <span class="climate-score-pill-val">{{ score_val }}<span class="climate-score-pill-max">/100</span></span>
      </div>
    {% endif %}
  </header>

  {# Dynamic 1-Sentence Narrative #}
  {% if narrative %}
    <p class="climate-full-narrative">
      {{ narrative }}
    </p>
  {% endif %}

  {# 4-Metric Environmental Grid #}
  <div class="climate-metrics-grid">
    
    {# Metric 1: Summer High #}
    {% if summer_val %}
      <div class="climate-metric-well">
        <span class="text-overline climate-metric-overline">Summer High</span>
        <div class="climate-metric-value">
          {{ summer_val }}
        </div>
        <div class="climate-metric-subtext">Avg Jul / Aug</div>
      </div>
    {% endif %}

    {# Metric 2: Winter Low #}
    {% if winter_val %}
      <div class="climate-metric-well">
        <span class="text-overline climate-metric-overline">Winter Low</span>
        <div class="climate-metric-value val-winter">
          {{ winter_val }}
        </div>
        <div class="climate-metric-subtext">Avg Dec / Jan</div>
      </div>
    {% endif %}

    {# Metric 3: Annual Rainfall #}
    {% if rain_val %}
      <div class="climate-metric-well">
        <span class="text-overline climate-metric-overline">Annual Rain</span>
        <div class="climate-metric-value">
          {{ rain_val }}
        </div>
        <div class="climate-metric-subtext">Precip Total</div>
      </div>
    {% endif %}

    {# Metric 4: Sunny Days #}
    {% if sun_val %}
      <div class="climate-metric-well">
        <span class="text-overline climate-metric-overline">Sunny / Fair</span>
        <div class="climate-metric-value val-sun">
          {{ sun_val }}
        </div>
        <div class="climate-metric-subtext">Clear Sun Days</div>
      </div>
    {% endif %}

  </div>

</section>
{% endif %}