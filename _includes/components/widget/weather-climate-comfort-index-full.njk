<!-- File: _includes/components/widget/weather-climate-comfort-index-full.njk -->
<div class="widget-card climate-comfort-full-card" style="padding: 1.75rem; width: 100%;">
  
  {# Header #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">Climate Profile & Comfort Index</h3>
      <div class="text-body-secondary" style="font-size: 0.8rem; margin-top: 0.2rem;">
        Station: {{ climate_station_id | default("KPAE (Paine Field Coastal Station)") }}
      </div>
    </div>
    
    {% set full_score = climate_comfort_score | default(78) %}
    <div style="display: flex; align-items: center; gap: 0.75rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 999px; padding: 0.35rem 0.85rem;">
      <span class="text-overline" style="font-size: 0.65rem; color: #86868b;">Climate Comfort Score</span>
      <span class="text-data-huge" style="font-size: 1.35rem; color: var(--color-secondary-default);">{{ full_score }}<span style="font-size: 0.8rem; color: #86868b;">/100</span></span>
    </div>
  </div>

  {# Dynamic 1-Sentence Summary #}
  <p class="text-body" style="line-height: 1.55; margin-bottom: 1.5rem; font-size: 0.95rem;">
    {{ climate_full_summary | default("Edmonds and the South Snohomish coastal basin benefit from Puget Sound thermal regulation, generating cooler summer afternoons and preventing severe winter deep freezes.") }}
  </p>

  {# 4-Metric Environmental Grid #}
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem;">
    
    {# Metric 1: Summer High #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.65rem; color: #86868b;">Summer High</div>
      <div class="text-data-huge" style="font-size: 1.5rem; margin-top: 0.25rem; color: var(--color-primary-default);">
        {{ climate_summer_high | default("73°F") }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.7rem; margin-top: 0.2rem;">Avg Jul / Aug</div>
    </div>

    {# Metric 2: Winter Low #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.65rem; color: #86868b;">Winter Low</div>
      <div class="text-data-huge" style="font-size: 1.5rem; margin-top: 0.25rem; color: var(--color-secondary-default);">
        {{ climate_winter_low | default("36°F") }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.7rem; margin-top: 0.2rem;">Avg Dec / Jan</div>
    </div>

    {# Metric 3: Annual Rainfall #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.65rem; color: #86868b;">Annual Rain</div>
      <div class="text-data-huge" style="font-size: 1.5rem; margin-top: 0.25rem; color: var(--color-primary-default);">
        {{ climate_rainfall | default("38.2 in") }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.7rem; margin-top: 0.2rem;">152 Precip Days</div>
    </div>

    {# Metric 4: Sunny Days #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.65rem; color: #86868b;">Sunny / Fair</div>
      <div class="text-data-huge" style="font-size: 1.5rem; margin-top: 0.25rem; color: #F59E0B;">
        {{ climate_sunny_days | default("158") }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.7rem; margin-top: 0.2rem;">Clear Sun Days</div>
    </div>

  </div>

</div>