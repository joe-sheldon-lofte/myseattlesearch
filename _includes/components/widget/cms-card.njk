<!-- File: _includes/components/widget/cms-card.njk -->
{# 
  COMPONENT: Editorial & CMS Article Card (widget.cms.card)
  CONTRACT:
    - card_title / article_title / post_title / title / post.title: String [Required]
    - card_url / article_url / post_url / url / post.url: String [Required]
    - card_excerpt / article_excerpt / post_excerpt / excerpt / post.excerpt: String [Optional]
    - content: String (Raw HTML/markdown body if excerpt absent) [Optional]
    - card_date / article_date / post_date / date / post.date: String [Optional]
    - card_author / article_author / post_author / author / post.author: String [Optional]
#}

{% set card_title = article_title or post_title or title or (post.title if post else '') %}
{% set card_excerpt = article_excerpt or post_excerpt or excerpt or (post.excerpt if post else '') %}
{% set card_date = article_date or post_date or date or (post.date if post else '') %}
{% set card_author = article_author or post_author or author or (post.author if post else '') %}
{% set card_url = article_url or post_url or url or (post.url if post else '') %}

{% if card_title %}
<article class="widget-card widget-card-interactive cms-card-item">
  
  <div class="card-main-content">
    {# Header Row: Title & Timestamp #}
    <div class="card-header-split">
      <h3 class="text-widget-title">
        {% if card_url %}
          <a href="{{ card_url }}" class="title-link">
            {{ card_title }}
          </a>
        {% else %}
          {{ card_title }}
        {% endif %}
      </h3>

      {% if card_date %}
        <time class="text-body-secondary card-timestamp">
          {{ card_date }}
        </time>
      {% endif %}
    </div>

    {# Excerpt / Rich Text Body #}
    {% if card_excerpt %}
      <p class="text-body cms-card-excerpt">
        {{ card_excerpt }}
      </p>
    {% elif content %}
      <div class="text-body cms-card-excerpt">
        {{ content | safe }}
      </div>
    {% endif %}
  </div>

  {# Footer Bar: Author Attribution & Action Triggers #}
  <div class="card-footer-strip text-body-secondary">
    {% if card_author %}
      <div class="cms-card-byline">
        <span>By </span>
        <a href="/#agent" class="link-subtle">
          {{ card_author }}
        </a>
        <span> • Redfin Senior Agent</span>
      </div>
    {% else %}
      <div></div>
    {% endif %}

    <div class="card-actions-group">
      <a href="/chat/?topic={{ card_title | urlencode }}" class="link-action-reply">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <span>Reply</span>
      </a>

      {% if card_url %}
        <a href="{{ card_url }}" class="link-arrow">
          <span>Read</span>
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>

</article>
{% endif %}