<!-- File: _includes/components/widget/neighborhood-map-widget.njk -->
{% set map_lat = map_lat | default(47.8107) %}
{% set map_lon = map_lon | default(-122.3774) %}
{% set map_title = map_title | default("Edmonds Geography & Infrastructure") %}
{% set map_zoom = map_zoom | default(13) %}

<div class="widget-card neighborhood-map-card" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1rem; box-sizing: border-box;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        LOCAL OVERVIEW
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ map_title }}
      </h3>
    </div>
  </div>

  {# Map Component Container #}
  <div style="width: 100%; border-radius: 8px; overflow: hidden; background: var(--color-surface-gray); border: 1px solid var(--color-border-light);">
    <neighborhood-map 
      lat="{{ map_lat }}" 
      lon="{{ map_lon }}" 
      zoom="{{ map_zoom }}">
    </neighborhood-map>
  </div>

  {# Link to the client script (Adjust path if your JS lives in /assets/js/ instead of /scripts/) #}
  <script src="/scripts/neighborhood-map.js" type="module" defer></script>
  
</div>