<!-- File: _includes/components/widget/realestate-housing-affordability-dashboard.njk -->
<div class="widget-card affordability-dashboard" style="padding: 2rem;">
  
  <div style="margin-bottom: 2rem;">
    <div class="text-overline">REGIONAL ECONOMICS</div>
    <h3 class="text-widget-title" style="font-size: 1.5rem;">Housing Affordability Matrix</h3>
    <p class="text-body-secondary">Benchmarking local median household income against purchasing power requirements.</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
    
    {# Sub-Panel 1: Property Tier Ladder #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1.5rem;">
      <h4 class="text-widget-title" style="font-size: 1rem; margin-bottom: 1rem;">Entry Requirements (5% Down)</h4>
      
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        {# Condo Tier #}
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.25rem;">
            <span>Condo / Co-op</span>
            <span>$450,000</span>
          </div>
          <div style="width: 100%; height: 8px; background: rgba(30,77,107,0.1); border-radius: 4px; overflow: hidden; margin-bottom: 0.25rem;">
            <div style="width: 45%; height: 100%; background: var(--color-secondary-default);"></div>
          </div>
          <div class="text-body-secondary" style="font-size: 0.75rem; text-align: right;">Req. Income: $92k</div>
        </div>

        {# Starter Home Tier #}
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.25rem;">
            <span>Starter Home</span>
            <span>$750,000</span>
          </div>
          <div style="width: 100%; height: 8px; background: rgba(30,77,107,0.1); border-radius: 4px; overflow: hidden; margin-bottom: 0.25rem;">
            <div style="width: 75%; height: 100%; background: var(--color-secondary-default);"></div>
          </div>
          <div class="text-body-secondary" style="font-size: 0.75rem; text-align: right;">Req. Income: $154k</div>
        </div>
      </div>
    </div>

    {# Sub-Panel 2: Monthly Payment Composition (100% Stacked Bar) #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1.5rem;">
      <h4 class="text-widget-title" style="font-size: 1rem; margin-bottom: 1rem;">Monthly Payment Composition</h4>
      <p class="text-body-secondary" style="font-size: 0.8rem; margin-bottom: 1.25rem;">Based on $750,000 Starter Home</p>
      
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        
        {# 5% Down Row #}
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.35rem;">
            <span>5% Down ($37k)</span>
            <span>$4,850/mo</span>
          </div>
          <div style="display: flex; width: 100%; height: 16px; border-radius: 8px; overflow: hidden;">
            <div style="width: 70%; background: var(--color-secondary-default);" title="Principal & Interest"></div>
            <div style="width: 15%; background: #10B981;" title="Taxes"></div>
            <div style="width: 5%; background: #F59E0B;" title="Insurance"></div>
            <div style="width: 10%; background: var(--color-tertiary-default);" title="PMI"></div>
          </div>
        </div>

        {# 20% Down Row (No PMI) #}
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.35rem;">
            <span>20% Down ($150k)</span>
            <span>$3,920/mo</span>
          </div>
          <div style="display: flex; width: 100%; height: 16px; border-radius: 8px; overflow: hidden;">
            <div style="width: 78%; background: var(--color-secondary-default);" title="Principal & Interest"></div>
            <div style="width: 16%; background: #10B981;" title="Taxes"></div>
            <div style="width: 6%; background: #F59E0B;" title="Insurance"></div>
          </div>
        </div>

      </div>

      {# Legend #}
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem; font-size: 0.7rem; font-weight: 600;">
        <span style="color: var(--color-secondary-default);">■ P&I</span>
        <span style="color: #10B981;">■ Taxes</span>
        <span style="color: #F59E0B;">■ Ins</span>
        <span style="color: var(--color-tertiary-default);">■ PMI</span>
      </div>
    </div>

  </div>
</div>