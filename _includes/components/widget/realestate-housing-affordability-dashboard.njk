<section class="widget-card housing-affordability-dashboard-container" style="padding: 2rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-surface-gray); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.75rem; box-sizing: border-box;">
  
  {# Dashboard Master Header #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--color-border-light); padding-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default);">
        REGIONAL HOUSING ANALYTICS
      </span>
      <h3 class="text-widget-title" style="margin: 0.25rem 0 0 0; font-size: 1.5rem;">
        Housing Affordability
      </h3>
    </div>
  </div>

  {# 3 Modular Sub-Panels in Full-Width Stacked Rows #}
  <div style="display: flex; flex-direction: column; gap: 1.5rem; width: 100%;">
    {% include "components/widget/realestate-housing-affordability-propertytierentryladder.njk" ignore missing %}
    {% include "components/widget/realestate-housing-affordability-downpaymenttier.njk" ignore missing %}
    {% include "components/widget/realestate-housing-affordability-householdincomepurchasingpower.njk" ignore missing %}
  </div>

  {# Dashboard Footer #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.75rem; font-size: 0.75rem; flex-wrap: wrap; gap: 0.5rem;" class="text-body-secondary">
    <span>Sources: Redfin Data Center</span>
  </div>

</section>