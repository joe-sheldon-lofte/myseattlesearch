<!-- File: _includes/components/widget/image-viewport-box.njk -->
{# 
  COMPONENT: 1:1 Aspect Image Viewport Box (widget.image.viewport.box)
  CONTRACT:
    - viewport_images / gallery_images: Array of Objects [Required]
      Each image object expects:
      - img.url: String [Required]
      - img.alt: String [Required]
    - viewport_box_id / viewport_id: String [Optional]
#}

{% set images = viewport_images or gallery_images %}
{% set box_id = viewport_box_id or viewport_id or ("image-viewport-" ~ (range(1000, 9999) | random)) %}

{% if images and images.length > 0 %}
<div id="{{ box_id }}" class="widget-card image-viewport-box-container">
  
  {# Inner Screen Viewport #}
  <div class="viewport-screen-frame">
    
    {# Horizontal Swipe Slider #}
    <div class="viewport-slider" tabindex="0">
      {% for img in images %}
        {% if img.url %}
          <div class="viewport-slide">
            {# Ambient Edge Frost Projection #}
            <div class="viewport-ambient-backdrop" 
                 style="background-image: url('{{ img.url }}');" 
                 aria-hidden="true"></div>
            <div class="viewport-gradient-scrim" aria-hidden="true"></div>
            
            {# Centered Primary Asset #}
            <img src="{{ img.url }}" 
                 alt="{{ img.alt }}" 
                 loading="{% if loop.first %}eager{% else %}lazy{% endif %}" 
                 decoding="async"
                 class="viewport-primary-image">
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {# Desktop Hover Navigation Chevrons #}
    {% if images.length > 1 %}
      <button type="button" 
              class="viewport-nav-btn prev" 
              aria-label="Previous image"
              onclick="navigateViewport('{{ box_id }}', -1)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      
      <button type="button" 
              class="viewport-nav-btn next" 
              aria-label="Next image"
              onclick="navigateViewport('{{ box_id }}', 1)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      {# Frosted Glass Dot Pagination #}
      <div class="viewport-dots-tray">
        {% for img in images %}
          <button type="button" 
                  class="viewport-dot {% if loop.first %}is-active{% endif %}"
                  onclick="jumpToSlide('{{ box_id }}', {{ loop.index0 }})" 
                  aria-label="Go to slide {{ loop.index }}">
          </button>
        {% endfor %}
      </div>
    {% endif %}

  </div>

  <script>
    if (typeof navigateViewport === 'undefined') {
      function navigateViewport(containerId, direction) {
        const c = document.getElementById(containerId);
        if (!c) return;
        const slider = c.querySelector('.viewport-slider');
        const slideWidth = slider.clientWidth;
        slider.scrollBy({ left: direction * slideWidth, behavior: 'smooth' });
      }
      function jumpToSlide(containerId, index) {
        const c = document.getElementById(containerId);
        if (!c) return;
        const slider = c.querySelector('.viewport-slider');
        const slideWidth = slider.clientWidth;
        slider.scrollTo({ left: index * slideWidth, behavior: 'smooth' });
      }
    }
  </script>
</div>
{% endif %}