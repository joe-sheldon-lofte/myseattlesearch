<!-- File: _includes/components/widget/emergency-dispatch-board-embed.njk -->
{% set embed_agency_code = agency_code | default("17D04") %}
{% set embed_agency_name = agency_name | default("Shoreline Fire Department") %}
{% set embed_city_name = city_name | default(city.City | default("Shoreline")) %}

<div class="widget-card dispatch-embed-card" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1rem; box-sizing: border-box;">
  
  {# Header Row with Integrated Parent-Level Frame Reset #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem; gap: 1rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        LIVE DISPATCH RADAR
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ embed_city_name }} Active Fire & EMS
      </h3>
    </div>

    {# Live Reset Action: Flushes stuck detail views and resets to active incident root #}
    <button 
      type="button" 
      id="pulsepoint-reset-btn"
      onclick="(function(){ const frame = document.getElementById('pulsepoint-embed-frame'); if(frame) { const src = frame.src; frame.src = ''; setTimeout(function(){ frame.src = src; }, 50); } })()"
      style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.85rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: var(--color-secondary-default); background: var(--color-surface-gray); border: 1px solid var(--color-border-light); cursor: pointer; transition: all 0.15s ease-in-out; line-height: 1;"
      title="Reset incident drilldown to live board">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
        <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
      </svg>
      <span>Reset Feed</span>
    </button>
  </div>

  {# Dual-Breakpoint Masked Viewport Container (Clips header without squishing) #}
  <div class="pulsepoint-viewport-mask">
    <iframe 
      id="pulsepoint-embed-frame"
      src="https://web.pulsepoint.org/?agencies={{ embed_agency_code }}&embed=true" 
      loading="lazy"
      title="{{ embed_city_name }} Emergency Dispatch Console">
    </iframe>
  </div>

  {# Scoped Mask Styling #}
  <style>
    .pulsepoint-viewport-mask {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 10;
      min-height: 420px;
      border-radius: 8px;
      overflow: hidden;
      background: var(--color-surface-gray);
      border: 1px solid var(--color-border-light);
      --pulse-header-crop: 56px;
    }
    @media (max-width: 767px) {
      .pulsepoint-viewport-mask {
        --pulse-header-crop: 102px;
        min-height: 480px;
      }
    }
    .pulsepoint-viewport-mask iframe {
      position: absolute;
      top: calc(-1 * var(--pulse-header-crop));
      left: 0;
      width: 100%;
      height: calc(100% + var(--pulse-header-crop));
      border: none;
    }
    #pulsepoint-reset-btn:hover {
      background: var(--color-border-light);
      color: var(--color-primary-default);
    }
  </style>

</div>