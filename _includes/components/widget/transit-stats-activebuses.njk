<!-- File: _includes/components/widget/transit-stats-activebuses.njk -->
<div class="widget-card transit-stat-card transit-active-buses-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; min-height: 180px; padding: 1.5rem; width: 100%;">
  
  {# Agency Vector: Sound Transit Express Bus (graphic.map.bus.soundtransit) #}
  <div style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem;" aria-hidden="true">
    <svg width="38" height="38" viewBox="0 0 24 24" fill="none">
      <!-- Upper Body & Windshield: Sound Transit Navy #002E6D -->
      <path d="M4 11V6a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v5H4z" fill="#002E6D"/>
      <rect x="6" y="5" width="12" height="4" rx="1" fill="#FFFFFF" opacity="0.9"/>
      <!-- Lower Chassis & Bumper: Sound Transit Teal #0091B3 -->
      <path d="M4 11v6a2 2 0 0 0 2 2h1v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2h4v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2h1a2 2 0 0 0 2-2v-6H4z" fill="#0091B3"/>
      <!-- Headlights -->
      <circle cx="7" cy="14" r="1.25" fill="#FFFFFF"/>
      <circle cx="17" cy="14" r="1.25" fill="#FFFFFF"/>
      <rect x="10" y="14" width="4" height="1.5" rx="0.5" fill="#FFFFFF" opacity="0.6"/>
    </svg>
  </div>

  {# Prominent Numerical Metric #}
  <div class="text-data-huge" style="line-height: 0.95; margin-bottom: 0.35rem;">
    {{ active_buses_count | default("38") }}
  </div>

  {# Descriptive Label String #}
  <div class="text-overline" style="color: var(--color-primary-default); font-size: 0.75rem; letter-spacing: 0.06em;">
    {{ active_buses_label | default("Active In-Service Buses") }}
  </div>

  <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.35rem;">
    {{ active_buses_agency | default("Sound Transit & Community Transit") }}
  </div>

</div>