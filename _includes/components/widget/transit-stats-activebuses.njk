{# 
  COMPONENT: Live Transit Active Bus Fleet Metric (widget.transit.stats.activebuses)
  PURPOSE: Real-time telemetry counter for active municipal and neighborhood bus coaches.
  CONTRACT:
    - transit_buses_count / active_buses_count / buses_count: Number or String [Required]
    - transit_stat_label / buses_label: String [Optional, defaults to "CURRENTLY ACTIVE LOCAL BUSES"]
    - transit_stat_overline / buses_overline: String [Optional, defaults to "LIVE BUS FLEET"]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set bus_count = transit_buses_count if transit_buses_count is defined else (active_buses_count if active_buses_count is defined else buses_count) %}
{% set stat_label = transit_stat_label or buses_label or "CURRENTLY ACTIVE LOCAL BUSES" %}
{% set stat_overline = transit_stat_overline or buses_overline or "LIVE BUS FLEET" %}

{% if bus_count is not none and bus_count != '' %}
<div class="widget-card transit-stat-item-card" role="region" aria-label="{{ stat_overline }}: {{ bus_count }} {{ stat_label }}">
  
  {# Graphic Icon Well #}
  <div class="transit-stat-icon-frame" aria-hidden="true">
    {% include "components/graphic/map-bus-soundtransit.njk" ignore missing %}
  </div>

  {# Quantitative Telemetry Stack #}
  <div class="transit-stat-content">
    <span class="text-overline transit-stat-overline">
      {{ stat_overline }}
    </span>
    <div class="transit-stat-number">
      {{ bus_count }}
    </div>
    <div class="transit-stat-descriptor">
      {{ stat_label }}
    </div>
  </div>

</div>
{% endif %}