<!-- File: _includes/components/widget/municipal-calendar-civic.njk -->
{# 
  COMPONENT: Civic & Municipal Calendar (widget.municipal.calendar.civic)
  CONTRACT:
    - civic_calendar_neighborhood_name / neighborhood.name / civic_calendar_city / city.City / city: String [Required]
    - civic_calendar_items / civic_meetings: Array of Objects [Required]
      Each meeting object expects:
      - m.title: String [Required, e.g. "City Council Regular Meeting"]
      - m.date: String [Required, e.g. "OCT 27"]
      - m.time: String [Optional, e.g. "7:00 PM"]
      - m.place: String [Optional, e.g. "Council Chambers / Zoom"]
      - m.type: String [Optional, e.g. "Council", "Planning"]
    - civic_calendar_badge_label: String [Optional, defaults to "Official Meetings"]
    - civic_calendar_footer_text: String [Optional, defaults to "Provided directly by public city calendar feed."]
#}

{% set active_neighborhood = civic_calendar_neighborhood_name or (neighborhood.name if neighborhood else '') or civic_calendar_city or (city.City if city else '') or city %}
{% set meetings_list = civic_calendar_items or civic_meetings %}
{% set badge_label = civic_calendar_badge_label or "Official Meetings" %}
{% set footer_text = civic_calendar_footer_text or "Provided directly by public city calendar feed." %}

{% if active_neighborhood and meetings_list and meetings_list.length > 0 %}
<div class="widget-card municipal-calendar-card">
  
  {# Header Row: Civic Overline, Neighborhood Title & Status Label #}
  <div class="card-header-split calendar-header-strip">
    <div>
      <span class="text-overline text-accent-alpine">
        CITY GOVERNMENT
      </span>
      <h3 class="text-widget-title calendar-headline">
        {{ active_neighborhood }} City Calendar
      </h3>
    </div>
    <span class="text-body-secondary calendar-header-badge">
      {{ badge_label }}
    </span>
  </div>

  {# Calendar Entries Stack #}
  <div class="calendar-events-stack">
    {% for m in meetings_list %}
      {% if m.title and m.date %}
        <div class="calendar-event-row">
          
          {# Left: Monospace Date Column #}
          <div class="calendar-date-stamp">
            <time class="calendar-date-text">
              {{ m.date }}
            </time>
          </div>

          {# Right: Title & Location/Time Details #}
          <div class="calendar-event-details">
            <div class="calendar-event-title">
              {{ m.title }}
            </div>
            {% if m.time or m.place %}
              <div class="text-body-secondary calendar-event-meta">
                {% if m.time %}{{ m.time }}{% endif %}
                {% if m.time and m.place %} • {% endif %}
                {% if m.place %}{{ m.place }}{% endif %}
              </div>
            {% endif %}
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Footer: Verification Attribution #}
  {% if footer_text %}
    <div class="card-footer-strip text-body-secondary">
      <span>{{ footer_text }}</span>
    </div>
  {% endif %}

</div>
{% endif %}