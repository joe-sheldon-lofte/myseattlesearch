<!-- File: _includes/components/widget/municipal-calendar-civic.njk -->
{% set city = civic_calendar_city | default("Edmonds") %}
{% set civic_meetings = civic_calendar_items | default([
  { title: "City Council Regular Meeting", date: "OCT 27", time: "7:00 PM", place: "Council Chambers / Zoom", type: "Council" },
  { title: "Planning Board Work Session", date: "OCT 28", time: "6:00 PM", place: "Public Safety Complex", type: "Planning" },
  { title: "Parks & Recreation Commission", date: "NOV 02", time: "5:30 PM", place: "Waterfront Center", type: "Parks" },
  { title: "Architectural Design Board", date: "NOV 04", time: "6:00 PM", place: "Council Chambers", type: "Design" }
]) %}

<div class="widget-card municipal-calendar-civic-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row per edit: "City Calendar" #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        CITY GOVERNMENT
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ city }} City Calendar
      </h3>
    </div>
    <span class="text-body-secondary" style="font-size: 0.75rem;">Official Meetings</span>
  </div>

  {# Calendar Entries #}
  <div style="display: flex; flex-direction: column; gap: 0.65rem;">
    {% for m in civic_meetings %}
      <div style="display: flex; align-items: center; gap: 1rem; padding: 0.65rem 0.85rem; background: var(--color-surface-gray); border-radius: 10px;">
        <div style="width: 44px; text-align: center; border-right: 1px solid var(--color-border-light); padding-right: 0.75rem; flex-shrink: 0;">
          <div style="font-size: 0.85rem; font-weight: 800; font-family: monospace; color: var(--color-secondary-default); line-height: 1;">
            {{ m.date }}
          </div>
        </div>

        <div style="flex-grow: 1; min-width: 0;">
          <div style="font-size: 0.85rem; font-weight: 700; color: var(--color-primary-default); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            {{ m.title }}
          </div>
          <div class="text-body-secondary" style="font-size: 0.7rem;">
            {{ m.time }} • {{ m.place }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Footer per edit #}
  <div style="border-top: 1px solid var(--color-border-light); padding-top: 0.65rem; font-size: 0.75rem;" class="text-body-secondary">
    Provided directly by public city calendar feed.
  </div>

</div>