<!-- File: _includes/components/widgets/widget-prose.njk -->
<article class="widget-card widget-prose-card">
  {% if prose_overline %}
    <div class="text-overline" style="margin-bottom: 0.5rem;">{{ prose_overline }}</div>
  {% endif %}
  {% if prose_title %}
    <h3 class="text-widget-title" style="margin-bottom: 0.5rem;">{{ prose_title }}</h3>
  {% endif %}
  {% if prose_author %}
    <div class="text-body-secondary" style="font-size: 0.8rem; margin-bottom: 1.25rem;">{{ prose_author }}</div>
  {% endif %}
  <div class="text-body" style="line-height: 1.65;">
    {{ prose_content | safe }}
  </div>
</article>