<!-- File: _includes/components/widgets/widget-prose.njk -->
{# 
  COMPONENT: Universal Prose & Editorial Card (widget.card.prose)
  CONTRACT:
    - prose_content / prose.content: String (HTML/Markdown rendered) [Required]
    - prose_title / prose.title: String [Optional]
    - prose_overline / prose.overline: String [Optional]
    - prose_author / prose.author: String [Optional]
#}

{% set content = prose_content or prose.content %}
{% set title = prose_title or prose.title %}
{% set overline = prose_overline or prose.overline %}
{% set author = prose_author or prose.author %}

{% if content or title %}
<article class="widget-card widget-prose-card">
  {% if overline %}
    <span class="text-overline prose-overline">{{ overline }}</span>
  {% endif %}

  {% if title %}
    <h3 class="text-widget-title">{{ title }}</h3>
  {% endif %}

  {% if author %}
    <div class="text-body-secondary prose-byline">{{ author }}</div>
  {% endif %}

  <div class="text-body prose-content">
    {{ content | safe }}
  </div>
</article>
{% endif %}