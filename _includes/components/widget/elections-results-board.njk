<!-- File: _includes/components/widget/elections-results-board.njk -->
{% set demo_results = [
  {
    race: "Snohomish County Council, District 3",
    status_text: "Final Certified Official Results",
    reporting_pct: "100% Counted",
    candidates: [
      { name: "Stephanie Wright", party: "Democrat", votes: "24,850", pct: 56.4, partisan_color: "#2563EB" },
      { name: "Greg Tisdel", party: "Republican", votes: "19,210", pct: 43.6, partisan_color: "var(--color-tertiary-default)" }
    ]
  },
  {
    race: "Edmonds City Council, Position 1 (Non-Partisan)",
    status_text: "Election Night Final Tabulation",
    reporting_pct: "100% Counted",
    candidates: [
      { name: "Alicia Crank", party: "Non-Partisan", votes: "8,940", pct: 52.8, partisan_color: "" },
      { name: "Roger Pence", party: "Non-Partisan", votes: "7,990", pct: 47.2, partisan_color: "" }
    ]
  }
] %}

{% set races = election_results | default(demo_results) %}

<section class="widget-card election-results-board-card" style="padding: 1.5rem; width: 100%;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline">VOTE TABULATION ARCHIVE & LIVE TRACKER</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">Certified Election Results</h3>
      <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.15rem;">
        Tabulated per Snohomish & King County Elections Canvassing Board certificates.
      </div>
    </div>
    
    <div style="font-size: 0.75rem; font-weight: 700; color: #059669; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); padding: 0.25rem 0.65rem; border-radius: 999px;">
      Official Tabulation
    </div>
  </div>

  {# Races Feed #}
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    {% for r in races %}
      <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
        
        {# Race Title & Reporting Status #}
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.5rem;">
          <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--color-primary-default); margin: 0;">
            {{ r.race }}
          </h4>
          <div style="font-size: 0.75rem; color: #86868b; font-family: monospace;">
            {{ r.status_text }} • <strong>{{ r.reporting_pct }}</strong>
          </div>
        </div>

        {# Candidate Rows with Progress Bars #}
        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
          {% for c in r.candidates %}
            {% set border_style = "border-left: 1px solid var(--color-border-light);" %}
            {% if c.partisan_color %}
              {% set border_style = "border-left: 4px solid " + c.partisan_color + ";" %}
            {% endif %}

            <div style="background: var(--color-surface-gray); border-radius: 8px; {{ border_style }} padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.35rem;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem;">
                <div>
                  <span style="font-size: 0.9rem; font-weight: 700; color: var(--color-primary-default);">
                    {{ c.name }}
                  </span>
                  {% if c.party %}
                    <span class="text-body-secondary" style="font-size: 0.7rem; margin-left: 0.35rem; font-style: italic;">
                      ({{ c.party }})
                    </span>
                  {% endif %}
                </div>

                <div style="font-family: monospace; font-size: 0.85rem; font-weight: 800; color: var(--color-primary-default);">
                  {{ c.votes }} votes <span style="color: var(--color-secondary-default);">({{ c.pct }}%)</span>
                </div>
              </div>

              {# Horizontal Progress Bar #}
              <div style="width: 100%; height: 7px; background: rgba(0,0,0,0.06); border-radius: 999px; overflow: hidden;">
                <div style="width: {{ c.pct }}%; height: 100%; background: var(--color-secondary-default); border-radius: 999px; transition: width 0.6s ease;"></div>
              </div>
            </div>
          {% endfor %}
        </div>

      </div>
    {% endfor %}
  </div>

  {# Footer Line #}
  <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.75rem; margin-top: 1.25rem;" class="text-body-secondary">
    <span>Canvassing source: WA Secretary of State / County Auditors</span>
    <span>RCW 29A.60 Certification Standard</span>
  </div>

</section>