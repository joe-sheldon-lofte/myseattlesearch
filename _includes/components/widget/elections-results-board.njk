<!-- File: _includes/components/widget/elections-results-board.njk -->
{% set board_title = election_results_title | default("Vote Tracker") %}
{% set board_election = election_results_name | default("2026 General Election") %}

{% set results_data = [
  { office: "Edmonds Mayor", cand1: "Mike Rosen", pct1: "54.2%", cand2: "Challenger Name", pct2: "45.8%", counted: "100% Counted", status: "Certified" },
  { office: "City Council Pos. 1", cand1: "Candidate A", pct1: "51.8%", cand2: "Candidate B", pct2: "48.2%", counted: "100% Counted", status: "Certified" },
  { office: "EMS Levy Renewal", cand1: "Approved", pct1: "68.4%", cand2: "Rejected", pct2: "31.6%", counted: "100% Counted", status: "Passed" }
] %}

<div class="widget-card elections-results-board-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row per edit: "VOTE TRACKER" (canvassing certificates boilerplate removed) #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        ELECTION RESULTS
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.25rem;">
        {{ board_title }}
      </h3>
      <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.15rem;">
        {{ board_election }}
      </div>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: #10B981; background: rgba(16, 185, 129, 0.12); padding: 0.2rem 0.65rem; border-radius: 999px;">
      State Verified Totals
    </div>
  </div>

  {# Tabulated Results Rows #}
  <div style="display: flex; flex-direction: column; gap: 0.85rem;">
    {% for r in results_data %}
      <div style="background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <h4 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: var(--color-primary-default);">{{ r.office }}</h4>
          <span style="font-size: 0.65rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 999px; background: rgba(16, 185, 129, 0.12); color: #059669;">{{ r.status }}</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.85rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 700; color: var(--color-primary-default);">{{ r.cand1 }}</span>
            <span style="font-weight: 800; font-family: monospace; color: var(--color-secondary-default);">{{ r.pct1 }}</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="text-body-secondary">{{ r.cand2 }}</span>
            <span style="font-family: monospace; color: #86868b;">{{ r.pct2 }}</span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

</div>