<!-- File: _includes/components/widget/transit-stats-activesoundertrain.njk -->
{% set transit_stat_value = transit_sounder_count | default("4") %}
{% set transit_stat_label = "ACTIVE SOUNDER TRAINS" %}
{% set transit_stat_overline = "PASSENGER COMMUTER RAIL" %}

<div class="widget-card transit-stat-item" style="padding: 1.25rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; align-items: center; gap: 1rem; box-sizing: border-box;">
  
  <div style="width: 44px; height: 44px; border-radius: 10px; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
    {% include "components/graphic/map-train-sounder.njk" ignore missing %}
  </div>

  <div style="display: flex; flex-direction: column;">
    <span class="text-overline" style="font-size: 0.6rem; color: #86868b;">
      {{ transit_stat_overline }}
    </span>
    <div class="text-data-huge" style="font-size: 1.75rem; font-weight: 800; line-height: 1.1; font-family: monospace; color: var(--color-primary-default);">
      {{ transit_stat_value }}
    </div>
    <div class="text-body-secondary" style="font-size: 0.75rem; font-weight: 700; color: var(--color-secondary-default);">
      {{ transit_stat_label }}
    </div>
  </div>

</div>