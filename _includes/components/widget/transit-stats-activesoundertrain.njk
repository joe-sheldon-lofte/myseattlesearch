<!-- File: _includes/components/widget/transit-stats-activesoundertrain.njk -->
{# 
  COMPONENT: Live Transit Active Sounder Train Fleet Metric (widget.transit.stats.activesoundertrain)
  PURPOSE: Real-time telemetry counter for active Sounder Commuter Rail trains (N Line / S Line).
  CONTRACT:
    - transit_sounder_count / active_sounder_count / sounder_count: Number or String [Required]
    - transit_stat_label / sounder_label: String [Optional, defaults to "CURRENTLY ACTIVE LOCAL SOUNDER TRAINS"]
    - transit_stat_overline / sounder_overline: String [Optional, defaults to "PASSENGER COMMUTER RAIL"]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set sounder_num = transit_sounder_count if transit_sounder_count is defined else (active_sounder_count if active_sounder_count is defined else sounder_count) %}
{% set stat_label = transit_stat_label or sounder_label or "CURRENTLY ACTIVE LOCAL SOUNDER TRAINS" %}
{% set stat_overline = transit_stat_overline or sounder_overline or "PASSENGER COMMUTER RAIL" %}

{% if sounder_num is not none and sounder_num != '' %}
<div class="widget-card transit-stat-item-card" role="region" aria-label="{{ stat_overline }}: {{ sounder_num }} {{ stat_label }}">
  
  {# Graphic Icon Well #}
  <div class="transit-stat-icon-frame" aria-hidden="true">
    {% include "components/graphic/map-train-sounder.njk" ignore missing %}
  </div>

  {# Quantitative Telemetry Stack #}
  <div class="transit-stat-content">
    <span class="text-overline transit-stat-overline">
      {{ stat_overline }}
    </span>
    <div class="transit-stat-number">
      {{ sounder_num }}
    </div>
    <div class="transit-stat-descriptor">
      {{ stat_label }}
    </div>
  </div>

</div>
{% endif %}