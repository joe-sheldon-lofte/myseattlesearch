{% set active_agency_code = pulsepoint_city_map[city_normalized] | default(pulsepoint_fd_map[fd_normalized] | default(null)) %}
{% set frame_id = "pulsepoint-frame-" ~ (city_normalized | replace(" ", "-")) %}

<div class="widget-card pulsepoint-widget-card">
  <header class="pulsepoint-card-header">
    <div class="pulsepoint-title-stack">
      <h3 class="text-widget-title pulsepoint-card-title">{{ target_city }} Public Dispatch</h3>
    </div>

    {% if active_agency_code %}
      <button type="button"
              class="btn-pulsepoint-reset"
              data-pulsepoint-reset="{{ frame_id }}">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
        </svg>
        <span>Refresh Feed</span>
      </button>
    {% else %}
      <span class="pulsepoint-unmapped-pill">Unmapped</span>
    {% endif %}
  </header>

  {% if active_agency_code %}
    <div class="pulsepoint-viewport">
      <iframe
        id="{{ frame_id }}"
        src="https://web.pulsepoint.org/?agencies={{ active_agency_code }}"
        loading="lazy"
        title="{{ target_city }} Fire and EMS Live Dispatch">
      </iframe>
    </div>
  {% else %}
    <div class="pulsepoint-offline-state">
      <h4 class="pulsepoint-offline-title">Dispatch Feed Pending</h4>
      <p class="pulsepoint-offline-desc">
        Live 911 dispatch telemetry is not currently mapped for {{ target_city }}.
      </p>
    </div>
  {% endif %}
</div>