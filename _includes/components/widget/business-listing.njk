<!-- File: _includes/components/widget/business-listing.njk -->
{# 
  COMPONENT: Local Business Place Card (widget.business.listing)
  CONTRACT:
    - business_name / business.name: String [Required]
    - business_category / business.category: String [Optional]
    - business_price_level / business.price_level: String [Optional]
    - business_rating / business.rating: Number [Optional]
    - business_reviews_count / business.review_count: Number [Optional]
    - business_address / business.location: String [Optional]
    - business_summary / business.summary: String [Optional]
    - business_image_url / business.image_url: String [Optional]
    - business_url / business.url / business_website: String [Optional]
    - business_phone / business.phone: String [Optional]
    - business_tel / business.tel: String [Optional]
#}

{% set name = business_name or business.name %}
{% set category = business_category or business.category %}
{% set price_level = business_price_level or business.price_level %}
{% set rating = business_rating or business.rating %}
{% set reviews_count = business_reviews_count or business.review_count or business_review_count %}
{% set address = business_address or business.location %}
{% set summary = business_summary or business.summary %}
{% set image_url = business_image_url or business.image_url %}
{% set url = business_url or business.url or business_website %}
{% set phone = business_phone or business.phone %}
{% set tel_link = business_tel or business.tel %}
{% set tel_clean = tel_link or (phone | replace('-', '') | replace('(', '') | replace(')', '') | replace(' ', '')) if phone else '' %}

{% if name %}
<div class="widget-card widget-card-interactive business-listing-card">
  
  <div class="card-main-content">
    {# 1. Featured Venue Photography #}
    {% if image_url %}
      <div class="media-frame media-frame-16-9">
        <img src="{{ image_url }}" alt="{{ name }}" loading="lazy" class="media-cover media-zoom">
      </div>
    {% endif %}

    {# 2. Category Overline, Price Tier & Star Rating #}
    <div class="card-header-split">
      <span class="text-overline">
        {{ category | upper }}{% if price_level %} • {{ price_level }}{% endif %}
      </span>
      
      {% if rating %}
        <div class="rating-lockup">
          <span class="rating-star" aria-hidden="true">★</span>
          <span>{{ rating }}</span>
          {% if reviews_count %}
            <span class="rating-count">({{ reviews_count }})</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {# 3. Business Name Header #}
    <h3 class="text-widget-title">
      {% if url %}
        <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="title-link">
          {{ name }}
        </a>
      {% else %}
        {{ name }}
      {% endif %}
    </h3>

    {# 4. Street Location #}
    {% if address %}
      <div class="meta-icon-row">
        <span aria-hidden="true">📍</span>
        <span>{{ address }}</span>
      </div>
    {% endif %}

    {# 5. Editorial Summary #}
    {% if summary %}
      <p class="text-body-secondary">
        {{ summary }}
      </p>
    {% endif %}
  </div>

  {# 6. Footer Actions #}
  {% if phone or url %}
    <div class="card-footer-strip">
      {% if phone %}
        <a href="tel:{{ tel_clean }}" class="link-subtle">
          <span aria-hidden="true">📞</span>
          <span>{{ phone }}</span>
        </a>
      {% else %}
        <span></span>
      {% endif %}

      {% if url %}
        <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="link-arrow">
          <span>View</span>
          <span aria-hidden="true">↗</span>
        </a>
      {% endif %}
    </div>
  {% endif %}

</div>
{% endif %}