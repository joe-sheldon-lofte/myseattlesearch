<!-- File: _includes/components/widget/business-listing.njk -->
{% set name = business_name | default("Walnut Street Coffee") %}
{% set category = business_category | default("Artisan Cafe & Bakery") %}
{% set rating = business_rating | default("4.9") %}
{% set reviews_count = business_reviews_count | default("184") %}
{% set address = business_address | default("410 Walnut St, Edmonds, WA 98020") %}
{% set website = business_website | default("https://walnutstreetcoffee.com") %}
{% set phone = business_phone | default("(425) 774-3696") %}
{% set tel_link = business_tel | default("4257743696") %}

<div class="widget-card business-listing-card" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; justify-content: space-between; min-height: 200px; box-sizing: border-box;">
  
  {# Header Row #}
  <div>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.5rem;">
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        {{ category | upper }}
      </span>
      
      <div style="display: flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; font-weight: 800; color: #D97706;">
        <span>★</span>
        <span>{{ rating }}</span>
        <span class="text-body-secondary" style="font-weight: 500; font-size: 0.75rem;">({{ reviews_count }})</span>
      </div>
    </div>

    <h3 class="text-widget-title" style="margin: 0 0 0.35rem 0; font-size: 1.2rem; color: var(--color-primary-default);">
      {{ name }}
    </h3>

    {# Actual address per edit #}
    <div class="text-body-secondary" style="font-size: 0.8rem; display: flex; align-items: center; gap: 0.35rem;">
      <span aria-hidden="true">📍</span>
      <span>{{ address }}</span>
    </div>
  </div>

  {# Footer Actions #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.75rem; margin-top: 1rem; flex-wrap: wrap; gap: 0.5rem;">
    <a href="tel:{{ tel_link }}" style="color: var(--color-primary-default); font-size: 0.75rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;">
      <span>📞 {{ phone }}</span>
    </a>

    <a href="{{ website }}" target="_blank" rel="noopener noreferrer" style="color: var(--color-secondary-default); font-size: 0.8rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;">
      <span>Visit Website</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>

</div>