<!-- File: _includes/components/widget/realestate-market-balance-gauge.njk -->
{% set months_supply = current_months_supply | default(1.8) %}
{% set safe_supply = months_supply if months_supply <= 6.0 else 6.0 %}
{# Scale: 0 to 6 months mapped to 180 degrees (-90 to +90 deg needle angle) #}
{% set needle_angle = -90 + (safe_supply / 6.0) * 180 %}

{% set market_status = "Balanced Market" %}
{% set status_color = "var(--color-secondary-default)" %}
{% if months_supply < 2.0 %}
  {% set market_status = "Extreme Seller's Market" %}
  {% set status_color = "var(--color-tertiary-default)" %}
{% elif months_supply >= 4.0 %}
  {% set market_status = "Strong Buyer's Market" %}
  {% set status_color = "var(--color-tertiary-default)" %}
{% endif %}

<div class="widget-card market-balance-gauge-card" style="display: flex; flex-direction: column; align-items: center; text-align: center; padding: 1.5rem; width: 100%;">
  
  {# Header Row #}
  <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
    <span class="text-overline">MARKET LEVERAGE</span>
    <span style="font-size: 0.75rem; font-weight: 600; color: #86868b;">Closed Supply</span>
  </div>

  <h3 class="text-widget-title" style="margin-bottom: 0.5rem;">Market Balance Gauge</h3>

  {# Semi-Circle Gauge SVG (Radius = 80, Center = 100, 100) #}
  <div style="position: relative; width: 220px; height: 130px; margin: 0 auto;">
    <svg viewBox="0 0 200 120" style="width: 100%; height: 100%; overflow: visible;" aria-hidden="true">
      <defs>
        {# Arc geometry helper paths #}
      </defs>

      {# Outer Track 1: Left 1/3 (0 to 1.99 Mo - Seller's in Red) -> 180° to 120° (60 deg arc) #}
      <path d="M 20 100 A 80 80 0 0 1 60 30.7" fill="none" stroke="var(--color-tertiary-default)" stroke-width="12" stroke-linecap="round" opacity="0.85"></path>
      
      {# Outer Track 2: Middle 1/3 (2 to 3.99 Mo - Balanced in Alpine Blue) -> 120° to 60° (60 deg arc) #}
      <path d="M 64 28 A 80 80 0 0 1 136 28" fill="none" stroke="var(--color-secondary-default)" stroke-width="12" opacity="0.95"></path>
      
      {# Outer Track 3: Right 1/3 (4 to 6 Mo - Buyer's in Red) -> 60° to 0° (60 deg arc) #}
      <path d="M 140 30.7 A 80 80 0 0 1 180 100" fill="none" stroke="var(--color-tertiary-default)" stroke-width="12" stroke-linecap="round" opacity="0.85"></path>

      {# Needle Indicator #}
      <g transform="translate(100, 100) rotate({{ needle_angle }})">
        <line x1="0" y1="0" x2="0" y2="-68" stroke="var(--color-primary-default)" stroke-width="3.5" stroke-linecap="round"></line>
        <circle cx="0" cy="0" r="7" fill="var(--color-primary-default)"></circle>
        <circle cx="0" cy="0" r="3" fill="#FFFFFF"></circle>
      </g>

      {# Sub-labels for scale #}
      <text x="18" y="118" font-family="var(--font-default)" font-size="10" font-weight="700" fill="#86868b">0 Mo</text>
      <text x="100" y="20" font-family="var(--font-default)" font-size="10" font-weight="700" fill="#86868b" text-anchor="middle">Balanced</text>
      <text x="182" y="118" font-family="var(--font-default)" font-size="10" font-weight="700" fill="#86868b" text-anchor="end">6 Mo</text>
    </svg>
  </div>

  {# Center Value Display #}
  <div style="margin-top: 0.5rem;">
    <div class="text-data-huge" style="font-size: 2.25rem; color: {{ status_color }}; line-height: 1;">
      {{ months_supply }}
      <span style="font-size: 1rem; font-weight: 600; color: var(--color-primary-default);">Months</span>
    </div>
    <div style="margin-top: 0.4rem;">
      <span style="display: inline-block; padding: 0.25rem 0.75rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 999px; font-size: 0.8rem; font-weight: 700; color: {{ status_color }};">
        {{ market_status }}
      </span>
    </div>
  </div>

</div>