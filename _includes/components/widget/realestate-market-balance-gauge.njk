<!-- File: _includes/components/widget/realestate-market-balance-gauge.njk -->
{% set months_supply = current_months_supply | default(1.8) %}
{% set capped_supply = months_supply if months_supply <= 6.0 else 6.0 %}
{% set needle_angle = -90 + ((capped_supply / 6.0) * 180) %}

{% set market_state = "Seller's Market" %}
{% set state_color = "var(--color-tertiary-default, #D9232A)" %}
{% if months_supply >= 4.0 %}
  {% set market_state = "Buyer's Market" %}
  {% set state_color = "var(--color-tertiary-default, #D9232A)" %}
{% elif months_supply >= 2.0 %}
  {% set market_state = "Balanced Market" %}
  {% set state_color = "var(--color-secondary-default, #1E4D6B)" %}
{% endif %}

<div class="widget-card market-balance-gauge-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row #}
  <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <div>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        Market Balance Gauge
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: {{ state_color }}; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); padding: 0.2rem 0.65rem; border-radius: 999px;">
      {{ market_state }}
    </div>
  </div>

  {# Semi-Circle Gauge SVG with Unified Gradient Arc #}
  <div style="position: relative; width: 100%; max-width: 320px; aspect-ratio: 240 / 155; display: flex; align-items: center; justify-content: center;">
    <svg viewBox="0 0 240 155" width="100%" height="100%" style="overflow: visible;">
      <defs>
        <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#D9232A" />
          <stop offset="28%" stop-color="#D9232A" />
          <stop offset="35%" stop-color="#1E4D6B" />
          <stop offset="65%" stop-color="#1E4D6B" />
          <stop offset="72%" stop-color="#D9232A" />
          <stop offset="100%" stop-color="#D9232A" />
        </linearGradient>
      </defs>

      {# Continuous Semi-Circle Arc: radius 90, center (120, 115) #}
      <path d="M 30 115 A 90 90 0 0 1 210 115" 
            fill="none" 
            stroke="url(#gaugeGradient)" 
            stroke-width="18" 
            stroke-linecap="round"/>

      {# Zone Tick Marks #}
      <line x1="77" y1="40" x2="73" y2="34" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
      <line x1="163" y1="40" x2="167" y2="34" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>

      {# Needle Indicator #}
      <g transform="translate(120, 115) rotate({{ needle_angle }})">
        <polygon points="-4,0 4,0 0,-85" fill="var(--color-primary-default, #1C1C1E)"/>
        <circle cx="0" cy="0" r="10" fill="var(--color-primary-default, #1C1C1E)"/>
        <circle cx="0" cy="0" r="4" fill="#FFFFFF"/>
      </g>

      {# Current Metric Value positioned cleanly below the needle pivot #}
      <text x="120" y="146" text-anchor="middle" font-size="16" font-weight="800" font-family="monospace" fill="var(--color-primary-default, #1C1C1E)">{{ months_supply }} Mo</text>
    </svg>
  </div>

  {# Endpoint Labels (0 Mo Seller's on Left, 6 Mo Buyer's on Right) #}
  <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.75rem;">
    <div style="display: flex; flex-direction: column; align-items: flex-start;">
      <span class="text-overline" style="font-size: 0.65rem; color: var(--color-tertiary-default, #D9232A); font-weight: 800;">0 MO (SELLER'S)</span>
    </div>

    <div style="text-align: center;">
      <span class="text-overline" style="font-size: 0.65rem; color: var(--color-secondary-default, #1E4D6B); font-weight: 800;">3.0 MO (BALANCED)</span>
    </div>

    <div style="display: flex; flex-direction: column; align-items: flex-end;">
      <span class="text-overline" style="font-size: 0.65rem; color: var(--color-tertiary-default, #D9232A); font-weight: 800;">6 MO (BUYER'S)</span>
    </div>
  </div>

</div>