<!-- File: _includes/components/widget/resource-card.njk -->
{% if resource_title and resource_content %}
<div style="text-align: center; max-width: 600px; margin: 0 auto;">
  <h2 class="text-section-title" style="border: none; padding: 0; margin-top: 0; margin-bottom: 0.5rem;">{{ resource_title }}</h2>
  <p class="text-body-secondary" style="margin-bottom: 1.5rem;">{{ resource_content }}</p>
  <div style="max-width: 320px; margin: 0 auto;">
    {% if resource_button_text and resource_button_url %}
      <a href="{{ resource_button_url }}" class="btn-contact-primary">{{ resource_button_text }}</a>
    {% endif %}
  </div>
</div>
{% endif %}