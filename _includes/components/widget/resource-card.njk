{% if resource_title and resource_content %}
<div class="widget-resource-card">
  <h2 class="text-section-title resource-card-title">{{ resource_title }}</h2>
  <p class="resource-card-content text-body-secondary">{{ resource_content }}</p>
  {% if resource_button_text and resource_button_url %}
    <div class="resource-card-action">
      <a href="{{ resource_button_url }}" class="btn btn-primary">{{ resource_button_text }}</a>
    </div>
  {% endif %}
</div>
{% endif %}