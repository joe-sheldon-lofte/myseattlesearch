<!-- File: _includes/components/widget/transit-stats.njk -->
<div class="widget-card transit-stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; min-height: 180px; padding: 1.5rem; width: 100%;">
  
  {# Centered Transit Icon / SVG #}
  <div style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: var(--color-secondary-default); margin-bottom: 0.75rem;" aria-hidden="true">
    {% if transit_mode == 'lightrail' %}
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="3" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><circle cx="8" cy="15" r="1"/><circle cx="16" cy="15" r="1"/></svg>
    {% elif transit_mode == 'sounder' %}
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg>
    {% elif transit_mode == 'seats' %}
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3"/><path d="M6 4v10a2 2 0 0 0 2 2h10v2"/></svg>
    {% else %}
      {# Default: Bus #}
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6v6"/><path d="M15 6v6"/><path d="M2 12h19.6"/><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.2 6 18.1 6H5.9C4.8 6 3.9 6.8 3.6 7.8l-1.4 5c-.1.4-.2.8-.2 1.2 0 .4.1.8.2 1.2.3 1.1.8 2.8.8 2.8h3"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
    {% endif %}
  </div>

  {# Prominent Numerical Metric #}
  <div class="text-data-huge" style="line-height: 0.95; margin-bottom: 0.4rem;">
    {{ transit_stat_value | default("14") }}
  </div>

  {# Descriptive Label String #}
  <div class="text-overline" style="color: var(--color-primary-default); font-size: 0.75rem; letter-spacing: 0.06em;">
    {{ transit_stat_label | default("Active In-Service Buses") }}
  </div>

  {% if transit_stat_context %}
    <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.35rem;">
      {{ transit_stat_context }}
    </div>
  {% endif %}

</div>