{% set default_events = [
  {
    month: "AUG",
    day: "20",
    title: "Edmonds Third Thursday Art Walk",
    venue: "Downtown Edmonds Commercial District",
    time: "5:00 PM – 8:00 PM",
    calendar_url: "webcal://myseattlesearch.com/events/edmonds-art-walk.ics"
  },
  {
    month: "AUG",
    day: "22",
    title: "Homebuyer Readiness & Mortgage Strategy Workshop",
    venue: "Lynnwood Library Meeting Room / Online Stream",
    time: "10:00 AM – 11:30 AM",
    calendar_url: "webcal://myseattlesearch.com/events/homebuyer-workshop.ics"
  },
  {
    month: "AUG",
    day: "23",
    title: "Edmonds Waterfront Summer Concert Series",
    venue: "City Park Rotary Pavilion",
    time: "3:00 PM – 5:00 PM",
    calendar_url: "webcal://myseattlesearch.com/events/summer-concert.ics"
  },
  {
    month: "AUG",
    day: "25",
    title: "City Council Public Hearing: Shoreline Master Plan",
    venue: "Edmonds Municipal Council Chambers",
    time: "7:00 PM",
    calendar_url: "webcal://myseattlesearch.com/events/council-hearing.ics"
  },
  {
    month: "AUG",
    day: "29",
    title: "Salish Sea Puget Sound Ecology Walking Tour",
    venue: "Olympic Beach Visitor Station",
    time: "9:00 AM – 11:00 AM",
    calendar_url: "webcal://myseattlesearch.com/events/ecology-tour.ics"
  }
] %}

<section class="widget-card events-summary-list-card" style="padding: 1.5rem; width: 100%;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline">CIVIC & COMMUNITY CALENDAR</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">
        {{ events_heading | default("Upcoming Local Events") }}
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 600; color: #86868b; text-transform: uppercase;">
      Next 5 Scheduled
    </div>
  </div>

  {# Events Feed List #}
  <div style="display: flex; flex-direction: column;">
    {% for ev in events_items | default(default_events) %}
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 0; {% if not loop.last %}border-bottom: 1px solid var(--color-border-light);{% endif %}">
        
        {# Left: Date Pill Badge #}
        <div style="flex-shrink: 0; width: 56px; height: 56px; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
          <span style="font-size: 0.65rem; font-weight: 800; color: var(--color-tertiary-default); letter-spacing: 0.05em; line-height: 1;">
            {{ ev.month }}
          </span>
          <span style="font-size: 1.35rem; font-weight: 800; color: var(--color-primary-default); line-height: 1.1; margin-top: 0.15rem;">
            {{ ev.day }}
          </span>
        </div>

        {# Middle: Details #}
        <div style="flex-grow: 1; min-width: 0;">
          <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--color-primary-default); margin-bottom: 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            {{ ev.title }}
          </h4>
          <div class="text-body-secondary" style="font-size: 0.75rem;">
            <span>{{ ev.venue }}</span> • <span>{{ ev.time }}</span>
          </div>
        </div>

        {# Right: 1-Click Calendar Add #}
        <div style="flex-shrink: 0;">
          <a href="{{ ev.calendar_url }}" 
             title="Add to Calendar"
             aria-label="Add {{ ev.title }} to your calendar"
             style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 50%; color: var(--color-secondary-default); text-decoration: none; transition: background 0.2s ease;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
              <line x1="12" x2="12" y1="14" y2="18"/>
              <line x1="10" x2="14" y1="16" y2="16"/>
            </svg>
          </a>
        </div>

      </div>
    {% endfor %}
  </div>

  {# Footer CTA Link #}
  <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border-light); text-align: center;">
    <a href="{{ events_all_url | default('/events/') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; font-weight: 700; color: var(--color-secondary-default); text-decoration: none;">
      <span>See all {{ city_name | default("local") }} events</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

</section>