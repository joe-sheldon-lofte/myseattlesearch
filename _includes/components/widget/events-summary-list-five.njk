{# 
  COMPONENT: Five-Item Upcoming Community Events Summary (widget.events.summary.list.five)
  PURPOSE: Compact civic and entertainment schedule with dynamic city naming and optional topic pills.
  CONTRACT:
    - events_items / events_five_data / events: Array of Objects [Required]
      Each event object expects:
      - item.title: String [Required]
      - item.url / item.link: String [Optional]
      - item.date / item.display_date: String [Required, e.g. "SAT, MAR 28"]
      - item.time / item.display_time: String [Optional, e.g. "9:00 AM"]
      - item.location: String [Optional, e.g. "Library Chambers"]
      - item.category / item.categories[0]: String [Optional]
    - city_name / active_neighborhood / city.City: String [Optional]
    - events_heading: String [Optional]
    - predefined_category: String [Optional, locks feed to a single category]
    - enable_category_pills: Boolean [Optional, default false]
    - events_all_url: String [Optional, defaults to '/neighborhood/' + city_slug + '/news-events/']
#}

{% set city_label = city_name or active_neighborhood or (city.City if city else '') %}
{% set heading_text = events_heading or ("Upcoming " ~ city_label ~ " Events" if city_label else "Upcoming Regional Events") %}
{% set overline_text = (city_label ~ " COMMUNITY CALENDAR") if city_label else "REGIONAL COMMUNITY CALENDAR" %}
{% set feed = events_items or events_five_data or events %}
{% set target_cat = (predefined_category | lower) if predefined_category else null %}

{% if feed and feed.length > 0 %}
<section class="widget-card events-summary-five-card" aria-label="{{ heading_text }}">
  
  {# Header Row #}
  <header class="events-list-header">
    <div class="events-list-title-stack">
      <span class="text-overline text-accent-alpine">{{ overline_text }}</span>
      <h3 class="text-widget-title events-list-headline">{{ heading_text }}</h3>
    </div>

    {% if target_cat %}
      <span class="events-category-tag is-locked">{{ target_cat | upper }}</span>
    {% else %}
      <span class="events-count-caption">NEXT 5 UPCOMING</span>
    {% endif %}
  </header>

  {# Optional Interactive Pill Filter Toggles #}
  {% if enable_category_pills and not target_cat %}
    <nav class="events-filter-pills" role="tablist" aria-label="Filter events by category">
      <button type="button" class="btn-filter-pill is-active" data-filter="all" role="tab" aria-selected="true">All</button>
      <button type="button" class="btn-filter-pill" data-filter="municipal" role="tab" aria-selected="false">Municipal</button>
      <button type="button" class="btn-filter-pill" data-filter="family-friendly" role="tab" aria-selected="false">Family</button>
      <button type="button" class="btn-filter-pill" data-filter="music" role="tab" aria-selected="false">Music</button>
      <button type="button" class="btn-filter-pill" data-filter="entertainment" role="tab" aria-selected="false">Entertainment</button>
    </nav>
  {% endif %}

  {# 5 Stacked Events #}
  <div class="events-five-stack">
    {% set count = 0 %}
    {% for item in feed %}
      {% set item_cat = (item.category or (item.categories[0] if item.categories else 'Community')) | lower | replace(' ', '-') %}
      {% if (not target_cat or target_cat == item_cat) and count < 5 %}
        {% set count = count + 1 %}
        {% set item_url = item.url or item.link %}
        {% set item_date = item.date or item.display_date %}
        {% set item_time = item.time or item.display_time %}

        <article class="events-five-row" data-category="{{ item_cat }}">
          
          {# Left: Title & Location Stack #}
          <div class="events-five-lead">
            <h4 class="events-five-title">
              {% if item_url %}
                <a href="{{ item_url }}" class="events-title-link" target="_blank" rel="noopener noreferrer">
                  {{ item.title }}
                </a>
              {% else %}
                {{ item.title }}
              {% endif %}
            </h4>

            {% if item.location %}
              <div class="events-five-location">
                <svg class="events-pin-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <span>{{ item.location }}</span>
              </div>
            {% endif %}
          </div>

          {# Right: Date, Time & Category Badge #}
          <div class="events-five-timing">
            {% if item_date %}
              <time class="events-five-date">{{ item_date }}</time>
            {% endif %}
            {% if item_time and item_time != "12:00 AM" and item_time != "Community Event" %}
              <div class="events-five-time">{{ item_time }}</div>
            {% endif %}
            <span class="events-category-pill">{{ item.category or (item.categories[0] if item.categories else 'Community') }}</span>
          </div>

        </article>
      {% endif %}
    {% endfor %}
  </div>

  {# Footer Routing Strip #}
  <footer class="events-list-footer">
    <a href="{{ events_all_url | default('/neighborhood/' ~ (city_label | slugify) ~ '/news-events/') }}" class="events-all-action-link">
      <span>See all {{ city_label | default("regional") }} events</span>
      <span aria-hidden="true">→</span>
    </a>
  </footer>

</section>
{% endif %}