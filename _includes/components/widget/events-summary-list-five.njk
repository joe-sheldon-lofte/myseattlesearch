{# 
  COMPONENT: Five-Item Upcoming Community Events Summary (widget.events.summary.list.five)
  CONTRACT:
    - events_neighborhood_name / neighborhood.name / city.City / city: String [Required]
    - events_five_data / events / events_list: Array of Objects [Required]
      Each event object expects:
      - item.title: String [Required, e.g. "Edmonds Waterfront Spring Clean-Up"]
      - item.date: String [Required, e.g. "SAT, MAR 28"]
      - item.time: String [Optional, e.g. "9:00 AM - 12:00 PM"]
      - item.location: String [Optional, e.g. "Brackett's Landing North"]
    - events_archive_url: String [Optional, defaults to "/events/"]
#}

{% set active_neighborhood = events_neighborhood_name or (neighborhood.name if neighborhood else '') or city.City or city %}
{% set events_raw = events_five_data or events or events_list %}
{% set events_items = events_raw | slice(0, 5) if events_raw else [] %}
{% set archive_url = events_archive_url or "/events/" %}

{% if active_neighborhood and events_items and events_items.length > 0 %}
<div class="widget-card events-summary-five-card">
  
  {# Header Row: Overline, Neighborhood Title & Subtitle Badge #}
  <div class="card-header-split events-five-header">
    <div>
      <span class="text-overline text-accent-alpine">
        COMMUNITY CALENDAR
      </span>
      <h3 class="text-widget-title events-five-headline">
        Upcoming {{ active_neighborhood }} Events
      </h3>
    </div>
    <span class="text-overline events-five-badge">
      NEXT 5 UPCOMING EVENTS
    </span>
  </div>

  {# 5 Stacked Events #}
  <div class="events-five-stack">
    {% for item in events_items %}
      {% if item.title %}
        <div class="events-five-row">
          
          {# Left: Title & Location Stack #}
          <div class="events-five-lead">
            <div class="events-five-title">
              {{ item.title }}
            </div>
            {% if item.location %}
              <div class="text-body-secondary events-five-location">
                <svg class="events-five-pin-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <span>{{ item.location }}</span>
              </div>
            {% endif %}
          </div>

          {# Right: Date & Time Telemetry #}
          <div class="events-five-timing">
            {% if item.date %}
              <time class="events-five-date">
                {{ item.date }}
              </time>
            {% endif %}
            {% if item.time %}
              <div class="text-body-secondary events-five-time">
                {{ item.time }}
              </div>
            {% endif %}
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Footer Action Link #}
  <div class="events-five-footer">
    <a href="{{ archive_url }}" class="events-five-view-all">
      <span>See all {{ active_neighborhood }} events</span>
      <svg class="events-five-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

</div>
{% endif %}