<!-- File: _includes/components/widget/events-summary-list-five.njk -->
{% set city = events_city_name | default("Edmonds") %}
{% set events_list = events_five_data | default([
  { title: "Edmonds Waterfront Spring Clean-Up", date: "SAT, MAR 28", time: "9:00 AM - 12:00 PM", location: "Brackett's Landing North", category: "Civic" },
  { title: "City Council Regular Business Meeting", date: "TUE, APR 07", time: "7:00 PM", location: "Council Chambers / Zoom", category: "Government" },
  { title: "Downtown Edmonds Art Walk", date: "THU, APR 16", time: "5:00 PM - 8:00 PM", location: "Main Street Commercial Core", category: "Arts" },
  { title: "Planning Board Comprehensive Plan Hearing", date: "WED, APR 22", time: "6:00 PM", location: "Public Safety Complex", category: "Planning" },
  { title: "Snohomish County Fire Prevention Open House", date: "SAT, MAY 02", time: "10:00 AM - 2:00 PM", location: "South County Fire Station 17", category: "Public Safety" }
]) %}

<div class="widget-card events-summary-card" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; box-sizing: border-box;">
  
  {# Header Row per edit: "COMMUNITY CALENDAR" #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        COMMUNITY CALENDAR
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        Upcoming {{ city }} Events
      </h3>
    </div>
    <span class="text-body-secondary" style="font-size: 0.75rem;">NEXT 5 UPCOMING EVENTS</span>
  </div>

  {# 5 Stacked Events #}
  <div style="display: flex; flex-direction: column; gap: 0.65rem;">
    {% for item in events_list %}
      <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; padding: 0.5rem 0; border-bottom: 1px solid var(--color-surface-gray);">
        <div style="display: flex; flex-direction: column; gap: 0.15rem;">
          <div style="font-size: 0.85rem; font-weight: 700; color: var(--color-primary-default); line-height: 1.3;">
            {{ item.title }}
          </div>
          <div class="text-body-secondary" style="font-size: 0.75rem;">
            📍 {{ item.location }}
          </div>
        </div>

        <div style="text-align: right; flex-shrink: 0;">
          <div style="font-size: 0.75rem; font-weight: 800; font-family: monospace; color: var(--color-secondary-default);">
            {{ item.date }}
          </div>
          <div class="text-body-secondary" style="font-size: 0.7rem;">
            {{ item.time }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Footer Action Link #}
  <div style="border-top: 1px solid var(--color-border-light); padding-top: 0.5rem; text-align: right;">
    <a href="/events/" style="color: var(--color-secondary-default); font-size: 0.8rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;">
      <span>See all {{ city }} events</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

</div>