{# 
  COMPONENT: Ballot Measures & Initiatives Accordion (widget.elections.guide.measures)
  CONTRACT:
    - elections_measures / measures: Array of Objects [Required]
      Each measure object expects:
      - m.code: String [Optional, e.g. "Proposition No. 1"]
      - m.title: String [Required, e.g. "Emergency Medical Services Levy Renewal"]
      - m.summary: String [Required]
      - m.fiscal: String [Optional fiscal impact analysis]
    - measures_guide_title / guide_title: String [Optional, defaults to "Ballot Measures & Initiatives"]
    - measures_disclaimer / disclaimer_text: String [Optional]
#}

{% set measure_list = elections_measures or measures %}
{% set title = measures_guide_title or guide_title or "Ballot Measures & Initiatives" %}
{% set disclaimer = measures_disclaimer or disclaimer_text or "Official non-partisan measure summary compiled for voter reference." %}

{% if measure_list and measure_list.length > 0 %}
<div class="widget-card elections-guide-card">
  
  {# Header Row #}
  <div class="card-header-clean">
    <h3 class="text-widget-title">{{ title }}</h3>
  </div>

  {# Accordion Stack of Measures #}
  <div class="election-races-stack">
    {% for m in measure_list %}
      {% if m.title %}
        <details class="election-measure-accordion" {% if loop.first %}open{% endif %}>
          <summary class="accordion-summary">
            <span class="accordion-office-title">
              {% if m.code %}{{ m.code }}: {% endif %}{{ m.title }}
            </span>
            <svg class="accordion-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>

          <div class="measure-content-body">
            {% if m.summary %}
              <p class="text-body measure-summary-text">
                {{ m.summary }}
              </p>
            {% endif %}

            {% if m.fiscal %}
              <div class="measure-fiscal-callout">
                <span class="fiscal-label">Fiscal Impact:</span>
                <span class="fiscal-value text-body-secondary">{{ m.fiscal }}</span>
              </div>
            {% endif %}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>

  {# Non-partisan Disclaimer Footer #}
  {% if disclaimer %}
    <div class="card-footer-strip text-body-secondary">
      <span>{{ disclaimer }}</span>
    </div>
  {% endif %}

</div>
{% endif %}