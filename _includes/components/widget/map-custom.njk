<!-- File: _includes/components/widget/map-custom.njk -->
{# 
  COMPONENT: Master Polymorphic Geographic Map Engine (widget.map.custom)
  PURPOSE: Fluid interactive vector & raster cartographic viewport across all 58 neighborhoods.
  CONTRACT:
    - map_lat / neighborhood.latitude / city.Latitude: Number [Required]
    - map_lon / neighborhood.longitude / city.Longitude: Number [Required]
    - map_neighborhood / neighborhood.name / city.City: String [Optional]
    - map_layer / layer: String [Optional: "base", "emergencies", "transit", "weather" - defaults to "base"]
    - map_title: String [Optional, overrides default title]
    - map_overline: String [Optional, overrides default overline]
    - map_zoom: Number [Optional, defaults to 12]
    - map_aspect_class: String [Optional, e.g. "map-aspect-widescreen", "map-aspect-square"]
    - map_accent_color: String [Optional, defaults to Alpine Blue]
#}

{% set active_neighborhood = map_neighborhood or (neighborhood.name if neighborhood else '') or (city.City if city else '') %}
{% set lat_val = map_lat if map_lat is defined else ((neighborhood.latitude if neighborhood else null) or (city.Latitude if city else null)) %}
{% set lon_val = map_lon if map_lon is defined else ((neighborhood.longitude if neighborhood else null) or (city.Longitude if city else null)) %}

{% if lat_val and lon_val %}
  {% set layer_mode = map_layer or layer or "base" %}
  {% set zoom_val = map_zoom | default(12) %}
  {% set accent_color = map_accent_color or "var(--alpine-blue)" %}
  {% set aspect_modifier = map_aspect_class | default("") %}

  {# Dynamic Domain Layer Labels & Badges #}
  {% set default_overline = "LOCAL OVERVIEW" %}
  {% set default_title = (active_neighborhood ~ " Geography & Infrastructure") if active_neighborhood else "Regional Geography & Infrastructure" %}
  {% set pill_class = "layer-base" %}
  {% set pill_label = "Base Cartography" %}

  {% if layer_mode == "emergencies" %}
    {% set default_overline = "EMERGENCY & CIVIL DEFENSE" %}
    {% set default_title = (active_neighborhood ~ " Emergency Infrastructure & Evacuation") if active_neighborhood else "Emergency Corridors & Shelters" %}
    {% set pill_class = "layer-emergency" %}
    {% set pill_label = "Civil Defense Telemetry" %}
  {% elif layer_mode == "transit" %}
    {% set default_overline = "REGIONAL MOBILITY" %}
    {% set default_title = (active_neighborhood ~ " Transit Corridors & Rail Lines") if active_neighborhood else "Transit Lines & Regional Corridors" %}
    {% set pill_class = "layer-transit" %}
    {% set pill_label = "Multi-Modal Corridors" %}
  {% elif layer_mode == "weather" %}
    {% set default_overline = "ATMOSPHERIC INTELLIGENCE" %}
    {% set default_title = (active_neighborhood ~ " Microclimates & Doppler Radar") if active_neighborhood else "Regional Doppler & Sensor Network" %}
    {% set pill_class = "layer-weather" %}
    {% set pill_label = "Live Doppler Sweep" %}
  {% endif %}

  {% set card_overline = map_overline | default(default_overline) %}
  {% set card_title = map_title | default(default_title) %}

  <section class="widget-card custom-map-card" aria-label="{{ card_title }}">
    
    {# Header Row #}
    <header class="map-header-row">
      <div class="map-title-stack">
        <span class="text-overline text-accent-alpine">
          {{ card_overline }}
        </span>
        <h3 class="text-widget-title map-card-title">
          {{ card_title }}
        </h3>
      </div>

      <div class="map-layer-pill {{ pill_class }}">
        <span class="map-pulse-dot" aria-hidden="true"></span>
        <span>{{ pill_label }}</span>
      </div>
    </header>

    {# Fluid Map Viewport Container #}
    <div class="map-viewport-frame {{ aspect_modifier }}">
      <neighborhood-map 
        lat="{{ lat_val }}" 
        lon="{{ lon_val }}" 
        zoom="{{ zoom_val }}"
        layer="{{ layer_mode }}"
        active-neighborhood="{{ active_neighborhood | default('Local Area') }}"
        accent-color="{{ accent_color }}">
      </neighborhood-map>
    </div>

    {# Footer Metadata Coordinates #}
    <footer class="map-footer-row">
      <span>{{ active_neighborhood | default("Puget Sound Basin") }}, WA</span>
      <span class="map-coordinates-tag">{{ lat_val | round(4) }}° N, {{ (lon_val | abs) | round(4) }}° W</span>
    </footer>

  </section>

  {# Client-side Web Component Script Guard #}
  <script type="module" src="/scripts/utilities/neighborhood-map.js" defer></script>
{% endif %}