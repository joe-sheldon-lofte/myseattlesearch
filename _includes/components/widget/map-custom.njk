<!-- File: _includes/components/widget/map-custom.njk -->
{% set map_lat = map_lat | default(47.7560) %}
{% set map_lon = map_lon | default(-122.3415) %}
{% set map_title = map_title | default("Shoreline Geography & Infrastructure") %}
{% set map_zoom = map_zoom | default(13) %}
{% set map_aspect = map_aspect | default("16 / 10") %}
{% set map_min_height = map_min_height | default("240px") %}
{% set map_max_height = map_max_height | default("480px") %}

<div class="widget-card custom-map-card" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1rem; box-sizing: border-box;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        LOCAL OVERVIEW
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ map_title }}
      </h3>
    </div>
  </div>

  {# Fluid Map Viewport Container (Zero rigid height locks per Section 6) #}
  <div style="width: 100%; aspect-ratio: {{ map_aspect }}; min-height: {{ map_min_height }}; max-height: {{ map_max_height }}; border-radius: 8px; overflow: hidden; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); position: relative;">
    <neighborhood-map 
      lat="{{ map_lat }}" 
      lon="{{ map_lon }}" 
      zoom="{{ map_zoom }}"
      style="display: block; width: 100%; height: 100%;">
    </neighborhood-map>
  </div>

  {# Client-side Web Component script #}
  <script src="/scripts/utilities/neighborhood-map.js" type="module" defer></script>
  
</div>