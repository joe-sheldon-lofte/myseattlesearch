<!-- File: _includes/components/widget/events-summary-list-all.njk -->
{% set city = events_city_name | default("Edmonds") %}
{% set all_events = events_all_data | default([
  { title: "Edmonds Waterfront Spring Clean-Up", date: "SAT, MAR 28", time: "9:00 AM - 12:00 PM", location: "Brackett's Landing North", category: "Civic", desc: "Annual beach sweep and native plant restoration along the saltwater promenade." },
  { title: "City Council Regular Business Meeting", date: "TUE, APR 07", time: "7:00 PM", location: "Council Chambers / Zoom", category: "Government", desc: "Public comment period followed by legislative review of 2026 capital improvement funds." },
  { title: "Downtown Edmonds Art Walk", date: "THU, APR 16", time: "5:00 PM - 8:00 PM", location: "Main Street Commercial Core", category: "Arts", desc: "Third Thursday monthly celebration featuring local Pacific Northwest artists, galleries, and tastings." },
  { title: "Planning Board Comprehensive Plan Hearing", date: "WED, APR 22", time: "6:00 PM", location: "Public Safety Complex", category: "Planning", desc: "Public testimony regarding proposed transit-oriented development zoning along arterial corridors." },
  { title: "Snohomish County Fire Prevention Open House", date: "SAT, MAY 02", time: "10:00 AM - 2:00 PM", location: "South County Fire Station 17", category: "Public Safety", desc: "Community safety demonstrations, CPR training, and emergency vehicle exploration." }
]) %}

<div class="widget-card events-summary-all-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row per edit: "COMMUNITY CALENDAR" #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        COMMUNITY CALENDAR
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.25rem;">
        Full {{ city }} Event Schedule
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: #10B981; background: rgba(16, 185, 129, 0.12); padding: 0.2rem 0.65rem; border-radius: 999px;">
      {{ all_events | length }} Scheduled
    </div>
  </div>

  {# Full Events Stack #}
  <div style="display: flex; flex-direction: column; gap: 0.85rem;">
    {% for item in all_events %}
      <div style="background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem;">
          <h4 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: var(--color-primary-default);">
            {{ item.title }}
          </h4>
          <span style="font-family: monospace; font-size: 0.75rem; font-weight: 800; color: var(--color-secondary-default);">
            {{ item.date }} • {{ item.time }}
          </span>
        </div>

        <p class="text-body-secondary" style="font-size: 0.8rem; line-height: 1.45; margin: 0;">
          {{ item.desc }}
        </p>

        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; margin-top: 0.25rem;">
          <span class="text-body-secondary">📍 {{ item.location }}</span>
          <span style="font-size: 0.65rem; font-weight: 700; color: #86868b; background: var(--color-background-universal); padding: 0.15rem 0.45rem; border-radius: 999px; border: 1px solid var(--color-border-light);">
            {{ item.category }}
          </span>
        </div>
      </div>
    {% endfor %}
  </div>

</div>