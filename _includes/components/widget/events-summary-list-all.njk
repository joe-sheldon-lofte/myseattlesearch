<!-- File: _includes/components/widget/events-summary-list-all.njk -->
{# 
  COMPONENT: Comprehensive Community Event Schedule (widget.events.summary.list.all)
  PURPOSE: Full calendar feed with interactive category filters, descriptive body text, and zero inline CSS.
#}

{% set city_label = events_city_name or city_name or active_neighborhood or (city.City if city else '') %}
{% set heading_text = events_heading or ("Full " ~ city_label ~ " Event Schedule" if city_label else "Full Regional Event Schedule") %}
{% set overline_text = (city_label ~ " COMMUNITY CALENDAR") if city_label else "REGIONAL COMMUNITY CALENDAR" %}
{% set all_events = events_all_data or events_items or events %}

{% if all_events and all_events.length > 0 %}
<section class="widget-card events-summary-all-card" aria-label="{{ heading_text }}">
  
  {# Header Row #}
  <header class="events-all-header">
    <div class="events-all-title-stack">
      <span class="text-overline text-accent-alpine">{{ overline_text }}</span>
      <h3 class="text-widget-title events-all-headline">{{ heading_text }}</h3>
    </div>
    <div class="events-filter-caption">Filter Schedule by Category</div>
  </header>

  {# Topic Filter Pills (Scrubbed of city-* and county-* tags) #}
  <nav class="events-filter-pills" role="tablist" aria-label="Filter events by category">
    <button type="button" class="btn-filter-pill is-active" data-filter="all" role="tab" aria-selected="true">All Events</button>
    <button type="button" class="btn-filter-pill" data-filter="municipal" role="tab" aria-selected="false">Municipal</button>
    <button type="button" class="btn-filter-pill" data-filter="family-friendly" role="tab" aria-selected="false">Family Friendly</button>
    <button type="button" class="btn-filter-pill" data-filter="all-ages" role="tab" aria-selected="false">All Ages</button>
    <button type="button" class="btn-filter-pill" data-filter="music" role="tab" aria-selected="false">Music &amp; Arts</button>
    <button type="button" class="btn-filter-pill" data-filter="entertainment" role="tab" aria-selected="false">Entertainment</button>
  </nav>

  {# Full Events Stack #}
  <div class="events-all-stack">
    {% for item in all_events %}
      {% set item_url = item.url or item.link %}
      {% set item_cat = (item.category or (item.categories[0] if item.categories else 'Community')) | lower | replace(' ', '-') %}
      {% set item_tags = (item.tags | join(' ')) | lower if item.tags else '' %}

      <article class="events-all-item" data-category="{{ item_cat }}" data-tags="{{ item_tags }}">
        
        {# Title & Timing Header #}
        <div class="events-all-row-top">
          <h4 class="events-all-title">
            {% if item_url %}
              <a href="{{ item_url }}" class="events-title-link" target="_blank" rel="noopener noreferrer">
                {{ item.title }}
              </a>
            {% else %}
              {{ item.title }}
            {% endif %}
          </h4>

          <span class="events-all-datetime">
            {{ item.date or item.display_date }}{% if item.time and item.time != "12:00 AM" and item.time != "Community Event" %} • {{ item.time }}{% endif %}
          </span>
        </div>

        {# Excerpt / Description #}
        {% set item_desc = item.desc or item.excerpt %}
        {% if item_desc %}
          <p class="text-body-secondary events-all-desc">
            {{ item_desc }}
          </p>
        {% endif %}

        {# Location & Category Badge Strip #}
        <div class="events-all-footer">
          <div class="events-all-location">
            {% if item.location %}
              <span aria-hidden="true">📍</span>
              <span>{{ item.location }}</span>
            {% endif %}
          </div>
          
          <div class="events-all-actions">
            <span class="events-category-pill">
              {{ item.category or (item.categories[0] if item.categories else 'Community') }}
            </span>
            {% if item_url %}
              <a href="{{ item_url }}" class="events-view-link" target="_blank" rel="noopener noreferrer">
                <span>View Event</span>
                <span aria-hidden="true">→</span>
              </a>
            {% endif %}
          </div>
        </div>

      </article>
    {% endfor %}
  </div>

  {# Client Controller (Category Pill Filter Engine) #}
  <script>
    (function() {
      const container = document.currentScript ? document.currentScript.closest('.events-summary-all-card') : document.querySelector('.events-summary-all-card');
      if (!container) return;
      const pills = container.querySelectorAll('.btn-filter-pill');
      const items = container.querySelectorAll('.events-all-item');

      pills.forEach(pill => {
        pill.addEventListener('click', function() {
          pills.forEach(p => {
            p.classList.remove('is-active');
            p.setAttribute('aria-selected', 'false');
          });
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          const filter = this.getAttribute('data-filter');
          items.forEach(item => {
            const cat = item.getAttribute('data-category');
            const tags = item.getAttribute('data-tags') || '';
            if (filter === 'all' || cat === filter || tags.includes(filter)) {
              item.classList.remove('is-hidden');
            } else {
              item.classList.add('is-hidden');
            }
          });
        });
      });
    })();
  </script>

</section>
{% endif %}