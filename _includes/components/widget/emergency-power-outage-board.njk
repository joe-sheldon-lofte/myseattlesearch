<!-- File: _includes/components/widget/emergency-power-outage-board.njk -->
{# 
  COMPONENT: Electrical Power Outage Monitor (widget.emergency.power.outage.board)
  CONTRACT:
    - outage_utilities_data / utilities / power_outage_data: Array of Objects [Required]
      Each utility provider object expects:
      - u.name: String [Required, e.g. "Snohomish County PUD"]
      - u.customers_affected: Number [Required, e.g. 42]
      - u.active_outages: Number [Optional, e.g. 3]
      - u.status: String [Optional, e.g. "Normal Operations"]
      - u.restored_pct: String [Optional, e.g. "99.98%"]
    - outage_board_title: String [Optional, defaults to "Electrical Power Outage Monitor"]
    - outage_board_overline: String [Optional, defaults to "UTILITY STATUS"]
    - outage_source_text: String [Optional, defaults to "Source: Washington State Emergency Operations Center"]
    - outage_sync_interval: String [Optional, defaults to "Updated Every 15 min"]
#}

{% set utility_list = outage_utilities_data or utilities or power_outage_data %}
{% set board_title = outage_board_title or "Electrical Power Outage Monitor" %}
{% set board_overline = outage_board_overline or "UTILITY STATUS" %}
{% set source_text = outage_source_text or "Source: Washington State Emergency Operations Center" %}
{% set sync_interval = outage_sync_interval or "Updated Every 15 min" %}

{% if utility_list and utility_list.length > 0 %}
<div class="widget-card emergency-board-card">
  
  {# Header Row: Utility Status Overline & Title #}
  <div class="card-header-clean emergency-board-header">
    <div>
      <span class="text-overline text-accent-alpine">
        {{ board_overline }}
      </span>
      <h3 class="text-widget-title emergency-board-title">
        {{ board_title }}
      </h3>
    </div>
  </div>

  {# Utility Grid Matrix #}
  <div class="emergency-events-stack">
    {% for u in utility_list %}
      {% if u.name and u.customers_affected is defined %}
        <div class="power-outage-row">
          
          {# Left: Provider Identity & Graphic Frame #}
          <div class="power-outage-lead">
            <div class="power-outage-icon-frame" aria-hidden="true">
              {% include "components/graphic/map-power-outage.njk" ignore missing %}
            </div>
            <div class="power-outage-identity">
              <div class="power-outage-name">
                {{ u.name }}
              </div>
              {% if u.active_outages is defined %}
                <div class="text-body-secondary power-outage-subtext">
                  {{ u.active_outages }} Active Incidents
                </div>
              {% endif %}
            </div>
          </div>

          {# Right: Customer Impact Metric with Crimson Alert Switch #}
          <div class="power-outage-metric-block">
            <div class="power-outage-number {% if u.customers_affected > 500 %}text-tier-crimson{% else %}text-primary-charcoal{% endif %}">
              {{ u.customers_affected }}
            </div>
            <div class="text-overline power-outage-caption">
              Customers Without Power
            </div>
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Footer: Attribution & Refresh Interval #}
  <div class="card-footer-strip text-body-secondary">
    <span>{{ source_text }}</span>
    <span>{{ sync_interval }}</span>
  </div>

</div>
{% endif %}