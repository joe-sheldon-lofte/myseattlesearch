<!-- File: _includes/components/widget/emergency-power-outage-board.njk -->
{% set city = outage_city_name | default("Snohomish & King Counties") %}
{% set utilities = outage_utilities_data | default([
  { name: "Snohomish County PUD", customers_affected: 42, active_outages: 3, status: "Normal Operations", restored_pct: "99.98%" },
  { name: "Puget Sound Energy (PSE)", customers_affected: 118, active_outages: 6, status: "Normal Operations", restored_pct: "99.96%" },
  { name: "Seattle City Light", customers_affected: 15, active_outages: 1, status: "Normal Operations", restored_pct: "99.99%" }
]) %}

<div class="widget-card emergency-power-outage-board-card" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1rem; box-sizing: border-box;">
  
  {# Header Row per edit: "UTILITY STATUS" #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        UTILITY STATUS
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        Electrical Power Outage Monitor
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: #10B981; background: rgba(16, 185, 129, 0.12); padding: 0.2rem 0.65rem; border-radius: 999px;">
      Grid Stable
    </div>
  </div>

  {# Utility Grid Matrix including Seattle City Light per edit #}
  <div style="display: flex; flex-direction: column; gap: 0.65rem;">
    {% for u in utilities %}
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0.95rem; background: var(--color-surface-gray); border-radius: 10px;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            {% include "components/graphic/map-power-outage.njk" ignore missing %}
          </div>
          <div>
            <div style="font-size: 0.9rem; font-weight: 800; color: var(--color-primary-default);">
              {{ u.name }}
            </div>
            <div class="text-body-secondary" style="font-size: 0.75rem;">
              {{ u.active_outages }} Active Incidents • {{ u.restored_pct }} Online
            </div>
          </div>
        </div>

        <div style="text-align: right;">
          <div class="text-data-huge" style="font-size: 1.15rem; font-family: monospace; font-weight: 800; color: {% if u.customers_affected > 500 %}var(--color-tertiary-default){% else %}var(--color-primary-default){% endif %};">
            {{ u.customers_affected }}
          </div>
          <div style="font-size: 0.65rem; color: #86868b; text-transform: uppercase;">Meters Out</div>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Footer #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.5rem; font-size: 0.7rem;" class="text-body-secondary">
    <span>Direct Outage Map Telemetry (PSE, Snohomish PUD, Seattle City Light)</span>
    <span>Updated Every 15 min</span>
  </div>

</div>