<!-- File: _includes/components/widget/universal-data-chart-maxfour.njk -->
{# 
  COMPONENT: Universal 4-Series Vector Trend Chart (widget.universal.data.chart.maxfour)
  PURPOSE: Pure SSG vector line chart with interactive hover crosshair & value readout.
#}

{% set x_labels = chart_x_labels or chart_labels %}
{% set y_labels = chart_y_labels %}
{% set title_text = chart_title or title %}
{% set hover_dates = chart_hover_dates or x_labels %}

{% set active_series = chart_series if chart_series else [] %}
{% if (active_series | length == 0) and (series_1_points or series_1_name) %}
  {% set s1 = {'name': series_1_name, 'points': series_1_points, 'raw_vals': series_1_raw_vals, 'fmt_vals': series_1_fmt_vals, 'color_class': 'series-1'} if (series_1_points or series_1_name) else null %}
  {% set s2 = {'name': series_2_name, 'points': series_2_points, 'raw_vals': series_2_raw_vals, 'fmt_vals': series_2_fmt_vals, 'color_class': 'series-2'} if (series_2_points or series_2_name) else null %}
  {% set s3 = {'name': series_3_name, 'points': series_3_points, 'raw_vals': series_3_raw_vals, 'fmt_vals': series_3_fmt_vals, 'color_class': 'series-3'} if (series_3_points or series_3_name) else null %}
  {% set s4 = {'name': series_4_name, 'points': series_4_points, 'raw_vals': series_4_raw_vals, 'fmt_vals': series_4_fmt_vals, 'color_class': 'series-4'} if (series_4_points or series_4_name) else null %}
  {% set active_series = [s1, s2, s3, s4] | reject('falsy') | list %}
{% endif %}

{% set has_valid_points = false %}
{% for s in active_series %}
  {% if s.points %}
    {% set has_valid_points = true %}
  {% endif %}
{% endfor %}

{% if has_valid_points %}
<section class="widget-card universal-data-chart-card" aria-label="{{ title_text | default('Statistical Trend Chart') }}">
  
  <header class="chart-header-row">
    <div class="chart-title-stack">
      {% if title_text %}
        <h3 class="text-widget-title chart-card-title">{{ title_text }}</h3>
      {% endif %}
    </div>

    {% if active_series and (active_series | length > 0) %}
      <div class="chart-legend-cluster" aria-hidden="true">
        {% for s in active_series %}
          {% if s.name %}
            {% set color_class = s.color_class | default('series-' ~ loop.index) %}
            <div class="chart-legend-item">
              <span class="chart-legend-swatch {{ color_class }}"></span>
              <span class="chart-legend-name">{{ s.name }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <div class="chart-canvas-wrap" data-interactive-chart>
    <div class="chart-floating-tooltip" aria-hidden="true"></div>

    <svg viewBox="0 0 960 280" preserveAspectRatio="xMidYMid meet" class="chart-svg-stage" role="img" aria-label="{{ title_text | default('Data visualization chart') }}">
      
      {# Horizontal Grid Lines #}
      <g class="chart-grid-group">
        <line x1="16" y1="24" x2="944" y2="24" class="chart-grid-line" />
        <line x1="16" y1="96" x2="944" y2="96" class="chart-grid-line" />
        <line x1="16" y1="168" x2="944" y2="168" class="chart-grid-line" />
        <line x1="16" y1="240" x2="944" y2="240" class="chart-grid-line" />
      </g>

      {# Y-Axis Labels #}
      {% if y_labels and (y_labels | length > 0) %}
        {% set total_y = y_labels | length %}
        <g>
          {% for y_text in y_labels %}
            {% set y_pos = 24 + (loop.index0 * (216 / (total_y - 1))) if total_y > 1 else 132 %}
            <text x="942" y="{{ y_pos - 5 }}" text-anchor="end" class="chart-axis-label">{{ y_text }}</text>
          {% endfor %}
        </g>
      {% endif %}

      {# X-Axis Time Steps #}
      {% if x_labels and (x_labels | length > 0) %}
        {% set total_x = x_labels | length %}
        <g>
          {% for label in x_labels %}
            {% if label %}
              {% set x_pos = 16 + ((loop.index0 / (total_x - 1)) * 928) if total_x > 1 else 480 %}
              {% set anchor = "start" if loop.first else ("end" if loop.last else "middle") %}
              <text x="{{ x_pos | round(1) }}" y="266" text-anchor="{{ anchor }}" class="chart-axis-label">{{ label }}</text>
            {% endif %}
          {% endfor %}
        </g>
      {% endif %}

      {# Vertical Hover Crosshair #}
      <line x1="16" y1="20" x2="16" y2="244" class="chart-crosshair-line" />

      {# Data Series Lines & Crisp 3px Nodes #}
      {% for s in active_series %}
        {% if s.points %}
          {% set s_idx = loop.index0 %}
          {% set color_class = s.color_class | default('series-' ~ loop.index) %}
          <polyline points="{{ s.points }}" class="chart-series-polyline {{ color_class }}" />
          {% set pts_array = s.points.split(' ') %}
          {% for pt in pts_array %}
            {% set coord = pt.split(',') %}
            {% if (coord | length) == 2 %}
              <circle cx="{{ coord[0] }}" cy="{{ coord[1] }}" r="3" class="chart-data-dot {{ color_class }}" data-step="{{ loop.index0 }}" data-series-idx="{{ s_idx }}" />
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}

      {# Full-Height Interactive Hover Columns #}
      {% if hover_dates and (hover_dates | length > 0) %}
        {% set num_steps = hover_dates | length %}
        {% set col_w = (928 / num_steps) if num_steps > 0 else 928 %}
        {% for d_lbl in hover_dates %}
          {% set idx = loop.index0 %}
          {% set cx = 16 + ((idx / (num_steps - 1)) * 928) if num_steps > 1 else 480 %}
          {% set rx = 16 + (idx * col_w) %}
          {% set step_items = [] %}
          {% for s in active_series %}
            {% if s.points %}
              {% set vals_src = s.fmt_vals if s.fmt_vals else s.raw_vals %}
              {% set disp_v = vals_src[idx] if (vals_src and vals_src[idx] is defined) else '' %}
              {% set c_cls = s.color_class | default('series-' ~ loop.index) %}
              {% set _ = step_items.push(c_cls ~ '::' ~ s.name ~ '::' ~ disp_v) %}
            {% endif %}
          {% endfor %}
          <rect x="{{ rx | round(1) }}"
                y="16"
                width="{{ col_w | round(1) }}"
                height="232"
                class="chart-hit-band"
                data-step="{{ idx }}"
                data-cx="{{ cx | round(1) }}"
                data-date="{{ d_lbl }}"
                data-payload="{{ step_items | join('||') }}" />
        {% endfor %}
      {% endif %}

    </svg>
  </div>
</section>
{% endif %}
