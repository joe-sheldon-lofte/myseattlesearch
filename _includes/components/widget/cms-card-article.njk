<!-- File: _includes/components/widget/cms-card-article.njk -->
{% set card_type = article_badge | default("ARTICLE") %}
{% set card_title = article_title | default("Missing-Middle Infill Zoning Along the Swift BRT Corridor: What Homebuyers and Builders Must Know") %}
{% set card_excerpt = article_excerpt | default("How Snohomish County's updated development code is reshaping infill housing, duplex financing models, and property tax baselines.") %}
{% set card_date = article_date | default("Oct 20, 2026") %}
{% set card_author = article_author | default("Joe Sheldon") %}
{% set card_url = article_url | default("/posts/missing-middle-zoning-snohomish/") %}

<article class="widget-card cms-card-item" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; justify-content: space-between; gap: 1.25rem; box-sizing: border-box; transition: transform 0.2s ease, box-shadow 0.2s ease;">
  
  <div>
    {# Header Row (5 min read removed per edit) #}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
      <span class="text-overline" style="color: {% if card_type == 'ARTICLE' %}var(--color-tertiary-default, #D9232A){% else %}var(--color-secondary-default, #1E4D6B){% endif %}; font-weight: 800; font-size: 0.7rem;">
        {{ card_type }}
      </span>
      <time class="text-body-secondary" style="font-size: 0.75rem;">
        {{ card_date }}
      </time>
    </div>

    {# Title #}
    <h3 class="text-widget-title" style="margin: 0 0 0.5rem 0; font-size: 1.2rem; line-height: 1.35;">
      <a href="{{ card_url }}" style="color: var(--color-primary-default); text-decoration: none;">
        {{ card_title }}
      </a>
    </h3>

    {# Excerpt #}
    {% if card_excerpt %}
      <p class="text-body-secondary" style="font-size: 0.85rem; line-height: 1.5; margin: 0;">
        {{ card_excerpt }}
      </p>
    {% endif %}
  </div>

  {# Footer Bar: Author, Reply & Share (Phone number removed per edit) #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.85rem; flex-wrap: wrap; gap: 0.75rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <div style="width: 28px; height: 28px; border-radius: 50%; overflow: hidden; background: var(--color-surface-gray); flex-shrink: 0;">
        <img src="/assets/images/joe-sheldon-headshot.webp" alt="{{ card_author }}" width="28" height="28" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--color-primary-default);">{{ card_author }}</span>
    </div>

    <div style="display: flex; align-items: center; gap: 0.5rem;">
      {# Reply -> /chat/ #}
      <a href="/chat/?topic={{ card_title | urlencode }}" 
         style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: var(--color-secondary-default); text-decoration: none; transition: all 0.15s ease;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>Reply</span>
      </a>

      {# Share Button #}
      <button type="button" 
              onclick="if(navigator.share){navigator.share({title:'{{ card_title }}',url:'{{ card_url }}'})}else{navigator.clipboard.writeText(window.location.origin + '{{ card_url }}');alert('Article link copied!');}"
              style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: var(--color-primary-default); cursor: pointer; transition: all 0.15s ease;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        <span>Share</span>
      </button>
    </div>
  </div>

</article>