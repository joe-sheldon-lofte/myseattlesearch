<!-- File: _includes/components/widget/tool-calculator-results.njk -->
{# 
  COMPONENT: Calculated Financial Summary (widget.tool.calculator.results)
  PURPOSE: Itemized disposition settlement breakdown (Net Proceeds, Gross, Mortgage, REET, Title).
  CONTRACT:
    - calc_results_overline / overline_label: String [Optional, defaults to "RESULTS"]
    - calc_results_title / title_label: String [Optional, defaults to "Calculated Financial Summary"]
    - calc_net_cash: String [Optional, e.g. "$458,740"]
    - calc_gross_price: String [Optional, e.g. "$850,000"]
    - calc_mortgage_payoff: String [Optional, e.g. "$320,000"]
    - calc_reet_tax: String [Optional, e.g. "$13,425"]
    - calc_settlement_fees: String [Optional, e.g. "$4,845"]
    - calc_results_slot: String (HTML safe) [Optional]
    - content: String (HTML safe) [Optional]
#}

{% set overline = calc_results_overline or overline_label or "RESULTS" %}
{% set title_text = calc_results_title or title_label or "Calculated Financial Summary" %}
{% set net_val = calc_net_cash or "—" %}
{% set gross_val = calc_gross_price or "—" %}
{% set mortgage_val = calc_mortgage_payoff or "—" %}
{% set reet_val = calc_reet_tax or "—" %}
{% set fees_val = calc_settlement_fees or "—" %}

<section class="widget-card tool-calculator-results-card" aria-label="{{ title_text }}">
  
  {# Header Row #}
  <header class="calc-card-header">
    <div class="calc-title-stack">
      <span class="text-overline text-accent-alpine">
        {{ overline }}
      </span>
      <h3 class="text-widget-title calc-card-title">
        {{ title_text }}
      </h3>
    </div>
    <div class="calc-estimate-pill">
      Calculated Estimate
    </div>
  </header>

  {# Customizable / Bindable Results Body Section #}
  <div class="calculator-results-body-section">
    {% if calc_results_slot %}
      {{ calc_results_slot | safe }}
    {% elif content %}
      {{ content | safe }}
    {% else %}
      <div class="calc-results-stack">
        
        {# Primary Huge Metric Display #}
        <div class="calc-hero-metric-box">
          <span class="text-overline calc-hero-metric-label">
            Estimated Net Cash in Pocket
          </span>
          <div class="calc-hero-metric-value" id="calc-display-net">
            {{ net_val }}
          </div>
          <p class="calc-hero-metric-subtext">
            Reflects mortgage payoff, Washington graduated REET, brokerage fees, and settlement costs.
          </p>
        </div>

        {# Itemized Line-Item Breakdown #}
        <div class="calc-breakdown-list">
          <div class="calc-breakdown-row row-gross">
            <span class="calc-line-label">Expected Gross Sale Price</span>
            <span class="calc-line-value value-gross">+ {{ gross_val }}</span>
          </div>

          <div class="calc-breakdown-row row-deduction">
            <span class="calc-line-label label-muted">Mortgage Payoff / Lien Relief</span>
            <span class="calc-line-value value-deduction">- {{ mortgage_val }}</span>
          </div>

          <div class="calc-breakdown-row row-deduction">
            <span class="calc-line-label label-muted">WA Graduated REET (Real Estate Excise)</span>
            <span class="calc-line-value value-deduction">- {{ reet_val }}</span>
          </div>

          <div class="calc-breakdown-row row-deduction">
            <span class="calc-line-label label-muted">Estimated Settlement &amp; Title Fees</span>
            <span class="calc-line-value value-deduction">- {{ fees_val }}</span>
          </div>
        </div>

        {# Statutory Consumer Disclaimer Box #}
        <div class="calc-disclaimer-box">
          <span class="calc-disclaimer-tag">Statutory Disclaimer:</span> Informational estimate only. Actual net proceeds will vary based on verified daily interest payoff, municipal utility prorations, and final settlement credits.
        </div>

      </div>
    {% endif %}
  </div>

</section>