<!-- File: _includes/components/widget/tool-calculator-results.njk -->
{% set overline_label = calc_results_overline | default("RESULTS") %}
{% set title_label = calc_results_title | default("Calculated Financial Summary") %}

<div class="widget-card tool-calculator-results-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.5rem; box-sizing: border-box;">
  
  {# Header Row per Edit: "RESULTS" overline #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.85rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default);">
        {{ overline_label }}
      </span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">
        {{ title_label }}
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: #059669; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); padding: 0.25rem 0.65rem; border-radius: 999px;">
      Calculated Estimate
    </div>
  </div>

  {# Open / Customizable Results Body Section per Edit #}
  <div class="calculator-results-body-section" style="width: 100%;">
    {% if calc_results_slot %}
      {{ calc_results_slot | safe }}
    {% elif content %}
      {{ content | safe }}
    {% else %}
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        
        {# Primary Huge Metric Display #}
        <div style="background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 12px; padding: 1.5rem; text-align: center;">
          <div class="text-overline" style="font-size: 0.7rem; color: #86868b;">
            Estimated Net Cash in Pocket
          </div>
          <div class="text-data-huge" style="font-size: 2.75rem; color: var(--color-secondary-default); line-height: 1.1; margin: 0.5rem 0 0.25rem 0; font-family: monospace;">
            $458,740
          </div>
          <div class="text-body-secondary" style="font-size: 0.75rem;">
            Reflects mortgage payoff, Washington graduated REET, brokerage fees, and settlement costs.
          </div>
        </div>

        {# Itemized Line-Item Breakdown #}
        <div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem;">
          <div style="display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background: var(--color-surface-gray); border-radius: 8px;">
            <span style="font-weight: 600; color: var(--color-primary-default);">Expected Gross Sale Price</span>
            <span style="font-weight: 800; font-family: monospace;">+ $850,000</span>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 8px;">
            <span class="text-body-secondary">Mortgage Payoff / Lien Relief</span>
            <span style="font-weight: 700; font-family: monospace; color: var(--color-tertiary-default);">- $320,000</span>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 8px;">
            <span class="text-body-secondary">WA Graduated REET (Real Estate Excise)</span>
            <span style="font-weight: 700; font-family: monospace; color: var(--color-tertiary-default);">- $13,425</span>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 8px;">
            <span class="text-body-secondary">Estimated Settlement &amp; Title Fees</span>
            <span style="font-weight: 700; font-family: monospace; color: var(--color-tertiary-default);">- $4,845</span>
          </div>
        </div>

        {# Disclaimer Box #}
        <div style="background: var(--color-surface-gray); border-left: 3px solid var(--color-secondary-default); border-radius: 8px; padding: 0.75rem 1rem; font-size: 0.7rem; line-height: 1.5;" class="text-body-secondary">
          <strong>Statutory Disclaimer:</strong> Informational estimate only. Actual net proceeds will vary based on verified daily interest payoff, municipal utility prorations, and final settlement credits.
        </div>

      </div>
    {% endif %}
  </div>

</div>