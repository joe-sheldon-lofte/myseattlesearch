<!-- File: _includes/components/widget/people-profile-view.njk -->
{# 
  COMPONENT: Professional Profile View & Verified Dossier (widget.people.profile.view)
  PURPOSE: Full two-column professional profile with contact triggers, verified credentials, and editorial narrative.
  CONTRACT:
    - profile_view_name / person_name / name: String [Required]
    - profile_view_role / person_role / role: String [Optional, e.g. "Senior Real Estate Agent"]
    - profile_view_category / person_category / category: String [Optional, e.g. "REAL ESTATE ADVISOR"]
    - profile_view_image / person_image / image: String [Optional, headshot URL]
    - profile_view_phone / person_phone / phone: String [Optional, e.g. "(206) 657-7493"]
    - profile_view_tel / person_tel / tel: String [Optional, e.g. "2066577493"]
    - profile_view_email / person_email / email: String [Optional]
    - profile_view_website / person_website / website: String [Optional]
    - profile_view_license / person_license / license: String [Optional, e.g. "WA DOL License #115714"]
    - profile_view_back_url / back_url: String [Optional, defaults to "/team/"]
    - profile_view_content / content: String (HTML safe narrative markup) [Optional]
#}

{% set p_name = profile_view_name or person_name or name %}
{% set p_role = profile_view_role or person_role or role %}
{% set p_category = profile_view_category or person_category or category %}
{% set p_image = profile_view_image or person_image or image %}
{% set p_phone = profile_view_phone or person_phone or phone %}
{% set p_tel = profile_view_tel or person_tel or tel or (p_phone | replace('(', '') | replace(')', '') | replace(' ', '') | replace('-', '') if p_phone else '') %}
{% set p_email = profile_view_email or person_email or email %}
{% set p_website = profile_view_website or person_website or website %}
{% set p_license = profile_view_license or person_license or license %}
{% set p_back_url = profile_view_back_url or back_url or "/team/" %}
{% set p_content = profile_view_content or content %}

{% if p_name %}
<div class="people-profile-view-container">
  
  {# Top Navigation Bar #}
  <nav class="profile-nav-bar" aria-label="Profile Navigation">
    <a href="{{ p_back_url }}" class="profile-back-link">
      <svg class="profile-back-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Back to Directory</span>
    </a>
    <span class="profile-nav-label">
      Professional Profile
    </span>
  </nav>

  {# Two-Column Responsive Layout #}
  <div class="profile-stage-grid">
    
    {# Left Column: Contact & Identity Card #}
    <aside class="widget-card profile-aside-card" aria-label="Advisor credentials for {{ p_name }}">
      
      {# Standardized 150x150 Circular Avatar per SOP 6 #}
      {% if p_image %}
        <div class="profile-avatar-wrapper">
          <img src="{{ p_image }}" 
               alt="{{ p_name }}" 
               width="150" 
               height="150" 
               loading="lazy" 
               decoding="async" 
               class="profile-avatar-img">
        </div>
      {% endif %}

      <div class="profile-identity-stack">
        {% if p_category %}
          <span class="text-overline profile-category-tag">
            {{ p_category }}
          </span>
        {% endif %}
        <h1 class="text-page-title profile-name-heading">
          {{ p_name }}
        </h1>
        {% if p_role %}
          <div class="profile-role-text">
            {{ p_role }}
          </div>
        {% endif %}
      </div>

      {# Direct Contact Action Pills #}
      <div class="profile-actions-stack">
        {% if p_tel and p_phone %}
          <a href="tel:{{ p_tel }}" class="btn-profile-call" aria-label="Call {{ p_name }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>Call: {{ p_phone }}</span>
          </a>
        {% endif %}

        {% if p_email %}
          <a href="mailto:{{ p_email }}" class="btn-profile-email" aria-label="Email {{ p_name }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span>Email</span>
          </a>
        {% endif %}

        {% if p_website %}
          <a href="{{ p_website }}" target="_blank" rel="noopener noreferrer" class="btn-profile-website">
            <span>Visit Official Page</span>
            <svg class="btn-profile-website-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
        {% endif %}
      </div>

      {# Verified Credentials Sub-card #}
      {% if p_license %}
        <div class="profile-credentials-box">
          <div class="text-overline credentials-overline">VERIFIED CREDENTIALS</div>
          <div class="credentials-license-text">
            {{ p_license }}
          </div>
          <div class="credentials-standing-subtext">
            Active Washington State License • Standing Verified
          </div>
        </div>
      {% endif %}

    </aside>

    {# Right Column: Professional Narrative #}
    {% if p_content %}
      <section class="widget-card profile-narrative-card" aria-label="Professional biography for {{ p_name }}">
        <header class="profile-narrative-header">
          <h2 class="text-widget-title profile-narrative-title">
            Professional Profile &amp; Other Information
          </h2>
        </header>

        <div class="text-body profile-prose-body">
          {{ p_content | safe }}
        </div>
      </section>
    {% endif %}

  </div>

</div>
{% endif %}