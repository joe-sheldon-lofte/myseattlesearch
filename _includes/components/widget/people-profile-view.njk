<!-- File: _includes/components/widget/people-profile-view.njk -->
{% set p_name = profile_view_name or person_name or name %}
{% set p_role = profile_view_role or person_role or role %}
{% set p_image = profile_view_image or person_image or image %}
{% set p_phone = profile_view_phone or person_phone or phone %}
{% set p_tel = profile_view_tel or person_tel or tel or (p_phone | replace('(', '') | replace(')', '') | replace(' ', '') | replace('-', '') if p_phone else '') %}
{% set p_email = profile_view_email or person_email or email %}
{% set p_website = profile_view_website or person_website or website %}
{% set p_content = profile_view_content or content %}

{% if p_name %}
<article class="surface-bento profile-single-card" aria-label="Professional profile for {{ p_name }}">

  {# Mirrored Avatar & Identity Block #}
  {% if p_image %}
    <div class="profile-avatar-wrapper">
      <img src="{{ p_image }}" 
           alt="{{ p_name }}" 
           width="150" 
           height="150" 
           class="profile-avatar-img">
    </div>
  {% endif %}

  {% if p_role %}
    <div class="text-overline people-role-tag">
      {{ p_role }}
    </div>
  {% endif %}

  <h2 class="profile-name-heading">
    {{ p_name }}
  </h2>

  {# Mirrored Contact Meta Cluster #}
  <div class="people-contact-meta">
    {% if p_tel and p_phone %}
      <a href="tel:{{ p_tel }}" class="people-contact-link" aria-label="Call {{ p_name }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>{{ p_phone }}</span>
      </a>
    {% endif %}

    {% if p_email %}
      <a href="mailto:{{ p_email }}" class="people-contact-link" aria-label="Email {{ p_name }}">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        <span>{{ p_email }}</span>
      </a>
    {% endif %}
  </div>

  {# Blue Pill Button under Contact Info #}
  {% if p_website %}
    <div class="profile-cta-wrapper action-tray-constrained">
      <a href="{{ p_website }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        <span>View Additional Information</span>
      </a>
    </div>
  {% endif %}

  {# Divider and Narrative Block #}
  {% if p_content %}
    <div class="section-divider"></div>

    <section class="profile-narrative-section">
      <h3 class="text-section-title profile-narrative-heading">
        Professional Profile &amp; Additional Information
      </h3>
      <div class="text-body profile-prose-body">
        {{ p_content | safe }}
      </div>
    </section>
  {% endif %}

</article>
{% endif %}