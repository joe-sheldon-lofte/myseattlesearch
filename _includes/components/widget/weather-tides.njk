<!-- File: _includes/components/widget/weather-tides.njk -->
{% set is_night = tide_is_night | default(false) %}

<div class="widget-card weather-tides-card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; min-height: 240px; width: 100%; border-radius: var(--border-radius-squircle); box-sizing: border-box;">
  
  {# LAYER 1: SKY LAYER (Top 25%) #}
  <div style="flex: 1; min-height: 58px; padding: 0.75rem 1.25rem; display: flex; justify-content: space-between; align-items: center; {% if is_night %}background: linear-gradient(180deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF;{% else %}background: linear-gradient(180deg, #BAE6FD 0%, #E0F2FE 100%); color: #0369A1;{% endif %} transition: background 0.3s ease;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      {% if is_night %}
        {# Moon Icon #}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      {% else %}
        {# Sun Icon #}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      {% endif %}
      <span class="text-overline" style="font-size: 0.7rem; letter-spacing: 0.06em;">NEXT HIGH {{ tide_high_time | default("8:56 PM") }}</span>
    </div>
    <div style="font-size: 1.15rem; font-weight: 800; font-family: monospace;">
      {{ tide_high_level | default("+11.2 ft") }}
    </div>
  </div>

  {# LAYER 2: WATER LAYER (Middle 50% with wavy top border) #}
  <div style="flex: 2; min-height: 110px; background: var(--color-secondary-default); color: #FFFFFF; padding: 1rem 1.25rem; display: flex; flex-direction: column; justify-content: space-between; position: relative;">
    
    {# Wave SVG divider overlay #}
    <div style="position: absolute; top: -1px; left: 0; right: 0; height: 10px; overflow: hidden; pointer-events: none;" aria-hidden="true">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none" style="width: 100%; height: 100%;">
        <path d="M0,0 C150,90 350,-40 500,40 C650,120 900,10 1200,40 L1200,0 L0,0 Z" fill="{% if is_night %}#1E293B{% else %}#E0F2FE{% endif %}"></path>
      </svg>
    </div>

    {# Water Content #}
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 0.35rem;">
      <span style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.02em;">
        Station: {{ tide_station | default("Edmonds, Possession Sound") }}
      </span>
      <span style="display: inline-flex; align-items: center; gap: 0.35rem; background: rgba(255,255,255,0.18); backdrop-filter: blur(4px); padding: 0.25rem 0.65rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">
        {{ tide_trend_label | default("Tide Rising ↑") }}
      </span>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div style="font-size: 0.75rem; opacity: 0.85;">Current Est. Surface Level</div>
      <div class="text-data-huge" style="font-size: 2.2rem; color: #FFFFFF; line-height: 1;">
        {{ tide_current_level | default("+8.4 ft") }}
      </div>
    </div>
  </div>

  {# LAYER 3: SAND LAYER (Bottom 25%) #}
  <div style="flex: 1; min-height: 58px; background: #EED9C4; color: var(--color-primary-default); padding: 0.75rem 1.25rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(0,0,0,0.06);">
    <div class="text-overline" style="font-size: 0.7rem; color: #78350F; letter-spacing: 0.06em;">
      NEXT LOW {{ tide_low_time | default("2:55 AM") }}
    </div>
    <div style="font-size: 1.15rem; font-weight: 800; font-family: monospace; color: #78350F;">
      {{ tide_low_level | default("+1.9 ft") }}
    </div>
  </div>

</div>