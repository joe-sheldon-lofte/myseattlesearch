<!-- File: _includes/components/widgets/stat-card.njk -->
{# 
  COMPONENT: High-Density Statistical Telemetry Tile (widgets.stat.card)
  CONTRACT:
    - stat_value / value: String or Number [Required, e.g. "$1.15M", "24", "4.2%"]
    - stat_label / label: String [Required, e.g. "Median Sale Price", "Days on Market"]
    - stat_context / context_note: String [Optional, e.g. "+2.4% this month", "Active MLS Benchmark"]
    - stat_trend / trend: String [Optional: "positive", "negative", "neutral" - defaults to auto-detection]
#}

{% set stat_val = stat_value or value %}
{% set stat_lbl = stat_label or label %}
{% set stat_ctx = stat_context or context_note %}
{% set stat_trnd = stat_trend or trend %}

{% if stat_val and stat_lbl %}
  {% set trend_class = "stat-context-neutral" %}
  {% if stat_trnd == "positive" or (stat_ctx and "+" in stat_ctx) %}
    {% set trend_class = "stat-context-positive" %}
  {% elif stat_trnd == "negative" or (stat_ctx and "-" in stat_ctx) %}
    {% set trend_class = "stat-context-negative" %}
  {% elif stat_trnd == "neutral" %}
    {% set trend_class = "stat-context-neutral" %}
  {% endif %}

  <div class="stat-card" role="region" aria-label="{{ stat_lbl }}: {{ stat_val }}">
    
    {# The Primary Numerical Metric #}
    <span class="stat-value">
      {{ stat_val }}
    </span>
    
    {# The Secondary Descriptor #}
    <span class="stat-label">
      {{ stat_lbl }}
    </span>

    {# Optional Contextual Delta / Footnote #}
    {% if stat_ctx %}
      <span class="stat-context {{ trend_class }}">
        {{ stat_ctx }}
      </span>
    {% endif %}

  </div>
{% endif %}