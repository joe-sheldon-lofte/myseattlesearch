{# 
  COMPONENT: Current Atmospheric Weather Conditions (widget.weather.current.display)[cite: 27]
  PURPOSE: Real-time sky condition, temperature, diurnal high/low, wind, and humidity telemetry[cite: 27].
  CONTRACT:
    - current_weather_temp / weather_temp / weather.temp: Number or String [Required]
    - current_weather_condition / weather_condition / weather.condition: String [Optional, e.g. "Partly Cloudy", "Rain", "Clear"]
    - current_weather_high / weather_high / weather.high: Number or String [Optional]
    - current_weather_low / weather_low / weather.low: Number or String [Optional]
    - current_weather_wind / weather_wind / weather.wind: String [Optional, e.g. "NW at 7.2 MPH"]
    - current_weather_humidity / weather_humidity / weather.humidity: String [Optional, e.g. "52%"]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set raw_temp = current_weather_temp if current_weather_temp is defined else (weather_temp if weather_temp is defined else (weather.temp if weather else null)) %}
{% set active_neighborhood = active_neighborhood or (neighborhood.name if neighborhood else '') or (city.City if city else '') %}

{% if raw_temp is not none and raw_temp != '' %}
  {% set condition = current_weather_condition or (weather.condition if weather else '') or "Fair" %}
  {% set high_temp = current_weather_high if current_weather_high is defined else (weather.high if weather else null) %}
  {% set low_temp = current_weather_low if current_weather_low is defined else (weather.low if weather else null) %}
  {% set wind_str = current_weather_wind or (weather.wind if weather else '') %}
  {% set humidity_str = current_weather_humidity or (weather.humidity if weather else '') %}

  {# Clean wind string from any stray raw unicode arrows #}
  {% set clean_wind = wind_str | replace("↖", "") | replace("↗", "") | replace("↘", "") | replace("↙", "") | replace("→", "") | replace("←", "") | replace("↑", "") | replace("↓", "") | trim %}

  <section class="widget-card weather-current-display-card" aria-label="Current Weather for {{ active_neighborhood | default('This Neighborhood') }}: {{ raw_temp }} degrees, {{ condition }}">
    
    {# Header Line #}
    <header class="weather-current-header">
      <span class="text-overline weather-overline-tag">
        CURRENT WEATHER
      </span>
      {% if active_neighborhood %}
        <span class="weather-neighborhood-badge">
          {{ active_neighborhood }}, WA
        </span>
      {% endif %}
    </header>

    {# Sky Condition & Temperature Block #}
    <div class="weather-main-row">
      <div class="weather-condition-cluster">
        <div class="weather-icon-well" aria-hidden="true">
          {% set cond_lower = condition | lower %}
          <svg width="36" height="36" viewBox="0 0 32 32" fill="none" class="weather-icon-svg" aria-hidden="true">
            {% if 'rain' in cond_lower or 'drizzle' in cond_lower or 'shower' in cond_lower %}
              <path d="M7 19a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 19H7z" class="weather-svg-cloud-body" />
              <line x1="10" y1="22" x2="8" y2="27" class="weather-svg-rain-streak" />
              <line x1="16" y1="22" x2="14" y2="27" class="weather-svg-rain-streak" />
              <line x1="22" y1="22" x2="20" y2="27" class="weather-svg-rain-streak" />
            {% elif 'cloud' in cond_lower or 'overcast' in cond_lower %}
              {% if 'part' in cond_lower %}
                <circle cx="11" cy="11" r="5" class="weather-svg-sun-core" />
              {% endif %}
              <path d="M8 22a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 26 22H8z" class="weather-svg-cloud-body" />
            {% elif 'snow' in cond_lower or 'flurry' in cond_lower %}
              <path d="M7 18a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 18H7z" class="weather-svg-cloud-body" />
              <circle cx="10" cy="23" r="1.2" fill="#93C5FD" />
              <circle cx="16" cy="25" r="1.2" fill="#93C5FD" />
              <circle cx="22" cy="23" r="1.2" fill="#93C5FD" />
            {% elif 'thunder' in cond_lower or 'storm' in cond_lower %}
              <path d="M7 17a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 17H7z" fill="#64748B" />
              <polygon points="17,17 12,24 15,24 13,29 20,21 16,21" class="weather-svg-lightning" />
            {% else %}
              {# Clear / Sunny Default #}
              <circle cx="16" cy="16" r="7" class="weather-svg-sun-core" />
              <line x1="16" y1="4" x2="16" y2="7" class="weather-svg-sun-ray" />
              <line x1="16" y1="25" x2="16" y2="28" class="weather-svg-sun-ray" />
              <line x1="4" y1="16" x2="7" y2="16" class="weather-svg-sun-ray" />
              <line x1="25" y1="16" x2="28" y2="16" class="weather-svg-sun-ray" />
              <line x1="7.5" y1="7.5" x2="9.5" y2="9.5" class="weather-svg-sun-ray" />
              <line x1="22.5" y1="22.5" x2="24.5" y2="24.5" class="weather-svg-sun-ray" />
              <line x1="7.5" y1="24.5" x2="9.5" y2="22.5" class="weather-svg-sun-ray" />
              <line x1="22.5" y1="9.5" x2="24.5" y2="7.5" class="weather-svg-sun-ray" />
            {% endif %}
          </svg>
        </div>
        <div class="weather-condition-meta">
          <div class="weather-condition-headline">
            {{ condition }}
          </div>
          {% if active_neighborhood %}
            <div class="weather-condition-subtext">
              {{ condition }} in {{ active_neighborhood }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="weather-temp-display">
        {{ raw_temp }}°<span class="weather-temp-unit">F</span>
      </div>
    </div>

    {# Bottom Metrics: High/Low, Wind & Humidity #}
    {% if high_temp or wind_str or humidity_str %}
      <footer class="weather-metrics-footer">
        {% if high_temp is not none and low_temp is not none %}
          <div class="weather-metric-group">
            <span class="weather-metric-label">HIGH / LOW</span>
            <div class="weather-highlow-value">
              {{ high_temp }}° <span class="weather-low-span">/ {{ low_temp }}°</span>
            </div>
          </div>
        {% endif %}

        <div class="weather-vitals-cluster">
          {% if clean_wind %}
            <div class="weather-metric-group">
              <span class="weather-metric-label">WIND</span>
              <div class="weather-vital-value">
                {{ clean_wind }}
              </div>
            </div>
          {% endif %}

          {% if humidity_str %}
            <div class="weather-metric-group">
              <span class="weather-metric-label">HUMIDITY</span>
              <div class="weather-vital-value">
                {{ humidity_str }}
              </div>
            </div>
          {% endif %}
        </div>
      </footer>
    {% endif %}

  </section>
{% endif %}