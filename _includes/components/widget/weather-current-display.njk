<!-- File: _includes/components/widget/weather-current.njk -->
<div class="widget-card weather-current-card" style="display: flex; flex-direction: column; justify-content: space-between; min-height: 220px;">
  
  {# Top Row: Location & Condition #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <span class="text-overline">{{ weather_location | default("Current Conditions") }}</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">{{ weather_condition | default("Partly Cloudy") }}</h3>
    </div>
    <div style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: var(--color-secondary-default);">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="M20 12h2"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
        <path d="M15.947 12.65a4 4 0 0 0-5.925-4.128"></path>
        <path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"></path>
      </svg>
    </div>
  </div>

  {# Center: Primary Fluid Temperature Metric #}
  <div style="margin: 1.25rem 0 0.75rem 0;">
    <div class="text-data-huge" style="line-height: 0.95;">{{ weather_temp | default("54°") }}</div>
    <div class="text-body-secondary" style="margin-top: 0.5rem; font-size: 0.85rem;">
      Feels like {{ weather_feels_like | default("52°") }} • H: {{ weather_high | default("58°") }} L: {{ weather_low | default("46°") }}
    </div>
  </div>

  {# Bottom Bar: Secondary Environment Stats #}
  <div style="display: flex; flex-wrap: wrap; gap: 1.25rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.8rem;" class="text-body-secondary">
    <div>Humidity: <strong style="color: var(--color-primary-default);">{{ weather_humidity | default("72%") }}</strong></div>
    <div>Wind: <strong style="color: var(--color-primary-default);">{{ weather_wind | default("6 mph NW") }}</strong></div>
    <div>Barometer: <strong style="color: var(--color-primary-default);">{{ weather_pressure | default("30.04 in") }}</strong></div>
  </div>

</div>