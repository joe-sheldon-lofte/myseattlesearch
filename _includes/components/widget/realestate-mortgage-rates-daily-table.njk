{# 
  COMPONENT: Daily Mortgage Interest Rates Table (widget.realestate.mortgage.rates.daily.table)
  CONTRACT:
    - daily_rate_conventional: String [Optional, e.g. "6.84%"]
    - daily_rate_fha: String [Optional, e.g. "6.35%"]
    - daily_rate_va: String [Optional, e.g. "6.38%"]
    - mortgage_table_heading: String [Optional, defaults to "Daily Mortgage Rates"]
#}

{% set rate_conv = daily_rate_conventional | default('') %}
{% set rate_fha = daily_rate_fha | default('') %}
{% set rate_va = daily_rate_va | default('') %}
{% set heading = mortgage_table_heading | default("Daily Mortgage Rates") %}

{% if rate_conv or rate_fha or rate_va %}
<section class="widget-card realestate-mortgage-rates-daily-card" aria-label="{{ heading }}">
  
  {# Header Row #}
  <header class="mortgage-rates-header">
    <div class="mortgage-rates-title-stack">
      <h3 class="text-widget-title mortgage-rates-title">
        {{ heading }}
      </h3>
    </div>
  </header>

  {# 3 Stacked Loan Program Rows #}
  <div class="mortgage-rates-list" style="margin-bottom: 0.25rem;">
    {% if rate_conv %}
      <div class="mortgage-rate-row">
        <span class="mortgage-program-name">
          30-Year Conventional Fixed
        </span>
        <span class="mortgage-rate-value">
          {{ rate_conv }}
        </span>
      </div>
    {% endif %}

    {% if rate_fha %}
      <div class="mortgage-rate-row">
        <span class="mortgage-program-name">
          30-Year FHA Government
        </span>
        <span class="mortgage-rate-value rate-accent">
          {{ rate_fha }}
        </span>
      </div>
    {% endif %}

    {% if rate_va %}
      <div class="mortgage-rate-row">
        <span class="mortgage-program-name">
          30-Year VA Military Benefit
        </span>
        <span class="mortgage-rate-value rate-accent">
          {{ rate_va }}
        </span>
      </div>
    {% endif %}
  </div>

</section>
{% endif %}
