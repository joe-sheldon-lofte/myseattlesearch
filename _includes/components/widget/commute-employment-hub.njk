{# 
  COMPONENT: Commute & Major Employment Hub Times (widget.commute.employment.hub)
  CONTRACT:
    - commute_neighborhood_name / neighborhood.name / city.City: String [Required]
    - commute_origin_lat / city.Latitude / neighborhood.lat: Number [Optional]
    - commute_origin_lon / city.Longitude / neighborhood.lon: Number [Optional]
    - commute_data / commute_metrics: Object keyed by hub ID (slu, bellevue, redmond, everett, renton, kent) [Optional]
      Each hub metric entry can provide:
      - miles: String / Number
      - drive_live: String (e.g. "24 min")
      - drive_offpeak: String (e.g. "18 min")
      - transit_live: String (e.g. "38 min")
      - transit_offpeak: String (e.g. "32 min")
      - return_drive_live: String [Optional]
      - return_drive_offpeak: String [Optional]
      - return_transit_live: String [Optional]
      - return_transit_offpeak: String [Optional]
      - friction: Number [Optional, e.g. 14 for +14%]
      - friction_label: String [Optional, e.g. "Low Drag", "Moderate", "Heavy Delay"]
#}

{% set active_neighborhood = commute_neighborhood_name or (neighborhood.name if neighborhood else '') or city.City or city %}
{% set origin_lat = commute_origin_lat or (neighborhood.lat if neighborhood else '') or city.Latitude %}
{% set origin_lon = commute_origin_lon or (neighborhood.lon if neighborhood else '') or city.Longitude %}
{% set telemetry = commute_data or commute_metrics or {} %}

{# Canonical Regional Employment Hubs (Fixed Puget Sound Anchors) #}
{% set canonical_hubs = [
  { id: "slu", name: "South Lake Union (Seattle)", lat: 47.6253, lon: -122.3375 },
  { id: "bellevue", name: "Downtown Bellevue", lat: 47.6101, lon: -122.2015 },
  { id: "redmond", name: "Microsoft Redmond Campus", lat: 47.6423, lon: -122.1368 },
  { id: "everett", name: "Boeing Everett Factory", lat: 47.9253, lon: -122.2715 },
  { id: "renton", name: "Boeing Renton Factory", lat: 47.4915, lon: -122.2155 },
  { id: "kent", name: "Kent Valley Logistics Hub", lat: 47.3809, lon: -122.2348 }
] %}

{% if active_neighborhood %}
<div class="widget-card commute-hub-container"
     data-origin-neighborhood="{{ active_neighborhood }}"
     {% if origin_lat and origin_lon %}data-origin-lat="{{ origin_lat }}" data-origin-lon="{{ origin_lon }}"{% endif %}>
  
  {# Header Row #}
  <div class="card-header-split">
    <div>
      <span class="text-overline text-accent-alpine">
        CURRENT ACTIVE COMMUTE TIMES
      </span>
      <h3 class="text-widget-title">
        {{ active_neighborhood }} to Major Employment Hubs
      </h3>
    </div>
  </div>

  {# 2-Column Responsive Employment Hub Grid #}
  <div class="commute-hubs-grid">
    {% for hub in canonical_hubs %}
      {% set m = telemetry[hub.id] %}
      <div class="commute-hub-card"
           data-hub-id="{{ hub.id }}"
           data-hub-lat="{{ hub.lat }}"
           data-hub-lon="{{ hub.lon }}">
        
        {# Hub Header: Name & Friction Indicator #}
        <div class="commute-hub-header">
          <div>
            <h4 class="commute-hub-title">
              {{ hub.name }}
            </h4>
            {% if m and m.miles %}
              <span class="text-body-secondary commute-sub-metric">{{ m.miles }}</span>
            {% endif %}
          </div>

          {% if m and m.friction is defined %}
            {% set friction_class = "friction-low" if m.friction <= 15 else ("friction-moderate" if m.friction <= 30 else "friction-high") %}
            <div class="commute-friction-badge {{ friction_class }}" title="Commute Friction Delay Penalty">
              <span>+{{ m.friction }}%</span>
              {% if m.friction_label %}
                <span>{{ m.friction_label }}</span>
              {% endif %}
            </div>
          {% endif %}
        </div>

        {% if m and (m.drive_live or m.transit_live) %}
          {# Direction 1: Neighborhood -> Employment Hub #}
          <div class="commute-leg-block">
            <div class="text-overline commute-leg-overline">
              MORNING COMMUTE: {{ active_neighborhood | upper }} → HUB
            </div>
            
            <div class="commute-modes-grid">
              {% if m.drive_live %}
                <div class="commute-metric-cell">
                  <span class="commute-metric-label">DRIVE</span>
                  <div class="commute-metric-value">{{ m.drive_live }}</div>
                  {% if m.drive_offpeak %}
                    <span class="text-body-secondary commute-sub-metric">Off-peak: {{ m.drive_offpeak }}</span>
                  {% endif %}
                </div>
              {% endif %}

              {% if m.transit_live %}
                <div class="commute-metric-cell">
                  <span class="commute-metric-label text-accent-alpine">TRANSIT</span>
                  <div class="commute-metric-value text-accent-alpine">{{ m.transit_live }}</div>
                  {% if m.transit_offpeak %}
                    <span class="text-body-secondary commute-sub-metric">Off-peak: {{ m.transit_offpeak }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>

          {# Direction 2: Employment Hub -> Neighborhood #}
          <div class="commute-leg-block">
            <div class="text-overline commute-leg-overline">
              EVENING RETURN: HUB → {{ active_neighborhood | upper }}
            </div>

            {% set ret_drive = m.return_drive_live or m.drive_live %}
            {% set ret_drive_offpeak = m.return_drive_offpeak or m.drive_offpeak %}
            {% set ret_transit = m.return_transit_live or m.transit_live %}
            {% set ret_transit_offpeak = m.return_transit_offpeak or m.transit_offpeak %}

            <div class="commute-modes-grid">
              {% if ret_drive %}
                <div class="commute-metric-cell">
                  <span class="commute-metric-label">DRIVE</span>
                  <div class="commute-metric-value">{{ ret_drive }}</div>
                  {% if ret_drive_offpeak %}
                    <span class="text-body-secondary commute-sub-metric">Off-peak: {{ ret_drive_offpeak }}</span>
                  {% endif %}
                </div>
              {% endif %}

              {% if ret_transit %}
                <div class="commute-metric-cell">
                  <span class="commute-metric-label text-accent-alpine">TRANSIT</span>
                  <div class="commute-metric-value text-accent-alpine">{{ ret_transit }}</div>
                  {% if ret_transit_offpeak %}
                    <span class="text-body-secondary commute-sub-metric">Off-peak: {{ ret_transit_offpeak }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% else %}
          {# Telemetry Pending State #}
          <div class="commute-pending-state">
            <span class="text-body-secondary commute-sub-metric">Corridor telemetry syncing…</span>
          </div>
        {% endif %}

      </div>
    {% endfor %}
  </div>

</div>
{% endif %}