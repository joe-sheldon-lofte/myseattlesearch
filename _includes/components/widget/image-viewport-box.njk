{% set demo_images = [
  { url: "https://assets.myseattlesearch.com/neighborhood/hero-pools/snohomish/1.webp", alt: "Edmonds Waterfront and Olympic Mountains" },
  { url: "https://assets.myseattlesearch.com/neighborhood/hero-pools/snohomish/3.webp", alt: "Downtown Edmonds 5th and Main" },
  { url: "https://assets.myseattlesearch.com/neighborhood/hero-pools/snohomish/5.webp", alt: "Washington State Ferry Arriving at Edmonds" }
] %}
{% set gallery_images = viewport_images | default(demo_images) %}
{% set viewport_id = viewport_box_id | default("image-viewport-" + (range(100, 999) | random)) %}

<div id="{{ viewport_id }}" class="image-viewport-box-container" data-slide-count="{{ gallery_images.length }}" data-current-index="0">
  <div class="viewport-screen-frame">

    {% if viewport_badge %}
      <div class="viewport-overlay-badge">{{ viewport_badge }}</div>
    {% endif %}

    <div class="viewport-slider" tabindex="0">
      {% for img in gallery_images %}
        <div class="viewport-slide">
          <img src="{{ img.url }}" alt="" class="viewport-slide-backdrop" aria-hidden="true" loading="lazy">
          <div class="viewport-slide-scrim" aria-hidden="true"></div>
          <img src="{{ img.url }}"
               alt="{{ img.alt }}"
               class="viewport-primary-image"
               loading="{% if loop.first %}eager{% else %}lazy{% endif %}"
               decoding="async">
        </div>
      {% endfor %}
    </div>

    {% if gallery_images.length > 1 %}
      <button type="button"
              class="viewport-nav-btn prev"
              aria-label="Previous image"
              onclick="navigateViewport('{{ viewport_id }}', -1)">
        &lsaquo;
      </button>

      <button type="button"
              class="viewport-nav-btn next"
              aria-label="Next image"
              onclick="navigateViewport('{{ viewport_id }}', 1)">
        &rsaquo;
      </button>

      <div class="viewport-dots">
        {% for img in gallery_images %}
          <button type="button"
                  class="viewport-dot {% if loop.first %}is-active{% endif %}"
                  onclick="jumpToSlide('{{ viewport_id }}', {{ loop.index0 }})"
                  aria-label="Go to slide {{ loop.index }}"></button>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

<script>
(function() {
  function syncViewportDots(container, index) {
    container.dataset.currentIndex = String(index);
    const dots = container.querySelectorAll('.viewport-dot');
    dots.forEach(function(dot, idx) {
      dot.classList.toggle('is-active', idx === index);
    });
  }

  function animateToSlide(containerId, targetIndex) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const slider = container.querySelector('.viewport-slider');
    const count = parseInt(container.dataset.slideCount || '1', 10);
    if (!slider || count <= 1) return;

    const clamped = ((targetIndex % count) + count) % count;
    const targetLeft = clamped * slider.clientWidth;

    slider.classList.add('is-animating');
    syncViewportDots(container, clamped);
    slider.scrollTo({ left: targetLeft, behavior: 'smooth' });

    clearTimeout(slider._snapTimer);
    slider._snapTimer = setTimeout(function() {
      slider.classList.remove('is-animating');
      slider.scrollLeft = clamped * slider.clientWidth;
    }, 380);
  }

  if (typeof window.navigateViewport === 'undefined') {
    window.navigateViewport = function(containerId, direction) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const current = parseInt(container.dataset.currentIndex || '0', 10);
      animateToSlide(containerId, current + direction);
    };

    window.jumpToSlide = function(containerId, index) {
      animateToSlide(containerId, index);
    };
  }

  const host = document.getElementById('{{ viewport_id }}');
  if (host) {
    const slider = host.querySelector('.viewport-slider');
    if (slider) {
      slider.addEventListener('scroll', function() {
        if (slider.classList.contains('is-animating')) return;
        const width = slider.clientWidth;
        if (width > 0) {
          const activeIdx = Math.round(slider.scrollLeft / width);
          syncViewportDots(host, activeIdx);
        }
      }, { passive: true });
    }
  }
})();
</script>