<!-- File: _includes/components/widget/image-viewport-box.njk -->
{% set demo_images = [
  { url: "https://assets.myseattlesearch.com/neighborhood/hero-pools/snohomish/1.webp", alt: "Edmonds Waterfront and Olympic Mountains" },
  { url: "https://assets.myseattlesearch.com/neighborhood/hero-pools/snohomish/3.webp", alt: "Downtown Edmonds 5th and Main" },
  { url: "https://assets.myseattlesearch.com/neighborhood/hero-pools/snohomish/5.webp", alt: "Washington State Ferry Arriving at Edmonds" }
] %}
{% set gallery_images = viewport_images | default(demo_images) %}
{% set viewport_id = viewport_box_id | default("image-viewport-" + (range(100, 999) | random)) %}

{# Outer Bezel / Housing Frame: Enforces 1:1 Square & Uniform Bezel #}
<div id="{{ viewport_id }}" 
     class="widget-card image-viewport-box-container" 
     style="position: relative; width: 100%; aspect-ratio: 1 / 1; border-radius: var(--border-radius-squircle); background: #0F172A; border: 1px solid var(--color-border-light, #E5E5EA); box-shadow: 0 10px 30px rgba(0,0,0,0.14); box-sizing: border-box; padding: clamp(16px, 2.5vw, 24px); display: flex; flex-direction: column;">
  
  {# Inner Screen Viewport: Contained Screen with Rounded Corners #}
  <div class="viewport-screen-frame" 
       style="position: relative; width: 100%; height: 100%; border-radius: 16px; overflow: hidden; background: #000000; box-shadow: inset 0 0 20px rgba(0,0,0,0.5);">
    
    {# Horizontal Swipe Slider #}
    <div class="viewport-slider" 
         tabindex="0"
         style="display: flex; width: 100%; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none;">
      
      {% for img in gallery_images %}
        <div class="viewport-slide" 
             style="position: relative; flex: 0 0 100%; width: 100%; height: 100%; scroll-snap-align: start; overflow: hidden; display: flex; align-items: center; justify-content: center;">
          
          {# Ambient Color-Matched Edge Frost Projection (Covers 100% of frame for both horizontal & vertical orientations) #}
          <div style="position: absolute; inset: -24px; background-image: url('{{ img.url }}'); background-size: cover; background-position: center; filter: blur(32px) brightness(0.65); transform: scale(1.15); pointer-events: none;" aria-hidden="true"></div>
          <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.4) 100%); pointer-events: none;" aria-hidden="true"></div>
          
          {# Centered Primary Image (object-fit: contain guarantees no distortion on portrait or landscape) #}
          <img src="{{ img.url }}" 
               alt="{{ img.alt }}" 
               loading="{% if loop.first %}eager{% else %}lazy{% endif %}" 
               decoding="async"
               style="position: relative; z-index: 2; max-width: 100%; max-height: 100%; object-fit: contain; display: block; border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.35);">
        </div>
      {% endfor %}
    </div>

    {# Desktop Hover Navigation Arrows #}
    <button type="button" 
            class="viewport-nav-btn prev" 
            aria-label="Previous image"
            onclick="navigateViewport('{{ viewport_id }}', -1)" 
            style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); z-index: 10; width: 38px; height: 38px; border-radius: 50%; background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.9); display: flex; align-items: center; justify-content: center; color: var(--color-primary-default, #1C1C1E); font-size: 1.1rem; font-weight: 800; cursor: pointer; opacity: 0; transition: opacity 0.2s ease, transform 0.15s ease;">
      ‹
    </button>
    
    <button type="button" 
            class="viewport-nav-btn next" 
            aria-label="Next image"
            onclick="navigateViewport('{{ viewport_id }}', 1)" 
            style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); z-index: 10; width: 38px; height: 38px; border-radius: 50%; background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.9); display: flex; align-items: center; justify-content: center; color: var(--color-primary-default, #1C1C1E); font-size: 1.1rem; font-weight: 800; cursor: pointer; opacity: 0; transition: opacity 0.2s ease, transform 0.15s ease;">
      ›
    </button>

    {# Frosted Glass Dot Pagination #}
    <div class="viewport-dots" 
         style="position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 10; display: flex; align-items: center; gap: 8px; padding: 6px 12px; background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-radius: 999px;">
      {% for img in gallery_images %}
        <button type="button" 
                onclick="jumpToSlide('{{ viewport_id }}', {{ loop.index0 }})" 
                aria-label="Go to slide {{ loop.index }}"
                style="width: 8px; height: 8px; border-radius: 50%; border: none; padding: 0; cursor: pointer; transition: all 0.25s ease; {% if loop.first %}background: #FFFFFF; transform: scale(1.25); box-shadow: 0 0 8px rgba(255,255,255,0.8);{% else %}background: rgba(255, 255, 255, 0.45);{% endif %}"></button>
      {% endfor %}
    </div>

  </div>

  <style>
    #{{ viewport_id }}:hover .viewport-nav-btn { opacity: 1 !important; }
    #{{ viewport_id }} .viewport-slider::-webkit-scrollbar { display: none; }
  </style>

  <script>
    if (typeof navigateViewport === 'undefined') {
      function navigateViewport(containerId, direction) {
        const c = document.getElementById(containerId);
        if (!c) return;
        const slider = c.querySelector('.viewport-slider');
        const slideWidth = slider.clientWidth;
        slider.scrollBy({ left: direction * slideWidth, behavior: 'smooth' });
      }
      function jumpToSlide(containerId, index) {
        const c = document.getElementById(containerId);
        if (!c) return;
        const slider = c.querySelector('.viewport-slider');
        const slideWidth = slider.clientWidth;
        slider.scrollTo({ left: index * slideWidth, behavior: 'smooth' });
      }
    }
  </script>
</div>