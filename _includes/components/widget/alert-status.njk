{% set resolved_slug = city_slug if city_slug else (city.City | slugify if (city and city.City) else '') %}
{% set is_city_context = resolved_slug and resolved_slug != 'region' and active_alerts and active_alerts.neighborhoods and active_alerts.neighborhoods[resolved_slug] %}
{% set city_alerts = active_alerts.neighborhoods[resolved_slug] if is_city_context else null %}

{% set p_alert = false %}
{% set q_alert = false %}
{% set w_alert = false %}
{% set wx_alert = false %}
{% set s_level = 'optimal' %}
{% set alert_count = 0 %}
{% set target_url = '/neighborhood/' ~ resolved_slug ~ '/emergency-safety/' if is_city_context else '/region/emergency-safety/' %}

{% if is_city_context %}
  {% set p_alert = city_alerts.power_outage | default(false) %}
  {% set q_alert = city_alerts.earthquake | default(false) %}
  {% set w_alert = city_alerts.wildfire | default(false) %}
  {% set wx_alert = city_alerts.weather | default(false) %}
  {% set s_level = city_alerts.school_level | default('optimal') %}
  {% set alert_count = (city_alerts.school_count | default(0)) + (city_alerts.weather_count | default(0)) + (city_alerts.power_count | default(0)) + (city_alerts.earthquake_count | default(0)) + (city_alerts.wildfire_count | default(0)) %}
{% elif active_alerts and active_alerts.neighborhoods %}
  {% set g = active_alerts.global if active_alerts.global else {} %}
  {% set alert_count = g.active_alert_count | default(0) %}
  {% set p_alert = g.critical_grid_failure | default(false) %}
  {% set q_alert = g.seismic_emergency | default(false) %}
  {% set wx_alert = g.weather_emergency | default(false) %}
  {% if g.school_emergency %}
    {% set s_level = 'red' %}
  {% elif g.school_advisory %}
    {% set s_level = 'amber' %}
  {% endif %}

  {% for slug, n_obj in active_alerts.neighborhoods %}
    {% if n_obj.power_outage %}{% set p_alert = true %}{% endif %}
    {% if n_obj.earthquake %}{% set q_alert = true %}{% endif %}
    {% if n_obj.wildfire %}{% set w_alert = true %}{% endif %}
    {% if n_obj.weather %}{% set wx_alert = true %}{% endif %}
    {% if n_obj.school_level == 'red' %}
      {% set s_level = 'red' %}
    {% elif n_obj.school_level == 'amber' and s_level != 'red' %}
      {% set s_level = 'amber' %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set has_red = p_alert or q_alert or w_alert or wx_alert or (s_level == 'red') %}
{% set has_amber = (not has_red) and (s_level == 'amber') %}
{% set wrapper_state = 'is-alert' if has_red else ('is-amber' if has_amber else 'is-optimal') %}
{% set trigger_text = (alert_count ~ ' Active Alert' ~ ('' if alert_count == 1 else 's')) if has_red else ('Active Advisory' if has_amber else 'No Active Alerts') %}
{% set school_item_state = 'is-alert' if s_level == 'red' else ('is-amber' if s_level == 'amber' else 'is-optimal') %}

<div class="alert-center-wrapper {{ wrapper_state }}" id="alertCenterWrapper">
  <button type="button"
          class="alert-center-trigger"
          id="alertCenterTrigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Alert Center: {{ trigger_text }}">
    <span class="alert-led-dot" id="alertTriggerDot"></span>
    <span class="alert-text-stack">
      <span class="alert-label-top">Alert Center</span>
      <span class="alert-status-bottom" id="alertTriggerLabel">{{ trigger_text }}</span>
    </span>
  </button>

  <div class="alert-dropdown-panel" id="alertDropdownPanel" role="region" aria-label="Emergency Status Categories">
    <div class="alert-categories-list">

      {# 1. School Closures & Delays #}
      <a href="{{ target_url }}#schools" class="alert-category-item {{ school_item_state }}" id="catItemSchools">
        <span class="alert-category-dot" id="catDotSchools"></span>
        <div class="alert-category-content">
          <span class="alert-category-title">School Closures</span>
          <span class="alert-category-status" id="catStatusSchools">
            {% if s_level != 'optimal' %}Active School Alert{% else %}No Active School Alerts{% endif %}
          </span>
        </div>
        <span class="alert-category-action" aria-hidden="true">&rarr;</span>
      </a>

      {# 2. Severe Weather #}
      <a href="{{ target_url }}#weather" class="alert-category-item {{ 'is-alert' if wx_alert else 'is-optimal' }}" id="catItemWeather">
        <span class="alert-category-dot" id="catDotWeather"></span>
        <div class="alert-category-content">
          <span class="alert-category-title">Severe Weather</span>
          <span class="alert-category-status" id="catStatusWeather">
            {% if wx_alert %}Active Severe Weather Alert{% else %}No Active Severe Weather Alerts{% endif %}
          </span>
        </div>
        <span class="alert-category-action" aria-hidden="true">&rarr;</span>
      </a>

      {# 3. Power Outages #}
      <a href="{{ target_url }}#power" class="alert-category-item {{ 'is-alert' if p_alert else 'is-optimal' }}" id="catItemOutages">
        <span class="alert-category-dot" id="catDotOutages"></span>
        <div class="alert-category-content">
          <span class="alert-category-title">Power Outages</span>
          <span class="alert-category-status" id="catStatusOutages">
            {% if p_alert %}Active Power Outage Alert{% else %}No Active Power Outage Alerts{% endif %}
          </span>
        </div>
        <span class="alert-category-action" aria-hidden="true">&rarr;</span>
      </a>

      {# 4. Earthquakes #}
      <a href="{{ target_url }}#earthquakes" class="alert-category-item {{ 'is-alert' if q_alert else 'is-optimal' }}" id="catItemQuakes">
        <span class="alert-category-dot" id="catDotQuakes"></span>
        <div class="alert-category-content">
          <span class="alert-category-title">Earthquakes</span>
          <span class="alert-category-status" id="catStatusQuakes">
            {% if q_alert %}Active Earthquake Alert{% else %}No Active Earthquake Alerts{% endif %}
          </span>
        </div>
        <span class="alert-category-action" aria-hidden="true">&rarr;</span>
      </a>

      {# 5. Wildfires #}
      <a href="{{ target_url }}#wildfires" class="alert-category-item {{ 'is-alert' if w_alert else 'is-optimal' }}" id="catItemWildfires">
        <span class="alert-category-dot" id="catDotWildfires"></span>
        <div class="alert-category-content">
          <span class="alert-category-title">Wildfires</span>
          <span class="alert-category-status" id="catStatusWildfires">
            {% if w_alert %}Active Wildfire Alert{% else %}No Active Wildfire Alerts{% endif %}
          </span>
        </div>
        <span class="alert-category-action" aria-hidden="true">&rarr;</span>
      </a>

      {# 6. Elections (Unconfigured Muted Gray) #}
      <div class="alert-category-item is-unconfigured">
        <span class="alert-category-dot"></span>
        <div class="alert-category-content">
          <span class="alert-category-title">Elections</span>
          <span class="alert-category-status">Election Alerts Not Active</span>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    const wrapper = document.getElementById('alertCenterWrapper');
    const trigger = document.getElementById('alertCenterTrigger');
    const panel = document.getElementById('alertDropdownPanel');
    if (!wrapper || !trigger || !panel) return;

    trigger.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = panel.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    document.addEventListener('click', function(e) {
      if (!wrapper.contains(e.target)) {
        panel.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        panel.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      }
    });
  })();
</script>