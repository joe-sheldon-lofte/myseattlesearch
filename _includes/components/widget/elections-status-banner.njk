<!-- File: _includes/components/widget/elections-status-banner.njk -->
{% set is_active = election_cycle_active | default(true) %}
{% set election_name = election_title | default("Nov 3 General Election") %}
{% set next_date = election_next_date | default("November 3, 2026") %}

<div class="widget-card election-status-banner-card" 
     role="region" 
     aria-label="Civic Election Cycle Status"
     style="width: 100%; border-radius: var(--border-radius-squircle); padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; {% if is_active %}background: var(--color-secondary-default); color: #FFFFFF; border: 1px solid var(--color-secondary-default);{% else %}background: var(--color-surface-gray); color: var(--color-primary-default); border: 1px solid var(--color-border-light);{% endif %} transition: all 0.2s ease;">
  
  <div style="display: flex; align-items: center; gap: 0.85rem;">
    {# Ballot Box SVG Icon #}
    <div style="width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; {% if is_active %}background: rgba(255, 255, 255, 0.18); color: #FFFFFF;{% else %}background: var(--color-background-universal); border: 1px solid var(--color-border-light); color: var(--color-secondary-default);{% endif %}" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 12h.01M6 12h.01M12 12h.01M12 2v4M4.93 4.93l2.83 2.83M19.07 4.93l-2.83 2.83"/>
        <rect x="2" y="8" width="20" height="14" rx="2"/>
        <path d="M6 8V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3"/>
      </svg>
    </div>

    <div>
      <span class="text-overline" style="font-size: 0.65rem; letter-spacing: 0.08em; {% if is_active %}color: rgba(255, 255, 255, 0.8);{% else %}color: #86868b;{% endif %}">
        WASHINGTON STATE CIVIC VOTER GUIDE
      </span>
      <h3 style="font-size: 1.1rem; font-weight: 800; margin: 0.15rem 0 0 0; line-height: 1.2;">
        {% if is_active %}
          Upcoming Election: {{ election_name }}
        {% else %}
          No Active Election Cycle
        {% endif %}
      </h3>
      <div style="font-size: 0.75rem; margin-top: 0.15rem; {% if is_active %}color: rgba(255, 255, 255, 0.9);{% else %}color: #86868b;{% endif %}">
        {% if is_active %}
          Ballot drop boxes close strictly at 8:00 PM on Election Night ({{ next_date }}).
        {% else %}
          Next scheduled election: <strong>{{ next_date }}</strong>
        {% endif %}
      </div>
    </div>
  </div>

  {# Action Button #}
  <div>
    {% if is_active %}
      <a href="{{ election_info_url | default('#election-guide') }}" 
         style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 1rem; background: #FFFFFF; color: var(--color-secondary-default); border-radius: 999px; font-size: 0.8rem; font-weight: 700; text-decoration: none; box-shadow: 0 2px 6px rgba(0,0,0,0.1);">
        <span>View Voter Guide</span>
        <span aria-hidden="true">→</span>
      </a>
    {% else %}
      <a href="https://voter.votewa.gov" 
         target="_blank" 
         rel="noopener noreferrer" 
         style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 1rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); color: var(--color-primary-default); border-radius: 999px; font-size: 0.8rem; font-weight: 700; text-decoration: none;">
        <span>Verify Registration (VoteWA)</span>
        <span aria-hidden="true">↗</span>
      </a>
    {% endif %}
  </div>

</div>