<!-- File: _includes/components/widget/elections-status-banner.njk -->
{# 
  COMPONENT: Civic Election Status Alert Banner (widget.elections.status.banner)
  CONTRACT:
    - election_cycle_active / election.active: Boolean [Required]
    - election_name / election_title / election.ElectionName: String [Optional]
    - election_next_date / next_date / election.ElectionDate: String [Optional]
    - election_info_url / election.url: String [Optional, defaults to "#election-guide"]
    - election_verify_url: String [Optional, defaults to "https://voter.votewa.gov"]
#}

{% set is_active = election_cycle_active if election_cycle_active is defined else (election.active if (election and election.active is defined) else false) %}
{% set name = election_name or election_title or (election.ElectionName if election else '') %}
{% set target_date = election_next_date or next_date or (election.ElectionDate if election else '') %}
{% set guide_url = election_info_url or (election.url if election else '') or "#election-guide" %}
{% set verify_url = election_verify_url or "https://voter.votewa.gov" %}

{% if name or target_date %}
<div class="widget-card election-status-banner-card {% if is_active %}banner-state-active{% else %}banner-state-inactive{% endif %}"
     role="region" 
     aria-label="Civic Election Cycle Status">
  
  <div class="election-banner-lead">
    {# Ballot Box SVG Icon Badge #}
    <div class="election-banner-icon-badge" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 12h.01M6 12h.01M12 12h.01M12 2v4M4.93 4.93l2.83 2.83M19.07 4.93l-2.83 2.83"/>
        <rect x="2" y="8" width="20" height="14" rx="2"/>
        <path d="M6 8V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3"/>
      </svg>
    </div>

    {# Headline and Timeline Stack #}
    <div class="election-banner-content">
      <span class="text-overline election-banner-overline">
        WASHINGTON STATE VOTER GUIDE
      </span>
      <h3 class="election-banner-title">
        {% if is_active %}
          Upcoming Election: {{ name }}
        {% else %}
          No Active Election Cycle
        {% endif %}
      </h3>
      <div class="election-banner-subtext">
        {% if is_active %}
          Ballot drop boxes close strictly at 8:00 PM on Election Night ({{ target_date }}).
        {% else %}
          Next scheduled election: <span class="election-banner-highlight">{{ target_date }}</span>
        {% endif %}
      </div>
    </div>
  </div>

  {# Action Button Trigger #}
  <div class="election-banner-action">
    {% if is_active %}
      <a href="{{ guide_url }}" class="btn-banner-action-active">
        <span>View Voter Guide</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    {% else %}
      <a href="{{ verify_url }}" target="_blank" rel="noopener noreferrer" class="btn-banner-action-inactive">
        <span>Verify Registration (VoteWA)</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    {% endif %}
  </div>

</div>
{% endif %}