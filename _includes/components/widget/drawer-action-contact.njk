<!-- File: _includes/components/widget/drawer-action-contact.njk -->
{# 
  COMPONENT: Minimalist Mobile Contact Sheet (widget.drawer.action.contact)
  BEHAVIOR: Triggered by the "Contact" pill in the floating bottom action tray.
  CHANNELS: Hardcoded direct to Joe Sheldon (SMS, /chat/, and Voice) with pure SVG iconography.
#}

<div id="drawer-action-contact" 
     class="action-drawer-bottom contact-drawer" 
     role="dialog" 
     aria-modal="true" 
     aria-label="Contact Options">
  
  {# Backdrop Scrim #}
  <div class="drawer-scrim" onclick="closeContactDrawer()"></div>

  {# Liquid Glass Bottom Sheet (Minimalist Chassis) #}
  <div class="drawer-panel liquid-glass-surface drawer-panel-minimal">
    
    {# Sheet Grab Handle #}
    <div class="drawer-grab-handle" aria-hidden="true"></div>

    {# Minimalist Contact Action Cluster #}
    <div class="drawer-actions-stack">
      
      {# 1. Text (Primary: Alpine Blue) #}
      <a href="sms:+12066577493" class="btn-contact-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <span>Text</span>
      </a>

      {# 2. Chat (Primary: Alpine Blue) #}
      <a href="/chat/" class="btn-contact-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <span>Chat</span>
      </a>

      {# 3. Call (Secondary: White with Alpine Blue Text) #}
      <a href="tel:2066577493" class="btn-contact-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>Call</span>
      </a>
      
    </div>

  </div>

  <script>
    function openContactDrawer() {
      const drawer = document.getElementById('drawer-action-contact');
      if (drawer) drawer.classList.add('is-open');
    }
    function closeContactDrawer() {
      const drawer = document.getElementById('drawer-action-contact');
      if (drawer) drawer.classList.remove('is-open');
    }
  </script>

</div>