<!-- File: _includes/components/widget/municipal-surveillance-profile.njk -->
{% set demo_devices = [
  { label: "Automated License Plate Readers (ALPR)", count: "12 units", detail: "Flock Safety / Fixed Arterials" },
  { label: "Municipal Traffic Management Cameras", count: "28 feeds", detail: "WSDOT & City Traffic Operations" },
  { label: "Civic Parks & Facility CCTV Cameras", count: "18 locations", detail: "Public Works & Ferry Intermodal" },
  { label: "Integrated Law Enforcement Platforms", count: "3 systems", detail: "Axon Body 3 / CAD Interop / GeoShield" }
] %}

{% set surv_score = surveillance_score | default(54) %}
{% set surv_devices = surveillance_devices | default(demo_devices) %}

{# Score color coding: 0-33 Green/Minimal, 34-66 Yellow/Moderate, 67-100 Red/Dense #}
{% set score_color = "#10B981" %}
{% set score_rating = "Minimal Surveillance" %}
{% if surv_score >= 67 %}
  {% set score_color = "var(--color-tertiary-default)" %}
  {% set score_rating = "High Density Surveillance" %}
{% elif surv_score >= 34 %}
  {% set score_color = "#D97706" %}
  {% set score_rating = "Moderate Surveillance" %}
{% endif %}

<div class="widget-card municipal-surveillance-card" style="padding: 1.5rem; width: 100%; display: flex; flex-direction: column; justify-content: space-between; min-height: 240px;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline">CIVIC TRANSPARENCY & DATA INFRASTRUCTURE</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">Municipal Surveillance Profile</h3>
      <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.15rem;">
        Agency: <strong style="color: var(--color-primary-default);">{{ surveillance_agency | default("Edmonds Police Department") }}</strong>
      </div>
    </div>
    
    {# Embedded Custom Score Indicator #}
    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem;">
      <div style="width: 48px; height: 48px; border-radius: var(--border-radius-squircle); background: {{ score_color }}; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <span style="font-size: 1.35rem; font-weight: 800; color: #FFFFFF; line-height: 1;">
          {{ surv_score }}
        </span>
      </div>
      <span class="text-overline" style="font-size: 0.6rem; color: {{ score_color }}; text-align: right;">
        {{ score_rating }}
      </span>
    </div>
  </div>

  {# Device Counts 4-Row List #}
  <div style="display: flex; flex-direction: column; gap: 0.65rem;">
    {% for dev in surv_devices %}
      <div style="display: flex; justify-content: space-between; align-items: center; background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 0.65rem 0.9rem;">
        <div>
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary-default);">
            {{ dev.label }}
          </div>
          <div class="text-body-secondary" style="font-size: 0.7rem;">
            {{ dev.detail }}
          </div>
        </div>
        <div style="font-size: 0.85rem; font-weight: 800; font-family: monospace; color: var(--color-secondary-default); white-space: nowrap; margin-left: 0.75rem;">
          {{ dev.count }}
        </div>
      </div>
    {% endfor %}
  </div>

  {# Footer #}
  <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.75rem; margin-top: 1rem;" class="text-body-secondary">
    <span>Formula: <code>24.16 * LN(pop_density + 1) + 5.82</code></span>
    <span>Source: Municipal Public Records & SPD/SCSO</span>
  </div>

</div>