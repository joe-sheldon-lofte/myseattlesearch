<!-- File: _includes/components/widget/municipal-surveillance.profile.njk -->
{% set city = surveillance_city_name | default("Edmonds") %}
{% set surv_score = surveillance_index_score | default(54) %}

<div class="widget-card municipal-surveillance-profile-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row per edit: "MUNICIPAL CITIZEN MONITORING & INFRASTRUCTURE" #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        MUNICIPAL CITIZEN MONITORING &amp; INFRASTRUCTURE
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ city }} Surveillance Profile
      </h3>
    </div>
  </div>

  {# Embed Custom Surveillance Score Card #}
  <div>
    {% set score_surv_val = surv_score %}
    {% include "components/score/custom-surveillance.njk" ignore missing %}
  </div>

</div>