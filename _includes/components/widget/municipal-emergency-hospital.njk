<!-- File: _includes/components/widget/municipal-emergency-hospital.njk -->
{# 
  COMPONENT: Emergency Medical Care & Local Hospital (widget.municipal.emergency.hospital)
  CONTRACT:
    - emergency_hospital_name / hospital_name / neighborhood.hospital_name: String [Required]
    - emergency_hospital_address / hospital_address / neighborhood.hospital_address: String [Optional]
    - emergency_hospital_distance / hospital_dist: String [Optional, e.g. "1.8 Miles"]
    - emergency_hospital_drive_time / hospital_time: String [Optional, e.g. "5 min drive"]
    - emergency_hospital_badge: String [Optional, defaults to "24/7 Full ER"]
    - emergency_hospital_phone: String [Optional]
    - emergency_hospital_tel: String [Optional]
#}

{% set h_name = emergency_hospital_name or hospital_name or (neighborhood.hospital_name if neighborhood else '') %}
{% set h_address = emergency_hospital_address or hospital_address or (neighborhood.hospital_address if neighborhood else '') %}
{% set h_dist = emergency_hospital_distance or hospital_dist %}
{% set h_time = emergency_hospital_drive_time or hospital_time %}
{% set h_badge = emergency_hospital_badge or "24/7 Full ER" %}

{% if h_name %}
<div class="widget-card municipal-emergency-hospital-card">
  
  {# Header Row: Medical Overline, Title & 24/7 ER Status Badge #}
  <div class="card-header-split hospital-header-strip">
    <div>
      <span class="text-overline text-accent-alpine">
        EMERGENCY MEDICAL CARE
      </span>
      <h3 class="text-widget-title hospital-headline">
        Local Hospital
      </h3>
    </div>

    {% if h_badge %}
      <div class="badge-status-emerald">
        {{ h_badge }}
      </div>
    {% endif %}
  </div>

  {# Hospital Details & Graphic Icon Frame #}
  <div class="hospital-details-row">
    <div class="hospital-icon-frame" aria-hidden="true">
      {% include "components/graphic/map-emergency-hospital.njk" ignore missing %}
    </div>

    <div class="hospital-info-stack">
      <h4 class="hospital-name">
        {{ h_name }}
      </h4>
      
      {% if h_address %}
        <div class="text-body-secondary hospital-address">
          {{ h_address }}
        </div>
      {% endif %}

      {% if h_dist or h_time %}
        <div class="hospital-metrics">
          {% if h_dist %}{{ h_dist }}{% endif %}
          {% if h_dist and h_time %} • {% endif %}
          {% if h_time %}{{ h_time }}{% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {# Footer: 911 Emergency Protocol Notice #}
  <div class="card-footer-strip hospital-footer-strip">
    <div class="text-body-secondary hospital-emergency-callout">
      In you are experiencing an emergency, call <span class="hospital-emergency-numeral">911</span>.
    </div>
  </div>

</div>
{% endif %}