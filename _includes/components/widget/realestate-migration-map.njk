<!-- File: _includes/components/widget/realestate-migration-map.njk -->
{% set migration_title = migration_map_title | default("Seattle Area Migration Map") %}
{% set migration_overline = migration_map_overline | default("SEATTLE AREA TOP RELOCATION SOURCES AND DESTINATIONS") %}

{% set top_inflows = [
  { city: "Los Angeles, CA", share: "18.4%", net: "+3,420", x: 65, y: 155 },
  { city: "San Francisco, CA", share: "14.2%", net: "+2,640", x: 50, y: 120 },
  { city: "New York, NY", share: "8.6%", net: "+1,590", x: 250, y: 75 },
  { city: "Chicago, IL", share: "6.8%", net: "+1,260", x: 185, y: 80 },
  { city: "San Diego, CA", share: "5.4%", net: "+995", x: 75, y: 170 }
] %}

{% set top_outflows = [
  { city: "Phoenix, AZ", share: "16.8%", net: "-3,150", x: 95, y: 145 },
  { city: "Portland, OR", share: "12.5%", net: "-2,340", x: 45, y: 55 },
  { city: "Dallas, TX", share: "9.2%", net: "-1,720", x: 155, y: 150 },
  { city: "Spokane, WA", share: "7.4%", net: "-1,380", x: 70, y: 35 },
  { city: "Las Vegas, NV", share: "6.1%", net: "-1,140", x: 80, y: 120 }
] %}

<div class="widget-card realestate-migration-map-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
        {{ migration_overline }}
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.2rem;">
        {{ migration_title }}
      </h3>
    </div>

    {# Legend #}
    <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.75rem; font-weight: 700;">
      <span style="display: flex; align-items: center; gap: 0.35rem; color: var(--color-secondary-default);"><span style="width: 10px; height: 10px; border-radius: 50%; background: var(--color-secondary-default);"></span> Inflow (Moving In)</span>
      <span style="display: flex; align-items: center; gap: 0.35rem; color: #D97706;"><span style="width: 10px; height: 10px; border-radius: 50%; background: #D97706;"></span> Outflow (Relocating Out)</span>
    </div>
  </div>

  {# Conceptual US Vector Map with Seattle Label Above Pin & Labeled Points #}
  <div style="position: relative; width: 100%; aspect-ratio: 16 / 9; max-height: 340px; background: var(--color-surface-gray); border-radius: 12px; overflow: hidden; border: 1px solid var(--color-border-light);">
    <svg viewBox="0 0 320 200" width="100%" height="100%" style="display: block;">
      
      {# US Continental Outline #}
      <path d="M 40,25 L 85,25 L 120,30 L 170,25 L 230,35 L 265,30 L 295,45 L 305,75 L 280,105 L 285,150 L 255,185 L 225,175 L 175,175 L 140,195 L 100,165 L 65,160 L 35,115 L 35,45 Z" 
            fill="#E2E8F0" stroke="#CBD5E1" stroke-width="1.5" opacity="0.6"/>

      {# Outflow Vectors (Orange) from Seattle (45, 30) #}
      <path d="M 45,30 Q 75,85 95,145" fill="none" stroke="#D97706" stroke-width="1.75" stroke-dasharray="3,3" opacity="0.8"/>
      <path d="M 45,30 L 45,55" fill="none" stroke="#D97706" stroke-width="2" opacity="0.85"/>
      <path d="M 45,30 Q 110,80 155,150" fill="none" stroke="#D97706" stroke-width="1.75" stroke-dasharray="3,3" opacity="0.8"/>
      <path d="M 45,30 L 70,35" fill="none" stroke="#D97706" stroke-width="2" opacity="0.85"/>

      {# Inflow Vectors (Blue) into Seattle (45, 30) #}
      <path d="M 50,120 Q 40,75 45,30" fill="none" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="2" opacity="0.85"/>
      <path d="M 65,155 Q 50,90 45,30" fill="none" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="2" opacity="0.85"/>
      <path d="M 185,80 Q 110,45 45,30" fill="none" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="1.75" stroke-dasharray="3,3" opacity="0.8"/>
      <path d="M 250,75 Q 140,40 45,30" fill="none" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="1.75" stroke-dasharray="3,3" opacity="0.75"/>

      {# Labeled City Marker Points #}
      <circle cx="50" cy="120" r="2.5" fill="var(--color-secondary-default, #1E4D6B)"/>
      <text x="56" y="122" font-size="6.5" font-weight="600" fill="#475569">Bay Area</text>

      <circle cx="65" cy="155" r="2.5" fill="var(--color-secondary-default, #1E4D6B)"/>
      <text x="71" y="157" font-size="6.5" font-weight="600" fill="#475569">Los Angeles</text>

      <circle cx="95" cy="145" r="2.5" fill="#D97706"/>
      <text x="101" y="147" font-size="6.5" font-weight="600" fill="#475569">Phoenix</text>

      <circle cx="45" cy="55" r="2.5" fill="#D97706"/>
      <text x="51" y="57" font-size="6.5" font-weight="600" fill="#475569">Portland</text>

      <circle cx="70" cy="35" r="2.5" fill="#D97706"/>
      <text x="76" y="37" font-size="6.5" font-weight="600" fill="#475569">Spokane</text>

      <circle cx="155" cy="150" r="2.5" fill="#D97706"/>
      <text x="161" y="152" font-size="6.5" font-weight="600" fill="#475569">Dallas</text>

      <circle cx="185" cy="80" r="2.5" fill="var(--color-secondary-default, #1E4D6B)"/>
      <text x="191" y="82" font-size="6.5" font-weight="600" fill="#475569">Chicago</text>

      <circle cx="250" cy="75" r="2.5" fill="var(--color-secondary-default, #1E4D6B)"/>
      <text x="256" y="77" font-size="6.5" font-weight="600" fill="#475569">New York</text>

      {# Seattle Hub Pin - Label ABOVE Pin per Edit #}
      <text x="45" y="19" text-anchor="middle" font-size="8.5" font-weight="800" fill="var(--color-primary-default, #1C1C1E)">Seattle</text>
      <circle cx="45" cy="30" r="4.5" fill="var(--color-primary-default, #1C1C1E)"/>
      <circle cx="45" cy="30" r="2" fill="#FFFFFF"/>
    </svg>
  </div>

  {# Tabular Breakdown #}
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
    <div style="background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 1rem;">
      <div style="font-size: 0.75rem; font-weight: 800; color: var(--color-secondary-default); margin-bottom: 0.5rem;">
        Top Inflow Origins (Moving In)
      </div>
      <table style="width: 100%; border-collapse: collapse; font-size: 0.75rem;">
        <tbody>
          {% for r in top_inflows %}
            <tr style="border-bottom: 1px solid var(--color-border-light);">
              <td style="padding: 0.35rem 0; font-weight: 600; color: var(--color-primary-default);">{{ r.city }}</td>
              <td style="padding: 0.35rem 0; text-align: right; font-family: monospace; font-weight: 700; color: var(--color-secondary-default);">{{ r.share }}</td>
              <td style="padding: 0.35rem 0; text-align: right; font-family: monospace; color: #86868b;">{{ r.net }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div style="background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 1rem;">
      <div style="font-size: 0.75rem; font-weight: 800; color: #D97706; margin-bottom: 0.5rem;">
        Top Outflow Destinations (Relocating Out)
      </div>
      <table style="width: 100%; border-collapse: collapse; font-size: 0.75rem;">
        <tbody>
          {% for r in top_outflows %}
            <tr style="border-bottom: 1px solid var(--color-border-light);">
              <td style="padding: 0.35rem 0; font-weight: 600; color: var(--color-primary-default);">{{ r.city }}</td>
              <td style="padding: 0.35rem 0; text-align: right; font-family: monospace; font-weight: 700; color: #D97706;">{{ r.share }}</td>
              <td style="padding: 0.35rem 0; text-align: right; font-family: monospace; color: #86868b;">{{ r.net }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {# Footer per Edit #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.65rem; font-size: 0.75rem;" class="text-body-secondary">
    <span>Data source: Redfin Data Center</span>
    <span>Updated Quarterly</span>
  </div>

</div>