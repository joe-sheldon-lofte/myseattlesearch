{# 
  COMPONENT: Regional Migration Dynamics & Relocation Trajectories (widget.realestate.migration.map)
  PURPOSE: Visualizes demographic capital inflow and outflow across metropolitan source corridors.
  CONTRACT:
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
    - migration_map_title / migration_title: String [Optional]
    - migration_map_overline / migration_overline: String [Optional]
    - migration_inflows / top_inflows: Array of Objects [Required]
      Each inflow expects: { city, share, net }
    - migration_outflows / top_outflows: Array of Objects [Required]
      Each outflow expects: { city, share, net }
    - migration_source_label: String [Optional, defaults to "Data source: Redfin Data Center"]
    - migration_update_cadence: String [Optional, defaults to "Updated Quarterly"]
#}

{% set active_neighborhood = active_neighborhood or (neighborhood.name if neighborhood else '') or (city.City if city else '') %}
{% set default_title = (active_neighborhood ~ " Area Migration Map") if active_neighborhood else "Puget Sound Migration Map" %}
{% set card_title = migration_map_title or migration_title or default_title %}
{% set card_overline = migration_map_overline or migration_overline or "REGIONAL RELOCATION SOURCES AND DESTINATIONS" %}

{% set inflows = migration_inflows or top_inflows %}
{% set outflows = migration_outflows or top_outflows %}
{% set source_text = migration_source_label or "Data source: Redfin Data Center" %}
{% set cadence_text = migration_update_cadence or "Updated Quarterly" %}

{% if inflows and inflows.length > 0 %}
<section class="widget-card realestate-migration-map-card" aria-label="{{ card_title }}">
  
  {# Header Row & Inflow/Outflow Legend #}
  <header class="migration-header-row">
    <div class="migration-title-stack">
      <span class="text-overline text-accent-alpine">
        {{ card_overline }}
      </span>
      <h3 class="text-widget-title migration-card-title">
        {{ card_title }}
      </h3>
    </div>

    <div class="migration-legend-cluster" aria-hidden="true">
      <span class="migration-legend-item legend-inflow">
        <span class="migration-legend-dot dot-inflow"></span> Inflow (Moving In)
      </span>
      <span class="migration-legend-item legend-outflow">
        <span class="migration-legend-dot dot-outflow"></span> Outflow (Relocating Out)
      </span>
    </div>
  </header>

  {# Conceptual US Vector Map Stage with Seattle Hub Pin (Label Locked Above Pin) #}
  <div class="migration-map-stage" aria-hidden="true">
    <svg viewBox="0 0 320 200" class="migration-svg-stage">
      
      {# US Continental Outline Baseplate #}
      <path d="M 40,25 L 85,25 L 120,30 L 170,25 L 230,35 L 265,30 L 295,45 L 305,75 L 280,105 L 285,150 L 255,185 L 225,175 L 175,175 L 140,195 L 100,165 L 65,160 L 35,115 L 35,45 Z" 
            class="migration-us-baseplate" />

      {# Outflow Vectors (Cedar Amber) originating from Puget Sound Hub (45, 30) #}
      <path d="M 45,30 Q 75,85 95,145" class="vector-arc-outflow-dashed" />
      <path d="M 45,30 L 45,55" class="vector-arc-outflow-solid" />
      <path d="M 45,30 Q 110,80 155,150" class="vector-arc-outflow-dashed" />
      <path d="M 45,30 L 70,35" class="vector-arc-outflow-solid" />

      {# Inflow Vectors (Alpine Blue) terminating at Puget Sound Hub (45, 30) #}
      <path d="M 50,120 Q 40,75 45,30" class="vector-arc-inflow-solid" />
      <path d="M 65,155 Q 50,90 45,30" class="vector-arc-inflow-solid" />
      <path d="M 185,80 Q 110,45 45,30" class="vector-arc-inflow-dashed" />
      <path d="M 250,75 Q 140,40 45,30" class="vector-arc-inflow-dashed" />

      {# Major Metro Node Markers & Labels #}
      <circle cx="50" cy="120" r="2.5" class="map-point-inflow" />
      <text x="56" y="122" class="map-city-text">Bay Area</text>

      <circle cx="65" cy="155" r="2.5" class="map-point-inflow" />
      <text x="71" y="157" class="map-city-text">Los Angeles</text>

      <circle cx="95" cy="145" r="2.5" class="map-point-outflow" />
      <text x="101" y="147" class="map-city-text">Phoenix</text>

      <circle cx="45" cy="55" r="2.5" class="map-point-outflow" />
      <text x="51" y="57" class="map-city-text">Portland</text>

      <circle cx="70" cy="35" r="2.5" class="map-point-outflow" />
      <text x="76" y="37" class="map-city-text">Spokane</text>

      <circle cx="155" cy="150" r="2.5" class="map-point-outflow" />
      <text x="161" y="152" class="map-city-text">Dallas</text>

      <circle cx="185" cy="80" r="2.5" class="map-point-inflow" />
      <text x="191" y="82" class="map-city-text">Chicago</text>

      <circle cx="250" cy="75" r="2.5" class="map-point-inflow" />
      <text x="256" y="77" class="map-city-text">New York</text>

      {# Puget Sound Anchor Pin - Label Positioned Above Pin #}
      <text x="45" y="19" class="map-hub-label-top">Seattle</text>
      <circle cx="45" cy="30" r="4.5" class="map-hub-pin-outer" />
      <circle cx="45" cy="30" r="2" class="map-hub-pin-inner" />
    </svg>
  </div>

  {# Tabular Breakdown: Side-by-Side Dual Inflow/Outflow Wells #}
  <div class="migration-tables-grid">
    
    {# Inflow Origins #}
    <div class="migration-table-well">
      <div class="migration-well-header header-inflow">
        Top Inflow Origins (Moving In)
      </div>
      <table class="migration-data-table">
        <tbody>
          {% for r in inflows %}
            <tr>
              <td class="cell-city-label">{{ r.city }}</td>
              <td class="cell-share-metric share-inflow">{{ r.share }}</td>
              <td class="cell-net-differential">{{ r.net }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {# Outflow Destinations #}
    {% if outflows and outflows.length > 0 %}
      <div class="migration-table-well">
        <div class="migration-well-header header-outflow">
          Top Outflow Destinations (Relocating Out)
        </div>
        <table class="migration-data-table">
          <tbody>
            {% for r in outflows %}
              <tr>
                <td class="cell-city-label">{{ r.city }}</td>
                <td class="cell-share-metric share-outflow">{{ r.share }}</td>
                <td class="cell-net-differential">{{ r.net }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

  </div>

  {# Footer Disclosure Strip #}
  <footer class="migration-footer-strip">
    <span>{{ source_text }}</span>
    <span>{{ cadence_text }}</span>
  </footer>

</section>
{% endif %}