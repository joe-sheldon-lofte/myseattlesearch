<!-- File: _includes/components/widget/realestate-migration-map.njk -->
{% set demo_inflow = [
  { city: "San Francisco, CA", share: "18.4%" },
  { city: "Los Angeles, CA", share: "14.2%" },
  { city: "New York, NY", share: "9.8%" },
  { city: "Chicago, IL", share: "6.5%" },
  { city: "Washington, DC", share: "5.1%" }
] %}

{% set demo_outflow = [
  { city: "Phoenix, AZ", share: "12.8%" },
  { city: "Portland, OR", share: "10.4%" },
  { city: "Spokane, WA", share: "8.6%" },
  { city: "Bellingham, WA", share: "7.9%" },
  { city: "Austin, TX", share: "6.2%" }
] %}

{% set inflow_data = migration_inflow | default(demo_inflow) %}
{% set outflow_data = migration_outflow | default(demo_outflow) %}

<section class="widget-card migration-map-card" style="padding: 1.5rem; width: 100%;">
  
  {# Header Row & Series Legend #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline">REGIONAL DEMOGRAPHIC VELOCITY</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">Seattle Area Migration Map</h3>
      <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.15rem;">
        Census Bureau & Redfin Net Migration Inter-Metro Flow
      </div>
    </div>

    {# Series Legend: Inflow = Blue, Outflow = Orange #}
    <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.75rem; font-weight: 700;">
      <div style="display: flex; align-items: center; gap: 0.35rem;">
        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--color-secondary-default);"></span>
        <span style="color: var(--color-secondary-default);">Inflow to Seattle</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.35rem;">
        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #EA580C;"></span>
        <span style="color: #EA580C;">Outflow from Seattle</span>
      </div>
    </div>
  </div>

  {# Map Section (Top 50% Conceptual US Vector Map) #}
  <div style="position: relative; width: 100%; aspect-ratio: 2 / 1; min-height: 220px; background: var(--color-surface-gray); border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; border: 1px solid var(--color-border-light);">
    <svg viewBox="0 0 600 300" preserveAspectRatio="xMidYMid meet" style="width: 100%; height: 100%; display: block;" aria-label="Conceptual US Migration Flow Map">
      <defs>
        {# Arrowhead for Blue Inflow Vectors #}
        <marker id="arrow-inflow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#1E4D6B"/>
        </marker>
        {# Arrowhead for Orange Outflow Vectors #}
        <marker id="arrow-outflow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#EA580C"/>
        </marker>
      </defs>

      {# Conceptual US Landmass Silhouette #}
      <path d="M 50 35 L 140 30 L 260 40 L 350 45 L 430 40 L 510 55 L 560 90 L 540 140 L 490 200 L 460 250 L 410 240 L 340 270 L 280 270 L 210 230 L 140 220 L 70 200 L 45 130 Z" 
            fill="#E5E7EB" stroke="#D1D5DB" stroke-width="1.5" opacity="0.6"/>

      {# INFLOW VECTORS (Blue, into Seattle at 75, 45) #}
      {# San Francisco (60, 140) -> Seattle #}
      <path d="M 60 140 Q 60 90 75 48" fill="none" stroke="#1E4D6B" stroke-width="2.5" stroke-dasharray="3 3" marker-end="url(#arrow-inflow)"/>
      <circle cx="60" cy="140" r="3.5" fill="#1E4D6B"/>

      {# Los Angeles (80, 185) -> Seattle #}
      <path d="M 80 185 Q 55 105 75 48" fill="none" stroke="#1E4D6B" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#arrow-inflow)"/>
      <circle cx="80" cy="185" r="3.5" fill="#1E4D6B"/>

      {# Chicago (360, 105) -> Seattle #}
      <path d="M 360 105 Q 210 65 78 45" fill="none" stroke="#1E4D6B" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#arrow-inflow)"/>
      <circle cx="360" cy="105" r="3.5" fill="#1E4D6B"/>

      {# New York (505, 90) -> Seattle #}
      <path d="M 505 90 Q 280 50 78 45" fill="none" stroke="#1E4D6B" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#arrow-inflow)"/>
      <circle cx="505" cy="90" r="3.5" fill="#1E4D6B"/>

      {# OUTFLOW VECTORS (Orange, out of Seattle 75, 45) #}
      {# Seattle -> Phoenix (145, 195) #}
      <path d="M 75 45 Q 110 120 145 190" fill="none" stroke="#EA580C" stroke-width="2.5" marker-end="url(#arrow-outflow)"/>
      <circle cx="145" cy="195" r="3.5" fill="#EA580C"/>

      {# Seattle -> Portland (68, 78) #}
      <path d="M 75 45 L 68 74" fill="none" stroke="#EA580C" stroke-width="2.5" marker-end="url(#arrow-outflow)"/>
      <circle cx="68" cy="78" r="3.5" fill="#EA580C"/>

      {# Seattle -> Spokane (135, 42) #}
      <path d="M 75 45 L 130 43" fill="none" stroke="#EA580C" stroke-width="2.5" marker-end="url(#arrow-outflow)"/>
      <circle cx="135" cy="42" r="3.5" fill="#EA580C"/>

      {# Seattle -> Austin (310, 240) #}
      <path d="M 75 45 Q 200 150 305 235" fill="none" stroke="#EA580C" stroke-width="2" marker-end="url(#arrow-outflow)"/>
      <circle cx="310" cy="240" r="3.5" fill="#EA580C"/>

      {# SEATTLE FOCAL PIN (Black Dot) #}
      <circle cx="75" cy="45" r="6" fill="#1C1C1E"/>
      <circle cx="75" cy="45" r="2.5" fill="#FFFFFF"/>
      <text x="86" y="47" font-family="var(--font-default)" font-size="11" font-weight="800" fill="#1C1C1E">Seattle Hub</text>
    </svg>
  </div>

  {# Tabular Breakdown (Bottom 50%: Two Side-by-Side Tables) #}
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
    
    {# Inflow Table (Blue) #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-top: 4px solid var(--color-secondary-default); border-radius: 12px; padding: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem;">
        <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--color-secondary-default); margin: 0;">
          Top Inflow Origins
        </h4>
        <span class="text-overline" style="font-size: 0.65rem; color: #86868b;">Moving to Seattle</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        {% for in_item in inflow_data %}
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0; {% if not loop.last %}border-bottom: 1px solid var(--color-border-light);{% endif %}">
            <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-primary-default);">
              {{ in_item.city }}
            </span>
            <span style="font-size: 0.85rem; font-weight: 800; font-family: monospace; color: var(--color-secondary-default);">
              {{ in_item.share }}
            </span>
          </div>
        {% endfor %}
      </div>
    </div>

    {# Outflow Table (Orange) #}
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-top: 4px solid #EA580C; border-radius: 12px; padding: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem;">
        <h4 style="font-size: 0.95rem; font-weight: 800; color: #EA580C; margin: 0;">
          Top Outflow Destinations
        </h4>
        <span class="text-overline" style="font-size: 0.65rem; color: #86868b;">Leaving Seattle</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        {% for out_item in outflow_data %}
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0; {% if not loop.last %}border-bottom: 1px solid var(--color-border-light);{% endif %}">
            <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-primary-default);">
              {{ out_item.city }}
            </span>
            <span style="font-size: 0.85rem; font-weight: 800; font-family: monospace; color: #EA580C;">
              {{ out_item.share }}
            </span>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>

  {# Footer #}
  <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.75rem; margin-top: 1.25rem;" class="text-body-secondary">
    <span>Data sources: U.S. Census Bureau ACS 5-Year Inter-County Flow & Redfin Migration Metrics.</span>
    <a href="/rentvsbuy/" style="color: var(--color-secondary-default); font-weight: 700; text-decoration: none;">
      Explore Affordability Tools →
    </a>
  </div>

</section>