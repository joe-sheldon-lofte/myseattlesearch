<!-- File: _includes/components/widget/emergency-severe-weather-board.njk -->
{# 
  COMPONENT: Severe Weather & NWS Advisories Board (widget.emergency.severe.weather.board)
  CONTRACT:
    - nws_alerts / weather_alerts: Array of Objects [Required]
      Each alert object expects:
      - a.type / a.event: String [Required, e.g. "Special Weather Statement (Marine Fog)"]
      - a.agency: String [Optional, e.g. "National Weather Service Seattle, WA"]
      - a.issued: String [Optional, e.g. "Today at 1:15 PM PDT"]
      - a.expires: String [Optional, e.g. "Today at 9:00 PM PDT"]
      - a.summary / a.description: String [Required]
      - a.map_polygon: String [Optional, e.g. "47.78,-122.42;47.85,-122.45;47.83,-122.38"]
#}

{% set alert_list = nws_alerts if nws_alerts is defined else weather_alerts %}

{% if alert_list is defined %}
  {% set alert_active = (alert_list and alert_list.length > 0) %}

  <section class="widget-card emergency-weather-card">
    
    <details class="weather-details-wrapper" {% if alert_active %}open{% endif %}>
      
      {# Collapsible Header Summary #}
      <summary class="weather-summary-strip">
        <div class="weather-status-lead">
          
          {# Vector Status Icon Badge #}
          <span class="weather-status-icon-frame {% if alert_active %}alert-active{% else %}alert-clear{% endif %}" aria-hidden="true">
            {% if alert_active %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
            {% else %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            {% endif %}
          </span>

          <div class="weather-status-text-stack">
            <span class="text-overline weather-agency-overline">NATIONAL WEATHER SERVICE</span>
            <h3 class="text-widget-title weather-board-headline">
              {% if alert_active %}
                Weather Alert: Active ({{ alert_list | length }})
              {% else %}
                No active severe weather alerts
              {% endif %}
            </h3>
          </div>
        </div>

        {# Status Pill Tag & Chevron #}
        <div class="weather-summary-meta">
          <span class="weather-status-pill {% if alert_active %}alert-active{% else %}alert-clear{% endif %}">
            {% if alert_active %}Active Advisories{% else %}Clear Skies / Normal{% endif %}
          </span>
          <svg class="weather-chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </div>
      </summary>

      {# Alert Content Body #}
      <div class="weather-alerts-stack">
        {% if alert_active %}
          {% for a in alert_list %}
            {% set alert_type = a.type or a.event %}
            {% set alert_desc = a.summary or a.description %}
            {% set alert_poly = a.map_polygon %}

            {% if alert_type and alert_desc %}
              <div class="weather-alert-item">
                <div class="weather-alert-header">
                  <div>
                    <h4 class="weather-alert-title">
                      {{ alert_type }}
                    </h4>
                    {% if a.agency %}
                      <div class="text-body-secondary weather-alert-issuer">
                        Issued by: <span class="weather-meta-highlight">{{ a.agency }}</span>
                      </div>
                    {% endif %}
                  </div>

                  {% if alert_poly %}
                    <button type="button" 
                            class="btn-weather-polygon" 
                            onclick="const m=document.getElementById('city-interactive-map');if(m){m.scrollIntoView({behavior:'smooth'});}else{alert('Alert Polygon: {{ alert_poly }}');}">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                        <circle cx="12" cy="10" r="3"/>
                      </svg>
                      <span>View Alert Area on Map</span>
                    </button>
                  {% endif %}
                </div>

                <p class="text-body weather-alert-summary">
                  {{ alert_desc }}
                </p>

                {% if a.issued or a.expires %}
                  <div class="weather-alert-timestamps text-body-secondary">
                    {% if a.issued %}
                      <span>Issued: <span class="weather-meta-highlight">{{ a.issued }}</span></span>
                    {% endif %}
                    {% if a.expires %}
                      <span>Expires: <span class="weather-meta-highlight">{{ a.expires }}</span></span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <p class="text-body-secondary weather-baseline-message">
            All regional meteorological sensors reporting stable baseline parameters across South Snohomish and North King counties.
          </p>
        {% endif %}
      </div>

    </details>

  </section>
{% endif %}