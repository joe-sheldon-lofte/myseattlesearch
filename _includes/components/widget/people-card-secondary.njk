{# 
  COMPONENT: Secondary Team Member & Advisory Card (widget.people.card.secondary)
  PURPOSE: Team roster, transaction coordinators, listing managers, mortgage & escrow partners.
  CONTRACT:
    - person_sec_name / person_name / name: String [Required]
    - person_sec_role / person_role / role: String [Optional, e.g. "TRANSACTION COORDINATOR"]
    - person_sec_image / person_avatar / avatar: String [Optional, headshot URL]
    - person_sec_phone / person_phone / phone: String [Optional, e.g. "(206) 657-7493"]
    - person_sec_tel / person_tel / tel: String [Optional, e.g. "2066577493"]
    - person_sec_email / person_email / email: String [Optional]
    - person_sec_url / person_url / url: String [Optional, defaults to "/team/"]
#}

{% set p_name = person_sec_name or person_name or name %}
{% set p_role = person_sec_role or person_role or role %}
{% set p_avatar = person_sec_image or person_avatar or avatar %}
{% set p_phone = person_sec_phone or person_phone or phone %}
{% set p_tel = person_sec_tel or person_tel or tel or (p_phone | replace('(', '') | replace(')', '') | replace(' ', '') | replace('-', '') if p_phone else '') %}
{% set p_email = person_sec_email or person_email or email %}
{% set p_url = person_sec_url or person_url or url or "/team/" %}

{% if p_name %}
<article class="widget-card people-card-secondary" aria-label="Advisor profile for {{ p_name }}">
  
  <div class="people-sec-stage">
    {# Standardized 150x150 Circular Avatar per SOP 6 #}
    {% if p_avatar %}
      <div class="people-sec-avatar-wrapper">
        <img src="{{ p_avatar }}" 
             alt="{{ p_name }}" 
             width="150" 
             height="150" 
             loading="lazy" 
             decoding="async" 
             class="people-sec-avatar-img">
      </div>
    {% endif %}

    {% if p_role %}
      <span class="text-overline people-sec-role-tag">
        {{ p_role }}
      </span>
    {% endif %}

    <h4 class="text-widget-title people-sec-name-heading">
      {{ p_name }}
    </h4>

    <div class="people-sec-contact-cluster">
      {% if p_tel and p_phone %}
        <a href="tel:{{ p_tel }}" class="people-sec-phone-link" aria-label="Call {{ p_name }}">
          {{ p_phone }}
        </a>
      {% endif %}

      {% if p_email %}
        <a href="mailto:{{ p_email }}" class="people-sec-email-link" aria-label="Email {{ p_name }}">
          {{ p_email }}
        </a>
      {% endif %}
    </div>
  </div>

  {# Action Button #}
  <div class="people-sec-cta-wrapper">
    <a href="{{ p_url }}" class="btn-people-secondary">
      <span>View Profile</span>
      <svg class="btn-people-secondary-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

</article>
{% endif %}