<!-- File: _includes/components/widget/weather-sunrise-sunset.njk -->
{% set sunrise_time = weather_sunrise | default("6:34 AM") %}
{% set sunset_time = weather_sunset | default("8:52 PM") %}
{% set solar_pct = weather_solar_progress | default(63) %}
{% set current_time_label = weather_current_clock | default("3:34 PM") %}

<div class="widget-card weather-sunrise-sunset-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row #}
  <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
      SUNRISE &amp; SUNSET TIMES
    </span>
    <span class="text-body-secondary" style="font-size: 0.75rem; font-family: monospace;">
      Pacific Time
    </span>
  </div>

  {# SVG Solar Clock Dial #}
  <div style="position: relative; width: 100%; max-width: 260px; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center;">
    <svg viewBox="0 0 200 200" width="100%" height="100%" style="overflow: visible;">
      
      {# Top Semicircle: Daytime (Yellow) from 9:00 over the top to 3:00 #}
      <path d="M 30 100 A 70 70 0 0 1 170 100 Z" fill="#FDE047" stroke="#EAB308" stroke-width="2"/>

      {# Bottom Semicircle: Nighttime (Dark Slate) from 3:00 under the bottom to 9:00 #}
      <path d="M 170 100 A 70 70 0 0 1 30 100 Z" fill="#1E293B" stroke="#0F172A" stroke-width="2"/>

      {# Clockwise Rotation Arrows at Transition Lines #}
      <polygon points="26,92 34,92 30,82" fill="#EAB308"/>
      <polygon points="166,108 174,108 170,118" fill="#EAB308"/>

      {# Current Position Marker: Yellow outline, White fill #}
      <circle cx="128" cy="36" r="9" fill="#FFFFFF" stroke="#EAB308" stroke-width="3" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.2))"/>
      <circle cx="128" cy="36" r="3" fill="#EAB308"/>

      {# Center Hub: Current Time Display #}
      <circle cx="100" cy="100" r="32" fill="var(--color-background-universal, #FFFFFF)" stroke="var(--color-border-light, #E5E5EA)" stroke-width="1.5"/>
      <text x="100" y="97" text-anchor="middle" font-size="11" font-weight="800" font-family="monospace" fill="var(--color-primary-default, #1C1C1E)">{{ current_time_label }}</text>
      <text x="100" y="110" text-anchor="middle" font-size="7.5" font-weight="700" fill="#86868b">CURRENT</text>
    </svg>
  </div>

  {# Sunrise (9:00) & Sunset (3:00) Labels #}
  <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.75rem;">
    <div style="display: flex; flex-direction: column; align-items: flex-start;">
      <span class="text-overline" style="font-size: 0.6rem; color: #86868b;">SUNRISE</span>
      <span style="font-size: 0.95rem; font-weight: 800; font-family: monospace; color: var(--color-primary-default); margin-top: 0.15rem;">
        {{ sunrise_time }}
      </span>
    </div>

    <div style="text-align: center;">
      <span class="text-overline" style="font-size: 0.6rem; color: #86868b;">DAYLIGHT</span>
      <div style="font-size: 0.8rem; font-weight: 700; color: var(--color-secondary-default); font-family: monospace;">
        14h 18m
      </div>
    </div>

    <div style="display: flex; flex-direction: column; align-items: flex-end;">
      <span class="text-overline" style="font-size: 0.6rem; color: #86868b;">SUNSET</span>
      <span style="font-size: 0.95rem; font-weight: 800; font-family: monospace; color: var(--color-primary-default); margin-top: 0.15rem;">
        {{ sunset_time }}
      </span>
    </div>
  </div>

</div>