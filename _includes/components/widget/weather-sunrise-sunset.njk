<!-- File: _includes/components/widget/weather-sunrise-sunset.njk -->
{% set active_city = city or (city_data[0] if city_data else null) or (cityData[0] if cityData else null) %}
{% set city_key = (active_city.slug or active_city.City or active_city.name or "shoreline") | lower | replace(" ", "-") %}
{% set weather_source = city_weather or cityWeather or weather %}
{% set w_city = weather_source[city_key] if weather_source else null %}

{# Pull live astronomy timestamps directly from city_weather.json #}
{% set raw_rise = weather_sunrise or (w_city.astronomy.sunrise_today if w_city and w_city.astronomy else null) %}
{% set raw_set = weather_sunset or (w_city.astronomy.sunset_today if w_city and w_city.astronomy else null) %}

{# Clean inline time formatting: ISO (2026-10-24T07:42) -> 12-hour (7:42 AM) #}
{% set sunrise_display = null %}
{% if raw_rise and ('T' in raw_rise) %}
  {% set rise_h = raw_rise.split('T')[1].split(':')[0] | int %}
  {% set rise_m = raw_rise.split('T')[1].split(':')[1] %}
  {% set sunrise_display = (12 if rise_h == 0 else (rise_h if rise_h <= 12 else rise_h - 12)) ~ ':' ~ rise_m ~ (' AM' if rise_h < 12 else ' PM') %}
{% elif raw_rise %}
  {% set sunrise_display = raw_rise %}
{% endif %}

{% set sunset_display = null %}
{% if raw_set and ('T' in raw_set) %}
  {% set set_h = raw_set.split('T')[1].split(':')[0] | int %}
  {% set set_m = raw_set.split('T')[1].split(':')[1] %}
  {% set sunset_display = (12 if set_h == 0 else (set_h if set_h <= 12 else set_h - 12)) ~ ':' ~ set_m ~ (' AM' if set_h < 12 else ' PM') %}
{% elif raw_set %}
  {% set sunset_display = raw_set %}
{% endif %}

{# Compute build-time sun angle from last_updated #}
{% set sun_angle = null %}
{% if raw_rise and ('T' in raw_rise) and raw_set and ('T' in raw_set) %}
  {% set rise_h = raw_rise.split('T')[1].split(':')[0] | int %}
  {% set rise_m = raw_rise.split('T')[1].split(':')[1] | int %}
  {% set rise_mins = rise_h * 60 + rise_m %}

  {% set set_h = raw_set.split('T')[1].split(':')[0] | int %}
  {% set set_m = raw_set.split('T')[1].split(':')[1] | int %}
  {% set set_mins = set_h * 60 + set_m %}

  {% set updated_str = w_city.last_updated %}
  {% if updated_str and ('T' in updated_str) %}
    {% set u_h = updated_str.split('T')[1].split(':')[0] | int %}
    {% set u_m = updated_str.split('T')[1].split(':')[1] | int %}
    {# Pacific Daylight Time is UTC - 7 hours #}
    {% set cur_h = (u_h - 7 + 24) % 24 %}
    {% set cur_mins = cur_h * 60 + u_m %}
    {% if cur_mins >= rise_mins and cur_mins <= set_mins %}
      {% set day_dur = set_mins - rise_mins %}
      {% set sun_angle = (((cur_mins - rise_mins) / day_dur) * 180) | round(1) %}
    {% else %}
      {% set night_dur = (1440 - set_mins) + rise_mins %}
      {% set elapsed = (cur_mins - set_mins) if cur_mins > set_mins else ((1440 - set_mins) + cur_mins) %}
      {% set sun_angle = (180 + ((elapsed / night_dur) * 180)) | round(1) %}
    {% endif %}
  {% endif %}
{% endif %}

{% set widget_id = widget_solar_id or "solar-dial-widget" %}

<div class="widget-card weather-sunrise-sunset-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 1.25rem; box-sizing: border-box;">
  
  {# Header Row #}
  <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">
      SUNRISE &amp; SUNSET
    </span>
  </div>

  {# SVG Solar Clock Dial with Integrated Flanking Sunrise & Sunset Labels #}
  <div style="position: relative; width: 100%; max-width: 440px; aspect-ratio: 340 / 200; display: flex; align-items: center; justify-content: center;">
    <svg id="{{ widget_id }}" viewBox="0 0 340 200" width="100%" height="100%" style="overflow: visible;" aria-label="Sunrise and Sunset Solar Position Dial">
      <defs>
        <filter id="solarGlow-{{ widget_id }}" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="rgba(0,0,0,0.2)"/>
        </filter>
      </defs>

      {# Left Text: Sunrise #}
      {% if sunrise_display %}
        <g>
          <text x="86" y="93" text-anchor="end" font-size="9" font-weight="700" fill="#86868b" letter-spacing="0.08em" font-family="var(--font-default, -apple-system, sans-serif)">SUNRISE</text>
          <text x="86" y="112" text-anchor="end" font-size="16" font-weight="800" font-family="monospace" fill="var(--color-primary-default, #1C1C1E)">{{ sunrise_display }}</text>
        </g>
      {% endif %}

      {# Top Semicircle: Daytime (Yellow) from 9:00 over the top to 3:00 #}
      <path d="M 100 100 A 70 70 0 0 1 240 100 Z" fill="#FDE047" stroke="#EAB308" stroke-width="2"/>

      {# Bottom Semicircle: Nighttime (Dark Slate) from 3:00 under the bottom to 9:00 #}
      <path d="M 240 100 A 70 70 0 0 1 100 100 Z" fill="#1E293B" stroke="#0F172A" stroke-width="2"/>

      {# Clean Hollow Center Hub #}
      <circle cx="170" cy="100" r="32" fill="var(--color-background-universal, #FFFFFF)" stroke="var(--color-border-light, #E5E5EA)" stroke-width="1.5"/>

      {# Left Arrow: Sunrise at (100, 100) pointing UP (clockwise into day), centered across y=100 #}
      <polygon points="93,107 107,107 100,91" fill="#EAB308" stroke="#B45309" stroke-width="0.75"/>

      {# Right Arrow: Sunset at (240, 100) pointing DOWN (clockwise into night), centered across y=100 #}
      <polygon points="233,93 247,93 240,109" fill="#EAB308" stroke="#B45309" stroke-width="0.75"/>

      {# Current Sun Position Marker on Circumference #}
      {% if sun_angle is not none %}
        <g class="sun-marker-group" transform="rotate({{ sun_angle }}, 170, 100)">
          <circle cx="100" cy="100" r="9" fill="#FFFFFF" stroke="#EAB308" stroke-width="3" filter="url(#solarGlow-{{ widget_id }})"/>
          <circle cx="100" cy="100" r="3" fill="#EAB308"/>
        </g>
      {% endif %}

      {# Right Text: Sunset #}
      {% if sunset_display %}
        <g>
          <text x="254" y="93" text-anchor="start" font-size="9" font-weight="700" fill="#86868b" letter-spacing="0.08em" font-family="var(--font-default, -apple-system, sans-serif)">SUNSET</text>
          <text x="254" y="112" text-anchor="start" font-size="16" font-weight="800" font-family="monospace" fill="var(--color-primary-default, #1C1C1E)">{{ sunset_display }}</text>
        </g>
      {% endif %}

    </svg>
  </div>

</div>