<!-- File: _includes/components/widget/emergency-dispatch-board.njk -->
{% set city = dispatch_city_name | default("Edmonds") %}
{% set incidents = dispatch_incidents_data | default([
  { id: "CAD-2026-9041", type: "Aid Response (Medical)", time: "6m ago", loc: "76th Ave W & 212th St SW", units: "E17, M17", status: "En Route", severity: "med" },
  { id: "CAD-2026-9038", type: "Commercial Fire Alarm", time: "18m ago", loc: "200 5th Ave S", units: "E16, L17", status: "On Scene", severity: "high" },
  { id: "CAD-2026-9032", type: "Traffic Collision Non-Injury", time: "34m ago", loc: "SR 99 & 220th St SW", units: "E17", status: "Cleared", severity: "low" },
  { id: "CAD-2026-9029", type: "Wires Down / Hazard", time: "52m ago", loc: "9th Ave S & Elm St", units: "E16", status: "On Scene", severity: "med" }
]) %}

<div class="widget-card emergency-dispatch-board-card" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1rem; box-sizing: border-box;">
  
  {# Header Row (CAD Feed Sync removed per edit) #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <div>
      <span class="text-overline" style="color: var(--color-tertiary-default, #D9232A); font-size: 0.65rem;">
        LIVE 911 INCIDENT LOG
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        {{ city }} Active Emergency Dispatch
      </h3>
    </div>
    <div style="display: flex; align-items: center; gap: 0.4rem; padding: 0.2rem 0.65rem; border-radius: 999px; background: rgba(217, 35, 42, 0.12); color: var(--color-tertiary-default, #D9232A); font-size: 0.7rem; font-weight: 800;">
      <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--color-tertiary-default, #D9232A); display: inline-block;"></span>
      <span>{{ incidents | length }} Active Incidents</span>
    </div>
  </div>

  {# Compact Incident Rows for Scalable Vertical Stacking #}
  <div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 480px; overflow-y: auto;">
    {% for inc in incidents %}
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0.85rem; background: var(--color-surface-gray); border-radius: 8px; border-left: 3px solid {% if inc.severity == 'high' %}var(--color-tertiary-default, #D9232A){% elif inc.severity == 'med' %}#D97706{% else %}#10B981{% endif %}; gap: 0.75rem;">
        <div style="display: flex; flex-direction: column; gap: 0.1rem; min-width: 0;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-weight: 800; font-size: 0.85rem; color: var(--color-primary-default); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              {{ inc.type }}
            </span>
            <span style="font-family: monospace; font-size: 0.65rem; color: #86868b;">{{ inc.id }}</span>
          </div>
          <div style="font-size: 0.75rem; color: #64748B;">
            📍 {{ inc.loc }} • <span style="font-weight: 600;">Units: {{ inc.units }}</span>
          </div>
        </div>

        <div style="text-align: right; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 0.15rem;">
          <span style="font-size: 0.65rem; font-weight: 800; padding: 0.15rem 0.5rem; border-radius: 999px; {% if inc.status == 'On Scene' %}background: rgba(217, 35, 42, 0.12); color: var(--color-tertiary-default, #D9232A);{% elif inc.status == 'En Route' %}background: rgba(245, 158, 11, 0.15); color: #D97706;{% else %}background: rgba(16, 185, 129, 0.12); color: #059669;{% endif %}">
            {{ inc.status }}
          </span>
          <span style="font-family: monospace; font-size: 0.65rem; color: #86868b;">{{ inc.time }}</span>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Footer #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.5rem; font-size: 0.7rem;" class="text-body-secondary">
    <span>Direct SNO911 / NORCOM Inter-Agency Public Safety Feed</span>
    <span>Auto-refreshes every 60s</span>
  </div>

</div>