<!-- File: _includes/components/widget/emergency-dispatch-board.njk -->
{% set demo_dispatch = [
  {
    type: "Aid Response (Medical)",
    category: "medical",
    address: "7600 Block of 212th St SW, Edmonds",
    agency: "South County Fire Station 17",
    status_step: 3,
    time: "4 mins ago",
    lat: "47.807",
    lon: "-122.348"
  },
  {
    type: "Commercial Fire Alarm",
    category: "fire",
    address: "22000 Block of Highway 99, Edmonds",
    agency: "South County Fire Station 16 / Engine 16",
    status_step: 2,
    time: "18 mins ago",
    lat: "47.798",
    lon: "-122.336"
  },
  {
    type: "Motor Vehicle Collision",
    category: "mva",
    address: "SR 104 & 100th Ave W, Edmonds",
    agency: "Edmonds PD / South County Fire Medic 17",
    status_step: 4,
    time: "42 mins ago",
    lat: "47.791",
    lon: "-122.365"
  },
  {
    type: "Technical Water Rescue Support",
    category: "rescue",
    address: "Marina Beach Park Shoreline, Edmonds",
    agency: "Edmonds Marine Rescue 1 / Station 15",
    status_step: 4,
    time: "1 hr 15 mins ago",
    lat: "47.802",
    lon: "-122.388"
  }
] %}

{% set incidents = dispatch_incidents | default(demo_dispatch) %}
{% set active_count = 0 %}
{% for inc in incidents %}
  {% if inc.status_step < 4 %}
    {% set active_count = active_count + 1 %}
  {% endif %}
{% endfor %}

<section class="widget-card emergency-dispatch-card" style="padding: 1.5rem; width: 100%;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline">SOUTH COUNTY EMERGENCY DISPATCH</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem;">Live 911 Incident Feed</h3>
      <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.2rem;">
        CAD Feed Sync: Real-time PSAP dispatch queue
      </div>
    </div>
    
    <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--color-background-universal); border: 1px solid var(--color-border-light); padding: 0.35rem 0.75rem; border-radius: 999px;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: {% if active_count > 0 %}var(--color-tertiary-default){% else %}#10B981{% endif %};"></span>
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--color-primary-default);">
        {{ active_count }} Active {% if active_count == 1 %}Call{% else %}Calls{% endif %}
      </span>
    </div>
  </div>

  {# Scrolling Incidents Container #}
  <div class="dispatch-feed-scroll" style="display: flex; flex-direction: column; gap: 0.85rem; max-height: 480px; overflow-y: auto; padding-right: 0.25rem;">
    {% for inc in incidents %}
      {% set accent_color = "var(--color-secondary-default)" %}
      {% if inc.category == "fire" %}
        {% set accent_color = "var(--color-tertiary-default)" %}
      {% elif inc.category == "medical" %}
        {% set accent_color = "var(--color-secondary-default)" %}
      {% elif inc.category == "mva" %}
        {% set accent_color = "#F59E0B" %}
      {% elif inc.category == "rescue" %}
        {% set accent_color = "#EA580C" %}
      {% endif %}

      <article class="dispatch-item-card" style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-left: 5px solid {{ accent_color }}; border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
        
        {# Top Line: Icon, Title & Time #}
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.65rem;">
            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--color-surface-gray); display: flex; align-items: center; justify-content: center; color: {{ accent_color }}; flex-shrink: 0;" aria-hidden="true">
              {% if inc.category == "fire" %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-.5 2.5-3 5-3 8 0 3.3 2.7 6 6 6s6-2.7 6-6c0-2-1-3.5-2-4.5.5 1.5 0 3.5-1.5 4.5-.5-2-2-3.5-2.5-5.5-.5 1-1 2-1 3-1.5-1-2-3.5-2-5.5z"/></svg>
              {% elif inc.category == "medical" %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              {% elif inc.category == "mva" %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10.29 3.86-8.29 14.14A2 2 0 0 0 3.71 21h16.58a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              {% else %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/></svg>
              {% endif %}
            </div>

            <div>
              <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--color-primary-default); margin: 0; line-height: 1.3;">
                {{ inc.type }}
              </h4>
              <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.15rem;">
                {{ inc.address }}
              </div>
            </div>
          </div>

          <div style="text-align: right; flex-shrink: 0;">
            <time class="text-body-secondary" style="font-size: 0.75rem; font-weight: 600;">{{ inc.time }}</time>
          </div>
        </div>

        {# Sub-row: Agency & Action #}
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; border-top: 1px dashed var(--color-border-light); padding-top: 0.5rem;">
          <div class="text-body-secondary">
            Unit: <strong style="color: var(--color-primary-default);">{{ inc.agency }}</strong>
          </div>
          
          <button type="button" 
                  class="btn-dispatch-locate" 
                  aria-label="Locate {{ inc.type }} on map" 
                  onclick="const mapEl=document.getElementById('city-interactive-map');if(mapEl){mapEl.scrollIntoView({behavior:'smooth'});}else{alert('Coordinates: {{ inc.lat }}, {{ inc.lon }}');}" 
                  style="display: inline-flex; align-items: center; gap: 0.25rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 999px; padding: 0.2rem 0.55rem; font-size: 0.7rem; font-weight: 600; color: var(--color-secondary-default); cursor: pointer;">
            <span>Locate on Map</span>
            <span aria-hidden="true">📍</span>
          </button>
        </div>

        {# Status Step-Tracker #}
        {% set steps = ["Received", "Dispatched", "On Scene", "Cleared"] %}
        <div style="display: flex; align-items: center; justify-content: space-between; position: relative; padding: 0.35rem 0.5rem 0 0.5rem; margin-top: 0.25rem;">
          <div style="position: absolute; top: 50%; left: 16px; right: 16px; height: 2px; background: var(--color-border-light); z-index: 1;" aria-hidden="true"></div>
          
          {% for step in steps %}
            {% set is_active = (loop.index <= inc.status_step) %}
            {% set is_current = (loop.index == inc.status_step) %}
            <div style="position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 0.2rem;">
              <span style="width: 10px; height: 10px; border-radius: 50%; background: {% if is_active %}{{ accent_color }}{% else %}var(--color-surface-gray){% endif %}; border: 2px solid {% if is_active %}{{ accent_color }}{% else %}var(--color-border-light){% endif %}; {% if is_current and inc.status_step < 4 %}box-shadow: 0 0 0 3px rgba(0,0,0,0.08);{% endif %}"></span>
              <span style="font-size: 0.65rem; font-weight: {% if is_current %}700{% else %}500{% endif %}; color: {% if is_active %}var(--color-primary-default){% else %}#86868b{% endif %};">
                {{ step }}
              </span>
            </div>
          {% endfor %}
        </div>

      </article>
    {% endfor %}
  </div>

  {# Disclaimer #}
  <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.75rem;" class="text-body-secondary">
    <em>Note: Exact residential addresses for medical emergencies are omitted for patient privacy compliance.</em>
  </div>

</section>