<!-- File: _includes/components/widget/weather-forecast-sevenday-cascading.njk -->
{% set w_city = city_weather[city_slug] if city_weather else null %}

{% if w_city and w_city.forecast_7_day and w_city.forecast_7_day.dates %}
<section class="widget-card weather-forecast-sevenday-card" aria-label="7-Day Outlook">
  <header class="forecast-header-row">
    <div class="forecast-title-stack">
      <span class="text-overline text-accent-alpine">EXTENDED OUTLOOK</span>
      <h3 class="forecast-card-title">7-Day Forecast</h3>
    </div>
    <span class="forecast-model-attribution">NOAA / NWS Mesh</span>
  </header>

  <div class="forecast-days-stack">
    {% for date_str in w_city.forecast_7_day.dates %}
      {% set max_t = w_city.forecast_7_day.temp_max[loop.index0] | round %}
      {% set min_t = w_city.forecast_7_day.temp_min[loop.index0] | round %}
      {% set p_prob = w_city.forecast_7_day.precip_prob_max[loop.index0] | round %}
      
      <details class="forecast-accordion-item">
        <summary class="forecast-accordion-summary">
          <div class="forecast-acc-day">
            {{ "Today" if loop.first else (date_str | date_format("ddd")) }}
          </div>
          
          <div class="forecast-acc-icon">
            <svg viewBox="0 0 32 32" class="forecast-condition-svg">
              {% if p_prob >= 50 %}
                <path d="M7 19a5 5 0 0 1 1-9.9 7 7 0 0 1 13.5 1.9A4.5 4.5 0 0 1 25 19H7z" class="weather-svg-cloud-body"/>
                <line x1="10" y1="22" x2="8" y2="27" class="weather-svg-rain-streak"/>
                <line x1="16" y1="22" x2="14" y2="27" class="weather-svg-rain-streak"/>
              {% else %}
                <circle cx="16" cy="16" r="7" class="weather-svg-sun-core"/>
                <line x1="16" y1="4" x2="16" y2="7" class="weather-svg-sun-ray"/>
                <line x1="16" y1="25" x2="16" y2="28" class="weather-svg-sun-ray"/>
                <line x1="4" y1="16" x2="7" y2="16" class="weather-svg-sun-ray"/>
                <line x1="25" y1="16" x2="28" y2="16" class="weather-svg-sun-ray"/>
              {% endif %}
            </svg>
          </div>

          <div class="forecast-acc-rain">
            {{ p_prob }}%
          </div>

          <div class="forecast-acc-temps">
            <span class="forecast-acc-high">{{ max_t }}&deg;</span>
            <span class="forecast-acc-low">{{ min_t }}&deg;</span>
          </div>

          <svg class="forecast-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        
        <div class="forecast-acc-details">
          Detailed hourly conditions, wind vectors, and exact timing of precipitation for {{ "today" if loop.first else (date_str | date_format("dddd")) }} are dynamically synchronized with the NWS.
        </div>
      </details>
    {% endfor %}
  </div>
</section>
{% endif %}