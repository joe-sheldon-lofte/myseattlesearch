<!-- File: _includes/components/widget/region-school-ranking.njk -->
{% set district_name = school_district_name | default("Edmonds School District No. 15") %}
{% set psai_score = school_psai_score | default(84) %}
{% set math_proficiency = school_math_prof | default("68.4%") %}
{% set ela_proficiency = school_ela_prof | default("74.2%") %}
{% set science_proficiency = school_science_prof | default("65.8%") %}
{% set total_schools = school_total_count | default("34 Facilities") %}
{% set schools_url = school_portal_url | default("/schools/edmonds-school-district/") %}

{# PSAI Score color tier: 75+ Green, 55-74 Blue, 40-54 Amber, <40 Red #}
{% set psai_color = "#10B981" %}
{% set psai_label = "Academic Distinction" %}
{% if psai_score < 40 %}
  {% set psai_color = "var(--color-tertiary-default)" %}
  {% set psai_label = "Targeted Growth Area" %}
{% elif psai_score < 55 %}
  {% set psai_color = "#D97706" %}
  {% set psai_label = "Regional Average" %}
{% elif psai_score < 75 %}
  {% set psai_color = "var(--color-secondary-default)" %}
  {% set psai_label = "Above State Baseline" %}
{% endif %}

<div class="widget-card region-school-ranking-card" style="display: flex; flex-direction: column; justify-content: space-between; min-height: 240px; padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); box-sizing: border-box;">
  
  {# Header Row #}
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.75rem;">
    <div>
      <span class="text-overline">OSPI PUBLIC EDUCATION BENCHMARKS</span>
      <h3 class="text-widget-title" style="margin-top: 0.25rem; font-size: 1.15rem;">School District & Rankings</h3>
      <div class="text-body-secondary" style="font-size: 0.75rem; margin-top: 0.15rem;">
        {{ district_name }}
      </div>
    </div>

    {# Embedded Custom PSAI Score Badge #}
    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem;">
      <div style="width: 48px; height: 48px; border-radius: var(--border-radius-squircle); background: {{ psai_color }}; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <span style="font-size: 1.35rem; font-weight: 800; color: #FFFFFF; line-height: 1;">
          {{ psai_score }}
        </span>
      </div>
      <span class="text-overline" style="font-size: 0.6rem; color: {{ psai_color }}; text-align: right;">
        {{ psai_label }}
      </span>
    </div>
  </div>

  {# 3-Metric Proficiency Breakdown: Math, ELA, and Science #}
  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin: 1.15rem 0;">
    
    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 0.75rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.6rem; color: #86868b;">Math Prof.</div>
      <div class="text-data-huge" style="font-size: 1.35rem; margin-top: 0.25rem; line-height: 1; color: var(--color-primary-default);">
        {{ math_proficiency }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.65rem; margin-top: 0.2rem;">SBA Standard</div>
    </div>

    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 0.75rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.6rem; color: #86868b;">ELA / Reading</div>
      <div class="text-data-huge" style="font-size: 1.35rem; margin-top: 0.25rem; line-height: 1; color: var(--color-primary-default);">
        {{ ela_proficiency }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.65rem; margin-top: 0.2rem;">SBA Standard</div>
    </div>

    <div style="background: var(--color-background-universal); border: 1px solid var(--color-border-light); border-radius: 10px; padding: 0.75rem; text-align: center;">
      <div class="text-overline" style="font-size: 0.6rem; color: #86868b;">Science Prof.</div>
      <div class="text-data-huge" style="font-size: 1.35rem; margin-top: 0.25rem; line-height: 1; color: var(--color-primary-default);">
        {{ science_proficiency }}
      </div>
      <div class="text-body-secondary" style="font-size: 0.65rem; margin-top: 0.2rem;">WCAS Standard</div>
    </div>

  </div>

  {# Footer #}
  <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid var(--color-border-light); font-size: 0.8rem;">
    <span class="text-body-secondary" style="font-size: 0.7rem;">{{ total_schools }} • Source: WA OSPI</span>
    <a href="{{ schools_url }}" style="color: var(--color-secondary-default); font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;">
      <span>View local schools</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

</div>