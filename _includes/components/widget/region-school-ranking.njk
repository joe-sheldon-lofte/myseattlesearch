{# 
  COMPONENT: Public School District Academic Benchmark (widget.region.school.ranking)
  PURPOSE: OSPI standardized testing proficiencies (SBA Math, SBA ELA, WCAS Science) and PSAI index.
  CONTRACT:
    - school_district_name / district_name / district.name: String [Optional]
    - school_psai_score / psai_score: Number [Optional, 0-100]
    - school_math_prof / math_proficiency: String [Optional, e.g. "68.4%"]
    - school_ela_prof / ela_proficiency: String [Optional, e.g. "74.2%"]
    - school_science_prof / science_proficiency: String [Optional, e.g. "65.8%"]
    - school_total_count / total_schools: String [Optional, e.g. "34 Schools"]
    - school_portal_url / schools_url: String [Optional, link to district directory]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set district_name = school_district_name or district_name or (district.name if district else '') %}
{% set psai_num = school_psai_score or psai_score %}
{% set math_val = school_math_prof or math_proficiency %}
{% set ela_val = school_ela_prof or ela_proficiency %}
{% set science_val = school_science_prof or science_proficiency %}
{% set school_count = school_total_count or total_schools %}
{% set portal_href = school_portal_url or schools_url %}

{% if district_name or psai_num %}
  {% set psai_score_val = psai_num | float if psai_num else 0 %}
  {% if psai_score_val < 40 %}
    {% set tier_class = "psai-tier-attention" %}
  {% elif psai_score_val < 55 %}
    {% set tier_class = "psai-tier-moderate" %}
  {% elif psai_score_val < 75 %}
    {% set tier_class = "psai-tier-proficient" %}
  {% else %}
    {% set tier_class = "psai-tier-excellent" %}
  {% endif %}

  <section class="widget-card region-school-ranking-card" aria-label="Educational benchmarks for {{ district_name | default('local school district') }}">
    
    {# Header Row #}
    <header class="school-ranking-header">
      <div class="school-district-title-stack">
        <span class="text-overline text-accent-alpine">
          OSPI PUBLIC EDUCATION BENCHMARKS
        </span>
        <h3 class="text-widget-title school-district-title">
          School District &amp; Rankings
        </h3>
        {% if district_name %}
          <div class="school-district-name">
            {{ district_name }}
          </div>
        {% endif %}
      </div>

      {# Embedded PSAI Score Badge #}
      {% if psai_num %}
        <div class="school-psai-badge-col">
          <div class="school-psai-badge {{ tier_class }}">
            <span class="school-psai-number">
              {{ psai_num }}
            </span>
          </div>
          <span class="text-overline school-psai-label {{ tier_class }}">
            PUGET SOUND ACADEMIC INDEX
          </span>
        </div>
      {% endif %}
    </header>

    {# 3-Metric Proficiency Breakdown #}
    {% if math_val or ela_val or science_val %}
      <div class="school-metrics-grid">
        {% if math_val %}
          <div class="school-metric-card">
            <span class="text-overline school-metric-overline">Math Prof.</span>
            <div class="school-metric-value">
              {{ math_val }}
            </div>
            <div class="school-metric-subtext">SBA Standard</div>
          </div>
        {% endif %}

        {% if ela_val %}
          <div class="school-metric-card">
            <span class="text-overline school-metric-overline">ELA / Reading</span>
            <div class="school-metric-value">
              {{ ela_val }}
            </div>
            <div class="school-metric-subtext">SBA Standard</div>
          </div>
        {% endif %}

        {% if science_val %}
          <div class="school-metric-card">
            <span class="text-overline school-metric-overline">Science Prof.</span>
            <div class="school-metric-value">
              {{ science_val }}
            </div>
            <div class="school-metric-subtext">WCAS Standard</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {# Footer Strip #}
    <footer class="school-ranking-footer">
      <span class="school-footer-meta">
        {% if school_count %}{{ school_count }} • {% endif %}Source: Washington State OSPI
      </span>
      {% if portal_href %}
        <a href="{{ portal_href }}" class="school-schools-link">
          <span>View local schools</span>
          <svg class="school-link-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </footer>

  </section>
{% endif %}