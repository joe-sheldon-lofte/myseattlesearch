{# 
  COMPONENT: Regional Highway Toll Facility & Dynamic Congestion Matrix (widget.transit.tolling.matrix)
  PURPOSE: Real-time WSDOT Good To Go! rates across Puget Sound bridges, tunnels, and express lanes.
  CONTRACT:
    - toll_matrix_routes / toll_routes / wsdot_tolls: Array of Objects [Required]
      Each route expects:
      - r.name: String [Required, e.g. "SR 520 Floating Bridge"]
      - r.current: String [Required, e.g. "$4.50"]
      - r.offpeak: String [Optional, e.g. "$1.40"]
      - r.peak: String [Optional, e.g. "$4.50"]
      - r.status: String [Optional, e.g. "Active Peak", "Dynamic Rate", "Flat Rate"]
    - toll_matrix_title / matrix_title: String [Optional, defaults to "Active Toll Rates"]
    - toll_matrix_overline / matrix_overline: String [Optional, defaults to "WSDOT GOOD TO GO! PRICING"]
    - toll_source_label: String [Optional, defaults to "Source: WSDOT Toll Division"]
    - active_neighborhood / neighborhood.name / city.City: String [Optional]
#}

{% set active_neighborhood = active_neighborhood or (neighborhood.name if neighborhood else '') or (city.City if city else '') %}
{% set routes = toll_matrix_routes or toll_routes or wsdot_tolls %}
{% set card_title = toll_matrix_title or matrix_title or "Active Toll Rates" %}
{% set card_overline = toll_matrix_overline or matrix_overline or "WSDOT GOOD TO GO! PRICING" %}
{% set source_text = toll_source_label or "Source: WSDOT Toll Division" %}

{% if routes and routes.length > 0 %}
<section class="widget-card transit-tolling-matrix-card" aria-label="{{ card_title }} for {{ active_neighborhood | default('Puget Sound Region') }}">
  
  {# Header Row #}
  <header class="toll-matrix-header">
    <div class="toll-matrix-title-stack">
      <span class="text-overline text-accent-alpine">
        {{ card_overline }}
      </span>
      <h3 class="text-widget-title toll-matrix-title">
        {{ card_title }}
      </h3>
    </div>
    <div class="toll-live-indicator">
      <span class="toll-live-pulse-dot" aria-hidden="true"></span>
      <span>Live Rates</span>
    </div>
  </header>

  {# Highway Toll Sign Style Matrix Table #}
  <div class="toll-matrix-table-wrap">
    <table class="toll-matrix-table">
      <thead>
        <tr>
          <th scope="col">CORRIDOR / FACILITY</th>
          <th scope="col" style="text-align: right;">CURRENT RATE</th>
          <th scope="col" style="text-align: right;">OFF-PEAK</th>
          <th scope="col" style="text-align: right;">PEAK MAX</th>
          <th scope="col" style="text-align: center;">STATUS</th>
        </tr>
      </thead>
      <tbody>
        {% for r in routes %}
          {% if r.name and r.current %}
            {% set status_text = r.status | default("Standard") %}
            {% set status_class = "" %}
            {% if "Peak" in status_text %}
              {% set status_class = "status-peak" %}
            {% elif "Dynamic" in status_text %}
              {% set status_class = "status-dynamic" %}
            {% endif %}

            <tr class="toll-matrix-row">
              <th scope="row" class="cell-toll-corridor">
                {{ r.name }}
              </th>
              <td class="cell-toll-current">
                {{ r.current }}
              </td>
              <td class="cell-toll-offpeak">
                {{ r.offpeak | default("—") }}
              </td>
              <td class="cell-toll-peak">
                {{ r.peak | default("—") }}
              </td>
              <td class="cell-toll-status">
                <span class="toll-status-pill {{ status_class }}">
                  {{ status_text }}
                </span>
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# Footer Disclosure Strip #}
  <footer class="toll-matrix-footer">
    <span>Requires Good To Go! Pass for lowest published toll.</span>
    <span>{{ source_text }}</span>
  </footer>

</section>
{% endif %}