{# 
  COMPONENT: Universal Text-Only Link Tile & Strip (widget.universal.link.tile)
  PURPOSE: Forecast-style clickable text buttons for municipal links, local portals, or quick resources.
  MODES:
    1. Single Tile Mode: Pass link_url + link_title (or url + name / label)
    2. Batch Strip Mode: Pass link_items / municipal_directory_links (Array of link objects)
  CONTRACT:
    - link_url / item.url / url: String [Required for Single Mode]
    - link_title / link_name / item.name / item.label / label: String [Required for Single Mode]
    - link_target: String [Optional, defaults to "_blank"]
    - link_items / municipal_directory_links / directory_links: Array of Objects [Required for Batch Mode]
#}

{% set batch_links = link_items or municipal_directory_links or directory_links %}
{% set single_url = link_url or url or (item.url if item else '') %}
{% set single_title = link_title or link_name or (item.label if item else '') or (item.name if item else '') or label or title %}
{% set target_attr = link_target or "_blank" %}

{# Reusable Macro: Single Typographic Tile #}
{% macro render_text_tile(url, title, target) %}
  <a href="{{ url }}" 
     class="link-tile-card"
     {% if target == "_blank" %}target="_blank" rel="noopener noreferrer"{% endif %}>
    <span class="link-tile-label">
      {{ title }}
    </span>
  </a>
{% endmacro %}

{# Output Dispatcher #}
{% if batch_links and batch_links.length > 0 %}
  <nav class="universal-links-strip" aria-label="Quick Links">
    {% for item in batch_links %}
      {% set item_url = item.url or item.link_url %}
      {% set item_title = item.name or item.label or item.title or item.link_title %}
      {% if item_url and item_title %}
        {{ render_text_tile(item_url, item_title, target_attr) }}
      {% endif %}
    {% endfor %}
  </nav>
{% elif single_url and single_title %}
  {{ render_text_tile(single_url, single_title, target_attr) }}
{% endif %}