<!-- File: _includes/components/widget/emergency-wildfire-board.njk -->
{# 
  COMPONENT: Regional Wildfire Tracker & Air Quality Monitor (widget.emergency.wildfire.board)
  CONTRACT:
    - wildfire_incidents_data / fires / wildfire_incidents: Array of Objects [Required]
      Each wildfire incident object expects:
      - f.name: String [Required, e.g. "Pioneer Fire (Chelan Complex)"]
      - f.acres: String [Optional, e.g. "38,400 Acres"]
      - f.containment: String [Optional, e.g. "84%"]
      - f.distance: String [Optional, e.g. "88 Miles E"]
      - f.smoke: String [Optional, e.g. "Minimal Drift"]
    - wildfire_aqi / aqi_current: Number [Optional, e.g. 24]
    - wildfire_board_title: String [Optional, defaults to "Wildfire Tracker"]
    - wildfire_board_overline: String [Optional, defaults to "REGIONAL FIRE REPORT"]
    - wildfire_source_text: String [Optional, defaults to "Source: Washington State Emergency Operations Center & NWCC / InciWeb Interagency Data"]
#}

{% set fire_list = wildfire_incidents_data or fires or wildfire_incidents %}
{% set aqi_val = wildfire_aqi if wildfire_aqi is defined else aqi_current %}
{% set board_title = wildfire_board_title or "Wildfire Tracker" %}
{% set board_overline = wildfire_board_overline or "REGIONAL FIRE REPORT" %}
{% set source_text = wildfire_source_text or "Source: Washington State Emergency Operations Center & NWCC / InciWeb Interagency Data" %}

{% if fire_list and fire_list.length > 0 %}
<div class="widget-card emergency-board-card">
  
  {# Header Row: Fire Report Overline, Title & Dynamic AQI Badge #}
  <div class="card-header-split emergency-board-header">
    <div>
      <span class="text-overline text-accent-amber">
        {{ board_overline }}
      </span>
      <h3 class="text-widget-title emergency-board-title">
        {{ board_title }}
      </h3>
    </div>

    {% if aqi_val is defined and aqi_val is not none %}
      {% if aqi_val <= 50 %}
        {% set aqi_class = "badge-aqi-emerald" %}
        {% set aqi_label = "Good" %}
      {% elif aqi_val <= 100 %}
        {% set aqi_class = "badge-aqi-amber" %}
        {% set aqi_label = "Moderate" %}
      {% else %}
        {% set aqi_class = "badge-aqi-crimson" %}
        {% set aqi_label = "Unhealthy" %}
      {% endif %}
      <div class="{{ aqi_class }}">
        Current AQI: {{ aqi_val }} ({{ aqi_label }})
      </div>
    {% endif %}
  </div>

  {# Incident Rows Stack #}
  <div class="emergency-events-stack">
    {% for f in fire_list %}
      {% if f.name %}
        <div class="wildfire-incident-row">
          
          {# Left: Fire Identity & Graphic Well #}
          <div class="wildfire-lead">
            <div class="wildfire-icon-frame" aria-hidden="true">
              {% include "components/graphic/map-wildfire.njk" ignore missing %}
            </div>
            <div class="wildfire-identity">
              <div class="wildfire-name">
                {{ f.name }}
              </div>
              {% if f.acres or f.containment %}
                <div class="text-body-secondary wildfire-subtext">
                  {% if f.acres %}{{ f.acres }}{% endif %}
                  {% if f.acres and f.containment %} • {% endif %}
                  {% if f.containment %}{{ f.containment }} Contained{% endif %}
                </div>
              {% endif %}
            </div>
          </div>

          {# Right: Distance & Smoke Drift Telemetry #}
          <div class="wildfire-metric-block">
            {% if f.distance %}
              <div class="wildfire-distance">
                {{ f.distance }}
              </div>
            {% endif %}
            {% if f.smoke %}
              <div class="wildfire-smoke-tag text-status-emerald">
                {{ f.smoke }}
              </div>
            {% endif %}
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Footer: Interagency Attribution #}
  <div class="card-footer-strip text-body-secondary">
    <span>{{ source_text }}</span>
  </div>

</div>
{% endif %}