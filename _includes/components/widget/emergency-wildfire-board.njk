<!-- File: _includes/components/widget/emergency-wildfire-board.njk -->
{% set city = wildfire_city_name | default("Washington State & Cascades") %}
{% set aqi_current = wildfire_aqi | default(24) %}
{% set fires = wildfire_incidents_data | default([
  { name: "Pioneer Fire (Chelan Complex)", acres: "38,400 Acres", containment: "84%", distance: "88 Miles E", smoke: "Minimal Drift" },
  { name: "Easy Fire (North Cascades SR 20)", acres: "2,130 Acres", containment: "92%", distance: "74 Miles NE", smoke: "No Local Impact" }
]) %}

<div class="widget-card emergency-wildfire-board-card" style="padding: 1.5rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1rem; box-sizing: border-box;">
  
  {# Header Row (Satellite Sensor Verification removed per edit) #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.65rem;">
    <div>
      <span class="text-overline" style="color: #D97706; font-size: 0.65rem;">
        REGIONAL FIRE REPORT
      </span>
      <h3 class="text-widget-title" style="margin: 0.15rem 0 0 0; font-size: 1.15rem;">
        Wildfire Tracker
      </h3>
    </div>
    <div style="font-size: 0.75rem; font-weight: 700; color: #10B981; background: rgba(16, 185, 129, 0.12); padding: 0.2rem 0.65rem; border-radius: 999px;">
      Current AQI: {{ aqi_current }} (Good)
    </div>
  </div>

  {# Incident Rows #}
  <div style="display: flex; flex-direction: column; gap: 0.65rem;">
    {% for f in fires %}
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0.95rem; background: var(--color-surface-gray); border-radius: 10px;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            {% include "components/graphic/map-wildfire.njk" ignore missing %}
          </div>
          <div>
            <div style="font-size: 0.9rem; font-weight: 800; color: var(--color-primary-default);">
              {{ f.name }}
            </div>
            <div class="text-body-secondary" style="font-size: 0.75rem;">
              {{ f.acres }} • {{ f.containment }} Contained
            </div>
          </div>
        </div>

        <div style="text-align: right;">
          <div style="font-family: monospace; font-size: 0.8rem; font-weight: 700; color: var(--color-primary-default);">
            {{ f.distance }}
          </div>
          <div style="font-size: 0.7rem; color: #10B981; font-weight: 600;">{{ f.smoke }}</div>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Footer #}
  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-light); padding-top: 0.5rem; font-size: 0.7rem;" class="text-body-secondary">
    <span>Source: Washington State Emergency Operations Center & NWCC / InciWeb Interagency Data</span>
  </div>

</div>