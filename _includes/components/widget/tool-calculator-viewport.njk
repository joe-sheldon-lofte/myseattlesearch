<!-- File: _includes/components/widget/tool-calculator-viewport.njk -->
{% set form_id = calc_form_id | default("calculator-form") %}
{% set overline_label = calc_overline | default("CALCULATOR") %}
{% set title_label = calc_title | default("Financial Modeling & Planning Parameters") %}

<div class="widget-card tool-calculator-viewport-card" style="padding: 1.75rem; width: 100%; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; gap: 1.5rem; box-sizing: border-box;">
  
  {# Header Row per Edit #}
  <div style="border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.85rem;">
    <span class="text-overline" style="color: var(--color-secondary-default);">
      {{ overline_label }}
    </span>
    <h3 class="text-widget-title" style="margin-top: 0.25rem;">
      {{ title_label }}
    </h3>
  </div>

  {# Open / Customizable Calculator Body Section per Edit #}
  <div class="calculator-body-section" style="width: 100%;">
    {% if calc_body_slot %}
      {{ calc_body_slot | safe }}
    {% elif content %}
      {{ content | safe }}
    {% else %}
      <form id="{{ form_id }}" onsubmit="event.preventDefault();" style="display: flex; flex-direction: column; gap: 1.25rem;">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
          
          <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <label for="calc-sale-price" class="text-overline" style="font-size: 0.65rem; color: #86868b;">
              Estimated Home Value ($)
            </label>
            <div style="position: relative; display: flex; align-items: center;">
              <span style="position: absolute; left: 12px; font-weight: 700; color: #86868b;" aria-hidden="true">$</span>
              <input type="number" id="calc-sale-price" name="sale_price" value="850000" step="5000"
                     style="width: 100%; padding: 0.75rem 0.75rem 0.75rem 1.85rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; font-size: 0.95rem; font-weight: 700; color: var(--color-primary-default); font-family: monospace;">
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <label for="calc-mortgage-bal" class="text-overline" style="font-size: 0.65rem; color: #86868b;">
              Current Mortgage Payoff ($)
            </label>
            <div style="position: relative; display: flex; align-items: center;">
              <span style="position: absolute; left: 12px; font-weight: 700; color: #86868b;" aria-hidden="true">$</span>
              <input type="number" id="calc-mortgage-bal" name="mortgage_balance" value="320000" step="5000"
                     style="width: 100%; padding: 0.75rem 0.75rem 0.75rem 1.85rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; font-size: 0.95rem; font-weight: 700; color: var(--color-primary-default); font-family: monospace;">
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <label for="calc-county" class="text-overline" style="font-size: 0.65rem; color: #86868b;">
              Jurisdiction (REET Tier)
            </label>
            <select id="calc-county" name="county" 
                    style="width: 100%; padding: 0.75rem; background: var(--color-surface-gray); border: 1px solid var(--color-border-light); border-radius: 10px; font-size: 0.9rem; font-weight: 700; color: var(--color-primary-default);">
              <option value="snohomish" selected>Snohomish County (Edmonds / Lynnwood)</option>
              <option value="king">King County (Seattle / Shoreline)</option>
              <option value="pierce">Pierce County (Tacoma)</option>
            </select>
          </div>

        </div>

        <button type="submit" 
                style="width: 100%; padding: 0.85rem 1.5rem; background: var(--color-secondary-default); color: #FFFFFF; border: none; border-radius: 999px; font-size: 0.9rem; font-weight: 800; cursor: pointer;">
          Calculate Estimate →
        </button>

      </form>
    {% endif %}
  </div>

</div>