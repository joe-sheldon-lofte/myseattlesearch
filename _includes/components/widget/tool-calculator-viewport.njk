<!-- File: _includes/components/widget/tool-calculator-viewport.njk -->
{# 
  COMPONENT: Financial Modeling & Planning Viewport (widget.tool.calculator.viewport)
  PURPOSE: User inputs for estimated home value, mortgage balance, and REET tax jurisdiction.
  CONTRACT:
    - calc_form_id / form_id: String [Optional, defaults to "calculator-form"]
    - calc_overline / overline_label: String [Optional, defaults to "CALCULATOR"]
    - calc_title / title_label: String [Optional, defaults to "Financial Modeling & Planning Parameters"]
    - calc_sale_price: Number or String [Optional]
    - calc_mortgage_balance: Number or String [Optional]
    - calc_county_code: String [Optional, e.g. "snohomish", "king", "pierce"]
    - calc_body_slot: String (HTML safe) [Optional]
    - content: String (HTML safe) [Optional]
#}

{% set fid = calc_form_id or form_id or "calculator-form" %}
{% set overline = calc_overline or overline_label or "CALCULATOR" %}
{% set title_text = calc_title or title_label or "Financial Modeling & Planning Parameters" %}

<section class="widget-card tool-calculator-viewport-card" aria-label="{{ title_text }}">
  
  {# Header Row #}
  <header class="calc-card-header">
    <div class="calc-title-stack">
      <span class="text-overline text-accent-alpine">
        {{ overline }}
      </span>
      <h3 class="text-widget-title calc-card-title">
        {{ title_text }}
      </h3>
    </div>
  </header>

  {# Customizable Calculator Form #}
  <div class="calculator-body-section">
    {% if calc_body_slot %}
      {{ calc_body_slot | safe }}
    {% elif content %}
      {{ content | safe }}
    {% else %}
      <form id="{{ fid }}" class="calc-form-container" onsubmit="event.preventDefault();">
        
        <div class="calc-fields-grid">
          
          {# Estimated Home Value #}
          <div class="calc-field-group">
            <label for="calc-sale-price" class="text-overline calc-field-label">
              Estimated Home Value ($)
            </label>
            <div class="calc-input-wrapper">
              <span class="calc-currency-symbol" aria-hidden="true">$</span>
              <input type="number" 
                     id="calc-sale-price" 
                     name="sale_price" 
                     {% if calc_sale_price %}value="{{ calc_sale_price }}"{% endif %}
                     placeholder="e.g. 850,000"
                     step="5000"
                     class="calc-input-number">
            </div>
          </div>

          {# Current Mortgage Payoff #}
          <div class="calc-field-group">
            <label for="calc-mortgage-bal" class="text-overline calc-field-label">
              Current Mortgage Payoff ($)
            </label>
            <div class="calc-input-wrapper">
              <span class="calc-currency-symbol" aria-hidden="true">$</span>
              <input type="number" 
                     id="calc-mortgage-bal" 
                     name="mortgage_balance" 
                     {% if calc_mortgage_balance %}value="{{ calc_mortgage_balance }}"{% endif %}
                     placeholder="e.g. 320,000"
                     step="5000"
                     class="calc-input-number">
            </div>
          </div>

          {# Jurisdiction (REET Tier) #}
          <div class="calc-field-group">
            <label for="calc-county" class="text-overline calc-field-label">
              Jurisdiction (REET Tier)
            </label>
            <select id="calc-county" name="county" class="calc-select">
              <option value="snohomish" {% if calc_county_code == 'snohomish' %}selected{% endif %}>Snohomish County (Edmonds / Lynnwood)</option>
              <option value="king" {% if calc_county_code == 'king' %}selected{% endif %}>King County (Seattle / Shoreline)</option>
              <option value="pierce" {% if calc_county_code == 'pierce' %}selected{% endif %}>Pierce County (Tacoma)</option>
            </select>
          </div>

        </div>

        {# Action Trigger #}
        <button type="submit" class="btn-calc-submit">
          <span>Calculate Estimate</span>
          <svg class="btn-calc-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>

      </form>
    {% endif %}
  </div>

</section>