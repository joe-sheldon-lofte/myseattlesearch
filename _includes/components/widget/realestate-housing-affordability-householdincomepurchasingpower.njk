{# 
  COMPONENT: Chamber 3 - Household Income vs. Purchasing Power (widget.realestate.housing.affordability.householdincomepurchasingpower)
  CONTRACT:
    - household_purchasing_power_data: Array of Objects [Required]
      Each row expects:
      - row.group: String [Required, e.g. "Renter Households"]
      - row.inc_fmt: String [Required, e.g. "$72,400"]
      - row.years_save: String [Required, e.g. "7.8 Yrs"]
      - row.share: String [Required, e.g. "8.2%"]
      - row.pct: Number [Required, scale 0-100]
#}

{% set hh_data = household_purchasing_power_data %}

{% if hh_data and hh_data.length > 0 %}
<div class="affordability-subpanel affordability-household-card" aria-label="Household Income vs. Purchasing Power">
  
  {# Header #}
  <div class="affordability-subpanel-header">
    <h4 class="text-widget-title affordability-subpanel-title">
      Household Income vs. Purchasing Power
    </h4>
  </div>

  {# Horizontal Income Bars with 4 Vertical Qualification Overlay Lines #}
  <div class="hh-bar-row">
    <div class="text-body-secondary" style="font-size: 0.7rem;">
      Dotted qualification lines indicate minimum household income required per property tier:
    </div>

    {# Overlay Chart Canvas #}
    <div class="hh-overlay-canvas">
      
      {# Line 1: Condo ($108.5k) = 43.4% #}
      <div class="hh-marker-line line-condo" title="Condo Qualifying: $108.5k">
        <span class="hh-marker-tag tag-top tag-condo">Condo ($108k)</span>
      </div>

      {# Line 2: Starter ($174.8k) = 69.9% #}
      <div class="hh-marker-line line-starter" title="Starter Home Qualifying: $174.8k">
        <span class="hh-marker-tag tag-top tag-starter">Starter ($175k)</span>
      </div>

      {# Line 3: Townhouse ($190.2k) = 76% #}
      <div class="hh-marker-line line-th" title="Townhouse Qualifying: $190.2k">
        <span class="hh-marker-tag tag-bottom tag-th">TH ($190k)</span>
      </div>

      {# Line 4: Single Family ($242.5k) = 97% #}
      <div class="hh-marker-line line-sf" title="Single-Family Qualifying: $242.5k">
        <span class="hh-marker-tag tag-bottom tag-sf">SF ($242k)</span>
      </div>

      {# Income Bars Stack #}
      <div class="affordability-panels-stack" style="gap: 0.75rem;">
        {% for row in hh_data %}
          <div class="hh-bar-row">
            <div class="hh-bar-meta">
              <span class="hh-bar-group">{{ row.group }}</span>
              <span class="hh-bar-val">{{ row.inc_fmt }}</span>
            </div>

            <div class="hh-bar-track">
              <div class="hh-bar-gradient" style="width: {{ row.pct }}%;"></div>
            </div>
          </div>
        {% endfor %}
      </div>

    </div>
  </div>

  {# Group Metrics Table #}
  <div class="affordability-table-wrap">
    <table class="affordability-table">
      <thead>
        <tr>
          <th>HOUSEHOLD GROUP</th>
          <th style="text-align: right;">MEDIAN INCOME</th>
          <th style="text-align: center;">YRS TO SAVE 3.5%</th>
          <th style="text-align: right;">AFFORDABLE LISTINGS</th>
        </tr>
      </thead>
      <tbody>
        {% for row in hh_data %}
          <tr>
            <td class="table-cell-lead">{{ row.group }}</td>
            <td class="table-cell-num">{{ row.inc_fmt }}</td>
            <td class="table-cell-center cell-color-blue">{{ row.years_save }}</td>
            <td class="table-cell-num {% if '8' in row.share %}cell-color-crimson{% else %}cell-color-emerald{% endif %}">{{ row.share }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>
{% endif %}