{# 
  COMPONENT: Live & Final Sports Game Scoreboard Tile (widget.sports.game.summary)
  PURPOSE: Real-time scores, league status, and ballpark venue for Pacific Northwest teams.
  CONTRACT:
    - game_summary_team_local / team_local / local_team: String [Required]
    - game_summary_team_away / team_away / away_team: String [Required]
    - game_summary_score_local / score_local: String or Number [Optional]
    - game_summary_score_away / score_away: String or Number [Optional]
    - game_summary_league / league: String [Optional, e.g. "MLB", "NFL", "MLS", "NHL"]
    - game_summary_date / game_date: String [Optional, e.g. "Today, Oct 23"]
    - game_summary_status / status: String [Optional, e.g. "FINAL", "IN PROGRESS", "7:10 PM"]
    - game_summary_venue / venue: String [Optional, e.g. "T-Mobile Park, Seattle, WA"]
    - game_summary_url / game_url: String [Optional, link to game recap]
#}

{% set team_loc = game_summary_team_local or team_local or local_team %}
{% set team_ext = game_summary_team_away or team_away or away_team %}
{% set score_loc = game_summary_score_local if game_summary_score_local is defined else score_local %}
{% set score_ext = game_summary_score_away if game_summary_score_away is defined else score_away %}
{% set league_text = game_summary_league or league %}
{% set date_text = game_summary_date or game_date %}
{% set status_raw = game_summary_status or status or "FINAL" %}
{% set venue_text = game_summary_venue or venue %}

{% if team_loc and team_ext %}
  {% set status_upper = status_raw | upper %}
  {% set is_in_progress = (status_upper == "IN PROGRESS" or status_upper == "LIVE") %}
  {% set is_upcoming = (":" in status_raw or "PM" in status_upper or "AM" in status_upper) %}

  {% set status_class = "status-game-final" %}
  {% if is_in_progress %}
    {% set status_class = "status-game-live" %}
  {% elif is_upcoming %}
    {% set status_class = "status-game-upcoming" %}
  {% endif %}

  <article class="widget-card sports-game-summary-card" aria-label="{{ team_loc }} vs {{ team_ext }} Scoreboard">
    
    {# Header Row: League, Date & Status #}
    <header class="sports-game-header">
      <div class="sports-game-meta">
        {% if league_text %}
          <span class="text-overline sports-game-league">
            {{ league_text }}
          </span>
        {% endif %}

        {% if league_text and date_text %}
          <span class="sports-game-dot" aria-hidden="true">•</span>
        {% endif %}

        {% if date_text %}
          <span class="sports-game-date">
            {{ date_text }}
          </span>
        {% endif %}
      </div>

      <span class="sports-game-status-pill {{ status_class }}">
        {{ status_raw }}
      </span>
    </header>

    {# Matchup Scores #}
    <div class="sports-game-matchup">
      {# Local Team Row #}
      <div class="sports-team-row">
        <span class="sports-team-name">
          {{ team_loc }}
        </span>
        {% if score_loc is not none and score_loc != '' %}
          <span class="sports-team-score">
            {{ score_loc }}
          </span>
        {% endif %}
      </div>

      {# Away Team Row #}
      <div class="sports-team-row">
        <span class="sports-team-name team-away">
          {{ team_ext }}
        </span>
        {% if score_ext is not none and score_ext != '' %}
          <span class="sports-team-score score-away">
            {{ score_ext }}
          </span>
        {% endif %}
      </div>
    </div>

    {# Venue & Ballpark Footer #}
    {% if venue_text %}
      <footer class="sports-game-footer">
        <div class="sports-venue-cluster">
          <svg class="sports-venue-pin-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{{ venue_text }}</span>
        </div>
      </footer>
    {% endif %}

  </article>
{% endif %}