{# 
  COMPONENT: Local Fire Protection & WSRB Insurance Rating (widget.municipal.emergency.fire.department.rating)
  CONTRACT:
    - wsrb_rating / wsrb_class / fire_rating / neighborhood.wsrb_rating: Number [Required, scale 1-10]
    - fire_department_name / fire_dept / neighborhood.fire_dept: String [Optional, e.g. "South County Fire"]
    - fire_rating_title: String [Optional, defaults to "Fire & Risk Protection"]
    - fire_eval_agency: String [Optional, defaults to "WA Surveying & Rating Bureau"]
#}

{% set wsrb_val = wsrb_rating if wsrb_rating is defined else (wsrb_class if wsrb_class is defined else (fire_rating if fire_rating is defined else (neighborhood.wsrb_rating if neighborhood else none))) %}
{% set dept_name = fire_department_name or fire_dept or (neighborhood.fire_dept if neighborhood else '') %}
{% set widget_title = fire_rating_title or "Fire & Risk Protection" %}
{% set eval_agency = fire_eval_agency or "WA Surveying & Rating Bureau" %}

{% if wsrb_val is not none and wsrb_val != '' %}
  {% set is_exceptional = (wsrb_val | int <= 3) %}

<div class="widget-card fire-rating-card">
  
  {# Header Row: Risk Overline, Title, and Department Name #}
  <div class="fire-rating-header">
    <span class="text-overline text-accent-alpine">
      RISK ASSESSMENT &amp; HAZARD MITIGATION
    </span>
    <h3 class="text-widget-title fire-rating-title">
      {{ widget_title }}
    </h3>
    {% if dept_name %}
      <div class="text-body-secondary fire-dept-lead">
        Fire Department: <span class="fire-dept-name">{{ dept_name }}</span>
      </div>
    {% endif %}
  </div>

  {# WSRB Protection Class Badge & Insurance Notice #}
  <div class="fire-rating-body">
    
    {# Metric Well #}
    <div class="fire-wsrb-well">
      <span class="text-overline fire-wsrb-caption">
        Protection Rating
      </span>
      <div class="fire-wsrb-label-group">
        <span class="fire-wsrb-label">WSRB Protection:</span>
        <span class="badge-wsrb-pill {% if is_exceptional %}badge-wsrb-exceptional{% else %}badge-wsrb-standard{% endif %}">
          Class {{ wsrb_val }}
        </span>
      </div>
    </div>

    {# Insurance Financial Impact Advisory #}
    {% if is_exceptional %}
      <div class="fire-notice-box is-exceptional">
        <span class="fire-notice-tag">Insurance Impact:</span> This neighborhood maintains an exceptional fire protection rating. This directly reduces your baseline annual homeowners insurance premiums.
      </div>
    {% else %}
      <div class="fire-notice-box is-standard">
        <span class="fire-notice-tag">Insurance Impact:</span> Standard baseline rating for local municipal water supply pressure and engine company proximity.
      </div>
    {% endif %}

  </div>

  {# Footer: Evaluation Agency & Scale Calibration #}
  <div class="fire-rating-footer text-body-secondary">
    <span>Evaluation Agency: <span class="fire-footer-highlight">{{ eval_agency }}</span></span>
    <span>Score Range: <span class="fire-footer-highlight">Class 1 (Best) to 10</span></span>
  </div>

</div>
{% endif %}