<!-- File: _includes/components/widget/element-card-hubitem.njk -->
{# 
  COMPONENT: Portal Hub Item Card (widget.element.card.hubitem)
  CONTRACT:
    - card_hub_title / hub_title / title: String [Required]
    - card_hub_url / hub_url / url: String [Required]
    - card_hub_summary / hub_desc / summary / desc: String [Optional]
    - card_hub_tag / hub_tag / tag: String [Optional, e.g. "VOTER GUIDE"]
    - card_hub_cta / hub_cta / cta: String [Optional, defaults to "Explore"]
    - card_hub_icon: String (SVG markup) [Optional]
#}

{% set hub_title = card_hub_title or hub_title or title %}
{% set hub_url = card_hub_url or hub_url or url %}
{% set hub_desc = card_hub_summary or hub_desc or summary or desc %}
{% set hub_tag = card_hub_tag or hub_tag or tag %}
{% set hub_cta = card_hub_cta or hub_cta or cta or "Explore" %}
{% set hub_icon = card_hub_icon %}

{% if hub_title and hub_url %}
<div class="widget-card widget-card-interactive element-hubitem-card">
  
  <div class="hubitem-content-body">
    {# Top Leading Icon & Pill Tag #}
    <div class="card-header-split hubitem-top-row">
      <div class="hubitem-icon-frame" aria-hidden="true">
        {% if hub_icon %}
          {{ hub_icon | safe }}
        {% else %}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="20" x="4" y="2" rx="2"/>
            <line x1="8" x2="16" y1="6" y2="6"/>
            <line x1="16" x2="16" y1="14" y2="18"/>
            <path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01"/>
          </svg>
        {% endif %}
      </div>

      {% if hub_tag %}
        <span class="text-overline hubitem-tag-pill">
          {{ hub_tag }}
        </span>
      {% endif %}
    </div>

    {# Title & Body Copy #}
    <h3 class="text-widget-title hubitem-headline">
      <a href="{{ hub_url }}" class="title-link">
        {{ hub_title }}
      </a>
    </h3>

    {% if hub_desc %}
      <p class="text-body-secondary hubitem-desc-text">
        {{ hub_desc }}
      </p>
    {% endif %}
  </div>

  {# Bottom Action Button #}
  <div class="hubitem-action-footer">
    <a href="{{ hub_url }}" class="btn-hub-primary">
      <span>{{ hub_cta }}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

</div>
{% endif %}