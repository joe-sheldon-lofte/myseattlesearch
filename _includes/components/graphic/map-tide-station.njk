<!-- File: _includes/components/graphic/map-tide-station.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-tide-station {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Radio Telemetry Top Antenna Post #}
  <line x1="12" y1="3" x2="12" y2="7" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="12" cy="3" r="1" fill="var(--color-secondary-default, #1E4D6B)"/>
  {# Marine Monitoring Diamond / Buoy Hull #}
  <polygon points="12,7 16,11 12,15 8,11" fill="var(--color-secondary-default, #1E4D6B)" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="1"/>
  <circle cx="12" cy="11" r="1.5" fill="var(--color-background-universal, #FFFFFF)"/>
  {# Two Parallel Undulating Sine-Wave Tide Paths #}
  <path d="M2 16c2 0 3-1 5-1s3 1 5 1 3-1 5-1 3 1 5 1" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="1.75" stroke-linecap="round"/>
  <path d="M2 19.5c2 0 3-1 5-1s3 1 5 1 3-1 5-1 3 1 5 1" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="1.5" stroke-linecap="round" opacity="0.65"/>
</svg>