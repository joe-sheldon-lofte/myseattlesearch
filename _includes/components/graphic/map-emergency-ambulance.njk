<!-- File: _includes/components/graphic/map-emergency-ambulance.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-emergency-ambulance {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Rooftop emergency light bar #}
  <rect x="16" y="5" width="4" height="1.5" rx="0.5" fill="var(--color-tertiary-default, #D9232A)"/>
  {# Main ambulance body #}
  <path d="M2 9a1 1 0 0 1 1-1h13a1 1 0 0 1 1 1v1h3.5a1 1 0 0 1 .8.4l1.5 2a1 1 0 0 1 .2.6V17a1 1 0 0 1-1 1h-1a2.5 2.5 0 0 1-5 0H9a2.5 2.5 0 0 1-5 0H3a1 1 0 0 1-1-1V9z" 
        fill="var(--color-background-universal, #FFFFFF)" 
        stroke="var(--color-border-light, #E5E5EA)" 
        stroke-width="0.75"/>
  {# Cab windshield #}
  <path d="M17 11h3.5l1.5 2H17v-2z" fill="var(--color-secondary-default, #1E4D6B)" opacity="0.3"/>
  {# Centered Medical Cross Emblem #}
  <path d="M8.5 10.5h2v1.5h1.5v2h-1.5v1.5h-2v-1.5H7v-2h1.5v-1.5z" fill="var(--color-tertiary-default, #D9232A)"/>
  {# Wheel assemblies at (6.5, 18) and (16.5, 18) #}
  <circle cx="6.5" cy="18" r="1.75" fill="var(--color-primary-default, #1C1C1E)"/>
  <circle cx="6.5" cy="18" r="0.75" fill="var(--color-background-universal, #FFFFFF)"/>
  <circle cx="16.5" cy="18" r="1.75" fill="var(--color-primary-default, #1C1C1E)"/>
  <circle cx="16.5" cy="18" r="0.75" fill="var(--color-background-universal, #FFFFFF)"/>
</svg>