<!-- File: _includes/components/graphic/map-ferry-terminal.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-ferry-terminal {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Squircle Marker Container in WSF Evergreen Green #}
  <rect x="2" y="2" width="20" height="20" rx="6" fill="var(--color-wsf-green, #005A36)"/>
  {# White Nautical Anchor & Slip Emblem #}
  <circle cx="12" cy="6" r="1.5" stroke="var(--color-background-universal, #FFFFFF)" stroke-width="1.5"/>
  <line x1="12" y1="7.5" x2="12" y2="14.5" stroke="var(--color-background-universal, #FFFFFF)" stroke-width="1.75" stroke-linecap="round"/>
  <line x1="9" y1="9.5" x2="15" y2="9.5" stroke="var(--color-background-universal, #FFFFFF)" stroke-width="1.75" stroke-linecap="round"/>
  <path d="M8 12.5a4 4 0 0 0 8 0" stroke="var(--color-background-universal, #FFFFFF)" stroke-width="1.75" stroke-linecap="round" fill="none"/>
  {# Dual White Water-Line Ripple Paths at y=17.5 and y=19.5 #}
  <line x1="5.5" y1="17.5" x2="18.5" y2="17.5" stroke="var(--color-background-universal, #FFFFFF)" stroke-width="1.25" stroke-linecap="round" opacity="0.9"/>
  <line x1="7.5" y1="19.5" x2="16.5" y2="19.5" stroke="var(--color-background-universal, #FFFFFF)" stroke-width="1.25" stroke-linecap="round" opacity="0.6"/>
</svg>