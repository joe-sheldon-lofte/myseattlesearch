<!-- File: _includes/components/graphic/map-emergency-hospital.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-emergency-hospital {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Hospital Building Facade #}
  <rect x="3" y="5" width="18" height="16" rx="1.5" fill="var(--color-surface-gray, #F5F5F7)" stroke="{{ hospital_stroke | default('var(--color-secondary-default, #1E4D6B)') }}" stroke-width="1.5"/>
  {# Entrance #}
  <path d="M10 21v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4" fill="{{ hospital_accent | default('var(--color-secondary-default, #1E4D6B)') }}"/>
  {# Symmetrical Windows #}
  <rect x="5.5" y="12" width="2.5" height="2.5" rx="0.5" fill="{{ hospital_accent | default('var(--color-secondary-default, #1E4D6B)') }}" opacity="0.6"/>
  <rect x="16" y="12" width="2.5" height="2.5" rx="0.5" fill="{{ hospital_accent | default('var(--color-secondary-default, #1E4D6B)') }}" opacity="0.6"/>
  {# Medical Cross Emblem on Upper Facade #}
  <path d="M11 7h2v2h2v2h-2v2h-2v-2H9V9h2V7z" fill="var(--color-tertiary-default, #D9232A)"/>
</svg>