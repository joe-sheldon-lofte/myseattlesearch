<!-- File: _includes/components/graphic/map-emergency-hospital.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-emergency-hospital {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Classic teardrop map pin container in hospital blue/secondary #}
  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" 
        fill="{{ pin_color | default('var(--color-secondary-default, #1E4D6B)') }}" 
        stroke="var(--color-background-universal, #FFFFFF)" 
        stroke-width="1"/>
  {# Centered white bold "H" emblem inside pin head #}
  <path d="M9.5 6.5h1.5v2h2v-2h1.5v5.5h-1.5v-2.25h-2v2.25H9.5V6.5z" 
        fill="var(--color-background-universal, #FFFFFF)"/>
</svg>