<!-- File: _includes/components/graphic/map-trainstation.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-trainstation {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Pitched Roofline & Central Station Portico #}
  <polygon points="12,3 3,8 21,8" fill="var(--color-secondary-default, #1E4D6B)"/>
  {# Main Station Building Facade #}
  <rect x="4" y="8" width="16" height="10.5" fill="var(--color-surface-gray, #F5F5F7)" stroke="var(--color-border-light, #E5E5EA)" stroke-width="1"/>
  {# Circular Station Clock Inset at (12, 8.5) #}
  <circle cx="12" cy="8.5" r="2" fill="var(--color-background-universal, #FFFFFF)" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="0.75"/>
  <line x1="12" y1="7.25" x2="12" y2="8.5" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="0.75"/>
  <line x1="12" y1="8.5" x2="12.8" y2="8.5" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="0.75"/>
  {# Dual Roman Entry Arches #}
  <path d="M7 18.5v-4a1.75 1.75 0 0 1 3.5 0v4H7z" fill="var(--color-secondary-default, #1E4D6B)"/>
  <path d="M13.5 18.5v-4a1.75 1.75 0 0 1 3.5 0v4h-3.5z" fill="var(--color-secondary-default, #1E4D6B)"/>
  {# Parallel Rail Tracks along bottom margin #}
  <line x1="2" y1="20.5" x2="22" y2="20.5" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="1.25" stroke-linecap="round"/>
  <line x1="2" y1="22.5" x2="22" y2="22.5" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="1.25" stroke-linecap="round"/>
</svg>