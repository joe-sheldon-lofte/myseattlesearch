<!-- File: _includes/components/graphic/map-trainstation.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-trainstation {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Station Depot Building #}
  <path d="M2 9h12v10H2V9z" fill="var(--color-surface-gray, #F5F5F7)" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="1.25"/>
  {# Platform Awning Canopy #}
  <path d="M1 9l2-3h10l2 3H1z" fill="var(--color-secondary-default, #1E4D6B)"/>
  {# Station Clock Face #}
  <circle cx="8" cy="12.5" r="1.75" fill="#FFFFFF" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="0.75"/>
  <line x1="8" y1="11.5" x2="8" y2="12.5" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="0.75"/>
  <line x1="8" y1="12.5" x2="8.8" y2="12.5" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="0.75"/>
  {# Depot Entrance #}
  <rect x="6.5" y="15.5" width="3" height="3.5" rx="0.25" fill="var(--color-secondary-default, #1E4D6B)"/>
  {# Adjacent Parallel Rail Tracks #}
  <line x1="17.5" y1="4" x2="17.5" y2="21" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="1.25" stroke-linecap="round"/>
  <line x1="21.5" y1="4" x2="21.5" y2="21" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="1.25" stroke-linecap="round"/>
  {# Railroad Ties / Sleepers #}
  <line x1="16" y1="6" x2="23" y2="6" stroke="#86868b" stroke-width="1" stroke-linecap="round"/>
  <line x1="16" y1="9" x2="23" y2="9" stroke="#86868b" stroke-width="1" stroke-linecap="round"/>
  <line x1="16" y1="12" x2="23" y2="12" stroke="#86868b" stroke-width="1" stroke-linecap="round"/>
  <line x1="16" y1="15" x2="23" y2="15" stroke="#86868b" stroke-width="1" stroke-linecap="round"/>
  <line x1="16" y1="18" x2="23" y2="18" stroke="#86868b" stroke-width="1" stroke-linecap="round"/>
</svg>