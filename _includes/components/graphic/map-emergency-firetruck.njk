<!-- File: _includes/components/graphic/map-emergency-firetruck.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-emergency-firetruck {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Rooftop emergency beacon & ladder rail #}
  <rect x="18" y="6" width="3" height="1.5" rx="0.5" fill="var(--color-warning-amber, #F59E0B)"/>
  <line x1="3" y1="6.5" x2="16" y2="6.5" stroke="var(--color-primary-default, #1C1C1E)" stroke-width="1" stroke-linecap="round"/>
  {# Fire truck main red body #}
  <path d="M2 9a1 1 0 0 1 1-1h13v2h4.5a1 1 0 0 1 .8.4l1.5 2a1 1 0 0 1 .2.6V17a1 1 0 0 1-1 1h-1a2 2 0 0 1-4 0h-2a2 2 0 0 1-4 0H8a2 2 0 0 1-4 0H3a1 1 0 0 1-1-1V9z" 
        fill="var(--color-emergency-red, #D32F2F)"/>
  {# Cab windshield #}
  <path d="M17 11h3.5l1.5 2H17v-2z" fill="var(--color-background-universal, #FFFFFF)" opacity="0.85"/>
  {# Compartment panels / roll-up doors #}
  <rect x="4" y="10" width="3" height="5" rx="0.5" fill="var(--color-background-universal, #FFFFFF)" opacity="0.9"/>
  <rect x="8" y="10" width="3" height="5" rx="0.5" fill="var(--color-background-universal, #FFFFFF)" opacity="0.9"/>
  <rect x="12" y="10" width="3" height="5" rx="0.5" fill="var(--color-background-universal, #FFFFFF)" opacity="0.9"/>
  {# 3 Wheels: (6, 18), (11, 18), (19, 18) #}
  <circle cx="6" cy="18" r="1.6" fill="var(--color-primary-default, #1C1C1E)"/>
  <circle cx="6" cy="18" r="0.6" fill="var(--color-background-universal, #FFFFFF)"/>
  <circle cx="11" cy="18" r="1.6" fill="var(--color-primary-default, #1C1C1E)"/>
  <circle cx="11" cy="18" r="0.6" fill="var(--color-background-universal, #FFFFFF)"/>
  <circle cx="19" cy="18" r="1.6" fill="var(--color-primary-default, #1C1C1E)"/>
  <circle cx="19" cy="18" r="0.6" fill="var(--color-background-universal, #FFFFFF)"/>
</svg>