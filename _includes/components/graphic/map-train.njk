<!-- File: _includes/components/graphic/map-train.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-train {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Aerodynamic Cab Nose, Roofline & Passenger Window Band #}
  <path class="train-top" 
        d="M3 13V8a3 3 0 0 1 3-3h9l5 4.5V13H3z" 
        fill="{{ train_color_top | default('var(--train-color-top, #002E6D)') }}"/>
  
  {# Passenger Windows & Angled Cab Glass #}
  <path d="M6 7h3v3.5H6zM11 7h3v3.5h-3zM16 7h2.5l2 3.5H16z" fill="#FFFFFF" opacity="0.95"/>
  
  {# Lower Skirt, Wheel Housing & Coupler Block #}
  <path class="train-bottom" 
        d="M3 13v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4H3z" 
        fill="{{ train_color_bottom | default('var(--train-color-bottom, #0091B3)') }}"/>
  
  {# Nose Headlight & Recessed Rail Wheels #}
  <circle cx="19" cy="14" r="1" fill="#FACC15"/>
  <circle cx="6" cy="19" r="1.5" fill="#1C1C1E"/>
  <circle cx="18" cy="19" r="1.5" fill="#1C1C1E"/>
</svg>