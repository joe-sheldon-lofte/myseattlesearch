<!-- File: _includes/components/graphic/map-ferry-boat.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-ferry-boat {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Central Radar Mast & Smokestack #}
  <rect class="ferry-stack" x="11.25" y="4.5" width="1.5" height="4" rx="0.5" fill="var(--color-wsf-green, #005A36)"/>
  {# Main Superstructure Cabin (White Deck) #}
  <polygon class="ferry-superstructure" points="4,14 6,8.5 18,8.5 20,14" fill="var(--color-background-universal, #FFFFFF)" stroke="var(--color-wsf-green, #005A36)" stroke-width="0.75"/>
  {# Cabin Square Window Cutouts #}
  <rect x="7" y="10" width="1.5" height="1.5" rx="0.25" fill="var(--color-wsf-green, #005A36)"/>
  <rect x="9.5" y="10" width="1.5" height="1.5" rx="0.25" fill="var(--color-wsf-green, #005A36)"/>
  <rect x="13" y="10" width="1.5" height="1.5" rx="0.25" fill="var(--color-wsf-green, #005A36)"/>
  <rect x="15.5" y="10" width="1.5" height="1.5" rx="0.25" fill="var(--color-wsf-green, #005A36)"/>
  {# Double-Ended Lower Hull (WSF Evergreen Green) along waterline y=18 #}
  <polygon class="ferry-hull" points="1.5,17 3,14 21,14 22.5,17 19.5,18 4.5,18" fill="var(--color-wsf-green, #005A36)"/>
  {# Puget Sound Water Ripples at y=20 #}
  <line x1="2" y1="20" x2="22" y2="20" stroke="var(--color-secondary-default, #1E4D6B)" stroke-width="1" stroke-linecap="round" opacity="0.6"/>
</svg>