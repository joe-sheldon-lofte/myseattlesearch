<!-- File: _includes/components/graphic/map-bus.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     class="graphic-map-bus {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle;" 
     aria-hidden="true">
  {# Upper Body, Destination Header & Windshield Line #}
  <path class="bus-top" 
        d="M4 11V6a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v5H4z" 
        fill="{{ bus_color_top | default('var(--bus-color-top, #005596)') }}"/>
  <rect x="6" y="5" width="12" height="4.5" rx="1" fill="#FFFFFF" opacity="0.95"/>
  
  {# Lower Chassis, Grille & Bumper #}
  <path class="bus-bottom" 
        d="M4 11v6a2 2 0 0 0 2 2h1v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2h4v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2h1a2 2 0 0 0 2-2v-6H4z" 
        fill="{{ bus_color_bottom | default('var(--bus-color-bottom, #FFFFFF)') }}"/>
  
  {# Dual Headlights & Grille Bar #}
  <circle cx="7" cy="14" r="1.25" fill="#FFFFFF" stroke="rgba(0,0,0,0.15)" stroke-width="0.5"/>
  <circle cx="17" cy="14" r="1.25" fill="#FFFFFF" stroke="rgba(0,0,0,0.15)" stroke-width="0.5"/>
  <rect x="10" y="13.75" width="4" height="1.5" rx="0.5" fill="#1C1C1E" opacity="0.5"/>
  
  {# Tires at (6, 20) and (18, 20) #}
  <rect x="6" y="19" width="2" height="2" rx="0.5" fill="#1C1C1E"/>
  <rect x="16" y="19" width="2" height="2" rx="0.5" fill="#1C1C1E"/>
</svg>