<!-- File: _includes/components/graphic/globe-link.njk -->
<svg width="{{ graphic_width | default(24) }}" 
     height="{{ graphic_height | default(24) }}" 
     viewBox="0 0 24 24" 
     fill="none" 
     stroke="currentColor" 
     stroke-width="2" 
     stroke-linecap="round" 
     stroke-linejoin="round" 
     class="graphic-globe-link {{ graphic_class | default('') }}" 
     style="display: inline-block; vertical-align: middle; transition: transform 0.2s ease, stroke 0.2s ease;" 
     aria-hidden="true">
  {# Outer Sphere Centered at (12, 12) Radius 10 #}
  <circle cx="12" cy="12" r="10"/>
  {# Equator Line Across Center #}
  <line x1="2" y1="12" x2="22" y2="12"/>
  {# Meridian Longitude Arcs from Pole to Pole #}
  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
</svg>