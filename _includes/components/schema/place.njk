<!-- File: _includes/components/schema/Place.njk -->
{# 
  COMPONENT: Physical Facility & Transit Infrastructure Schema (schema.place)
  PURPOSE: Accurate coordinates for stations, ferry docks, municipal halls, and parks.
  CONTRACT:
    - place.name / schema_place_name: String [Required]
    - place.address / schema_place_address: String [Required]
    - place.city / schema_place_city: String [Required]
    - place.postal_code / schema_place_zip: String [Required]
    - place.lat / schema_place_lat: Number [Required]
    - place.lon / schema_place_lon: Number [Required]
    - place.map_url / schema_place_map: String [Optional]
#}

{% set is_debug = ('design-system' in (page.url | default(''))) or schema_debug %}
{% set p_name = schema_place_name or (place.name if place else '') %}
{% set p_addr = schema_place_address or (place.address if place else '') %}
{% set p_city = schema_place_city or (place.city if place else (neighborhood.name if neighborhood else '')) %}
{% set p_zip = schema_place_zip or (place.postal_code if place else '') %}
{% set p_lat = schema_place_lat or (place.lat if place else null) %}
{% set p_lon = schema_place_lon or (place.lon if place else null) %}
{% set p_map = schema_place_map or (place.map_url if place else '') %}

{% if p_name and p_lat and p_lon %}
  {% if is_debug %}
  <aside class="widget-card schema-preview-card" aria-label="Schema Debug: Place">
    <div>
      <div class="schema-header-strip">
        <span class="text-overline text-accent-alpine">SCHEMA.ORG JSON-LD</span>
        <span class="schema-badge-validated">Validated</span>
      </div>
      <h4 class="schema-headline">Place</h4>
      <p class="schema-caption">
        Physical facility and transit infrastructure schema with coordinates.
      </p>
    </div>
    <details class="schema-details-drawer">
      <summary class="schema-summary-trigger">Inspect JSON-LD</summary>
      <pre class="schema-code-block"><code>{
  "@context": "https://schema.org",
  "@type": "Place",
  "name": {{ p_name | dump | safe }},
  "geo": [{{ p_lat }}, {{ p_lon }}]
}</code></pre>
    </details>
  </aside>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Place",
    "name": {{ p_name | dump | safe }},
    {% if p_map %}"hasMap": {{ p_map | dump | safe }},{% endif %}
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ p_addr | dump | safe }},
      "addressLocality": {{ p_city | dump | safe }},
      "addressRegion": "WA",
      "postalCode": {{ p_zip | dump | safe }},
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ p_lat }},
      "longitude": {{ p_lon }}
    }
  }
  </script>
{% endif %}