<!-- File: _includes/components/schema/BreadcrumbList.njk -->
{# 
  COMPONENT: BreadcrumbList Hierarchical Navigation Schema (schema.breadcrumblist)
  PURPOSE: Generates Google SERP hierarchical breadcrumb trails for crawl navigation.
  CONTRACT:
    - breadcrumbs / schema_breadcrumbs: Array of Objects [Required]
      Each expects: { name: String, url: String }
#}

{% set is_debug = ('design-system' in (page.url | default(''))) or schema_debug %}
{% set crumbs = schema_breadcrumbs or breadcrumbs %}

{% if crumbs and crumbs.length > 0 %}
  {% if is_debug %}
  <aside class="widget-card schema-preview-card" aria-label="Schema Debug: BreadcrumbList">
    <div>
      <div class="schema-header-strip">
        <span class="text-overline text-accent-alpine">SCHEMA.ORG JSON-LD</span>
        <span class="schema-badge-validated">Validated</span>
      </div>
      <h4 class="schema-headline">BreadcrumbList</h4>
      <p class="schema-caption">
        Hierarchical search breadcrumb path across {{ crumbs | length }} hierarchy nodes.
      </p>
    </div>
    <details class="schema-details-drawer">
      <summary class="schema-summary-trigger">Inspect JSON-LD</summary>
      <pre class="schema-code-block"><code>{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": {{ crumbs | length }} steps
}</code></pre>
    </details>
  </aside>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {% for item in crumbs %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "name": {{ item.name | dump | safe }},
        "item": {{ item.url | dump | safe }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
{% endif %}