<!-- File: _includes/components/schema/SingleFamilyResidence.njk -->
{% set is_debug = ('design-system' in (page.url | default('design-system'))) or schema_debug %}
{% set r_address = schema_res_address | default(home.address if home and home.address else "8512 216th St SW") %}
{% set r_city = schema_res_city | default(home.city if home and home.city else "Edmonds") %}
{% set r_zip = schema_res_zip | default(home.zip if home and home.zip else "98026") %}
{% set r_beds = schema_res_beds | default(home.beds if home and home.beds else 4) %}
{% set r_baths = schema_res_baths | default(home.baths if home and home.baths else 2.5) %}
{% set r_sqft = schema_res_sqft | default(home.sqft if home and home.sqft else 2480) %}
{% set r_price = schema_res_price | default(home.price if home and home.price else 945000) %}
{% set r_status = schema_res_status | default(home.status if home and home.status else "https://schema.org/Sold") %}
{% set r_url = schema_res_url | default(home.url if home and home.url else "https://myseattlesearch.com/portfolio/8512-216th-st-sw/") %}

{% if is_debug %}
<div class="widget-card schema-preview-card" style="padding: 1.25rem; border-radius: var(--border-radius-squircle); background: var(--color-background-universal); border: 1px solid var(--color-border-light); display: flex; flex-direction: column; justify-content: space-between; min-height: 180px; box-sizing: border-box;">
  <div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span class="text-overline" style="color: var(--color-secondary-default); font-size: 0.65rem;">SCHEMA.ORG JSON-LD</span>
      <span style="font-size: 0.7rem; font-weight: 700; color: #10B981; background: rgba(16, 185, 129, 0.12); padding: 0.15rem 0.5rem; border-radius: 999px;">✅ Validated</span>
    </div>
    <h4 class="text-widget-title" style="margin: 0 0 0.25rem 0; font-size: 0.95rem;">SingleFamilyResidence</h4>
    <p class="text-body-secondary" style="font-size: 0.75rem; margin: 0; line-height: 1.4;">
      Property data structure (beds, baths, FTK square footage, price) for Google Real Estate rich snippets.
    </p>
  </div>
  <details style="margin-top: 0.75rem; border-top: 1px solid var(--color-border-light); padding-top: 0.5rem;">
    <summary style="font-size: 0.7rem; font-weight: 700; color: var(--color-secondary-default); cursor: pointer;">Inspect JSON-LD</summary>
    <pre style="background: var(--color-surface-gray); padding: 0.5rem; border-radius: 6px; font-size: 0.65rem; overflow-x: auto; margin-top: 0.35rem; font-family: monospace;"><code>{
  "@context": "https://schema.org",
  "@type": "SingleFamilyResidence",
  "name": "{{ r_address }}",
  "rooms": "{{ r_beds }} beds, {{ r_baths }} baths"
}</code></pre>
  </details>
</div>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SingleFamilyResidence",
  "@id": "{{ r_url }}",
  "name": "{{ r_address }}, {{ r_city }}, WA {{ r_zip }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ r_address }}",
    "addressLocality": "{{ r_city }}",
    "addressRegion": "WA",
    "postalCode": "{{ r_zip }}",
    "addressCountry": "US"
  },
  "numberOfRooms": {{ r_beds }},
  "numberOfBathroomsTotal": {{ r_baths }},
  "floorSize": {
    "@type": "QuantitativeValue",
    "value": {{ r_sqft }},
    "unitCode": "FTK"
  },
  "offers": {
    "@type": "Offer",
    "price": "{{ r_price }}",
    "priceCurrency": "USD",
    "availability": "{{ r_status }}"
  },
  "broker": {
    "@type": "Person",
    "@id": "https://myseattlesearch.com/#agent",
    "name": "Joe Sheldon",
    "telephone": "(206) 657-7493"
  }
}
</script>