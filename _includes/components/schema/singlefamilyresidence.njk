<!-- File: _includes/components/schema/SingleFamilyResidence.njk -->
{# 
  COMPONENT: Real Estate Residential Listing Schema (schema.singlefamilyresidence)
  PURPOSE: Property attributes (beds, baths, FTK square footage, pricing) for Google Real Estate snippets.
  CONTRACT:
    - home.address / schema_res_address: String [Required]
    - home.city / schema_res_city: String [Required]
    - home.zip / schema_res_zip: String [Required]
    - home.beds / schema_res_beds: Number [Required]
    - home.baths / schema_res_baths: Number [Required]
    - home.sqft / schema_res_sqft: Number [Required]
    - home.price / schema_res_price: Number [Required]
    - home.url / schema_res_url: String (Canonical Listing URL) [Required]
    - home.status / schema_res_status: String [Optional, defaults to InStock]
#}

{% set is_debug = ('design-system' in (page.url | default(''))) or schema_debug %}
{% set r_addr = schema_res_address or (home.address if home else '') %}
{% set r_city = schema_res_city or (home.city if home else '') %}
{% set r_zip = schema_res_zip or (home.zip if home else '') %}
{% set r_beds = schema_res_beds or (home.beds if home else null) %}
{% set r_baths = schema_res_baths or (home.baths if home else null) %}
{% set r_sqft = schema_res_sqft or (home.sqft if home else null) %}
{% set r_price = schema_res_price or (home.price if home else null) %}
{% set r_status = schema_res_status or (home.status if home else "https://schema.org/InStock") %}
{% set r_url = schema_res_url or (home.url if home else '') %}

{% if r_addr and r_city and r_price %}
  {% if is_debug %}
  <aside class="widget-card schema-preview-card" aria-label="Schema Debug: SingleFamilyResidence">
    <div>
      <div class="schema-header-strip">
        <span class="text-overline text-accent-alpine">SCHEMA.ORG JSON-LD</span>
        <span class="schema-badge-validated">Validated</span>
      </div>
      <h4 class="schema-headline">SingleFamilyResidence</h4>
      <p class="schema-caption">
        Property data structure for Google Real Estate rich snippets.
      </p>
    </div>
    <details class="schema-details-drawer">
      <summary class="schema-summary-trigger">Inspect JSON-LD</summary>
      <pre class="schema-code-block"><code>{
  "@context": "https://schema.org",
  "@type": "SingleFamilyResidence",
  "name": {{ r_addr | dump | safe }},
  "price": {{ r_price }}
}</code></pre>
    </details>
  </aside>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SingleFamilyResidence",
    {% if r_url %}"@id": {{ r_url | dump | safe }},{% endif %}
    "name": {{ (r_addr ~ ", " ~ r_city ~ ", WA " ~ r_zip) | dump | safe }},
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ r_addr | dump | safe }},
      "addressLocality": {{ r_city | dump | safe }},
      "addressRegion": "WA",
      "postalCode": {{ r_zip | dump | safe }},
      "addressCountry": "US"
    },
    {% if r_beds %}"numberOfRooms": {{ r_beds }},{% endif %}
    {% if r_baths %}"numberOfBathroomsTotal": {{ r_baths }},{% endif %}
    {% if r_sqft %}
    "floorSize": {
      "@type": "QuantitativeValue",
      "value": {{ r_sqft }},
      "unitCode": "FTK"
    },
    {% endif %}
    "offers": {
      "@type": "Offer",
      "price": {{ r_price | dump | safe }},
      "priceCurrency": "USD",
      "availability": {{ r_status | dump | safe }}
    },
    "broker": {
      "@type": "Person",
      "@id": "https://myseattlesearch.com/#agent",
      "name": "Joe Sheldon",
      "telephone": "(206) 657-7493"
    }
  }
  </script>
{% endif %}