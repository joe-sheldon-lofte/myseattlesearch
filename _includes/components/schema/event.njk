<!-- File: _includes/components/schema/Event.njk -->
{# 
  COMPONENT: Generic Event Schema (schema.event)
  PURPOSE: Powers Google "Events near me" for any community event, concert, or municipal hearing.
  CONTRACT:
    - event.title / schema_event_name: String [Required]
    - event.start_time / schema_event_start: String (ISO 8601) [Required]
    - event.end_time / schema_event_end: String (ISO 8601) [Required]
    - event.location_name / schema_event_loc_name: String [Required]
    - event.address / schema_event_loc_address: String [Required]
    - event.city / schema_event_city: String [Required]
    - event.postal_code / schema_event_zip: String [Required]
    - event.organizer.name / schema_org_name: String [Required]
    - event.organizer.url / schema_org_url: String [Optional]
#}

{% set is_debug = ('design-system' in (page.url | default(''))) or schema_debug %}
{% set e_name = schema_event_name or (event.title if event else '') %}
{% set e_start = schema_event_start or (event.start_time if event else '') %}
{% set e_end = schema_event_end or (event.end_time if event else '') %}
{% set e_desc = schema_event_desc or (event.description if event else '') %}
{% set e_loc = schema_event_loc_name or (event.location_name if event else '') %}
{% set e_addr = schema_event_loc_address or (event.address if event else '') %}
{% set e_city = schema_event_city or (event.city if event else (neighborhood.name if neighborhood else '')) %}
{% set e_zip = schema_event_zip or (event.postal_code if event else '') %}
{% set e_url = schema_event_url or (event.url if event else page.url) %}

{# Dynamic Organizer Bindings #}
{% set org_name = schema_org_name or (event.organizer.name if event and event.organizer else 'Community Organizer') %}
{% set org_url = schema_org_url or (event.organizer.url if event and event.organizer else '') %}
{% set org_phone = schema_org_phone or (event.organizer.phone if event and event.organizer else '') %}

{% if e_name and e_start and e_loc %}
  {% if is_debug %}
  <aside class="widget-card schema-preview-card" aria-label="Schema Debug: Event">
    <div>
      <div class="schema-header-strip">
        <span class="text-overline text-accent-alpine">SCHEMA.ORG JSON-LD</span>
        <span class="schema-badge-validated">Validated</span>
      </div>
      <h4 class="schema-headline">Event</h4>
      <p class="schema-caption">
        Generic event schema. Current Organizer: <strong>{{ org_name }}</strong>.
      </p>
    </div>
    <details class="schema-details-drawer">
      <summary class="schema-summary-trigger">Inspect JSON-LD</summary>
      <pre class="schema-code-block"><code>{
  "@context": "https://schema.org",
  "@type": "Event",
  "name": {{ e_name | dump | safe }},
  "organizer": { "name": {{ org_name | dump | safe }} }
}</code></pre>
    </details>
  </aside>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": {{ e_name | dump | safe }},
    {% if e_desc %}"description": {{ e_desc | dump | safe }},{% endif %}
    "startDate": {{ e_start | dump | safe }},
    "endDate": {{ e_end | dump | safe }},
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": {{ e_loc | dump | safe }},
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ e_addr | dump | safe }},
        "addressLocality": {{ e_city | dump | safe }},
        "addressRegion": "WA",
        "postalCode": {{ e_zip | dump | safe }},
        "addressCountry": "US"
      }
    },
    "organizer": {
      "@type": "Organization",
      "name": {{ org_name | dump | safe }}
      {% if org_url %},"url": {{ org_url | dump | safe }}{% endif %}
      {% if org_phone %},"telephone": {{ org_phone | dump | safe }}{% endif %}
    },
    "offers": {
      "@type": "Offer",
      "url": {{ e_url | dump | safe }},
      "price": "0",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-01-01"
    }
  }
  </script>
{% endif %}