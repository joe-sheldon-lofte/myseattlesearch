<!-- File: _includes/components/schema/WebSite.njk -->
{# 
  COMPONENT: Canonical WebSite & Sitelinks Searchbox Schema (schema.website)
  PURPOSE: Declares the top-level digital platform entity (#website) and enables Google Sitelinks Search.
  USAGE: Included once in the <head> of base.njk.
#}

{% set s_url = "https://myseattlesearch.com" %}
{% set s_name = stats.site_name | default("MySeattleSearch") %}
{% set s_desc = "Puget Sound Real Estate & Municipal Intelligence Platform" %}
{% set s_search = "/search/?q=" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ s_url }}/#website",
  "url": "{{ s_url }}/",
  "name": {{ s_name | dump | safe }},
  "description": {{ s_desc | dump | safe }},
  "inLanguage": "en-US",
  "publisher": {
    "@type": "RealEstateAgent",
    "@id": "{{ s_url }}/#agent"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ s_url }}{{ s_search }}{search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>