<!-- File: _includes/components/schema/LocalBusiness.njk -->
{# 
  COMPONENT: Generic Local Business Directory Schema (schema.localbusiness)
  PURPOSE: Maps any community business (restaurants, plumbers, boutiques) for local SEO.
  CONTRACT:
    - business.name / schema_biz_name: String [Required]
    - business.type / schema_biz_type: String [Optional, defaults to "LocalBusiness", can be "Restaurant", "Plumber", etc.]
    - business.address / schema_biz_address: String [Required]
    - business.city / schema_biz_city: String [Required]
    - business.zip / schema_biz_zip: String [Required]
    - business.phone / schema_biz_phone: String [Optional]
    - business.url / schema_biz_url: String [Optional]
    - business.image / schema_biz_image: String [Optional]
    - business.price_range / schema_biz_price: String [Optional, e.g. "$$"]
#}

{% set is_debug = ('design-system' in (page.url | default(''))) or schema_debug %}
{% set b_name = schema_biz_name or (business.name if business else '') %}
{% set b_type = schema_biz_type or (business.type if business else 'LocalBusiness') %}
{% set b_addr = schema_biz_address or (business.address if business else '') %}
{% set b_city = schema_biz_city or (business.city if business else '') %}
{% set b_zip = schema_biz_zip or (business.zip if business else '') %}
{% set b_phone = schema_biz_phone or (business.phone if business else '') %}
{% set b_url = schema_biz_url or (business.url if business else '') %}
{% set b_img = schema_biz_image or (business.image if business else '') %}
{% set b_price = schema_biz_price or (business.price_range if business else '') %}

{% if b_name and b_addr %}
  {% if is_debug %}
  <aside class="widget-card schema-preview-card" aria-label="Schema Debug: LocalBusiness">
    <div>
      <div class="schema-header-strip">
        <span class="text-overline text-accent-alpine">SCHEMA.ORG JSON-LD</span>
        <span class="schema-badge-validated">Validated</span>
      </div>
      <h4 class="schema-headline">{{ b_type }}</h4>
      <p class="schema-caption">
        Generic directory listing schema for <strong>{{ b_name }}</strong>.
      </p>
    </div>
    <details class="schema-details-drawer">
      <summary class="schema-summary-trigger">Inspect JSON-LD</summary>
      <pre class="schema-code-block"><code>{
  "@context": "https://schema.org",
  "@type": "{{ b_type }}",
  "name": {{ b_name | dump | safe }}
}</code></pre>
    </details>
  </aside>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "{{ b_type }}",
    "name": {{ b_name | dump | safe }},
    {% if b_img %}"image": {{ b_img | dump | safe }},{% endif %}
    {% if b_phone %}"telephone": {{ b_phone | dump | safe }},{% endif %}
    {% if b_url %}"url": {{ b_url | dump | safe }},{% endif %}
    {% if b_price %}"priceRange": {{ b_price | dump | safe }},{% endif %}
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ b_addr | dump | safe }},
      "addressLocality": {{ b_city | dump | safe }},
      "addressRegion": "WA",
      "postalCode": {{ b_zip | dump | safe }},
      "addressCountry": "US"
    }
  }
  </script>
{% endif %}