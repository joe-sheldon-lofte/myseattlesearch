  "@context": "https://schema.org",
  "@type": ["Person", "RealEstateAgent"],
  "@id": "https://myseattlesearch.com/#agent",
  "name": "Joe Sheldon",
  "telephone": "{{ agent_phone }}"
}</code></pre>
  </details>
</div>
{% endif %}

