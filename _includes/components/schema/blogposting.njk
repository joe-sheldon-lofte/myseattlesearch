<!-- File: _includes/components/schema/BlogPosting.njk -->
{# 
  COMPONENT: BlogPosting Article Schema (schema.blogposting)
  PURPOSE: Authorship, syndication permalink, and publisher entity graph for editorial posts.
  CONTRACT:
    - post.title / schema_post_title: String [Required]
    - post.date / schema_post_date: String (ISO 8601) [Required]
    - post.url / schema_post_url: String (Canonical URL) [Required]
    - post.excerpt / schema_post_excerpt: String [Optional]
    - post.image / schema_post_image: String (URL) [Optional]
    - post.modified / schema_post_modified: String (ISO 8601) [Optional]
    - post.author.name / schema_author_name: String [Required]
    - post.author.url / schema_author_url: String [Optional]
    - publisher_name / schema_publisher_name: String [Optional, defaults to Site Name]
#}

{% set is_debug = ('design-system' in (page.url | default(''))) or schema_debug %}
{% set p_title = schema_post_title or (post.title if post else '') %}
{% set p_date = schema_post_date or (post.date if post else '') %}
{% set p_mod = schema_post_modified or (post.modified if post else p_date) %}
{% set p_url = schema_post_url or (post.url if post else '') %}
{% set p_desc = schema_post_excerpt or (post.excerpt if post else '') %}
{% set p_img = schema_post_image or (post.image if post else 'https://assets.myseattlesearch.com/brand/og-card-default.webp') %}

{# Dynamic Author & Publisher Bindings #}
{% set a_name = schema_author_name or (post.author.name if post and post.author else 'Guest Contributor') %}
{% set a_url = schema_author_url or (post.author.url if post and post.author else '') %}
{% set pub_name = schema_publisher_name or 'MySeattleSearch' %}

{% if p_title and p_url %}
  {% if is_debug %}
  <aside class="widget-card schema-preview-card" aria-label="Schema Debug: BlogPosting">
    <div>
      <div class="schema-header-strip">
        <span class="text-overline text-accent-alpine">SCHEMA.ORG JSON-LD</span>
        <span class="schema-badge-validated">Validated</span>
      </div>
      <h4 class="schema-headline">BlogPosting</h4>
      <p class="schema-caption">
        Dynamic authorship schema currently attributing this post to: <strong>{{ a_name }}</strong>.
      </p>
    </div>
    <details class="schema-details-drawer">
      <summary class="schema-summary-trigger">Inspect JSON-LD</summary>
      <pre class="schema-code-block"><code>{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ p_title | dump | safe }},
  "author": { "name": {{ a_name | dump | safe }} }
}</code></pre>
    </details>
  </aside>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ p_url | dump | safe }}
    },
    "headline": {{ p_title | dump | safe }},
    {% if p_desc %}"description": {{ p_desc | dump | safe }},{% endif %}
    "image": {{ p_img | dump | safe }},
    "datePublished": {{ p_date | dump | safe }},
    "dateModified": {{ p_mod | dump | safe }},
    "author": {
      "@type": "Person",
      "name": {{ a_name | dump | safe }}
      {% if a_url %},"url": {{ a_url | dump | safe }}{% endif %}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ pub_name | dump | safe }},
      "logo": {
        "@type": "ImageObject",
        "url": "https://assets.myseattlesearch.com/brand/logo.png"
      }
    }
  }
  </script>
{% endif %}