<!-- File: _includes/components/section/neighborhood-page-header.njk -->
{% set city = section_city_name | default("Edmonds") %}
{% set county = section_county_name | default("snohomish") %}
{% set hero_image = section_hero_image_url | default("https://assets.myseattlesearch.com/neighborhood/hero-pools/" + county + "/edmonds-waterfront.webp") %}
{% set tagline = section_city_tagline | default("Possession Sound Maritime Living & Historic Bowl Community") %}

<section class="section-neighborhood-page-header" 
         style="position: relative; width: 100%; min-height: 480px; border-radius: var(--border-radius-squircle); overflow: hidden; background: var(--color-surface-gray); display: flex; align-items: flex-end; margin-bottom: 3.5rem; box-sizing: border-box;">
  
  {# Cloudflare R2 Full-Bleed Hero Image #}
  <div style="position: absolute; inset: 0; z-index: 1;">
    <img src="{{ hero_image }}" 
         alt="{{ city }}, Washington" 
         loading="eager" 
         decoding="async" 
         style="width: 100%; height: 100%; object-fit: cover; object-position: center; display: block;">
  </div>

  {# Ambient Edge Fill Gradient Overlay (Smooth Transition into White Page Content) #}
  <div class="ambient-edge-scrim" 
       style="position: absolute; inset: 0; z-index: 2; background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.4) 55%, rgba(0,0,0,0.85) 90%, var(--color-background-universal) 100%); pointer-events: none;" 
       aria-hidden="true"></div>

  {# Foreground Hero Content: City Name Aligned Bottom-Left #}
  <div class="layout-container" style="position: relative; z-index: 3; width: 100%; padding: 2.5rem 2rem 2.5rem 2rem;">
    <div style="max-width: 860px; display: flex; flex-direction: column; gap: 0.5rem;">
      
      <div style="display: flex; align-items: center; gap: 0.65rem;">
        <span class="text-overline" style="color: #FFFFFF; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-shadow: 0 1px 4px rgba(0,0,0,0.6);">
          PUGET SOUND COMMUNITY GUIDE
        </span>
        <span style="color: rgba(255,255,255,0.7); font-size: 0.75rem;">•</span>
        <span style="color: #FFFFFF; font-size: 0.75rem; font-weight: 600; text-transform: capitalize; text-shadow: 0 1px 4px rgba(0,0,0,0.6);">
          {{ county }} County
        </span>
      </div>

      <h1 class="text-display" style="font-size: clamp(2.5rem, 6vw, 4.25rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; color: #FFFFFF; margin: 0; text-shadow: 0 2px 12px rgba(0,0,0,0.5);">
        {{ city }}
      </h1>

      <p style="font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 500; color: rgba(255, 255, 255, 0.95); margin: 0.25rem 0 0 0; line-height: 1.45; text-shadow: 0 1px 6px rgba(0,0,0,0.6); max-width: 680px;">
        {{ tagline }}
      </p>

    </div>
  </div>

</section>