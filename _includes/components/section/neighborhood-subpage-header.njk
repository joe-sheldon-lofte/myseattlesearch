<!-- File: _includes/components/section/neighborhood-subpage.header.njk -->
{% set city = subpage_city_name | default("Edmonds") %}
{% set subpage = subpage_heading | default("Real Estate & Housing Data") %}
{% set county = subpage_county_name | default("snohomish") %}
{% set hero_pool = subpage_hero_images | default([
  "https://assets.myseattlesearch.com/neighborhood/hero-pools/" + county + "/edmonds-waterfront.webp",
  "https://assets.myseattlesearch.com/neighborhood/hero-pools/" + county + "/edmonds-downtown.webp",
  "https://assets.myseattlesearch.com/neighborhood/hero-pools/" + county + "/edmonds-ferry.webp"
]) %}

<section class="section-neighborhood-subpage-header" style="position: relative; width: 100%; min-height: 320px; overflow: hidden; border-radius: var(--border-radius-squircle); margin-bottom: 3rem; background: var(--color-surface-gray); display: flex; align-items: center; justify-content: center; box-sizing: border-box;">
  
  {# Background: Continuous Horizontal Scrolling 3-Image Wall #}
  <div class="hero-scroll-track" style="position: absolute; inset: 0; display: flex; width: max-content; overflow: hidden; pointer-events: none;" aria-hidden="true">
    <div style="display: flex; gap: 0; min-width: 100%; animation: scrollHorizontal 45s linear infinite;">
      {% for img in hero_pool %}
        <div style="width: 50vw; min-width: 380px; height: 100%; flex-shrink: 0;">
          <img src="{{ img }}" alt="" loading="eager" decoding="async" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
      {% endfor %}
      {% for img in hero_pool %}
        <div style="width: 50vw; min-width: 380px; height: 100%; flex-shrink: 0;">
          <img src="{{ img }}" alt="" loading="eager" decoding="async" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
      {% endfor %}
    </div>
  </div>

  {# Darkening ambient scrim #}
  <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.45) 100%); pointer-events: none;" aria-hidden="true"></div>

  {# Foreground: Layered Frosted Box with Squircle Corners #}
  <div class="hero-frosted-box" style="position: relative; z-index: 10; padding: 2rem 2.75rem; background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.6); border-radius: var(--border-radius-squircle); text-align: center; box-shadow: 0 12px 36px rgba(0,0,0,0.16); max-width: 90%; margin: 1.5rem;">
    <div style="font-family: var(--font-script, cursive, serif); font-size: clamp(1.2rem, 2vw, 1.65rem); color: var(--color-secondary-default); line-height: 1.1; margin-bottom: 0.2rem;">
      Welcome to the neighborhood
    </div>
    <div style="font-size: clamp(1.8rem, 4vw, 2.75rem); font-weight: 800; letter-spacing: -0.02em; color: var(--color-primary-default); margin: 0; line-height: 1.1;">
      {{ city }}
    </div>
    <div style="font-size: clamp(1rem, 2vw, 1.35rem); font-weight: 700; color: var(--color-secondary-default); margin-top: 0.35rem;">
      {{ subpage }}
    </div>
  </div>

</section>