<!-- File: _includes/components/section/infinite-horizontal-scroll-large.njk -->
{% set scroll_id = scroll_large_id | default("scroll-large-" + (range(100, 999) | random)) %}

<div id="{{ scroll_id }}" class="section-scroll-container scroll-size-large" style="position: relative; width: 100%; margin-bottom: 3rem; box-sizing: border-box;">
  
  {# Left and Right Gradient Fades #}
  <div class="scroll-fade-left" style="position: absolute; left: 0; top: 0; bottom: 0; width: 52px; background: linear-gradient(90deg, var(--color-background-universal) 0%, transparent 100%); z-index: 5; pointer-events: none;" aria-hidden="true"></div>
  <div class="scroll-fade-right" style="position: absolute; right: 0; top: 0; bottom: 0; width: 52px; background: linear-gradient(270deg, var(--color-background-universal) 0%, transparent 100%); z-index: 5; pointer-events: none;" aria-hidden="true"></div>

  {# Horizontally Scrolling Flex Track hiding scrollbar #}
  <div class="scroll-track" 
       tabindex="0"
       role="region" 
       aria-label="Horizontally scrollable featured articles and hero cards"
       style="display: flex; gap: 1.5rem; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; scroll-snap-type: x mandatory; padding: 0.5rem 1rem; width: 100%; box-sizing: border-box;">
    
    {% if scroll_slot %}
      {{ scroll_slot | safe }}
    {% elif content %}
      {{ content | safe }}
    {% else %}
      {# Default Demo Items for Large / Hero Articles #}
      <div style="flex: 0 0 auto; scroll-snap-align: start; width: 440px; max-width: 90vw;">
        {% set article_title = "Missing-Middle Zoning Along the Swift BRT Corridor: What Buyers and Builders Must Know" %}
        {% set article_excerpt = "How Snohomish County's updated development code is reshaping infill housing, duplex financing models, and property tax baselines." %}
        {% set article_read_time = "5 min read" %}
        {% include "components/widget/cms-card-article.njk" ignore missing %}
      </div>
      <div style="flex: 0 0 auto; scroll-snap-align: start; width: 440px; max-width: 90vw;">
        {% set chart_overline = "MARKET VELOCITY" %}{% set chart_title = "90-Day Trajectory" %}
        {% include "components/widget/universal-data-chart-maxfour.njk" ignore missing %}
      </div>
      <div style="flex: 0 0 auto; scroll-snap-align: start; width: 440px; max-width: 90vw;">
        {% include "components/widget/realestate-housing-affordability-dashboard.njk" ignore missing %}
      </div>
    {% endif %}

  </div>

  <style>
    #{{ scroll_id }} .scroll-track::-webkit-scrollbar {
      display: none;
    }
  </style>

</div>