<!-- File: _includes/components/section/image-gallery.njk -->
{% set gallery_title = image_gallery_title | default("Community Visual Gallery") %}
{% set gallery_overline = image_gallery_overline | default("LOCAL LIFESTYLE & ARCHITECTURE") %}
{% set gallery_desc = image_gallery_desc | default("High-resolution visual tour showcasing neighborhood streetscapes, waterfront parks, and residential character.") %}

<section class="section-image-gallery" style="width: 100%; margin-bottom: 3.5rem; box-sizing: border-box;">
  
  {# Section Header #}
  <div style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.85rem;">
    <span class="text-overline" style="color: var(--color-secondary-default);">
      {{ gallery_overline }}
    </span>
    <h2 class="text-section-title" style="margin-top: 0.25rem;">
      {{ gallery_title }}
    </h2>
    {% if gallery_desc %}
      <p class="text-body-secondary" style="font-size: 0.9rem; line-height: 1.5; margin: 0.35rem 0 0 0;">
        {{ gallery_desc }}
      </p>
    {% endif %}
  </div>

  {# Houses widget.image.viewport.box per catalog edit #}
  <div class="gallery-viewport-wrapper" style="width: 100%; max-width: 680px; margin: 0 auto;">
    {% if image_gallery_slot %}
      {{ image_gallery_slot | safe }}
    {% elif content %}
      {{ content | safe }}
    {% else %}
      {% include "components/widget/image-viewport-box.njk" ignore missing %}
    {% endif %}
  </div>

</section>