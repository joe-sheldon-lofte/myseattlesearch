<!-- File: _includes/components/section/infinite-horizontal-scroll-medium.njk -->
{% set scroll_id = scroll_medium_id | default("scroll-medium-" + (range(100, 999) | random)) %}

<div id="{{ scroll_id }}" class="section-scroll-container scroll-size-medium" style="position: relative; width: 100%; margin-bottom: 2.5rem; box-sizing: border-box;">
  
  {# Left and Right Gradient Fades #}
  <div class="scroll-fade-left" style="position: absolute; left: 0; top: 0; bottom: 0; width: 44px; background: linear-gradient(90deg, var(--color-background-universal) 0%, transparent 100%); z-index: 5; pointer-events: none;" aria-hidden="true"></div>
  <div class="scroll-fade-right" style="position: absolute; right: 0; top: 0; bottom: 0; width: 44px; background: linear-gradient(270deg, var(--color-background-universal) 0%, transparent 100%); z-index: 5; pointer-events: none;" aria-hidden="true"></div>

  {# Horizontally Scrolling Flex Track hiding scrollbar #}
  <div class="scroll-track" 
       tabindex="0"
       role="region" 
       aria-label="Horizontally scrollable real estate listings"
       style="display: flex; gap: 1.25rem; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; scroll-snap-type: x mandatory; padding: 0.5rem 1rem; width: 100%; box-sizing: border-box;">
    
    {% if scroll_slot %}
      {{ scroll_slot | safe }}
    {% elif content %}
      {{ content | safe }}
    {% else %}
      {# Default Demo Items for Medium / Real Estate Listings #}
      <div style="flex: 0 0 auto; scroll-snap-align: start; width: 320px; max-width: 85vw;">
        {% set business_name = "Walnut Street Coffee" %}
        {% set business_category = "Downtown Cafe" %}
        {% set business_rating = "4.9" %}
        {% set business_reviews_count = "184" %}
        {% include "components/widget/business-listing.njk" ignore missing %}
      </div>
      <div style="flex: 0 0 auto; scroll-snap-align: start; width: 320px; max-width: 85vw;">
        {% set ferry_origin = "Edmonds" %}{% set ferry_destination = "Kingston" %}{% set ferry_status = "On Time" %}
        {% include "components/widget/ferry-status.njk" ignore missing %}
      </div>
      <div style="flex: 0 0 auto; scroll-snap-align: start; width: 320px; max-width: 85vw;">
        {% set airport_name = "Paine Field" %}{% set airport_code = "PAE" %}{% set airport_status = "Normal Operations" %}
        {% include "components/widget/regional-airport-status.njk" ignore missing %}
      </div>
      <div style="flex: 0 0 auto; scroll-snap-align: start; width: 320px; max-width: 85vw;">
        {% set current_months_supply = 1.8 %}
        {% include "components/widget/realestate-market-balance-bar.njk" ignore missing %}
      </div>
    {% endif %}

  </div>

  <style>
    #{{ scroll_id }} .scroll-track::-webkit-scrollbar {
      display: none;
    }
  </style>

</div>