<!-- File: _includes/layouts/base.njk -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  
  {# Dynamic Meta Titles & Descriptions #}
  <title>{{ title | default(stats.site_name | default("MySeattleSearch | Puget Sound Real Estate & Hyperlocal Data")) }}</title>
  <meta name="description" content="{{ meta_description | default("Explore Puget Sound real estate, municipal data, and neighborhood telemetry with " ~ stats.full_name ~ ".") }}">
  
  {# Open Graph / Social Sharing #}
  <meta property="og:title" content="{{ title | default(stats.site_name) }}">
  <meta property="og:description" content="{{ meta_description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://myseattlesearch.com{{ page.url }}">
  <meta property="og:image" content="{{ og_image | default('https://assets.myseattlesearch.com/brand/og-default.jpg') }}">
  <meta name="twitter:card" content="summary_large_image">
  
  {# Favicons #}
  <link rel="icon" href="/assets/brand/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">

  {# Core Design System Stylesheet #}
  <link rel="stylesheet" href="/style.css">

  {# Canonical Platform & Publisher Schemas #}
  {% include "components/schema/website.njk" %}
  {% include "components/schema/siteowner.njk" %}
</head>
<body>

  {# Global Overlay Navigation #}
  {% include "header.njk" %}

  {# Primary Content Viewport #}
  <main id="main-content">
    {{ content | safe }}
  </main>

  {# Minimalist Integrated Footer #}
  {% include "footer.njk" %}

  {# Floating Bottom Action Tray (Liquid Glass) #}
  {% include "components/widget/layout-actionbar-bottom.njk" %}

</body>
</html>