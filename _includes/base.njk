<!-- File: _includes/base.njk -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("MySeattleSearch | Puget Sound Real Estate & Hyperlocal Data") }}</title>
  
  {% if meta_description %}
    <meta name="description" content="{{ meta_description }}">
  {% endif %}

  <!-- Core Design Tokens & Stylesheet -->
  <link rel="stylesheet" href="/style.css">

  <!-- Global Schema.org JSON-LD Entity -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Person", "RealEstateAgent"],
    "@id": "https://myseattlesearch.com/#agent",
    "name": "Joe Sheldon",
    "jobTitle": "Senior Real Estate Agent",
    "worksFor": {
      "@type": "RealEstateAgent",
      "name": "Redfin",
      "url": "https://www.redfin.com"
    },
    "telephone": "+12066577493",
    "email": "joe.sheldon@redfin.com",
    "url": "https://myseattlesearch.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Lynnwood",
      "addressRegion": "WA",
      "addressCountry": "US"
    },
    "areaServed": [
      "Seattle",
      "Bellevue",
      "Edmonds",
      "Lynnwood",
      "Mountlake Terrace",
      "Shoreline",
      "Brier",
      "Kenmore",
      "Lake Forest Park",
      "Mukilteo",
      "Woodinville",
      "Kirkland"
    ]
  }
  </script>
</head>
<body>

  {{ content | safe }}

  <!-- Build-Time Freshness Tracking & Semantic Footer -->
  <footer style="margin-top: 5rem; padding: 2.5rem 1.5rem; border-top: 1px solid var(--color-border-light); text-align: center;" class="text-body-secondary">
    <div class="layout-container">
      <p style="font-size: 0.85rem;">
        © {{ page.date.getFullYear() if page.date else "2026" }} MySeattleSearch • Joseph Sheldon, Senior Real Estate Agent • Redfin
      </p>
      <p style="font-size: 0.75rem; margin-top: 0.5rem; color: #86868b;">
        Data compiled at {% buildTime %}. Direct line: <a href="tel:2066577493" style="color: var(--color-secondary-default); text-decoration: none; font-weight: 600;">(206) 657-7493</a>
      </p>
    </div>
  </footer>

</body>
</html>