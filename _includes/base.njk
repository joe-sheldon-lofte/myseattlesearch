<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  
  {# Dynamic Meta Titles & Descriptions #}
  <title>{{ title | default(stats.site_name | default("MySeattleSearch | Puget Sound Real Estate & Hyperlocal Data")) }}</title>
  <meta name="description" content="{{ meta_description | default("Explore Puget Sound real estate, municipal data, and neighborhood telemetry with " ~ stats.full_name ~ ".") }}">
  
  {# Favicons #}
  <link rel="icon" href="/assets/brand/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">

  {# Core Design System Stylesheet with Automatic Cache-Buster #}
  <link rel="stylesheet" href="/style.css?v={{ buildTime | slugify }}">

  {# Canonical Schemas #}
  {% include "components/schema/website.njk" ignore missing %}
  {% include "components/schema/siteowner.njk" ignore missing %}
</head>
<body>

  {# Global Overlay Header #}
  {% include "header.njk" %}

  {# Primary Content Viewport #}
  <main id="main-content">
    {{ content | safe }}
  </main>

  {# Minimalist Integrated Footer #}
  {% include "footer.njk" %}

  {# Floating Bottom Action Tray (75% Liquid Glass) #}
  {% include "components/widget/layout-actionbar-bottom.njk" ignore missing %}

  {# Slide-Up Section Navigation Drawer (Hidden Off-Screen) #}
  {% include "components/widget/drawer-action-navigate.njk" ignore missing %}

</body>
</html>