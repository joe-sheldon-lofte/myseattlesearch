<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  
  {# Preconnect to Google Font origins early #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  {# Dynamic Meta Titles & Descriptions #}
  <title>{{ title | default(stats.site_name | default("MySeattleSearch | Puget Sound Real Estate & Hyperlocal Data")) }}</title>
  <meta name="description" content="{{ meta_description | default("Explore Puget Sound real estate, municipal data, and neighborhood telemetry with " ~ (stats.full_name | default("Joe Sheldon")) ~ ".") }}">
  
  {# Favicons #}
  <link rel="icon" href="/assets/brand/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">

  {# Dancing Script Font Resource #}
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&display=swap" rel="stylesheet">

  {# Canonical Master Stylesheet with Cache-Buster #}
  <link rel="stylesheet" href="/style.css{% if buildTime %}?v={{ buildTime | slugify }}{% endif %}">

  {# Canonical Schemas #}
  {% include "components/schema/website.njk" ignore missing %}
  {% include "components/schema/siteowner.njk" ignore missing %}
</head>
<body>

  {# Global Overlay Header #}
  {% include "header.njk" %}

  {# Primary Content Viewport Anchor (Div wrapper prevents invalid nested <main> elements; scoped for Pagefind) #}
  <div id="main-content" data-pagefind-body>
    {{ content | safe }}
  </div>

  {# Minimalist Integrated Footer #}
  {% include "footer.njk" %}

  {# Floating Bottom Action Tray (78% Liquid Glass) #}
  {% include "components/widget/layout-actionbar-bottom.njk" ignore missing %}

  {# Interactive Site Search & Discovery Modal (Pagefind) #}
  {% include "components/widget/search-modal.njk" ignore missing %}

  {# Slide-Up Section Navigation Drawer (Hidden Off-Screen) #}
  {% include "components/widget/drawer-action-navigate.njk" ignore missing %}

  {# Global Telemetry Polling Hook #}
  <script>
  document.querySelectorAll("[data-live-source]").forEach(async (el) => {
    const endpoint = el.getAttribute("data-live-source");
    try {
      const res = await fetch(endpoint);
      const json = await res.json();
      
      const valueEl = el.querySelector('[data-target="value"]');
      const labelEl = el.querySelector('[data-target="label"]');
      
      if (valueEl) valueEl.textContent = json.value;
      if (labelEl) labelEl.textContent = json.label;
      if (json.status_token) el.style.setProperty("--stat-accent", json.status_token);
    } catch (e) {
      const valueEl = el.querySelector('[data-target="value"]');
      if (valueEl) valueEl.textContent = "NO DATA";
    }
  });
  </script>

<script>
(function() {
  const containers = document.querySelectorAll(".neighborhood-nav-container");
  if (!containers.length) return;

  containers.forEach(function(container) {
    if (container.dataset.navEnhanced === "true") return;
    const track = container.querySelector(".neighborhood-nav-track");
    if (!track) return;

    container.dataset.navEnhanced = "true";

    const btnLeft = document.createElement("button");
    btnLeft.type = "button";
    btnLeft.className = "neighborhood-nav-arrow neighborhood-nav-arrow--left";
    btnLeft.setAttribute("aria-label", "Scroll navigation left");
    btnLeft.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>';

    const btnRight = document.createElement("button");
    btnRight.type = "button";
    btnRight.className = "neighborhood-nav-arrow neighborhood-nav-arrow--right";
    btnRight.setAttribute("aria-label", "Scroll navigation right");
    btnRight.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>';

    container.prepend(btnLeft);
    container.append(btnRight);

    function updateArrows() {
      const maxScroll = track.scrollWidth - track.clientWidth;
      container.classList.toggle("can-scroll-left", track.scrollLeft > 2);
      container.classList.toggle("can-scroll-right", maxScroll - track.scrollLeft > 2);
    }

    function scrollStep(direction) {
      const delta = Math.max(180, Math.round(track.clientWidth * 0.65));
      track.scrollBy({ left: direction * delta, behavior: "smooth" });
    }

    btnLeft.addEventListener("click", function() { scrollStep(-1); });
    btnRight.addEventListener("click", function() { scrollStep(1); });
    track.addEventListener("scroll", updateArrows, { passive: true });
    window.addEventListener("resize", updateArrows, { passive: true });
    window.addEventListener("load", updateArrows);

    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(updateArrows).observe(track);
    }

    updateArrows();
  });
})();
</script>

</body>
</html>
