<!-- File: _includes/footer.njk -->
{# 
  COMPONENT: Minimalist Integrated Footer (global.footer)
  PURPOSE: Statutory Redfin brokerage disclosure, compliance links, and continuous build telemetry.
  CONTRACT:
    - stats.brokerage_name: String [Optional, defaults to "Redfin"]
    - stats.universal_contact_address: String [Required via _data/stats.json]
    - stats.universal_contact_city: String [Required via _data/stats.json]
    - stats.universal_contact_state: String [Required via _data/stats.json]
    - stats.universal_contact_zip: String [Required via _data/stats.json]
    - stats.full_name / stats.short_name: String [Optional via _data/stats.json]
    - buildTime: String (Generated by Eleventy global build data)
    - r2_storage.usedGB: Number or String (Cloudflare R2 storage allocation)
#}

<footer class="integrated-footer" role="contentinfo">
  
  {# Main Content Grid #}
  <div class="footer-content-grid">
    
    {# Left Anchor: Verified Brokerage Mark & Physical Office #}
    <div class="footer-left-anchor">
      <img src="https://assets.myseattlesearch.com/repomove/redfin.webp" 
           alt="{{ stats.brokerage_name | default('Redfin') }} Real Estate" 
           class="footer-logo-redfin" 
           loading="lazy" 
           width="220" 
           height="88">
      
      <address class="footer-office-address">
        {{ stats.universal_contact_address }}, 
        {{ stats.universal_contact_city }}, 
        {{ stats.universal_contact_state }} 
        {{ stats.universal_contact_zip }}
      </address>
    </div>

    {# Right Anchor: Statutory Compliance & Professional Representation #}
    <nav class="footer-right-anchor" aria-label="Footer Nav Links">
      <a href="/about-joe/" class="footer-nav-link">About {{ stats.short_name | default("Joe") }}</a>
      <a href="/boldprint/" class="footer-nav-link">The Bold Print</a>
      <a href="/fair-housing/" class="footer-nav-link">Commitment to Fair Housing</a>
    </nav>

  </div>

  {# Base System Line: Copyright & Operational Telemetry #}
  <div class="footer-system-line">
    <span>&copy; 2026 {{ stats.full_name | default("Joseph Sheldon") }}</span>
    
    <span class="footer-telemetry-stamp">
      Last Update: {{ buildTime }}{% if r2_storage and r2_storage.usedGB is defined %} &bull; {{ r2_storage.usedGB }}/10{% endif %}
    </span>
  </div>

</footer>