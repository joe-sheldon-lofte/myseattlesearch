      <p class="v4-hero-sub">Real Estate Intelligence & Municipal Metrics</p>
    </div>
  </section>

  <!-- SECTION 1: AT-A-GLANCE METRICS CAROUSEL -->
  <section id="section-glance" class="v4-section">
    <div class="v4-section-header">
      <h2 class="v4-section-title">At a Glance</h2>
    </div>
    <div class="v4-carousel-wrapper">
