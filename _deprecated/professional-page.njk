---
layout: base.njk
pagination:
  data: professionals.vendors
  addAllPagesToCollections: true
  size: 1
  alias: vendor
  addAllPages: true
permalink: "/professionals/{{ vendor.slug }}/"
eleventyComputed:
  title: "{{ vendor.name }} - Preferred Professional | Joe Sheldon"
  description: "Verified credentials, licensing, and contact details for {{ vendor.name }}{% if vendor.company %} ({{ vendor.company }}){% endif %}."
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://myseattlesearch.com/professionals/{{ vendor.slug }}/#service",
      "name": "{{ vendor.name }}",
      "image": "https://assets.myseattlesearch.com/repomove/hero-living-room.webp",
      "telephone": "{{ vendor.phoneClean }}",
      "email": "{{ vendor.email }}",
      "url": "{% if vendor.website %}{{ vendor.website }}{% else %}https://myseattlesearch.com/professionals/{{ vendor.slug }}/{% endif %}",
      "category": "{{ vendor.category }}",
      "description": "{% if vendor.additionalInfo %}{{ vendor.additionalInfo }}{% else %}{{ vendor.name }} - Pre-vetted real estate service provider serving King and Snohomish counties.{% endif %}",
      "areaServed": [
        {
          "@type": "AdministrativeArea",
          "name": "King County, WA"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Snohomish County, WA"
        }
      ],
      "provider": {
        "@type": "RealEstateAgent",
        "@id": "https://myseattlesearch.com/#agent",
        "name": "Joe Sheldon"
      },
      "knowsAbout": [
        "{{ vendor.category }}",
        "Residential Real Estate Services",
        "King & Snohomish County Property Care"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://myseattlesearch.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Preferred Professionals",
          "item": "https://myseattlesearch.com/professionals/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ vendor.name }}",
          "item": "https://myseattlesearch.com/professionals/{{ vendor.slug }}/"
        }
      ]
    }
  ]
}
</script>

<div class="vendor-profile-container">
  
  <div class="back-link-wrapper">
    <a href="/professionals/" class="back-link">&larr; Back to Preferred Professionals Directory</a>
  </div>

  <article class="vendor-profile-card">
    <span class="vendor-category-badge">{{ vendor.category }}</span>
    <h1 class="vendor-profile-title">{{ vendor.name }}</h1>
    
    {% if vendor.company %}
    <div class="vendor-company-sub">({{ vendor.company }})</div>
    {% endif %}

    {% if vendor.additionalInfo %}
    <p class="vendor-info-lead">{{ vendor.additionalInfo }}</p>
    {% else %}
    <p class="vendor-info-lead">Verified local service provider servicing single-family homes and residential real estate transactions across King and Snohomish counties.</p>
    {% endif %}

    <div class="vendor-contact-grid">
      {% if vendor.phone %}
      <a href="tel:{{ vendor.phoneClean }}" class="contact-action-btn contact-btn-phone">
        📞 Call {{ vendor.phone }}
      </a>
      {% endif %}

      {% if vendor.website %}
      <a href="{{ vendor.website }}" target="_blank" rel="noopener" class="contact-action-btn contact-btn-website">
        🌐 Visit Official Website ↗
      </a>
      {% endif %}
    </div>

    {% if vendor.legalReq %}
    <div class="credentials-box">
      <h4>🛡️ Verified License & Credentials</h4>
      <p>{{ vendor.legalReq }}</p>
      {% if vendor.legalLink %}
      <a href="{{ vendor.legalLink }}" target="_blank" rel="noopener" class="verify-link">
        Verify Active License on WA L&I State Portal &rarr;
      </a>
      {% endif %}
    </div>
    {% endif %}

    <div class="agent-endorsement-banner">
      <h4>💡 Need Vendor Advice or Contractor Coordination?</h4>
      <p>I pre-vet local vendors to help my buying and selling clients navigate home inspections, pre-sale repairs, and ongoing property maintenance with zero headaches.</p>
      <a href="sms:+12066577493" class="btn-agent-sms">💬 Text Joe Sheldon</a>
      <span style="display: block; margin-top: 0.5rem; font-size: 0.82rem; opacity: 0.85;">Or call Joe directly at (206) 657-7493</span>
    </div>

  </article>
</div>