<script>
class PropertyHazardRadar extends HTMLElement {
  constructor() {
    super();
    this.cityData = [];
    this.hazardsMaster = [];
  }

  async connectedCallback() {
    this.citySelect = this.querySelector('#radar-city-select');
    this.yearInput = this.querySelector('#radar-year-built');
    this.chkOil = this.querySelector('#chk-oil-tank');
    this.chkSeptic = this.querySelector('#chk-septic-well');
    this.chkBasement = this.querySelector('#chk-basement-crawl');
    this.container = this.querySelector('#radar-results-container');
    this.countBadge = this.querySelector('#results-count');

    this.querySelectorAll('.btn-preset').forEach(btn => {
      btn.addEventListener('click', (e) => {
        this.yearInput.value = e.target.getAttribute('data-year');
        this.evaluateHazards();
      });
    });

    this.citySelect?.addEventListener('change', () => this.evaluateHazards());
    this.yearInput?.addEventListener('input', () => this.evaluateHazards());
    this.chkOil?.addEventListener('change', () => this.evaluateHazards());
    this.chkSeptic?.addEventListener('change', () => this.evaluateHazards());
    this.chkBasement?.addEventListener('change', () => this.evaluateHazards());

    try {
      const [resCities, resHazards] = await Promise.all([
        fetch('/data/city_data.json'),
        fetch('/data/hazards_master.json')
      ]);

      if (resCities.ok) this.cityData = await resCities.json();
      if (resHazards.ok) this.hazardsMaster = await resHazards.json();

      this.evaluateHazards();
    } catch (err) {
      console.warn('Property Hazard Radar: Error fetching master JSON data', err);
    }
  }

  evaluateHazards() {
    if (!this.hazardsMaster || this.hazardsMaster.length === 0) return;

    const selectedCityName = this.citySelect?.value || 'Lynnwood';
    const yearBuilt = parseInt(this.yearInput?.value, 10) || 1975;
    const hasOil = this.chkOil?.checked || false;
    const hasSeptic = this.chkSeptic?.checked || false;
    const hasBasement = this.chkBasement?.checked || false;

    const cityRecord = this.cityData.find(c => c.City === selectedCityName) || {};
    const rawCityHazards = cityRecord['Health Hazards'] || cityRecord['health_hazards'] || '';
    const cityTags = rawCityHazards.split(',').map(t => t.trim().toLowerCase()).filter(Boolean);

    const activeHazards = [];

    this.hazardsMaster.forEach(item => {
      let isMatch = false;

      if (item.trigger_type === 'always') {
        isMatch = true;
      } else if (item.trigger_type === 'city_tag' && cityTags.includes(item.trigger_key.toLowerCase())) {
        isMatch = true;
      } else if (item.trigger_type === 'year_built_before' && yearBuilt < item.trigger_key) {
        isMatch = true;
      } else if (item.trigger_type === 'feature') {
        if (item.trigger_key === 'has_oil_tank' && hasOil) isMatch = true;
        if (item.trigger_key === 'has_septic_well' && hasSeptic) isMatch = true;
        if (item.trigger_key === 'has_basement_crawl' && hasBasement) isMatch = true;
      }

      if (isMatch) activeHazards.push(item);
    });

    this.renderResults(activeHazards, selectedCityName, yearBuilt);
  }

  renderResults(hazards, cityName, yearBuilt) {
    if (!this.container) return;

    if (this.countBadge) {
      this.countBadge.textContent = `${hazards.length} Items Identified for ${cityName} (${yearBuilt})`;
    }

    if (hazards.length === 0) {
      this.container.innerHTML = `
        <div style="text-align: center; padding: 1.5rem; color: var(--premier-charcoal); opacity: 0.8;">
          <p>No specific geographic land hazards identified for this exact criteria. Standard WA safety codes apply.</p>
        </div>
      `;
      return;
    }

    this.container.innerHTML = hazards.map(item => {
      return `
        <article class="hazard-result-card">
          <span class="card-category-tag">${item.category || 'Property Factor'}</span>
          <h3 class="hazard-title">${item.title}</h3>
          <p class="hazard-summary">${item.summary}</p>
          <a href="${item.url}" style="font-weight: 700; color: var(--premier-charcoal); text-decoration: underline; font-size: 0.9rem;">
            Read Full Guide &amp; Local Rules &rarr;
          </a>
        </article>
      `;
    }).join('');
  }
}

if (!customElements.get('property-hazard-radar')) {
  customElements.define('property-hazard-radar', PropertyHazardRadar);
}
</script>